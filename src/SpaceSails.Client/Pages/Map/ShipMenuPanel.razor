@namespace SpaceSails.Client.Pages
@implements IHandleEvent
@using NpcState = SpaceSails.Client.Pages.Map.NpcState
@using System.Globalization
@using SpaceSails.Client.Rendering
@using SpaceSails.Contracts
@using SpaceSails.Core
@using SpaceSails.Core.Interior
@*
    #251 item 1 · THE SHIP CLICK MENU, ON ITS OWN FILE.

    Moved out of Map.razor by PURE MOTION — the block between the two fences below is the block that was in
    the page, character for character. Every page member it reads is a [Parameter] with the SAME NAME (the
    fields keep their underscore, the methods come across as delegates), which is what lets the markup move
    without a rewrite and lets the suite's source guards read it through MapMarkup exactly as before.

    The `@if` that opens it stays in Map.razor: the page keeps its paint order in one place, and a closed
    surface still renders nothing. IHandleEvent repeats the page's own override (Map.Sim.cs) — without it
    Blazor would put an automatic re-render back on every event in here, which the page turns off because
    the HUD's refresh belongs to OnTick's 200 ms throttle. The .razor.css beside this file carries no rules;
    it exists to give the component Map.razor.css's scope (#251 item 3 moves the rules).

    The `@{ }` around the fences is not decoration: the block used to sit inside `@if (…) { … }`,
    which is a Razor CODE block, and a code block is where its first statements are legal. The braces
    put the moved lines back in the context they were written in; they are outside the fences, so what
    the source guards read is still exactly the lines that were in the page.
*@
@* ── THE PAGE'S OWN NOTE ON THIS SURFACE, moved here with it (#251 item 1) and not touched by a
   word: it is the paragraph that stood above this block in Map.razor. It sits ABOVE the fence, not
   inside it, so that a source guard slicing the block by text goes on reading markup and not prose.
   ── *@
    @* M29: the contact menu — clicking a ship selects it for the scope AND offers the real
       actions: telescope tracking and the war-room interest (intercept clock, firing solutions). *@

@{
@* ── MARKUP BEGINS · verbatim from Map.razor ─────────────────────────────────────────────────────────── *@
        @* #253: a vitals line plus up to three actions (interest · track · scan). *@
        var shipAt = ClampMenu(_shipMenuX, _shipMenuY, 4);
        @* #997 wave 10 · Card · Close. The vitals line and the three actions are the page's own children of
           the shell's body, in the order they were typed; the ✕ is the shell's. *@
        <OverlayShell class="map-body-menu bg-dark bg-opacity-75 rounded p-2 text-light small shadow"
                      style="@MenuAnchorStyle(shipAt)"
                      Dismiss="OverlayDismiss.Close" OnClose="CloseShipMenu"
                      HeadClass="d-flex justify-content-between align-items-center mb-1"
                      Title="@menuNpc.Ship.Callsign" TitleClass="fw-bold me-2"
                      DismissClass="btn-close btn-close-white btn-sm"
                      DismissLabel="Close" DismissTitle="Close this contact's menu">
            @if (menuNpc.CurrentlyObserved)
            {
                <div class="text-secondary mb-1">
                    @FormatDistance((menuNpc.State.Position - _ship.Position).Length) ·
                    rel @(((menuNpc.State.Velocity - _ship.Velocity).Length / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s ·
                    @* #210: the SIGNED range-rate — are we closing or opening — same voice as the dossier card. *@
                    @RelativeMotion.WordedBefore(RelativeMotion.ClosingSpeed(_ship.Position, _ship.Velocity, menuNpc.State.Position, menuNpc.State.Velocity)) ·
                    scope tracking her now
                </div>
            }
            else
            {
                @* PR-C, the Barnacle case: a labeled contact with no live fix is never mute. *@
                <div class="text-warning mb-1">
                    no live fix — last seen @(((SimTime - menuNpc.LastObservation!.Value.SimTime) / 86400.0).ToString("F1", CultureInfo.InvariantCulture))d ago
                </div>
            }
            <div class="d-grid gap-1">
                @if (menuNpc.CurrentlyObserved)
                {
                    <button type="button" class="btn btn-sm btn-info" title="Mark her a target of interest — intercept clock and firing solutions"
                            @onclick="() => InterestFromMenu(menuShipId)">
                        🎯 Target of interest — intercept clock &amp; firing solutions
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" title="Put the telescope on her — sharpen the fix"
                            @onclick="() => TrackShipFromMenu(menuShipId)">
                        📡 Track with telescope — sharpen the intel
                    </button>
                }
                @if (_activeDesk == ShipDesk.Sensors)
                {
                    Vector2d scanCenter = menuNpc.CurrentlyObserved
                        ? menuNpc.State.Position
                        : menuNpc.LastObservation!.Value.Position;
                    string shipScanLabel = $"scan near {menuNpc.Ship.Callsign}";
                    <button type="button" class="btn btn-sm btn-outline-info" title="Sweep the telescope around here to find her"
                            @onclick="() => ScanAreaFromMenu(scanCenter, 8e9, shipScanLabel)">
                        🔭 Scan around here@(menuNpc.CurrentlyObserved ? "" : " — find out where she went")
                    </button>
                }
            </div>
        </OverlayShell>
@* ── MARKUP ENDS ─────────────────────────────────────────────────────────────────────────────────────── *@
}

@code {
    // ── WHAT THESE PARAMETERS ARE ────────────────────────────────────────────────────────────────────
    //
    // #251 item 1 · Every [Parameter] below carries a member of the page under THE MEMBER'S OWN NAME —
    // a field keeps its underscore, a method arrives as a delegate with its own signature, a variable the
    // page's `@if` binds arrives under the name the `@if` gave it. That is the whole trick of this
    // refactor: it is what let the markup above move out of Map.razor without a single character of it
    // changing, and what lets the suite's source guards read it through MapMarkup exactly as they read it
    // when it lived in the page. A parameter that needs saying more than that says it on its own line.

    [Parameter] public ShipDesk _activeDesk { get; set; } = default!;
    [Parameter] public ShipState _ship { get; set; } = default!;
    [Parameter] public Func<double, double, int, (double X, double Y)> ClampMenu { get; set; } = default!;
    [Parameter] public Action CloseShipMenu { get; set; } = default!;
    [Parameter] public Func<Action, Task> Dismiss { get; set; } = default!;
    [Parameter] public Func<double, string> FormatDistance { get; set; } = default!;
    [Parameter] public Action<string> InterestFromMenu { get; set; } = default!;
    [Parameter] public Func<(double X, double Y), string> MenuAnchorStyle { get; set; } = default!;
    [Parameter] public Action<Vector2d, double, string> ScanAreaFromMenu { get; set; } = default!;
    [Parameter] public double SimTime { get; set; }
    [Parameter] public Action<string> TrackShipFromMenu { get; set; } = default!;
    [Parameter] public NpcState menuNpc { get; set; } = default!;
    [Parameter] public string menuShipId { get; set; } = default!;

    [Parameter] public double _shipMenuX { get; set; }
    [Parameter] public double _shipMenuY { get; set; }
    // The page's own event dispatch, repeated: no automatic re-render per event.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);
}
