@namespace SpaceSails.Client.Pages
@implements IHandleEvent
@using System.Globalization
@using SpaceSails.Client.Rendering
@using SpaceSails.Contracts
@using SpaceSails.Core
@using SpaceSails.Core.Interior
@*
    #251 item 1 · THE SCUTTLE PANEL, ON ITS OWN FILE.

    Moved out of Map.razor by PURE MOTION — the block between the two fences below is the block that was in
    the page, character for character. Every page member it reads is a [Parameter] with the SAME NAME (the
    fields keep their underscore, the methods come across as delegates), which is what lets the markup move
    without a rewrite and lets the suite's source guards read it through MapMarkup exactly as before.

    The `@if` that opens it stays in Map.razor: the page keeps its paint order in one place, and a closed
    surface still renders nothing. IHandleEvent repeats the page's own override (Map.Sim.cs) — without it
    Blazor would put an automatic re-render back on every event in here, which the page turns off because
    the HUD's refresh belongs to OnTick's 200 ms throttle. The .razor.css beside this file carries no rules;
    it exists to give the component Map.razor.css's scope (#251 item 3 moves the rules).

    The `@{ }` around the fences is not decoration: the block used to sit inside `@if (…) { … }`,
    which is a Razor CODE block, and a code block is where its first statements are legal. The braces
    put the moved lines back in the context they were written in; they are outside the fences, so what
    the source guards read is still exactly the lines that were in the page.
*@
@{
@* ── MARKUP BEGINS · verbatim from Map.razor ─────────────────────────────────────────────────────────── *@
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseScuttlePanel)">
            <OverlayShell class="vent-board scuttle-panel" StopClicks="true"
                          Frame="OverlayFrame.Bare" Dismiss="OverlayDismiss.Close"
                          DismissClass="view-object-close" DismissFace="Step away"
                          OnClose="() => Dismiss(CloseScuttlePanel)">
                <div class="view-object-title">☢ SCUTTLING PANEL — @scWreck.ShipName.ToUpperInvariant()</div>

                <img class="scuttle-art" src="art/scuttle-panel.jpg" alt=""
                     onerror="this.style.display='none'" />

                <div class="vent-sub">
                    @Scuttle.PriceLine(
                        scWreck.AssessedValueCr,
                        Derelict.Resolve(scWreck, Derelict.SalvageChoice.FileTheReport, scWreck.Cause).CreditsNow)
                </div>

                @if (_scuttleSecondsLeft is { } armedLeft)
                {
                    <div class="vent-message">
                        ☢ RUNNING — @HullVenting.SoakLabel(armedLeft). The way out is the way you came in.
                    </div>
                    <div class="vent-actions">
                        <button type="button" class="btn btn-outline-light btn-sm"
                                disabled="@(!Scuttle.CanAbort(armedLeft))"
                                title="@(Scuttle.CanAbort(armedLeft) ? "" : Scuttle.PastRecallLine)"
                                @onclick="AbortTheOverload">
                            🔑 Back the keys out
                        </button>
                        @if (!Scuttle.CanAbort(armedLeft))
                        {
                            <div class="vent-refusal">@Scuttle.PastRecallLine</div>
                        }
                    </div>
                }
                else
                {
                    <div class="vent-actions">
                        @foreach (Scuttle.Method m in ScuttleMethods())
                        {
                            <button type="button" class="btn btn-danger btn-sm"
                                    title="@($"Takes {Scuttle.Speed(m)}. Nobody pays you to be sure.")"
                                    @onclick="ArmTheOverload">
                                ☢ Turn both keys — reactor overload
                            </button>
                        }
                        @* The methods this hull cannot do, and WHY. A greyed control that does not say why
                           is a bug wearing a tooltip's clothes. *@
                        @foreach (Scuttle.Method m in System.Enum.GetValues<Scuttle.Method>())
                        {
                            @if (!ScuttleMethods().Contains(m))
                            {
                                <div class="vent-refusal">@Scuttle.Refusal(m, scWreck.Cause)</div>
                            }
                        }
                    </div>
                }
            </OverlayShell>
        </div>
@* ── MARKUP ENDS ─────────────────────────────────────────────────────────────────────────────────────── *@
}

@code {
    /// <summary>the page's `double? _scuttleSecondsLeft`</summary>
    [Parameter] public double? _scuttleSecondsLeft { get; set; }
    /// <summary>the page's `void AbortTheOverload()`</summary>
    [Parameter] public Action AbortTheOverload { get; set; } = default!;
    /// <summary>the page's `void ArmTheOverload()`</summary>
    [Parameter] public Action ArmTheOverload { get; set; } = default!;
    /// <summary>the page's `void CloseScuttlePanel()`</summary>
    [Parameter] public Action CloseScuttlePanel { get; set; } = default!;
    /// <summary>the page's `Task Dismiss(Action close)`</summary>
    [Parameter] public Func<Action, Task> Dismiss { get; set; } = default!;
    /// <summary>the page's `IReadOnlyList<Scuttle.Method> ScuttleMethods()`</summary>
    [Parameter] public Func<IReadOnlyList<Scuttle.Method>> ScuttleMethods { get; set; } = default!;
    /// <summary>bound by the @if that stays in the page</summary>
    [Parameter] public Derelict.Wreck scWreck { get; set; } = default!;

    // The page's own event dispatch, repeated: no automatic re-render per event.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);
}
