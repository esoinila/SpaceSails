@namespace SpaceSails.Client.Pages
@implements IHandleEvent
@using System.Globalization
@using SpaceSails.Client.Rendering
@using SpaceSails.Contracts
@using SpaceSails.Core
@using SpaceSails.Core.Interior
@*
    #251 item 1 · THE PRESSURE DOOR CARD, ON ITS OWN FILE.

    Moved out of Map.razor by PURE MOTION — the block between the two fences below is the block that was in
    the page, character for character. Every page member it reads is a [Parameter] with the SAME NAME (the
    fields keep their underscore, the methods come across as delegates), which is what lets the markup move
    without a rewrite and lets the suite's source guards read it through MapMarkup exactly as before.

    The `@if` that opens it stays in Map.razor: the page keeps its paint order in one place, and a closed
    surface still renders nothing. IHandleEvent repeats the page's own override (Map.Sim.cs) — without it
    Blazor would put an automatic re-render back on every event in here, which the page turns off because
    the HUD's refresh belongs to OnTick's 200 ms throttle. The .razor.css beside this file carries no rules;
    it exists to give the component Map.razor.css's scope (#251 item 3 moves the rules).

    The `@{ }` around the fences is not decoration: the block used to sit inside `@if (…) { … }`,
    which is a Razor CODE block, and a code block is where its first statements are legal. The braces
    put the moved lines back in the context they were written in; they are outside the fences, so what
    the source guards read is still exactly the lines that were in the page.
*@
@* ── THE PAGE'S OWN NOTE ON THIS SURFACE, moved here with it (#251 item 1) and not touched by a
   word: it is the paragraph that stood above this block in Map.razor. It sits ABOVE the fence, not
   inside it, so that a source guard slicing the block by text goes on reading markup and not prose.
   ── *@
    @* #488 · THE DOOR THAT WILL NOT MOVE. Owner, after strolling into a compartment he had just blown:
       "we need some kind of door locked due to vacuum feature … maybe a gauge that says the door is shut
       due to pressure difference." One atmosphere across a door is about ten tonnes; nobody opens that by
       hand. Two roads through it, priced differently — crack the valve and lose the ship's air for free,
       or spend a charge off the shuttle and keep it. *@

@{
@* ── MARKUP BEGINS · verbatim from Map.razor ─────────────────────────────────────────────────────────── *@
        var pdVacuumSide = pdSpace.Vented;
        var pdLoaded = HullVenting.DoorHeldByPressure(pdSpace, _spinePressurised);
        <div class="view-object-backdrop" @onclick="() => Dismiss(ClosePressureDoorCard)">
            <OverlayShell class="vent-board pressure-door" StopClicks="true"
                          Frame="OverlayFrame.Bare" Dismiss="OverlayDismiss.Close"
                          DismissClass="view-object-close" DismissFace="Step away"
                          OnClose="() => Dismiss(ClosePressureDoorCard)">
                <div class="view-object-title">
                    @(pdLoaded ? $"⛔ {pdName} — THE DOOR IS LOADED" : $"🚪 {pdName} — HATCH")
                </div>

                @* The gauge. A needle hard over on its stop, which is the whole message — and slack in the
                   middle of its travel when there is nothing across the door at all. *@
                <div class="pd-gauge" role="img" aria-label="pressure differential">
                    <div class="pd-face">
                        <div class="pd-needle @(pdLoaded ? "hard-over" : "slack")"></div>
                        <div class="pd-scale"><span>0</span><span>Δp</span><span class="hot">MAX</span></div>
                    </div>
                    <div class="pd-sides">
                        <span class="@(pdVacuumSide ? "vac" : "air")">@(pdVacuumSide ? "VACUUM" : "AIR") — that side</span>
                        <span class="@(_spinePressurised ? "air" : "vac")">@(_spinePressurised ? "AIR" : "VACUUM") — this side</span>
                    </div>
                </div>

                @if (pdLoaded)
                {
                    <div class="vent-message">@HullVenting.PressureLockLine(pdName, pdVacuumSide)</div>
                    <div class="vent-actions">
                        <button type="button" class="btn btn-warning btn-sm"
                                title="@HullVenting.EqualiseWarnsLine"
                                @onclick="() => { EqualiseAtDoor(pdName); ClosePressureDoorCard(); }">
                            🎚 Crack the equalisation valve
                        </button>
                        <div class="vent-refusal">@HullVenting.EqualiseWarnsLine</div>
                        <div class="vent-refusal">
                            One valve empties the corridor and every room standing open to it. What survives is
                            whatever somebody dogged a hatch on.
                        </div>
                        <div class="vent-refusal">
                            Or keep the ship's air: bring @pdName back to pressure at the valve board aft
                            (@_refillCharges of the shuttle's breaths left).
                        </div>
                    </div>
                }
                else
                {
                    @* The hand-dogs. The counterplay to somebody cracking a valve two compartments away —
                       and the infestation will never use it, because it has not read the manual. *@
                    <div class="vent-actions">
                        <button type="button" class="btn btn-outline-light btn-sm"
                                @onclick="() => { ToggleSealAtHand(pdName); ClosePressureDoorCard(); }">
                            @(pdSpace.DoorShut ? $"🔓 Undog the {pdName} hatch" : $"🔒 Dog the {pdName} hatch down")
                        </button>
                        <div class="vent-refusal">
                            @(pdSpace.DoorShut
                                ? "Sealed. Whatever happens to the pressure in the rest of this ship happens without it — and you are not walking through it either."
                                : "Standing open. It shares the corridor's air, which means it shares whatever happens to the corridor's air.")
                        </div>
                    </div>
                }
            </OverlayShell>
        </div>
@* ── MARKUP ENDS ─────────────────────────────────────────────────────────────────────────────────────── *@
}

@code {
    // ── WHAT THESE PARAMETERS ARE ────────────────────────────────────────────────────────────────────
    //
    // #251 item 1 · Every [Parameter] below carries a member of the page under THE MEMBER'S OWN NAME —
    // a field keeps its underscore, a method arrives as a delegate with its own signature, a variable the
    // page's `@if` binds arrives under the name the `@if` gave it. That is the whole trick of this
    // refactor: it is what let the markup above move out of Map.razor without a single character of it
    // changing, and what lets the suite's source guards read it through MapMarkup exactly as they read it
    // when it lived in the page. A parameter that needs saying more than that says it on its own line.

    [Parameter] public int _refillCharges { get; set; }
    [Parameter] public bool _spinePressurised { get; set; }
    [Parameter] public Action ClosePressureDoorCard { get; set; } = default!;
    [Parameter] public Func<Action, Task> Dismiss { get; set; } = default!;
    [Parameter] public Action<string> EqualiseAtDoor { get; set; } = default!;
    [Parameter] public Action<string> ToggleSealAtHand { get; set; } = default!;
    [Parameter] public string pdName { get; set; } = default!;
    [Parameter] public HullVenting.Space pdSpace { get; set; } = default!;

    // The page's own event dispatch, repeated: no automatic re-render per event.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);
}
