@namespace SpaceSails.Client.Pages
@implements IHandleEvent
@using System.Globalization
@using SpaceSails.Client.Rendering
@using SpaceSails.Contracts
@using SpaceSails.Core
@using SpaceSails.Core.Interior
@*
    #251 item 1 · THE SHIP SCUTTLE PANEL, ON ITS OWN FILE.

    Moved out of Map.razor by PURE MOTION — the block between the two fences below is the block that was in
    the page, character for character. Every page member it reads is a [Parameter] with the SAME NAME (the
    fields keep their underscore, the methods come across as delegates), which is what lets the markup move
    without a rewrite and lets the suite's source guards read it through MapMarkup exactly as before.

    The `@if` that opens it stays in Map.razor: the page keeps its paint order in one place, and a closed
    surface still renders nothing. IHandleEvent repeats the page's own override (Map.Sim.cs) — without it
    Blazor would put an automatic re-render back on every event in here, which the page turns off because
    the HUD's refresh belongs to OnTick's 200 ms throttle. The .razor.css beside this file carries no rules;
    it exists to give the component Map.razor.css's scope (#251 item 3 moves the rules).

    The `@{ }` around the fences is not decoration: the block used to sit inside `@if (…) { … }`,
    which is a Razor CODE block, and a code block is where its first statements are legal. The braces
    put the moved lines back in the context they were written in; they are outside the fences, so what
    the source guards read is still exactly the lines that were in the page.
*@
@* ── THE PAGE'S OWN NOTE ON THIS SURFACE, moved here with it (#251 item 1) and not touched by a
   word: it is the paragraph that stood above this block in Map.razor. It sits ABOVE the fence, not
   inside it, so that a source guard slicing the block by text goes on reading markup and not prose.
   ── *@
    @* ═══════════════════════════════════════════════════════════════════════════════════════════════════
       HER SCUTTLING CHARGES, AND THE TWO HANDS IT TAKES. Owner: "that ship also has the scuttling charges...
       let's have a captains approval mechanic for that also on our ship. :-D ... it is the last defence against
       the Borg in Star Trek :-D", and then the sentence that makes it a mechanic rather than an ending: "they
       only need to activate it for the borg to back down enough."

       The second key is the CREW's — "I guess we need the another opinion we just don't have a desk for that on
       the bridge yet" — read off the sheet already on the captain's desk. No new desk required, and the crew
       temperature stops being a report card.
       ═══════════════════════════════════════════════════════════════════════════════════════════════════ *@

@{
@* ── MARKUP BEGINS · verbatim from Map.razor ─────────────────────────────────────────────────────────── *@
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseShipScuttlePanel)">
            <OverlayShell class="vent-board" StopClicks="true"
                          Frame="OverlayFrame.Bare" Dismiss="OverlayDismiss.Close"
                          DismissClass="view-object-close" DismissFace="Step away"
                          OnClose="() => Dismiss(CloseShipScuttlePanel)">
                <div class="view-object-title">☢ SCUTTLING CHARGES — HER OWN KEEL</div>

                @if (_shipChargesSeconds is { } shipBurn)
                {
                    <div class="vent-sub">
                        @(Scuttle.CanAbort(shipBurn)
                            ? "The note of her is up half a tone. The panel will still take the keys back."
                            : "Past recall. Whatever happens now happens on its own schedule.")
                    </div>
                    <div class="vent-readout">
                        ☢ OVERLOAD — @HullVenting.SoakLabel(shipBurn) · the way out is the way you came in
                    </div>
                    @if (Scuttle.CanAbort(shipBurn))
                    {
                        <button type="button" class="btn btn-outline-warning btn-sm" @onclick="BackTheKeysOut">
                            ↩ Back the keys out
                        </button>
                    }
                }
                else
                {
                    <div class="vent-sub">@ShipScuttle.NeverDelegable</div>
                    <div class="vent-readout">@ShipScuttle.PriceLine(_cargoUnits, (long)_cargoValue, _credits)</div>

                    <div class="vent-actions">
                        <button type="button"
                                class="btn btn-sm @(_shipScuttleWordGiven ? "btn-success" : "btn-outline-danger")"
                                title="@ShipScuttle.AskFor("this ship")"
                                @onclick="GiveTheWordAgainstHer">
                            @(_shipScuttleWordGiven ? "✅ THE CAPTAIN'S KEY IS TURNED — click to take it back" : "🔑 The captain's key")
                        </button>

                        @* THE SECOND OPINION. Not a rules explanation and not a dice roll the captain can
                           re-roll: the crew answer from where they already stand with him. *@
                        <button type="button"
                                class="btn btn-sm @(_shipScuttleSecondKey == ShipScuttle.SecondKey.Refused ? "btn-outline-secondary" : "btn-outline-warning")"
                                disabled="@(!_shipScuttleWordGiven)"
                                title="Scuttling her takes two hands. Ask the crew for theirs."
                                @onclick="AskTheCrewForTheSecondKey">
                            🧑‍🔧 Ask the crew for the second key
                        </button>

                        <button type="button" class="btn btn-danger btn-sm"
                                disabled="@(!_shipScuttleWordGiven
                                            || _shipScuttleSecondKey is null
                                            || _shipScuttleSecondKey == ShipScuttle.SecondKey.Refused)"
                                title="@(_shipScuttleSecondKey == ShipScuttle.SecondKey.Refused
                                         ? ShipScuttle.RefusedPointerLine
                                         : "Both keys together. Ninety seconds, and a recall window for the first sixty.")"
                                @onclick="TurnBothKeys">
                            ☢ TURN BOTH KEYS
                        </button>
                    </div>
                }

                @if (_shipScuttleMessage is { Length: > 0 } shipScuttleMsg)
                {
                    <div class="vent-message">@shipScuttleMsg</div>
                }
            </OverlayShell>
        </div>
@* ── MARKUP ENDS ─────────────────────────────────────────────────────────────────────────────────────── *@
}

@code {
    // ── WHAT THESE PARAMETERS ARE ────────────────────────────────────────────────────────────────────
    //
    // #251 item 1 · Every [Parameter] below carries a member of the page under THE MEMBER'S OWN NAME —
    // a field keeps its underscore, a method arrives as a delegate with its own signature, a variable the
    // page's `@if` binds arrives under the name the `@if` gave it. That is the whole trick of this
    // refactor: it is what let the markup above move out of Map.razor without a single character of it
    // changing, and what lets the suite's source guards read it through MapMarkup exactly as they read it
    // when it lived in the page. A parameter that needs saying more than that says it on its own line.

    [Parameter] public int _cargoUnits { get; set; }
    [Parameter] public int _cargoValue { get; set; }
    [Parameter] public int _credits { get; set; }
    [Parameter] public double? _shipChargesSeconds { get; set; }
    [Parameter] public string? _shipScuttleMessage { get; set; }
    [Parameter] public ShipScuttle.SecondKey? _shipScuttleSecondKey { get; set; }
    [Parameter] public bool _shipScuttleWordGiven { get; set; }
    [Parameter] public Action AskTheCrewForTheSecondKey { get; set; } = default!;
    [Parameter] public Action BackTheKeysOut { get; set; } = default!;
    [Parameter] public Action CloseShipScuttlePanel { get; set; } = default!;
    [Parameter] public Func<Action, Task> Dismiss { get; set; } = default!;
    [Parameter] public Action GiveTheWordAgainstHer { get; set; } = default!;
    [Parameter] public Action TurnBothKeys { get; set; } = default!;

    // The page's own event dispatch, repeated: no automatic re-render per event.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);
}
