@namespace SpaceSails.Client.Pages
@implements IHandleEvent
@using SpaceSails.Client.Rendering
@using SpaceSails.Core
@*
    #251 · THE NAV DESK'S OWN FOUR CARDS, ON ONE FILE.

    The loud plan alarm, the adrift lifeline, the rescue offer and the tutorial — the cards that only the Nav desk raises, moved with the desk's gate around them.

    Moved out of Map.razor by PURE MOTION (the owner's ruling of 2026-09-03: "Map.razor → components"):
    the block between the two fences below is the block that was in the page, character for character,
    gates included — a gate is what says WHEN a thing is on the glass, and it travels with the thing.
    Every page member the block reads is a [Parameter] with the SAME NAME; a member it WRITES crosses as
    a value-and-setter pair (NoSurfaceSwallowsAWriteTests). TheComposedMapIsTheMapTests holds the page
    this composes to, byte for byte.

    IHandleEvent repeats the page's own override (Map.Sim.cs): no automatic re-render per event, as on
    every surface under Pages/Map/. The .razor.css beside this file carries no rules; it exists to give
    the component Map.razor.css's scope (pinned in SpaceSails.Client.csproj).
*@
@* ── MARKUP BEGINS · verbatim from Map.razor ───────────────────────────────────────────────── *@
    @if (_activeDesk == ShipDesk.Nav)
    {

    @if (LoudPlanAlarm is { } _planBreak)
    {
        <LoudPlanAlarmCard DismissLoudPlanAlarm="@DismissLoudPlanAlarm" LoudPlanAlarmHail="@LoudPlanAlarmHail"
                           LoudPlanAlarmQuote="@LoudPlanAlarmQuote" _planBreak="@_planBreak" />
    }

    @if (Adrift && !_showRescueOffer)
    {
        <AdriftLifeline OpenRescueOffer="@OpenRescueOffer" />
    }

    @if (_showRescueOffer && Adrift)
    {
        <RescueOfferCard _docked="@_docked" _reactionMassPulses="@_reactionMassPulses" AcceptRescue="@AcceptRescue"
                         Adrift="@Adrift" CloseRescueOffer="@CloseRescueOffer" Dismiss="@Dismiss"
                         HotGlossTitle="@HotGlossTitle" ReactionMassCapacity="@ReactionMassCapacity"
                         RescueFeeLines="@RescueFeeLines" />
    }

    @if (_showTutorial)
    {
        <TutorialCard _tutorialStep="@_tutorialStep" ActiveTutorialIndex="@ActiveTutorialIndex" Dismiss="@Dismiss"
                      ToggleTutorial="@ToggleTutorial" TutorialSteps="@TutorialSteps"
                      TutorialTracks="@TutorialTracks" />
    }
    }
@* ── MARKUP ENDS ──────────────────────────────────────────────────────────────── *@
