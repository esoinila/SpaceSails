@namespace SpaceSails.Client.Pages
@implements IHandleEvent
@using System.Globalization
@using SpaceSails.Client.Rendering
@using SpaceSails.Contracts
@using SpaceSails.Core
@using SpaceSails.Core.Interior
@*
    #251 item 1 · THE SENSORS DESK LAYER, ON ITS OWN FILE.

    Moved out of Map.razor by PURE MOTION — the block between the two fences below is the block that was in
    the page, character for character. Every page member it reads is a [Parameter] with the SAME NAME (the
    fields keep their underscore, the methods come across as delegates), which is what lets the markup move
    without a rewrite and lets the suite's source guards read it through MapMarkup exactly as before.

    The `@if` that opens it stays in Map.razor: the page keeps its paint order in one place, and a closed
    surface still renders nothing. IHandleEvent repeats the page's own override (Map.Sim.cs) — without it
    Blazor would put an automatic re-render back on every event in here, which the page turns off because
    the HUD's refresh belongs to OnTick's 200 ms throttle. The .razor.css beside this file carries no rules;
    it exists to give the component Map.razor.css's scope (#251 item 3 moves the rules).

    The `@{ }` around the fences is not decoration: the block used to sit inside `@if (…) { … }`,
    which is a Razor CODE block, and a code block is where its first statements are legal. The braces
    put the moved lines back in the context they were written in; they are outside the fences, so what
    the source guards read is still exactly the lines that were in the page.
*@
@{
@* ── MARKUP BEGINS · verbatim from Map.razor ─────────────────────────────────────────────────────────── *@
    <div class="desk-layer desk-layer-dimmed desk-layer-passthrough @(_activeDesk == ShipDesk.Sensors ? "" : "d-none")">
        <div class="desk-content">
            <SpaceSails.Client.Pages.Stations.TrackingPost @ref="_trackingPost" Visible="_activeDesk == ShipDesk.Sensors" FullScreen="true"
                SimTime="SimTime" ShipPosition="_ship.Position" ShipVelocity="_ship.Velocity" ShipCharge="_ship.Charge"
                Ephemeris="_ephemeris" Candidates="TrackingCandidates()" MaxTracks="_telescopeLevel + 1"
                TelescopeSpeedFactor="1 + 0.5 * _telescopeLevel"
                RadarActive="_activeRadar" OnRadarToggle="SetActiveRadar"
                Transponder="_transponderMode" OnTransponderChange="SetTransponder"
                Opportunities="_courseOpportunities" OnSetInterest="SetInterestTarget"
                OnZoomMap="ZoomSensorsBackdrop" OnCenterShip="CenterShipOnMap"
                OnAreaScanCompleted="OnAreaScanCovered"
                OnClose="() => SwitchDeskFromClick(ShipDesk.Nav)" />
        </div>
    </div>
@* ── MARKUP ENDS ─────────────────────────────────────────────────────────────────────────────────────── *@
}

@code {
    /// <summary>the page's `ShipDesk _activeDesk`</summary>
    [Parameter] public ShipDesk _activeDesk { get; set; } = default!;
    /// <summary>the page's `bool _activeRadar`</summary>
    [Parameter] public bool _activeRadar { get; set; }
    /// <summary>the page's `List<SpaceSails.Client.Pages.Stations.TrackingPost.CourseOpportunity> _courseOpportunities`</summary>
    [Parameter] public List<SpaceSails.Client.Pages.Stations.TrackingPost.CourseOpportunity> _courseOpportunities { get; set; } = default!;
    /// <summary>the page's `ICelestialEphemeris? _ephemeris`</summary>
    [Parameter] public ICelestialEphemeris? _ephemeris { get; set; }
    /// <summary>the page's `ShipState _ship`</summary>
    [Parameter] public ShipState _ship { get; set; } = default!;
    /// <summary>the page's `int _telescopeLevel`</summary>
    [Parameter] public int _telescopeLevel { get; set; }
    /// <summary>the page's `SpaceSails.Client.Pages.Stations.TrackingPost? _trackingPost` — and this markup WRITES it, so it crosses as a pair: the
    /// value in, the page's own setter out. The private property below keeps the member's own name, so
    /// the moved block still assigns to `_trackingPost` and the assignment still lands on the page.</summary>
    [Parameter] public SpaceSails.Client.Pages.Stations.TrackingPost? _trackingPostValue { get; set; }
    /// <summary>The page's `_trackingPost = value`, handed down so the write survives the move.</summary>
    [Parameter] public Action<SpaceSails.Client.Pages.Stations.TrackingPost?> _trackingPostSet { get; set; } = default!;
    private SpaceSails.Client.Pages.Stations.TrackingPost? _trackingPost { get => _trackingPostValue; set { _trackingPostValue = value; _trackingPostSet(value); } }
    /// <summary>the page's `TransponderMode _transponderMode`</summary>
    [Parameter] public TransponderMode _transponderMode { get; set; } = default!;
    /// <summary>the page's `void CenterShipOnMap()`</summary>
    [Parameter] public Action CenterShipOnMap { get; set; } = default!;
    /// <summary>the page's `void OnAreaScanCovered(SpaceSails.Client.Pages.Stations.TrackingPost.CompletedAreaScan scan)`</summary>
    [Parameter] public Action<SpaceSails.Client.Pages.Stations.TrackingPost.CompletedAreaScan> OnAreaScanCovered { get; set; } = default!;
    /// <summary>the page's `void SetActiveRadar(bool on)`</summary>
    [Parameter] public Action<bool> SetActiveRadar { get; set; } = default!;
    /// <summary>the page's `void SetInterestTarget(string id)`</summary>
    [Parameter] public Action<string> SetInterestTarget { get; set; } = default!;
    /// <summary>the page's `void SetTransponder(TransponderMode mode)`</summary>
    [Parameter] public Action<TransponderMode> SetTransponder { get; set; } = default!;
    /// <summary>the page's `double SimTime`</summary>
    [Parameter] public double SimTime { get; set; }
    /// <summary>the page's `Task SwitchDeskFromClick(ShipDesk desk)`</summary>
    [Parameter] public Func<ShipDesk, Task> SwitchDeskFromClick { get; set; } = default!;
    /// <summary>the page's `IReadOnlyList<SpaceSails.Client.Pages.Stations.TrackingPost.TrackingCandidate> TrackingCandidates()`</summary>
    [Parameter] public Func<IReadOnlyList<SpaceSails.Client.Pages.Stations.TrackingPost.TrackingCandidate>> TrackingCandidates { get; set; } = default!;
    /// <summary>the page's `void ZoomSensorsBackdrop(double factor)`</summary>
    [Parameter] public Action<double> ZoomSensorsBackdrop { get; set; } = default!;

    // The page's own event dispatch, repeated: no automatic re-render per event.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);
}
