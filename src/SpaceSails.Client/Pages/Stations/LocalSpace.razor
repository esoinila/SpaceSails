@using SpaceSails.Core

@* The trading tree (owner, 2026-07-05 evening: "TradingPost → Buy → ItemName ... then display
   options to that in detail view. Like File Explorer. Master-Detail it is called.")

   The LEFT pane is the tree of places of business — host body, its trading posts, each post's
   Buy/Sell branches down to individual items. The RIGHT pane details exactly the selected
   node. Nothing trades loose anymore: the dock market renders as the dockyard node's detail,
   visually tied to the body you're docked at (Map.razor passes its markup in as a
   RenderFragment so every dock binding stays where it always lived). Map.razor still owns the
   actual transfer engine — this component only renders and raises OnStartTrade/OnStartBuy. *@

<div class="local-space-card @(FullScreen ? "local-space-desk text-light" : "card bg-dark bg-opacity-75 text-light") @(Visible ? "" : "d-none")">
    <div class="card-header py-1 d-flex justify-content-between align-items-center gap-1">
        <span class="fw-bold small">Places of business @(BodyName is null ? "" : $"— near {BodyName}")</span>
        @if (!FullScreen)
        {
            <button type="button" class="btn-close btn-close-white" aria-label="Close" title="Close the places-of-business board and step back to the desk" @onclick="() => OnClose.InvokeAsync()"></button>
        }
    </div>
    <div class="card-body p-2 small @(FullScreen ? "local-space-desk-body" : "")">
        @if (Contacts.Count == 0 && DockedBodyId is null)
        {
            <div class="text-secondary">Nothing here and nothing in shuttle reach (@FormatDistance(CommerceRule.ShuttleRangeMeters)) — close on a station, depot or haven.</div>
        }
        else
        {
            List<TreeNode> tree = BuildTree();
            string selectedId = EffectiveSelection(tree);
            <div class="local-space-master-detail">
                <div class="local-space-tree">
                    @foreach (TreeNode node in tree)
                    {
                        TreeNode row = node;
                        <div class="local-space-node @(row.Id == selectedId ? "local-space-node-selected" : "")"
                             style="padding-left:@((0.3 + row.Depth * 1.05).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))rem"
                             role="button" tabindex="0" title="Open @row.Label in the tree — its details fill the pane on the right" @onclick="() => _selectedId = row.Id">
                            <span class="local-space-icon">@row.Icon</span>
                            <span class="flex-grow-1 @(row.Depth == 0 ? "fw-bold" : "")">@row.Label</span>
                            @if (ActiveTradeTargetId is { } activeId && row.ContactId == activeId && row.Depth == 1)
                            {
                                <span class="text-info">▶</span>
                            }
                            @if (row.Badge is { } badge)
                            {
                                <span class="badge @row.BadgeClass">@badge</span>
                            }
                        </div>
                    }
                </div>
                <div class="local-space-detail">
                    @* Breadcrumbs (file-manager convention, Gemini design consult): where you
                       are, clickable back up — Earth › Earth Depot › Buy › Machinery. *@
                    @{
                        List<(string Id, string Label)> crumbs = Breadcrumbs(selectedId);
                    }
                    @if (crumbs.Count > 1)
                    {
                        <div class="local-space-breadcrumbs text-secondary mb-1">
                            @for (int i = 0; i < crumbs.Count; i++)
                            {
                                (string crumbId, string crumbLabel) = crumbs[i];
                                @if (i > 0)
                                {
                                    <span> › </span>
                                }
                                @if (i < crumbs.Count - 1)
                                {
                                    <a href="" class="link-info" title="Jump back up to @crumbLabel" @onclick="() => _selectedId = crumbId" @onclick:preventDefault="true">@crumbLabel</a>
                                }
                                else
                                {
                                    <span class="text-light">@crumbLabel</span>
                                }
                            }
                        </div>
                    }
                    @if (selectedId == "dock")
                    {
                        <div class="fw-bold mb-1">⚓ @(DockedBodyName ?? "The") dockyard — docked, no ferry fees</div>
                        @DockMarket
                    }
                    else if (selectedId.StartsWith("body:"))
                    {
                        string hostId = selectedId["body:".Length..];
                        <div class="fw-bold mb-1">🪐 @HostName(hostId) — local space</div>
                        <div class="text-secondary">Pick a place of business in the tree: every post shows what it sells and buys under it; the dockyard (when docked) trades fee-free.</div>
                    }
                    else if (FindContact(selectedId) is { } contact)
                    {
                        CommerceRule.TradeMode mode = TradeModeFor(contact);
                        bool canTrade = mode != CommerceRule.TradeMode.None;
                        double distance = ShipDistance(contact);
                        double relSpeed = (ShipVelocity - contact.Velocity).Length;
                        string section = SectionOf(selectedId);

                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="local-space-icon">@Icon(contact.Kind)</span>
                            <span class="fw-bold flex-grow-1">@contact.Name</span>
                            <span class="text-secondary">@FormatDistance(distance) · rel @((relSpeed / 1000).ToString("F1")) km/s</span>
                        </div>

                        @if ((contact.Actions & CommerceRule.ActionKind.Trade) == 0)
                        {
                            <div class="text-secondary">No cooperative trade here — this one you board (see the boarding shuttle).</div>
                        }
                        else if (section == "item")
                        {
                            @if (contact.CargoUnits > 0 && contact.CargoClass is { } stockClass)
                            {
                                int unitValue = CargoMarket.UnitValue(stockClass);
                                int buyUnits = CommerceRule.MaxBuyableUnits(mode, contact.CargoUnits, HoldSpaceUnits, Credits, unitValue);
                                <div class="fw-bold mb-1">📦 @stockClass — @contact.CargoUnits u in stock · @unitValue.ToString("N0") cr/u face value</div>
                                @if (!canTrade)
                                {
                                    <div class="text-secondary local-space-hint">@OutOfReachText</div>
                                }
                                else
                                {
                                    <div class="d-grid gap-1 local-space-actions">
                                        <button type="button" class="btn btn-sm btn-info py-0 px-1 text-start"
                                                disabled="@(buyUnits <= 0 || ActiveTradeTargetId is not null)"
                                                title="Start buying this cargo — ferries the goods across and debits your credits" @onclick="() => OnStartBuy.InvokeAsync(contact.Id)">
                                            @BuyButtonLabel(mode, contact, buyUnits, unitValue, relSpeed, distance)
                                        </button>
                                        @if (buyUnits > 0 && buyUnits < contact.CargoUnits)
                                        {
                                            <div class="text-secondary local-space-hint">
                                                taking @buyUnits of @contact.CargoUnits — limited by @(HoldSpaceUnits < contact.CargoUnits ? "hold space" : "credits")
                                            </div>
                                        }
                                        @if (mode != CommerceRule.TradeMode.SameOrbit)
                                        {
                                            <div class="text-secondary local-space-hint">
                                                ⚓ other option: close in and match orbit to buy dockside — @contact.CargoUnits u would cost
                                                @CommerceRule.BuyCostCr(CommerceRule.TradeMode.SameOrbit, contact.CargoUnits, unitValue).ToString("N0") cr flat, no ferry fee
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-secondary">Sold out — the manifest is empty.</div>
                            }
                        }
                        else if (section == "buy")
                        {
                            <div class="fw-bold mb-1">🛒 For sale at @contact.Name</div>
                            @if (contact.CargoUnits > 0 && contact.CargoClass is { } stockClass)
                            {
                                string itemId = $"item:{contact.Id}";
                                <div class="local-space-node" role="button" tabindex="0" title="Open this item's buy options in the detail pane" @onclick="() => _selectedId = itemId">
                                    <span>📦</span>
                                    <span class="flex-grow-1">@stockClass × @contact.CargoUnits</span>
                                    <span class="text-secondary">@CargoMarket.UnitValue(stockClass).ToString("N0") cr/u</span>
                                </div>
                            }
                            else
                            {
                                <div class="text-secondary">Sold out — the manifest is empty.</div>
                            }
                        }
                        else if (section == "sell")
                        {
                            <div class="fw-bold mb-1">📤 Sell your hold to @contact.Name</div>
                            @if (CargoValue <= 0)
                            {
                                <div class="text-secondary">Hold empty — nothing to sell. Buy from a post or board a prize first.</div>
                            }
                            else if (!canTrade)
                            {
                                <div class="text-secondary local-space-hint">@OutOfReachText</div>
                            }
                            else
                            {
                                <div>hold: @CargoUnits u worth @CargoValue.ToString("N0") cr</div>
                                <div class="d-grid gap-1 local-space-actions">
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1 text-start"
                                            disabled="@(ActiveTradeTargetId is not null)"
                                            title="Start selling your hold here — ferries the cargo over and credits the payout shown" @onclick="() => OnStartTrade.InvokeAsync(contact.Id)">
                                        @SellButtonLabel(mode, relSpeed, distance)
                                    </button>
                                    @if (mode != CommerceRule.TradeMode.SameOrbit)
                                    {
                                        <div class="text-secondary local-space-hint">⚓ other option: dock to sell fee-free (+@CargoValue.ToString("N0") cr)</div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @* The post itself: its whole business at a glance. *@
                            @if (contact.CargoUnits > 0 && contact.CargoClass is { } stockClass)
                            {
                                <div>carries <span class="fw-bold">@contact.CargoUnits u @stockClass</span> · @CargoMarket.UnitValue(stockClass).ToString("N0") cr/u — open <span class="text-info">Buy</span> under this post for options</div>
                            }
                            else
                            {
                                <div class="text-secondary">nothing for sale right now</div>
                            }
                            @if ((contact.Actions & CommerceRule.ActionKind.Fence) != 0)
                            {
                                <div><span class="badge bg-danger">Fence</span> no questions asked about cargo provenance</div>
                            }
                            @if (!canTrade)
                            {
                                <div class="text-secondary local-space-hint">@OutOfReachText</div>
                            }
                            else if (mode == CommerceRule.TradeMode.Shuttle)
                            {
                                <div class="text-secondary local-space-hint">⚓ heavy load? close in and match orbit to trade dockside — no ferry fee</div>
                            }
                        }

                        @if (ActiveTradeTargetId == contact.Id)
                        {
                            <div class="mt-2">
                                <div class="text-info">@(TradeMessage ?? "Transfer in progress…")</div>
                                <div class="progress local-space-progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                                         style="width:@(((int)(TradeProgress * 100)))%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-secondary">Select a place of business in the tree.</div>
                    }
                </div>
            </div>
        }
    </div>
</div>
