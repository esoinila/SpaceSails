@namespace SpaceSails.Client.Pages.Stations
@using SpaceSails.Core
@using TrackedTarget = SpaceSails.Core.TrackedTarget
@using TrackingCandidate = SpaceSails.Client.Pages.Stations.TrackingPost.TrackingCandidate
@*
    #251 · THE COMPACT LEDGER TABLE (the desk as a card, not a desk), ON ITS OWN FILE.

    Moved out of Pages/Stations/TrackingPost.razor by PURE MOTION — the block between the two fences
    below is the block that stood in the desk, character for character, at the indentation it had
    there. Every member it reads is a [Parameter] carrying the desk's own member UNDER THAT MEMBER'S
    OWN NAME (a field keeps its underscore, a method arrives as a delegate, a callback as itself), so
    the markup moved without a rewrite and TrackingPostMarkup splices the desk back byte for byte.

    The .razor.css beside this file carries no rules; it is there to give the component
    TrackingPost.razor.css's OWN scope (b-9ekzcovohe, pinned in SpaceSails.Client.csproj). That sheet
    has forty rules and not one `::deep` among them, so every one of them is scope-dependent: without
    the carrier, every rule that styles this surface would stop matching the moment the markup moved
    out of the desk — no build error, no test, the block just renders unstyled.

    What the tracking post shows when it is NOT the full-screen sensors desk — the same ledger, three
    columns wide, with Confirm and Drop and nothing else. The `else` of TrackingPost.razor's own
    `@if (FullScreen)` stays in the desk; this is the whole of the branch's body.
*@
@* ── MARKUP BEGINS · verbatim from TrackingPost.razor ─────────────────────────────────────────────── *@
            <div class="fw-bold mb-1">Tracked targets (@_ledger.Entries.Count / @_ledger.MaxTracks)</div>
            @if (_ledger.Entries.Count == 0)
            {
                <div class="text-secondary">Nothing on the ledger yet — sweep a region to find contacts.</div>
            }
            else
            {
                <table class="table table-sm table-dark mb-0">
                    <tbody>
                        @foreach (TrackedTarget entry in OrderedTracks())
                        {
                            double quality = entry.EffectiveQuality(SimTime);
                            double daysAgo = (SimTime - entry.LastConfirmedTime) / 86400.0;
                            TrackingCandidate? candidate = FindCandidate(entry.ShipId);
                            <tr>
                                <td>
                                    @(candidate?.Callsign ?? entry.ShipId)@(_aware.Contains(entry.ShipId) ? " aware ⚠" : "")
                                    <div class="tracking-quality-bar"><div class="tracking-quality-fill" style="width:@((int)(quality * 100))%"></div></div>
                                </td>
                                <td class="text-end align-middle">@daysAgo.ToString("F1")d</td>
                                <td class="text-end align-middle text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1" disabled="@(candidate is null)"
                                            title="Take a fresh fix on this contact now — a zero-age observation tightens the prediction cone"
                                            @onclick="() => ConfirmNow(entry.ShipId)">Confirm</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="Drop this track from the ledger and free the telescope slot" @onclick="() => Drop(entry.ShipId)">Drop</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
@* ── MARKUP ENDS ──────────────────────────────────────────────────────────────────────────────────── *@

@code {
    // #251 · Every [Parameter] below is a member of TrackingPost under the member's own name.
    // A parameter that needs saying more than that says it on its own line.

    [Parameter] public TrackedTargetLedger _ledger { get; set; } = default!;
    /// <summary>the desk's `HashSet&lt;string&gt; _aware` — the SAME set, not a copy.</summary>
    [Parameter] public HashSet<string> _aware { get; set; } = default!;
    [Parameter] public double SimTime { get; set; }
    [Parameter] public Func<List<TrackedTarget>> OrderedTracks { get; set; } = default!;
    [Parameter] public Func<string, TrackingCandidate?> FindCandidate { get; set; } = default!;
    [Parameter] public Action<string> ConfirmNow { get; set; } = default!;
    [Parameter] public Action<string> Drop { get; set; } = default!;
}
