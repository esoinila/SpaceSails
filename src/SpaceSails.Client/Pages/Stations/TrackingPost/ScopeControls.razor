@namespace SpaceSails.Client.Pages.Stations
@using SpaceSails.Core
@*
    #251 · THE SCOPE'S AIM AND MODE CONTROLS, ON ITS OWN FILE.

    Moved out of Pages/Stations/TrackingPost.razor by PURE MOTION — the block between the two fences
    below is the block that stood in the desk, character for character, at the indentation it had
    there. Every member it reads is a [Parameter] carrying the desk's own member UNDER THAT MEMBER'S
    OWN NAME (a field keeps its underscore, a method arrives as a delegate, a callback as itself), so
    the markup moved without a rewrite and TrackingPostMarkup splices the desk back byte for byte.

    The .razor.css beside this file carries no rules; it is there to give the component
    TrackingPost.razor.css's OWN scope (b-9ekzcovohe, pinned in SpaceSails.Client.csproj). That sheet
    has forty rules and not one `::deep` among them, so every one of them is scope-dependent: without
    the carrier, every rule that styles this surface would stop matching the moment the markup moved
    out of the desk — no build error, no test, the block just renders unstyled.

    Everything the sensors chief actually presses: the two aim sliders, start/stop sweep, the passive
    watch, the active radar, and #765's three-way transponder. `_centerBearingDeg` and `_arcWidthDeg` are
    READ here and written nowhere — the sliders report through OnBearingInput/OnArcInput, which are the
    desk's own handlers, so nothing in this block is a write a component boundary could swallow.
*@
@* ── MARKUP BEGINS · verbatim from TrackingPost.razor ─────────────────────────────────────────────── *@
            <div class="flex-grow-1">
                <label class="form-label mb-0 d-block">Bearing @((int)_centerBearingDeg)°</label>
                <input type="range" class="form-range" min="0" max="359" step="1" value="@_centerBearingDeg"
                       title="Swing the scope's aim around the sky — sets the center bearing of the manual sweep wedge"
                       @oninput="OnBearingInput" @onkeydown:stopPropagation="true" />
                <label class="form-label mb-0 d-block">Arc width @((int)_arcWidthDeg)°</label>
                <input type="range" class="form-range" min="5" max="360" step="1" value="@_arcWidthDeg"
                       title="Open or narrow the sweep — a wide arc searches more sky at once, a tight one drills a single bearing"
                       @oninput="OnArcInput" @onkeydown:stopPropagation="true" />
                @* PR-C: the corridor-watch dropdown is gone — trade lanes are clickable regions
                   on the map itself now. The sliders remain for a truly manual aim. *@
                @if (_activeJob is null)
                {
                    <button type="button" class="btn btn-sm btn-info w-100" title="Point the telescope at the aimed wedge and sweep it for ships that don't advertise themselves" @onclick="StartSweep">Start sweep</button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-warning w-100" title="Abort the running sweep and hand the telescope back to the queue" @onclick="StopSweep">Stop sweep</button>
                }
                @* M27: the eyes are open by default — a passive watch keeps a full-circle sweep
                   running whenever nothing manual is queued. *@
                <button type="button" class="btn btn-sm w-100 mt-1 @(_passiveWatch ? "btn-success" : "btn-outline-secondary")"
                        title="Keep the eyes open — a full-circle survey runs itself whenever no manual sweep or task holds the scope"
                        @onclick="TogglePassiveWatch">
                    👁 Passive watch: @(_passiveWatch ? "ON — always scanning" : "off")
                </button>
                <button type="button" class="btn btn-sm w-100 mt-1 @(RadarActive ? "btn-danger" : "btn-outline-danger")"
                        title="Light the active radar for exact close-range fixes — but every ship in earshot now knows exactly where you are"
                        @onclick="() => OnRadarToggle.InvokeAsync(!RadarActive)">
                    📡 @(RadarActive ? "ACTIVE RADAR ON — LOUD" : "Active radar (close range — loud)")
                </button>
                @* M29: the transponder — like ships on the ocean. Lit = honest traffic; dark =
                   the click before the run; false colors = the ghost flies the declared course. *@
                <div class="btn-group btn-group-sm w-100 mt-1" role="group" aria-label="Transponder">
                    <button type="button" class="btn @(Transponder == TransponderMode.On ? "btn-success" : "btn-outline-secondary")"
                            title="Broadcast our true position — honest traffic runs lit"
                            @onclick="() => OnTransponderChange.InvokeAsync(TransponderMode.On)">📻 LIT</button>
                    <button type="button" class="btn @(Transponder == TransponderMode.Dark ? "btn-dark border-light" : "btn-outline-secondary")"
                            title="Broadcast nothing — they get only what their optics earn"
                            @onclick="() => OnTransponderChange.InvokeAsync(TransponderMode.Dark)">🕶 DARK</button>
                    <button type="button" class="btn @(Transponder == TransponderMode.Fake ? "btn-warning text-dark" : "btn-outline-secondary")"
                            title="Broadcast the ghost of the course we abandoned — blown per observer whose own optics see the real us"
                            @onclick="() => OnTransponderChange.InvokeAsync(TransponderMode.Fake)">🎭 FAKE</button>
                </div>
                <div class="text-secondary tracking-transponder-hint">@TransponderHint()</div>
            </div>
@* ── MARKUP ENDS ──────────────────────────────────────────────────────────────────────────────────── *@

@code {
    // #251 · Every [Parameter] below is a member of TrackingPost under the member's own name.
    // A parameter that needs saying more than that says it on its own line.

    [Parameter] public double _centerBearingDeg { get; set; }
    [Parameter] public double _arcWidthDeg { get; set; }
    /// <summary>the desk's `ScanJob? _activeJob` — which of the two sweep buttons is shown.</summary>
    [Parameter] public ScanJob? _activeJob { get; set; }
    [Parameter] public bool _passiveWatch { get; set; }
    [Parameter] public bool RadarActive { get; set; }
    [Parameter] public TransponderMode Transponder { get; set; }
    [Parameter] public Action<ChangeEventArgs> OnBearingInput { get; set; } = default!;
    [Parameter] public Action<ChangeEventArgs> OnArcInput { get; set; } = default!;
    [Parameter] public Action StartSweep { get; set; } = default!;
    [Parameter] public Action StopSweep { get; set; } = default!;
    [Parameter] public Action TogglePassiveWatch { get; set; } = default!;
    [Parameter] public Func<string> TransponderHint { get; set; } = default!;
    [Parameter] public EventCallback<bool> OnRadarToggle { get; set; }
    [Parameter] public EventCallback<TransponderMode> OnTransponderChange { get; set; }
}
