@using System.Globalization
@using SpaceSails.Core

@* The dark space web (vision ¶14/¶16), MARKET ONLY since the comms-tree rebuild: buy route
   intel about secretive ships at a haven or a far trading post, and fence your own
   tracking-post finds. The tight-beam and laser-ranging consoles moved into the selected
   contact's detail pane on the Comms desk — they were always per-contact actions, not a
   market. The intel ledger itself is Map.razor's now (passed in as a parameter): this
   component used to OWN it, which quietly destroyed every bought tip the moment the player
   switched desks — a conditionally-rendered component forgets everything (the same disease
   the tracking post was cured of in M27). *@

<div class="dark-web-card @(FullScreen ? "dark-web-desk text-light" : "card bg-dark bg-opacity-75 text-light") @(Visible ? "" : "d-none")">
    <div class="card-header py-1 d-flex justify-content-between align-items-center gap-1">
        <span class="fw-bold small">Dark web market 🕸</span>
        @if (!FullScreen)
        {
            <button type="button" class="btn-close btn-close-white" aria-label="Close" title="Close the dark web market and step back to the desk" @onclick="() => OnClose.InvokeAsync()"></button>
        }
    </div>
    <div class="card-body p-2 small dark-web-scroll @(FullScreen ? "dark-web-desk-body" : "")">
        @if (!CanTrade)
        {
            <div class="text-secondary mb-1 fw-bold">Intel market offline.</div>
            <div class="text-secondary mb-2">@(DisabledReason ?? "Not orbiting or docked at a haven or a far trading post.")</div>
            <div class="text-secondary">Here you can <span class="text-light">buy route intel</span> on ships that don't publish a timetable, and <span class="text-light">fence your own telescope tracks</span> (quality ≥ 50%) for credits.</div>
        }
        else
        {
            <div class="text-secondary mb-1">Off-the-books ships the market knows about:</div>
            @if (MarketShips.Count == 0)
            {
                <div class="text-secondary mb-2">No leads for sale here right now.</div>
            }
            else
            {
                <table class="table table-sm table-dark mb-2">
                    <tbody>
                        @foreach (MarketShip ship in MarketShips)
                        {
                            int price = BuyPriceFor(ship);
                            bool known = Ledger.Knows(ship.Id, SimTime);
                            <tr>
                                <td>
                                    @ship.Callsign
                                    <div class="text-secondary">@ship.RouteLabel — @ship.CargoClass (@ship.CargoUnits u)</div>
                                </td>
                                <td class="text-end align-middle text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1"
                                            disabled="@(known || Credits < price)" title="Buy this ship's route intel — pin its off-the-books course to your ledger for the price shown" @onclick="() => BuyIntel(ship, price)">
                                        @(known ? "Known" : $"{price:N0} cr")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @* PR-WIRE — the favor bank over the wire (FridaySecondPlan §0, ruling 6). Dark-web-native
               contacts you have history with will move coin for you from anywhere: deposit safe from
               confiscation, draw it back, or borrow gas money on a favor. In-person-only contacts (the
               asteroid hermit, the Magpie) never appear here — you bank those across their table. *@
            <div class="text-secondary mb-1">🏦 Favor bank — wire-capable contacts:</div>
            @if (WireContacts.Count == 0)
            {
                <div class="text-secondary mb-2">No wire-capable contacts yet. Do a job for a dark-web fixer (Madam Coil, The Fixer, Gilt-Eye) and they'll bank for you from anywhere.</div>
            }
            else
            {
                <table class="table table-sm table-dark mb-2">
                    <tbody>
                        @foreach (WireContact wc in WireContacts)
                        {
                            WireContact w = wc;
                            <tr>
                                <td>
                                    @w.DisplayName
                                    <div class="text-secondary">
                                        @(w.Balance > 0 ? $"holds {w.Balance:N0} cr of yours"
                                          : w.Balance < 0 ? $"you owe {(-w.Balance):N0} cr"
                                          : "no coin between you yet")
                                    </div>
                                </td>
                                <td class="text-end align-middle text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-warning py-0 px-1"
                                            title="Open this contact's account over the wire — deposit, withdraw or borrow"
                                            @onclick="() => OnOpenWireBank.InvokeAsync(w.ContactId)">💰 Bank</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @* #233 · The buyer seam, used for the one thing on this desk that is not a timetable. The row
               only exists while the chip is in the captain's pocket and this desk is open, so there is no
               verb here to refuse — a verb is drawn where it applies rather than shown and denied. *@
            @if (ChipPrice is { } chipPrice)
            {
                <div class="text-secondary mb-1">Off the books entirely:</div>
                <table class="table table-sm table-dark mb-2">
                    <tbody>
                        <tr>
                            <td>
                                @CompromisingChip.Name
                                <div class="text-secondary">@CompromisingChip.LookCardLine</div>
                            </td>
                            <td class="text-end align-middle text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-success py-0 px-1" title="Sell it here instead of handing it back — the buyer pays more than the contract, and the outfit that runs this ground will hear about it" @onclick="() => OnSellChip.InvokeAsync()">
                                    Sell @chipPrice.ToString("N0", CultureInfo.InvariantCulture) cr
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            }

            @* #1149 · The one thing on this desk the fence SELLS rather than buys. Like the chip's row it
               exists only while it applies — the captain is not already carrying one, and the desk is open
               — so there is no verb here to refuse. What the row says about the object is the object's own
               plate and its own look-card line, read off Core: the desk never describes a thing it does not
               own, and the price is Map's (Inspectorate.FencePrice), never composed here. *@
            @if (InspectorCardPrice is { } cardPrice)
            {
                <div class="text-secondary mb-1">Papers, if you have the coin:</div>
                <table class="table table-sm table-dark mb-2">
                    <tbody>
                        <tr>
                            <td>
                                @Inspectorate.Plate
                                <div class="text-secondary">@Inspectorate.LookCardLine</div>
                            </td>
                            <td class="text-end align-middle text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-info py-0 px-1"
                                        disabled="@(Credits < cardPrice)"
                                        title="Buy a set of inspectorate credentials — an office that sits above the sites, and a bet on somebody's inspection roster"
                                        @onclick="() => OnBuyInspectorCard.InvokeAsync()">
                                    Buy @cardPrice.ToString("N0", CultureInfo.InvariantCulture) cr
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            }

            <div class="text-secondary mb-1">Your sellable tracks (quality ≥ 50%):</div>
            @if (!SellableTracks.Any())
            {
                <div class="text-secondary mb-2">Nothing solid enough to fence yet — sharpen a track at the Sensors desk.</div>
            }
            else
            {
                <table class="table table-sm table-dark mb-2">
                    <tbody>
                        @foreach (TrackedShipInfo t in SellableTracks)
                        {
                            int price = SellPriceFor(t);
                            <tr>
                                <td>
                                    @t.Callsign
                                    <div class="text-secondary">@t.CargoClass (@t.CargoUnits u) — quality @((int)(t.Quality * 100))%</div>
                                </td>
                                <td class="text-end align-middle text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-success py-0 px-1" title="Fence this telescope track — cash out your own sighting for the credits shown" @onclick="() => SellTrack(t, price)">
                                        Sell @price.ToString("N0", CultureInfo.InvariantCulture) cr
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>
