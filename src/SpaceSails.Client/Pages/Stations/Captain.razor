@using SpaceSails.Core
@using SpaceSails.Client.Pages

@* The captain's position (PR-15, docs/SaturdayPlan/StationDesks.md addendum, owner: "the mission
   of the ship could be the captain's position... he selects the goal of the ship"). A stately,
   uncluttered room — one big statement of the current mission, then the catalog of selectable
   missions grouped by kind. One click selects; no confirm dialog — the captain's word is final the
   moment it's given. *@

@{
    RenderFragment<ShipMission> Card = m =>
        @<div class="captain-card @(IsSelected(m) ? "captain-card-selected" : "")" role="button" tabindex="0"
              title="Give this order — the ship makes for it at once, and the captain's word is final the moment it's given"
              @onclick="() => Pick(m)" @onkeydown="e => OnCardKeyDown(e, m)">
            @m.Describe()
        </div>;
}

<div class="captain-desk text-light">
    @* #963 follow-up · THE BLACK BOX, WHERE A CAPTAIN WILL FIND IT. Owner's playtest ended twice at
       Blazor's textless "An unhandled error has occurred. Reload." — the console had the real text and
       the console died with the tab. The note survives in localStorage now, so the desk is still holding
       it after the reload: the sentence, and a button that puts it on the clipboard for the issue. *@
    @if (LastError is { } crash)
    {
        <div class="captain-crash" role="alert">
            <div class="captain-crash-head">⚠ The last voyage ended in an error.</div>
            <pre class="captain-crash-text">@crash.DescribeFully()</pre>
            <div class="captain-crash-actions">
                <button type="button" class="btn btn-sm btn-warning"
                        title="Put the whole note on the clipboard — paste it straight into an issue"
                        @onclick="() => OnCopyError.InvokeAsync()">📋 @(ErrorCopied ? "copied" : "copy")</button>
                <button type="button" class="btn btn-sm btn-outline-light"
                        title="Filed and dealt with — clear the note from the log"
                        @onclick="() => OnDismissError.InvokeAsync()">✕ clear</button>
            </div>
        </div>
    }

    @* M26: two displays (owner) — the orders catalog, and a status board: every station's chip
       writ large, the whole ship at a glance from the captain's chair. *@
    <div class="captain-view-toggle">
        <div class="btn-group btn-group-sm" role="group" aria-label="Captain view">
            <button type="button" class="btn @(_view == CaptainView.Orders ? "btn-info" : "btn-outline-light")"
                    title="Show the orders catalog — pick the ship's mission"
                    @onclick="() => SetView(CaptainView.Orders)">⚓ Orders</button>
            <button type="button" class="btn @(_view == CaptainView.Status ? "btn-info" : "btn-outline-light")"
                    title="Show the whole ship at a glance — every station's board writ large"
                    @onclick="() => SetView(CaptainView.Status)">🧭 Ship status</button>
            <button type="button" class="btn @(_view == CaptainView.Tutorials ? "btn-info" : "btn-outline-light")"
                    title="Put the crew to school — pick a lesson that plays out at the helm"
                    @onclick="() => SetView(CaptainView.Tutorials)">🎓 Tutorials</button>
            <button type="button" class="btn @(_view == CaptainView.Ledger ? "btn-info" : "btn-outline-light")"
                    title="Open the captain's ledger — every job in hand and every whisper worth keeping"
                    @onclick="() => SetView(CaptainView.Ledger)">📜 Ledger</button>
            @* THE CREW'S OWN SHEET. Owner: "let's have a Winningtemp-like crew satisfaction report on the
               captain's desk … it is the captain's performance as seen by the crew." It belongs HERE, at his
               chair, because it is the one board on the ship that is about him. *@
            <button type="button" class="btn @(_view == CaptainView.Crew ? "btn-info" : "btn-outline-light")"
                    title="Read the crew temperature — what they said when you were not in the room"
                    @onclick="() => SetView(CaptainView.Crew)">🌡 Crew</button>
        </div>
    </div>

    @* #948 · WHO YOU ARE, AT YOUR OWN DESK. Owner: "Let's have an option to change the name of our avatar.
       It solves the issue of forgetting who you are amongst the autogenerated names. Making it personal
       makes it easy to remember, and having it updatable." The chip in the corner has always shown the face;
       the name lived only in a hover title and on the front door. It is stated here, at the captain's own
       chair, with the pencil beside it — and the same pencil stands on the roster card at the front door,
       which is where the six seeded names sit one under the other and the confusion actually happens.
       Both write the one registry field through Map's RenameCaptain. *@
    @if (CaptainName is { Length: > 0 })
    {
        <div class="captain-ident-row">
            <span class="captain-ident-label">🪪 The license reads</span>
            @if (RenamingCaptain)
            {
                <input class="captain-rename-input" maxlength="@SpaceSails.Core.Captains.MaxNameLength"
                       placeholder="A name of your whim" autofocus
                       value="@RenameDraft" @oninput="e => OnRenameDraft.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
                       @onkeydown="OnRenameKeyDown" @onblur="() => OnCommitRename.InvokeAsync()" />
                <button type="button" class="btn btn-sm btn-outline-success"
                        title="Keep this name — it goes on the license and into every save from here on"
                        @onclick="() => OnCommitRename.InvokeAsync()">✔ Keep it</button>
                <button type="button" class="btn btn-sm btn-outline-light"
                        title="Leave the name as it was"
                        @onclick="() => OnCancelRename.InvokeAsync()">✕</button>
            }
            else
            {
                <span class="captain-ident-name">@CaptainName</span>
                <button type="button" class="btn btn-sm btn-outline-info captain-ident-pencil"
                        title="Rename this captain — a name of your own is far easier to find again in the logbook than a generated one. Blank puts the generated name back."
                        @onclick="() => OnBeginRename.InvokeAsync()">✏ Rename</button>
            }
        </div>
    }

    @* Set course from the chart-room: reopens the start-point picker so the captain can begin (or
       resume) a run at another locale — the same chooser the game offers at boot. *@
    @if (OnReopenStartPicker.HasDelegate)
    {
        <div class="captain-start-jump">
            <button type="button" class="btn btn-sm btn-outline-info"
                    title="Choose a berth to begin at — every start is docked at a station, inner to outer"
                    @onclick="() => OnReopenStartPicker.InvokeAsync()">🧭 Set course to a start point…</button>
        </div>
    }

    @* The ship's logbook (#310): the save/load surface — ten slots (place + when), manual banking,
       export/import — reachable in-game from the desk, the SAME door the game opens at boot. The
       autosave keeps following the ship on its own; this is where you bank a moment or load an old one. *@
    @if (OnOpenSaves.HasDelegate)
    {
        <div class="captain-start-jump captain-vault-actions">
            <button type="button" class="btn btn-sm btn-outline-success"
                    title="Open the ship's logbook — load a saved voyage, bank this moment to a slot, or export/import a file"
                    @onclick="() => OnOpenSaves.InvokeAsync()">💾 Ship's logbook (saves)…</button>
        </div>
    }

    @* The mission statement and weapons authority belong to the working desk (Orders / Status);
       the reference tabs (Tutorials, Quests) stand on their own. *@
    @if (_view is CaptainView.Orders or CaptainView.Status)
    {
        <div class="captain-articles">
            <div class="captain-articles-label">@(_view == CaptainView.Status ? "The ship at a glance" : "The ship's articles")</div>
            <div class="captain-articles-mission">@CurrentMission.Describe()</div>
        </div>
    }

    @* Weapons authority (owner, The Expanse consult): the gun deck cannot pull the trigger
       without the captain's word — one shot per authorization, or the standing order. *@
    @if (_view is CaptainView.Orders or CaptainView.Status)
    {
        <div class="captain-articles captain-weapons-authority">
            <div class="captain-articles-label">Weapons authority</div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button type="button" class="btn btn-sm @(ShotAuthorized ? "btn-success" : "btn-outline-success")"
                        title="Authorizes exactly one shot from the war room; withdrawn automatically when it fires"
                        @onclick="() => OnAuthorizeShot.InvokeAsync()">
                    @(ShotAuthorized ? "✅ NEXT SHOT AUTHORIZED — click to withdraw" : "✍ AUTHORIZE NEXT SHOT")
                </button>
                <label class="text-light captain-fire-at-will">
                    <input type="checkbox" checked="@FireAtWill" title="Standing order — let the gun deck fire on hostiles without waiting on your word each time" @onchange="() => OnToggleFireAtWill.InvokeAsync()" />
                    ⚓ fire at will (standing order)
                </label>
                @* #538 · the sentry remote is NOT here. Owner: "the remote to sentries should be in the mobile
                   hud not at captains desk" — the order is given on foot, with somebody else's boots on the
                   deck plating, so it lives on the deck HUD under H. This desk only says whether it stands. *@
                @if (WeaponsTight)
                {
                    <span class="text-warning small">🤖 weapons tight stands — the bots are holding (H, on the deck)</span>
                }
            </div>
            <div class="text-secondary small">Warning shots need no word — they ARE the captain talking.</div>
            @* #205: the owner authorized the next shot and reasonably assumed the boarding was declared
               too. It isn't — guns and shuttles are separate consents. Say so, right where the shot is cleared. *@
            <div class="text-secondary small">Guns cleared ≠ boarding authorized — a boarding is a separate word (the 🏴 window prompt, or the ship-wide alert on any desk).</div>
        </div>

        @* DAMAGE-CONTROL AUTHORITY. Owner, reading this desk: "I see authorize shot but no authorize repair
           station etc here?", then "Let's add separate option to captains desk to authorize the back of the
           ship repair station … (even while the bridge still works) … like we have the fire at will checkbox."

           So: the same checkbox, for the other set of handles. A captain who has to be asked about every hatch
           during a fire gets asked at the worst possible moment — and the fire is exactly what the board is
           for ("if a room is on fire then pumping air out of it or venting it to space is a good way to stop
           the fire"). The single-compartment word stays available at the board itself; this delegates. *@
        <div class="captain-articles captain-weapons-authority">
            <div class="captain-articles-label">Damage-control authority</div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                @* THE LIMITED PRE-OK, mirroring AUTHORIZE NEXT SHOT exactly. Owner: "we have the authorize
                   next shot, that kind of authorize damage control next vent action is missing, it would be
                   usefull as limited pre-ok from captain." No room is named because the captain does not know
                   yet which compartment it will be — which is precisely the shape of a fire. *@
                <button type="button"
                        class="btn btn-sm @(DamageControlNextActCleared ? "btn-success" : "btn-outline-success")"
                        disabled="@DamageControlAuthorized"
                        title="@(DamageControlAuthorized
                                 ? "Not needed — damage control already holds your standing authority."
                                 : "Clears exactly one damage-control act — dog, pump or open — whichever compartment it turns out to be. Spent when they use it.")"
                        @onclick="() => OnAuthorizeNextDamageControlAct.InvokeAsync()">
                    @(DamageControlNextActCleared
                        ? "✅ NEXT VENT AUTHORIZED — click to withdraw"
                        : "✍ AUTHORIZE NEXT VENT")
                </button>
                <label class="text-light captain-fire-at-will">
                    <input type="checkbox" checked="@DamageControlAuthorized"
                           title="Standing order — the station aft may dog, pump and open her compartments without waiting on your word each time"
                           @onchange="() => OnToggleDamageControlAuthority.InvokeAsync()" />
                    ⚓ damage control may act (standing order)
                </label>
                @if (ArmedCompartment is { Length: > 0 } armed)
                {
                    <span class="text-warning small">🔑 @armed armed at the board</span>
                }
            </div>
            <div class="text-secondary small">
                Dogging a hatch never needs a word — quarantine and fire containment are seamanship. Opening a
                compartment to space, or pumping it down to vacuum, is the part that carries your name.
            </div>
            @if (!BridgeRepeaterAlive)
            {
                <div class="text-warning small">
                    ⚙ Her bridge repeater is dead — the valves aft are mechanical and still answer. Any standing
                    order you gave stands there.
                </div>
            }
        </div>
    }

    @if (_view == CaptainView.Status)
    {
        <div class="captain-status-grid">
            @foreach (DeskChips.ChipData chip in StatusChips)
            {
                <div class="captain-status-card" role="button" tabindex="0"
                     title="Take the chair at this station"
                     @onclick="() => OnGoToDesk.InvokeAsync(chip.Desk)"
                     @onkeydown="e => OnStatusKeyDown(e, chip.Desk)">
                    <div class="captain-group-header"><span class="captain-group-icon">@chip.Icon</span> @chip.Label</div>
                    <div class="captain-status-line">@chip.Line1</div>
                    @if (chip.Line2 is not null)
                    {
                        <div class="captain-status-line captain-status-dim">@chip.Line2</div>
                    }
                    @if (chip.Line3 is not null)
                    {
                        <div class="captain-status-line captain-status-dim">@chip.Line3</div>
                    }
                </div>
            }
        </div>
        @* Version stamp (#254): the captain sees which build she's flying, right on the status board. *@
        <div class="captain-build-stamp text-secondary small mt-3 font-monospace"
             title="Compile-time git SHA + build time (UTC)">@BuildStamp.Display</div>
    }
    else if (_view == CaptainView.Tutorials)
    {
        <div class="captain-groups">
            <div class="captain-group">
                <div class="captain-group-header"><span class="captain-group-icon">🎓</span> Learn the ropes</div>
                <div class="captain-group-flavor">The captain puts the crew to school. Pick a lesson — it plays out at the helm, with a checklist to follow. Start any one; you can replay them in any order.</div>
                <div class="captain-group-cards">
                    @if (Tutorials.Count == 0)
                    {
                        <div class="captain-empty">No lessons on the slate.</div>
                    }
                    else
                    {
                        @for (int i = 0; i < Tutorials.Count; i++)
                        {
                            int idx = i;
                            bool active = ActiveTutorial == idx;
                            bool done = ActiveTutorial < 0 || idx < ActiveTutorial;
                            <div class="captain-card @(active ? "captain-card-selected" : "")" role="button" tabindex="0"
                                 title="Begin this lesson — it plays out at the helm with a checklist to follow"
                                 @onclick="() => OnStartTutorial.InvokeAsync(idx)" @onkeydown="e => OnTutorialKeyDown(e, idx)">
                                <div class="fw-bold">@(active ? "▶ " : done ? "✓ " : "")@Tutorials[idx].Title</div>
                                <div class="captain-card-blurb text-secondary small">@Tutorials[idx].Blurb</div>
                            </div>
                        }
                    }
                    @* #949 — the reading, beside the doing. A lesson plays out at the helm with a checklist;
                       this is the two-minute page a captain reads BEFORE he has a ship to lose, and the same
                       page the Nav toolbar's ? opens. New tab, because leaving the desk mid-voyage to read
                       is exactly the thing nobody does. *@
                    <a class="btn btn-sm btn-outline-info mt-2 text-start" href="/help/nav" target="_blank"
                       title="Plotting a trip, in eight pictures — pick a target, Plot, scrub, add a burn, iterate with the ± buttons, end it with an arrival, arm, warp">
                        📐 How to plot a trip — the eight steps
                    </a>
                    <a class="btn btn-sm btn-outline-light mt-2 text-start" href="/guide" target="_blank"
                       title="The whole Captain's Guide — every desk, every system">
                        📖 The Captain's Guide — everything else
                    </a>
                </div>
            </div>
        </div>
    }
    else if (_view == CaptainView.Crew)
    {
        @* CREW TEMPERATURE. Owner: "let's have a Winningtemp-like crew satisfaction report on the captain's
           desk … the crew satisfaction reports could guide the player into seeking the right balance for his
           crew's greed/honesty ratio, that keeps him in the captain's seat."

           Read as a survey is actually read: the standing first (what they are about to DO about it), then
           the one line to fix this week, then every dimension with the crew's own words under it. No grade,
           no advice — the sheet reports and the captain decides. *@
        <div class="captain-groups">
            <div class="captain-group">
                <div class="captain-group-header"><span class="captain-group-icon">🌡</span> @CrewTemp.SheetTitle</div>
                <div class="captain-group-flavor">@CrewTemp.SheetFooter</div>

                <div class="crew-standing crew-standing-@CrewTemp.StandingOf(Voyage).ToString().ToLowerInvariant()">
                    <div class="crew-standing-word">@CrewTemp.StandingOf(Voyage).ToString().ToUpperInvariant()</div>
                    <div class="crew-standing-line">@CrewTemp.StandingLine(CrewTemp.StandingOf(Voyage))</div>
                </div>

                @* The pointer, not the grade — the lowest line is the one he can act on this week. *@
                <div class="crew-worst">
                    ⚑ Lowest this cycle: <strong>@CrewTemp.Heading(CrewTemp.WorstOf(Voyage).Dimension)</strong>
                    — @CrewTemp.BandWord(CrewTemp.BandOf(CrewTemp.WorstOf(Voyage).Score))
                </div>

                @foreach (CrewTemp.Reading r in CrewTemp.Readings(Voyage))
                {
                    <div class="crew-line">
                        <div class="crew-line-head">
                            <span class="crew-dim">@CrewTemp.Heading(r.Dimension)</span>
                            <span class="crew-band crew-band-@CrewTemp.BandOf(r.Score).ToString().ToLowerInvariant()">
                                @CrewTemp.BandWord(CrewTemp.BandOf(r.Score))
                            </span>
                        </div>
                        @* A bar rather than a number: the crew do not have an opinion to the nearest percent,
                           the same reason the nerve gauge is pips. *@
                        <div class="crew-bar"><div class="crew-bar-fill" style="width:@(r.Score)%"></div></div>
                        <div class="crew-quote">“@r.Comment”</div>
                    </div>
                }

                <div class="crew-cohesion">
                    Cohesion: <strong>+@CrewTemp.Cohesion(Voyage)</strong> —
                    what this crew has been through <em>with</em> you. It does not make them happier; it makes
                    them slower to act on being unhappy.
                </div>
            </div>
        </div>
    }
    else if (_view == CaptainView.Ledger)
    {
        @* The Captain's ledger (PR-J, UIUsabilityNotes "The Captain's ledger"): jobs and every whisper
           worth keeping in one brief. The ledger never does the task — each line jumps you to the desk
           that acts on it (the intel card's 🔭 pattern, generalized). *@
        <div class="captain-groups">
            <div class="captain-group">
                <div class="captain-group-header"><span class="captain-group-icon">📜</span> THE CAPTAIN'S LEDGER</div>
                <div class="captain-group-flavor">Every job in hand and every whisper worth keeping — in one place. The ledger never does the work; each line points you to the desk that does.</div>

                <div class="captain-ledger-section-label text-info fw-bold small mt-2">⚓ Jobs</div>
                <div class="captain-group-cards">
                    @if (Quests.Count == 0)
                    {
                        <div class="captain-empty">No contracts in hand. Dock at a haven and go ashore — someone at the bar always has work.</div>
                    }
                    else
                    {
                        @foreach (QuestItem q in Quests)
                        {
                            <div class="captain-card captain-quest-@q.StatusKind">
                                <div class="fw-bold">@q.Title</div>
                                @* #959 · THE PLAIN BLOCK, ABOVE THE VOICE. Owner, on a row that read
                                   "Bring down Mars Depot / Hunt Mars Depot — hole her sail or board her":
                                   "What is this job... should I destroy a ship or rob a place?" So the
                                   verb (a fixed five-word vocabulary), what completion takes AND what the
                                   target IS, and the honest distance + lane time stand first. @q.Detail
                                   keeps every word of its voice one line below. Byte for byte the same
                                   block the offer card showed before the job was accepted. *@
                                @if (q.Plain is { Count: > 0 } plain)
                                {
                                    <div class="job-plain">
                                        <div class="job-plain-verb">@plain[0]</div>
                                        <div class="job-plain-takes">@plain[1]</div>
                                        <div class="job-plain-effort">@plain[2]</div>
                                    </div>
                                }
                                <div class="captain-card-blurb text-secondary small">@q.Detail</div>
                                @if (q.NextAction is { } next)
                                {
                                    @* #175: the live next action, read off ship state — so the card
                                       tells the captain what to do RIGHT NOW, not just what the job is. *@
                                    <div class="captain-quest-next small mt-1">▶ @next</div>
                                }
                                @if (q.Steps.Count > 0)
                                {
                                    <div class="captain-quest-steps small mt-1">
                                        @foreach (QuestStep step in q.Steps)
                                        {
                                            <div class="text-secondary">@step.Icon @step.Text</div>
                                        }
                                    </div>
                                }
                                @if (q.ShowScopeButton)
                                {
                                    <button type="button" class="btn btn-sm btn-info py-0 px-1 mt-1 text-start"
                                            title="Aim the scope where the tip points and jump to Sensors to run the scan"
                                            @onclick="() => OnPointScope.InvokeAsync()">
                                        🔭 Point the scope where the tip says
                                    </button>
                                }
                                <div class="captain-quest-foot">
                                    <span class="captain-quest-status captain-quest-status-@q.StatusKind">@q.StatusLabel</span>
                                    <span class="captain-quest-reward">@q.RewardText</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* PR-WIRE — the favor bank's books (FridaySecondPlan §0). Balances both ways: coin we've
                   parked with a contact (safe from confiscation), and gas money we owe. Read-only here;
                   the deposit/withdraw/borrow controls live at the contact's table and the dark-web desk. *@
                <div class="captain-ledger-section-label text-info fw-bold small mt-3">💰 Accounts</div>
                <div class="captain-group-cards">
                    @if (Accounts.Count == 0)
                    {
                        <div class="captain-empty">No coin in the air. Park a stake with a trusted contact ashore (press B at their table) and it rides safe from the collectors.</div>
                    }
                    else
                    {
                        @foreach (AccountRow acct in Accounts)
                        {
                            AccountRow a = acct;
                            <div class="captain-card captain-ledger-account">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">@a.DisplayName</span>
                                    <span class="fw-bold @(a.Balance > 0 ? "text-success" : a.Balance < 0 ? "text-danger" : "text-secondary")">
                                        @(a.Balance > 0
                                            ? $"holds {a.Balance:N0} cr of yours"
                                            : a.Balance < 0
                                                ? $"you owe {(-a.Balance):N0} cr"
                                                : "square")
                                    </span>
                                </div>
                                @if (a.Channel is { } channel)
                                {
                                    <div class="captain-card-blurb text-secondary small">@channel</div>
                                }
                                @foreach (string line in a.Transactions)
                                {
                                    <div class="captain-account-txn text-secondary small">@line</div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="captain-ledger-section-label text-info fw-bold small mt-3">🔭 Tips, intel &amp; rumors</div>
                <div class="captain-group-cards">
                    @if (Tips.Count == 0)
                    {
                        <div class="captain-empty">No tips yet — buy someone a round ashore, or stand a contact a drink.</div>
                    }
                    else
                    {
                        @foreach (LedgerTip tip in Tips)
                        {
                            LedgerTip t = tip;
                            bool actionable = t.ScopeTipId is not null || t.ShowDarkWeb || t.DossierShipId is not null;
                            @* #973 L1 · A PAGE YOU DON'T REMEMBER WRITING. The row is still in the book — it is
                               drawn greyed, with the mark and the label saying what the mark means, and it is
                               clickable: sitting down with it is a flashback attempt, once per page per life.
                               The mark carries the meaning rather than the colour, because a greyed row on a
                               dark ledger is not a difference everybody can see. *@
                            <div class="captain-card captain-ledger-tip @(t.Grey ? "captain-ledger-unremembered" : "")"
                                 role="@(t.Grey ? "button" : null)" tabindex="@(t.Grey ? "0" : null)"
                                 title="@(t.Grey ? "Sit down with this page and try to remember writing it" : null)"
                                 @onclick="() => ReadIfGrey(t)">
                                @if (t.Grey)
                                {
                                    <div class="captain-ledger-unremembered-head">
                                        <span class="captain-ledger-unremembered-mark">@GreyPageMark</span>
                                        <span class="captain-ledger-unremembered-label">@GreyPageLabel</span>
                                    </div>
                                }
                                <div class="fw-bold">@t.Title</div>
                                @foreach (string line in t.Lines)
                                {
                                    <div class="captain-card-blurb text-secondary small">@line</div>
                                }
                                @if (t.Provenance is not null)
                                {
                                    <div class="captain-ledger-prov text-secondary small fst-italic">@t.Provenance</div>
                                }
                                @if (t.ScopeTipId is { } scopeId)
                                {
                                    <button type="button" class="btn btn-sm btn-info py-0 px-1 mt-1 text-start"
                                            title="Aim the scope where this tip points and jump to Sensors to run the scan"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OnScopeTip.InvokeAsync(scopeId)">
                                        🔭 Point the scope where this says
                                    </button>
                                }
                                @if (t.ShowDarkWeb || t.DossierShipId is not null)
                                {
                                    <div class="captain-ledger-links mt-1 d-flex gap-2 flex-wrap">
                                        @if (t.ShowDarkWeb)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info py-0 px-1"
                                                    title="Jump to Comms and open the dark-web node this tip points to"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OnRouteToDarkWeb.InvokeAsync()">→ dark web</button>
                                        }
                                        @if (t.DossierShipId is { } dossierId)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info py-0 px-1"
                                                    title="Jump to Comms and open this ship's dossier"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OnRouteToDossier.InvokeAsync(dossierId)">→ dossier</button>
                                        }
                                    </div>
                                }
                                @if (!actionable)
                                {
                                    <div class="captain-quest-status text-secondary small mt-1">background — may matter later</div>
                                }
                            </div>
                        }
                    }
                </div>

                @* #223: the buried-treasure maps — every chest we know of, ours and any rival's whose
                   map we hold. Viewable any time: click a map to throw the full-screen card back up. *@
                <div class="captain-ledger-section-label text-info fw-bold small mt-3">🗺 Treasure maps</div>
                @* #223: what is actually in the ground, totalled. CacheLedger has known BuriedCoin and
                   BuriedHotUnits since the hoard shipped and NOTHING ever read them — the one number a
                   captain wants from this page (how much of my fortune is off the books, and how much of
                   it is evidence) lived only in Core. Own caches only: a rival's chest is a map, not a
                   holding. *@
                @if (HoardSummary.Length > 0)
                {
                    <div class="captain-group-flavor">@HoardSummary</div>
                }
                <div class="captain-group-cards">
                    @if (Maps.Count == 0)
                    {
                        <div class="captain-empty">No maps in the ledger. Bury a chest on a landable moon via the shuttle-bay door — X always marks the spot.</div>
                    }
                    else
                    {
                        @foreach (CacheMapItem m in Maps)
                        {
                            CacheMapItem map = m;
                            <div class="captain-card captain-ledger-tip" role="button" tabindex="0"
                                 title="Open the map card"
                                 @onclick="() => OnViewMap.InvokeAsync(map.CacheId)">
                                <div class="fw-bold">🗺 @map.Caption</div>
                                <div class="captain-card-blurb text-secondary small">🧭 @map.Bearing</div>
                                <div class="captain-card-blurb text-secondary small">🧰 @map.Contents</div>
                                <div class="captain-ledger-prov text-secondary small fst-italic">@(map.PlayerOwned ? "your hoard" : $"{map.Owner}'s hoard — a map you hold")</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
    else
    {
    <div class="captain-groups">
        <div class="captain-group">
            <div class="captain-group-header"><span class="captain-group-icon">⛵</span> Free sailing</div>
            <div class="captain-group-flavor">No orders given. The crew keeps her trim and waits on your word.</div>
            <div class="captain-group-cards">
                @Card(ShipMission.Default)
            </div>
        </div>

        <div class="captain-group">
            <div class="captain-group-header"><span class="captain-group-icon">🎯</span> Fly to</div>
            <div class="captain-group-flavor">Set the helm for a world — Nav plots the course, the autopilot parks us in orbit.</div>
            <div class="captain-group-cards">
                @if (Options.FlyTo.Count == 0)
                {
                    <div class="captain-empty">No worlds charted to make for.</div>
                }
                else
                {
                    @foreach (ShipMission m in Options.FlyTo)
                    {
                        @Card(m)
                    }
                }
            </div>
        </div>

        <div class="captain-group">
            <div class="captain-group-header"><span class="captain-group-icon">☠</span> Hunt</div>
            <div class="captain-group-flavor">Name the cargo, and we'll run down every hauler carrying it.</div>
            <div class="captain-group-cards">
                @if (Options.Hunt.Count == 0)
                {
                    <div class="captain-empty">No haulers worth the name in these waters.</div>
                }
                else
                {
                    @foreach (ShipMission m in Options.Hunt)
                    {
                        @Card(m)
                    }
                }
            </div>
        </div>

        <div class="captain-group">
            <div class="captain-group-header"><span class="captain-group-icon">🛰</span> Trade run</div>
            <div class="captain-group-flavor">Honest cargo, honest coin — and the safest way to grow the hold.</div>
            <div class="captain-group-cards">
                @if (Options.TradeRuns.Count == 0)
                {
                    <div class="captain-empty">No charted trade lanes yet.</div>
                }
                else
                {
                    @foreach (ShipMission m in Options.TradeRuns)
                    {
                        @Card(m)
                    }
                }
            </div>
        </div>

        <div class="captain-group">
            <div class="captain-group-header"><span class="captain-group-icon">🍹</span> Lay low</div>
            <div class="captain-group-flavor">Heat's rising. Find a haven, cool the trail, and let the fuss pass.</div>
            <div class="captain-group-cards">
                @if (Options.LayLow.Count == 0)
                {
                    <div class="captain-empty">No havens charted — nowhere quiet to run to.</div>
                }
                else
                {
                    @foreach (ShipMission m in Options.LayLow)
                    {
                        @Card(m)
                    }
                }
            </div>
        </div>

        <div class="captain-group">
            <div class="captain-group-header"><span class="captain-group-icon">🔭</span> Survey</div>
            <div class="captain-group-flavor">Chart the corridor end to end — every hull that passes it becomes known to us.</div>
            <div class="captain-group-cards">
                @if (Options.Survey.Count == 0)
                {
                    <div class="captain-empty">No corridor worth the watch yet.</div>
                }
                else
                {
                    @foreach (ShipMission m in Options.Survey)
                    {
                        @Card(m)
                    }
                }
            </div>
        </div>
    </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ShipMission CurrentMission { get; set; } = ShipMission.Default;
    [Parameter, EditorRequired] public MissionOptions Options { get; set; } = new([], [], [], [], []);
    [Parameter] public EventCallback<ShipMission> OnSelectMission { get; set; }

    /// <summary>#963 follow-up — what killed the last voyage, if anything did. Null on a clean run.</summary>
    [Parameter] public SpaceSails.Core.CrashNote? LastError { get; set; }

    /// <summary>True once the note has been copied, so the button can say it took.</summary>
    [Parameter] public bool ErrorCopied { get; set; }

    [Parameter] public EventCallback OnCopyError { get; set; }
    [Parameter] public EventCallback OnDismissError { get; set; }
    [Parameter] public IReadOnlyList<DeskChips.ChipData> StatusChips { get; set; } = [];
    [Parameter] public EventCallback<ShipDesk> OnGoToDesk { get; set; }
    [Parameter] public bool ShotAuthorized { get; set; }
    [Parameter] public bool FireAtWill { get; set; }
    [Parameter] public EventCallback OnAuthorizeShot { get; set; }
    [Parameter] public EventCallback OnToggleFireAtWill { get; set; }

    /// <summary>Whether the standing WEAPONS TIGHT order is in force — bots and the tube gun stand down while it
    /// is, and the captain's own trigger is untouched (#538). READ-ONLY here: the remote is on the deck HUD (H),
    /// because the order is given on foot and not from a chair.</summary>
    [Parameter] public bool WeaponsTight { get; set; }

    /// <summary>Whether damage control holds the captain's standing authority over her compartments — the
    /// owner's "fire at will" for the other set of handles.</summary>
    [Parameter] public bool DamageControlAuthorized { get; set; }
    [Parameter] public EventCallback OnToggleDamageControlAuthority { get; set; }

    /// <summary>Whether the captain has cleared damage control's NEXT act — the limited pre-ok, spent by the
    /// act it permits. The exact shape of AUTHORIZE NEXT SHOT, for the other set of handles.</summary>
    [Parameter] public bool DamageControlNextActCleared { get; set; }
    [Parameter] public EventCallback OnAuthorizeNextDamageControlAct { get; set; }

    /// <summary>The one compartment armed by name at a board right now, if any. Read-only here: the word is
    /// given where the valve is, because it names the room it was given for.</summary>
    [Parameter] public string? ArmedCompartment { get; set; }

    /// <summary>Whether her bridge repeater still has a bus behind it. Star Trek's engineering/bridge
    /// duplication is the arrangement (the owner's own reference): NEITHER station locks the other out — the
    /// valves aft are mechanical and always answer, and the repeater answers while the bridge lives.</summary>
    [Parameter] public bool BridgeRepeaterAlive { get; set; } = true;
    // Reopens Map's start-point picker (playtest / "begin elsewhere" jump). Optional — the button
    // only shows when Map wires it.
    [Parameter] public EventCallback OnReopenStartPicker { get; set; }

    // The ship's logbook (#310): open the save/load surface (slots, banking, export/import). Optional —
    // the button only shows when Map wires it.
    [Parameter] public EventCallback OnOpenSaves { get; set; }

    // ── #948 · the captain's own name, editable from the chair. The desk holds no state of its own: Map
    //    owns the draft and the registry write (RenameCaptain), so the desk and the front-door roster card
    //    are two doors onto ONE act, and neither can drift from the other. ──

    /// <summary>The captain's display name — the renamed one, or the seeded roster name.</summary>
    [Parameter] public string CaptainName { get; set; } = "";

    /// <summary>True while THIS captain's name is being typed (Map's rename draft is open on this thread).</summary>
    [Parameter] public bool RenamingCaptain { get; set; }

    /// <summary>The name as typed so far.</summary>
    [Parameter] public string RenameDraft { get; set; } = "";

    /// <summary>Open the rename input.</summary>
    [Parameter] public EventCallback OnBeginRename { get; set; }

    /// <summary>Each keystroke's text.</summary>
    [Parameter] public EventCallback<string> OnRenameDraft { get; set; }

    /// <summary>Enter/Escape while typing the name.</summary>
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.KeyboardEventArgs> OnRenameKeyDown { get; set; }

    /// <summary>Write the typed name onto the license.</summary>
    [Parameter] public EventCallback OnCommitRename { get; set; }

    /// <summary>Abandon the typed name.</summary>
    [Parameter] public EventCallback OnCancelRename { get; set; }

    // Tutorials tab (the picker used to float on the Nav map; starting a lesson is a captain's order).
    [Parameter] public IReadOnlyList<TutorialItem> Tutorials { get; set; } = [];

    /// <summary>Everything the crew have formed an opinion from. A plain aggregate of the voyage, so the
    /// sheet is a pure function of what actually happened.</summary>
    [Parameter] public CrewTemp.Voyage Voyage { get; set; }
    [Parameter] public int ActiveTutorial { get; set; } = -1; // index of the in-progress lesson, -1 = none
    [Parameter] public EventCallback<int> OnStartTutorial { get; set; }
    // A one-shot request to open this desk straight on the lessons. (The Nav "New here? Learn the
    // ropes" banner that used to raise it was removed in #195; the hook is kept dormant for a future
    // tutorial mission to drive — see Map.Quests.cs _openCaptainToTutorials.)
    [Parameter] public bool OpenToTutorials { get; set; }

    // #124/#125 playtest: the desk component is re-created on every desk switch (see the note by
    // _view below), so the active tab used to reset to Orders each return. Map now OWNS the last
    // tab: it seeds this desk with InitialTab on creation and the desk reports every tab change
    // back through OnTabChanged, so "find the tab where I left it" holds across desk switches.
    [Parameter] public CaptainView InitialTab { get; set; } = CaptainView.Orders;
    [Parameter] public EventCallback<CaptainView> OnTabChanged { get; set; }

    /// <summary>One lesson on the Tutorials tab — title + one-line blurb. Map owns the actual steps.</summary>
    public sealed record TutorialItem(string Title, string Blurb);

    // Quests tab (go-ashore contracts, M-Q2): a read-only ledger of work picked up at haven bars.
    // Accepted at the table, tracked in Map, paid on docking — this desk is the crew's copy.
    [Parameter] public IReadOnlyList<QuestItem> Quests { get; set; } = [];

    /// <summary>Raised by a quest card's 🔭 button (Tuesday plan PR-A): the intel-fed fetch hunt is
    /// reachable from the quest card too, not just the Comms desk. Map aims the scope and jumps to
    /// Sensors.</summary>
    [Parameter] public EventCallback OnPointScope { get; set; }

    /// <summary>One contract on the Quests tab. <paramref name="StatusKind"/> is a css slug
    /// (active / complete / paid); Map owns the live quest state. <paramref name="Steps"/> is the
    /// staged plan (empty for quests without one); <paramref name="ShowScopeButton"/> surfaces the
    /// 🔭 "point the scope" hook while the fetch hunt is at its pre-scan stage.</summary>
    /// <remarks>#959 — <paramref name="Plain"/> is the verb / takes / effort block Core's
    /// <c>JobTerms.PlainBlock</c> computes, rendered ABOVE the flavour <paramref name="Detail"/>. Null or
    /// empty for a row Map could not measure; the card then simply shows the voice, as it always did.</remarks>
    public sealed record QuestItem(
        string Title, string Detail, string RewardText, string StatusLabel, string StatusKind,
        IReadOnlyList<QuestStep> Steps, bool ShowScopeButton, string? NextAction = null,
        IReadOnlyList<string>? Plain = null)
    {
        public QuestItem(string title, string detail, string rewardText, string statusLabel, string statusKind)
            : this(title, detail, rewardText, statusLabel, statusKind, [], false) { }
    }

    /// <summary>One line of a staged quest plan — an icon (✅ done / ▶ current / ▪ ahead) and its text.</summary>
    public sealed record QuestStep(string Icon, string Text);

    // The ledger's "Tips & intel" section (PR-J): every scope/route tip, projected by Map so this
    // desk only renders. A scope tip carries <paramref name="ScopeTipId"/> (its 🔭 action jumps to
    // Sensors with the scan queued); a route tip carries <paramref name="ShowDarkWeb"/> and, when the
    // ship is a known contact, <paramref name="DossierShipId"/> (the two "→" links onto Comms). A tip
    // with none of the three is background — "may matter later".
    [Parameter] public IReadOnlyList<LedgerTip> Tips { get; set; } = [];

    /// <summary>A scope tip's 🔭 button (by tip id): Map aims the prioritized scan and jumps to Sensors,
    /// exactly like the Comms intel card.</summary>
    [Parameter] public EventCallback<string> OnScopeTip { get; set; }

    /// <summary>A route tip's "→ dark web" link: Map switches to Comms and selects the dark-web node.</summary>
    [Parameter] public EventCallback OnRouteToDarkWeb { get; set; }

    /// <summary>A route tip's "→ dossier" link (by ship id): Map switches to Comms and selects the contact.</summary>
    [Parameter] public EventCallback<string> OnRouteToDossier { get; set; }

    /// <summary>One line in the ledger's Tips &amp; intel section. <paramref name="Lines"/> is the
    /// grounded numbers (scope) or the route in plain words (route); <paramref name="Provenance"/> is
    /// "&lt;giver&gt; · &lt;station&gt; · day N" or null when unknown. Exactly the actions that apply
    /// are non-null/true; a tip with no action renders as background.
    ///
    /// <para>#973 L1 · <paramref name="EntryId"/> and <paramref name="SimTime"/> are the FILING LINE's two
    /// facts about this row: an identity that survives the ledger being reassembled from six books every
    /// render, and the stamp that decides which side of the last filing it falls on. Null on the rows that
    /// have no date at all — the standing note, the two arc readouts — which is why those can never grey.
    /// <paramref name="Grey"/> is Map's answer for this captain: a page they don't remember writing, drawn
    /// with the mark and open to being read at.</para></summary>
    public sealed record LedgerTip(
        string Title, IReadOnlyList<string> Lines, string? Provenance,
        string? ScopeTipId, bool ShowDarkWeb, string? DossierShipId,
        string? EntryId = null, double? SimTime = null, bool Grey = false);

    /// <summary>#973 L1 · The captain sits down with a page they don't remember writing. Map rolls it once
    /// on the shared dice — it comes back, it comes back wrong, or nothing — and never again this life.</summary>
    [Parameter] public EventCallback<string> OnReadGreyPage { get; set; }

    /// <summary>#973 L1 · The mark a grey row wears (<c>FilingLine.Mark</c>), passed in rather than typed
    /// here so the glyph has one home.</summary>
    [Parameter] public string GreyPageMark { get; set; } = "";

    /// <summary>#973 L1 · What the mark means, spelled out on the row (<c>FilingLine.Label</c>).</summary>
    [Parameter] public string GreyPageLabel { get; set; } = "";

    /// <summary>#223: the ledger's 🗺 treasure-maps section. Every buried chest we know of, ours and
    /// any rival's whose map we hold — clicking one throws its full-screen card back up (OnViewMap).</summary>
    [Parameter] public IReadOnlyList<CacheMapItem> Maps { get; set; } = [];

    /// <summary>Open the full-screen map card for a cache id.</summary>
    [Parameter] public EventCallback<string> OnViewMap { get; set; }

    /// <summary>#223: one line over the 🗺 section totalling what is OURS and underground — buried coin,
    /// buried units, and how many of those units are evidence. Empty when we have nothing in the ground
    /// (a rival's map is not a holding), and then the section shows nothing extra.</summary>
    [Parameter] public string HoardSummary { get; set; } = "";

    /// <summary>One map in the ledger's 🗺 section — the caption, the bearing line, the contents, and
    /// whose hoard it is. The cache id drives the "view the card" jump.</summary>
    public sealed record CacheMapItem(
        string CacheId, string Caption, string Bearing, string Contents, string Owner, bool PlayerOwned);

    // PR-WIRE — the favor bank's accounts, projected by Map for the ledger's 💰 Accounts section.
    [Parameter] public IReadOnlyList<AccountRow> Accounts { get; set; } = [];

    /// <summary>One contact's bank standing for the ledger. <paramref name="Balance"/> is signed
    /// (+ = they hold our coin; − = we owe them); <paramref name="Channel"/> is the one-line "how they
    /// bank" hint; <paramref name="Transactions"/> is the recent passbook, newest first.</summary>
    public sealed record AccountRow(string DisplayName, long Balance, string? Channel, IReadOnlyList<string> Transactions);

    /// <summary>#973 L1 · A click anywhere on a ledger row. Only a GREY one does anything: it hands the entry
    /// id back to Map, which owns the roll, the nerve and the beat. A remembered row is an ordinary card and
    /// this is why it stays one.</summary>
    private Task ReadIfGrey(LedgerTip tip)
        => tip.Grey && tip.EntryId is { Length: > 0 } id ? OnReadGreyPage.InvokeAsync(id) : Task.CompletedTask;

    public enum CaptainView { Orders, Status, Tutorials, Ledger, Crew }
    private CaptainView _view;

    // The component is re-created each time you switch to the Captain desk. The banner's one-shot
    // "open on Tutorials" wins for that single arrival; otherwise we restore the last tab Map kept
    // for us (InitialTab), so a manual return lands where you left rather than always on Orders.
    protected override void OnInitialized()
    {
        _view = OpenToTutorials ? CaptainView.Tutorials : InitialTab;
    }

    // Set the active tab and let Map remember it (it survives this desk's re-creation).
    private async Task SetView(CaptainView view)
    {
        _view = view;
        await OnTabChanged.InvokeAsync(view);
    }

    private async Task OnStatusKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, ShipDesk desk)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnGoToDesk.InvokeAsync(desk);
        }
    }

    private async Task OnTutorialKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, int index)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnStartTutorial.InvokeAsync(index);
        }
    }

    private bool IsSelected(ShipMission m) => CurrentMission == m;

    private Task Pick(ShipMission m) => OnSelectMission.InvokeAsync(m);

    private async Task OnCardKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, ShipMission m)
    {
        if (e.Key is "Enter" or " ")
        {
            await Pick(m);
        }
    }
}
