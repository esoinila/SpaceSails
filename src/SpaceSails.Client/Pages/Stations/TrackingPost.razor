@using SpaceSails.Core
@using SpaceSails.Client.Rendering
@implements IDisposable

@* The tracking post (worldbuilding notes §5; vision ¶12/¶14/¶16): aim the ship's telescope at a
   sky region, sweep it over sim time, and hold a ledger of found ships that don't advertise
   themselves. Entirely self-contained: Map.razor only ever passes it the shared clock/geometry
   and reads back the ledger for its own emphasis pass — no engine logic lives in Map.razor.

   PR-12 (the scope wall): the specialist position shows every tracked target live at once
   instead of one small inset — one ScopeView canvas per ledger slot (max 4), redrawn straight
   off SpaceSails.Client.Rendering.RendererInterop.FrameTick, the exact same global rAF-driven
   event Map.razor's own scope inset rides. No new timer, no new interop — just more canvases
   subscribed to the render loop that's already running. *@

<div class="tracking-post-card @(FullScreen ? "tracking-post-desk text-light" : "card bg-dark bg-opacity-75 text-light") @(Visible ? "" : "d-none")">
    <DeskHeaderBar FullScreen="@FullScreen"
                   OnZoomMap="OnZoomMap" OnCenterShip="OnCenterShip" OnClose="OnClose" />
    <div class="card-body p-2 small @(FullScreen ? "tracking-post-desk-body" : "")">
        <div class="d-flex gap-2 @(FullScreen ? "tracking-post-desk-top" : "")">
            <AimRosette FullScreen="@FullScreen"
                        RosettePolygonPoints="RosettePolygonPoints" WedgePolygonPoints="WedgePolygonPoints"
                        _activeJob="_activeJob" TrackedTargetDots="TrackedTargetDots"
                        ProgradePoint="ProgradePoint" HeadingLine="HeadingLine" />
            <ScopeControls _centerBearingDeg="_centerBearingDeg" _arcWidthDeg="_arcWidthDeg"
                           _activeJob="_activeJob" _passiveWatch="_passiveWatch"
                           RadarActive="@RadarActive" Transponder="@Transponder"
                           OnBearingInput="OnBearingInput" OnArcInput="OnArcInput"
                           StartSweep="StartSweep" StopSweep="StopSweep"
                           TogglePassiveWatch="TogglePassiveWatch" TransponderHint="TransponderHint"
                           OnRadarToggle="OnRadarToggle" OnTransponderChange="OnTransponderChange" />
        </div>

        @if (FullScreen && Opportunities.Count > 0)
        {
            <EnRoutePassesBox Opportunities="Opportunities" SimTime="@SimTime"
                              FormatWallDistance="FormatWallDistance" FormatOppDuration="FormatOppDuration"
                              OnSetInterest="OnSetInterest" />
        }

        @if (FullScreen && RadarActive)
        {
            <RadarReturnsBox ShipPosition="@ShipPosition" ShipVelocity="@ShipVelocity"
                             RadarReturns="RadarReturns" FormatWallDistance="FormatWallDistance" />
        }

        <SweepReadoutStrip _activeJob="_activeJob" SweepProgressPercent="@SweepProgressPercent"
                           _lastSweepMessage="_lastSweepMessage" />

        <hr class="my-2" />

        @if (FullScreen)
        {
            @* PR-D: the Sensor tasks list — the telescope's queue, visible and reorderable.
               What the one instrument does next is never a mystery: it works this list top to
               bottom and wraps around; one-shots leave after their pass. *@
            @if (_schedule.Queue.Count > 0)
            {
                <SensorTaskQueue _schedule="_schedule" SimTime="@SimTime"
                                 KindIcon="KindIcon" StateChipClass="StateChipClass"
                                 TaskCostText="TaskCostText" AbandonSearch="AbandonSearch" />
            }

            @* PR-D: the cold-case board — every lost lock, its live search area, and the
               PRIORITIZE REDISCOVERY button. Priority is a real trade: every other task waits. *@
            @if (_lostTracks.Entries.Count > 0)
            {
                <LostLockBoard _lostTracks="_lostTracks" SimTime="@SimTime"
                               FindCandidate="FindCandidate" FormatWallDistance="FormatWallDistance"
                               PrioritizeSearch="PrioritizeSearch" />
            }

            @if (_recentFinds.Count > 0)
            {
                <RecentFindsBox _recentFinds="_recentFinds" FindIcon="FindIcon" />
            }

            @* PR-D: the tracked-target boxes, one live scope image per slot (owner: "boxes with
               images. Each has its own") — the M27 single cycling tile grew into a per-card
               instrument; the card still carries the full nav-grade picture beside it. *@
            <div class="fw-bold mb-1">Tracked targets (@_ledger.Entries.Count / @_ledger.MaxTracks)</div>
            <div class="sensors-main">
                <div class="sensors-cards flex-grow-1">
                    @{
                        List<TrackedTarget> orderedCards = OrderedTracks();
                    }
                    @if (orderedCards.Count == 0)
                    {
                        <div class="text-secondary">Track ledger empty — the passive watch is scanning; contacts land here as the sweep finds them, and lost tracks come back as cold cases.</div>
                    }
                    @foreach (TrackedTarget entry in orderedCards)
                    {
                        TrackingCandidate? candidate = FindCandidate(entry.ShipId);
                        double quality = entry.EffectiveQuality(SimTime);
                        double daysAgo = (SimTime - entry.LastConfirmedTime) / 86400.0;
                        Vector2d position = candidate?.State.Position ?? entry.LastObservation.Position;
                        Vector2d velocity = candidate?.State.Velocity ?? entry.LastObservation.Velocity;
                        double distance = (position - ShipPosition).Length;
                        double relSpeed = (velocity - ShipVelocity).Length;
                        double closing = RelativeMotion.ClosingSpeed(ShipPosition, ShipVelocity, position, velocity);
                        double bearingDeg = TrackingStation.Bearing(position - ShipPosition) * 180.0 / Math.PI;
                        if (bearingDeg < 0) { bearingDeg += 360; }
                        bool isThreat = candidate?.IsThreat ?? false;
                        bool onScope = _schedule.Active?.TargetShipId == entry.ShipId;
                        SightAdvantage sight = SensorModel.Default.Advantage(
                            new ShipState(ShipPosition, ShipVelocity, SimTime, ShipCharge),
                            new ShipState(position, velocity, SimTime));
                        <div class="sensor-card sensor-card-row @(onScope ? "sensor-card-live" : "") @(isThreat ? "sensor-card-threat" : "")"
                             @key="entry.ShipId">
                            <canvas id="@CardCanvasId(entry.ShipId)" class="sensor-card-scope"></canvas>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">@(isThreat ? "🐺 " : "")@(candidate?.Callsign ?? entry.ShipId)@(_aware.Contains(entry.ShipId) ? " · aware ⚠" : "")</span>
                                    <span>@(onScope ? "● ON SCOPE" : "")</span>
                                </div>
                                <div>@FormatWallDistance(distance) · rel @((relSpeed / 1000).ToString("F2")) km/s ·
                                     @RelativeMotion.WordedBefore(closing, "F2")</div>
                                <div class="text-secondary">brg @((int)bearingDeg)° · @daysAgo.ToString("F1")d since fix@(candidate?.CargoDetail is { } cd ? $" · {cd}" : "")</div>
                                <div class="@(sight.TheySeeUs ? "text-warning" : "text-info")">@SightLine(sight)</div>
                                @if (BeaconLine(sight) is { } beaconLine)
                                {
                                    <div class="@(beaconLine.StartsWith("🚨") ? "text-danger fw-bold" : "text-secondary")">@beaconLine</div>
                                }
                                <div class="tracking-quality-bar"><div class="tracking-quality-fill" style="width:@((int)(quality * 100))%"></div></div>
                                <div class="d-flex justify-content-end gap-1 mt-1">
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1"
                                            title="War-room target of interest — a DIFFERENT slot than the nav destination"
                                            @onclick="() => OnSetInterest.InvokeAsync(entry.ShipId)">🎯</button>
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1" disabled="@(candidate is null)"
                                            title="Take a fresh fix on this contact now — a zero-age observation tightens the prediction cone"
                                            @onclick="() => ConfirmNow(entry.ShipId)">Confirm</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1"
                                            title="Drop this track from the ledger and free the telescope slot"
                                            @onclick="() => Drop(entry.ShipId)">Drop</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="fw-bold mb-1">Tracked targets (@_ledger.Entries.Count / @_ledger.MaxTracks)</div>
            @if (_ledger.Entries.Count == 0)
            {
                <div class="text-secondary">Nothing on the ledger yet — sweep a region to find contacts.</div>
            }
            else
            {
                <table class="table table-sm table-dark mb-0">
                    <tbody>
                        @foreach (TrackedTarget entry in OrderedTracks())
                        {
                            double quality = entry.EffectiveQuality(SimTime);
                            double daysAgo = (SimTime - entry.LastConfirmedTime) / 86400.0;
                            TrackingCandidate? candidate = FindCandidate(entry.ShipId);
                            <tr>
                                <td>
                                    @(candidate?.Callsign ?? entry.ShipId)@(_aware.Contains(entry.ShipId) ? " aware ⚠" : "")
                                    <div class="tracking-quality-bar"><div class="tracking-quality-fill" style="width:@((int)(quality * 100))%"></div></div>
                                </td>
                                <td class="text-end align-middle">@daysAgo.ToString("F1")d</td>
                                <td class="text-end align-middle text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1" disabled="@(candidate is null)"
                                            title="Take a fresh fix on this contact now — a zero-age observation tightens the prediction cone"
                                            @onclick="() => ConfirmNow(entry.ShipId)">Confirm</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="Drop this track from the ledger and free the telescope slot" @onclick="() => Drop(entry.ShipId)">Drop</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>
