@page "/map"
@implements IDisposable
@implements IHandleEvent
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Globalization
@using SpaceSails.Client.Rendering
@using SpaceSails.Contracts
@using SpaceSails.Core
@using SpaceSails.Core.Interior

<PageTitle>SpaceSails — Map</PageTitle>

<div @ref="_focusableDiv" class="map-page @(_peekMap ? "map-peek" : "")" tabindex="0" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" @onfocusout="OnFocusOut">
    @if (!_worldReady)
    {
        @* #318 follow-up: an honest, LIVE boot door. The ⚙ gear spins via a pure CSS transform
           (compositor thread), so it keeps turning even while the main thread is blocked in a
           synchronous generation phase — proof the app is alive, not frozen. The sub-line shows the
           current coarse phase (set by BootPhaseAsync, which yields so each phase actually paints). *@
        <div class="map-loading d-flex flex-column justify-content-center align-items-center">
            <span class="wait-gear" aria-hidden="true">⚙</span>
            <div class="text-light mt-3">Rigging the sails…</div>
            <div class="text-secondary small mt-1" role="status">@(_bootPhase ?? "planning NPC routes, spinning up the ephemeris")</div>
        </div>
    }
    else if (_shuttleDescending)
    {
        @* #318/#329 follow-up: the Board→surface descent runs several first-time synchronous blocks
           (clock jump, tube/surface/maze weld, first cold render). A 🛸 flies across on a pure CSS
           transform (compositor thread), so it keeps moving while they run; the sub-line narrates the
           current coarse phase, set by DescentPhaseAsync which yields between phases so no single block
           trips Chrome's page-unresponsive dialog. *@
        <div class="map-loading shuttle-descent d-flex flex-column justify-content-center align-items-center">
            <div class="wait-shuttle-lane"><span class="wait-shuttle" aria-hidden="true">🛸</span></div>
            <div class="text-light mt-3">Shuttle descending…</div>
            <div class="text-secondary small mt-1" role="status">@(_descentPhase ?? "mating the airlock…")</div>
        </div>
    }
    <canvas id="@CanvasId" class="map-canvas"
            @onwheel="OnWheel" @onwheel:preventDefault="true"
            @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove"
            @onpointerup="OnPointerUp" @onpointerleave="OnPointerUp">
    </canvas>

    @* #841 / Lab 46 · WHAT THIS FRAME COST, ON THE GLASS. Only ever present under ?perf=1 — the probe is
       null otherwise and this element with it. It is HTML rather than canvas text on purpose: #782's law is
       about size and contrast, and the sweep next door can only read a rule it can find in a stylesheet, so
       the perf line wears .perf-hud (its own opaque ground, its own real font size) instead of being a 10px
       monospace whisper nothing could check. The reading is the rolling window, refreshed on the page's own
       5 Hz HUD throttle; the copy that goes into the lab's table is the console block. *@
    @if (_deckView?.Perf is { HudLine.Length: > 0 } perf)
    {
        <div class="perf-hud" role="status">@perf.HudLine</div>
    }

    @* Start picker (2026-07-08): "why always Earth?" — a boot chooser of named start points, over
       the freshly-built world. Skips the long transit for playtesting and lets a run begin at a gas
       giant or already ashore. Suppressed when /map?start=<id> already picked one. Same registry. *@
    @* #310 — the front door IS the load view. Its primary content is the save slots (place + when);
       Continue-newest is the headline, one prominent "New voyage" launches Sol for a fresh player, and
       the barely-tested non-Sol skies are demoted to a footer toggle. Same surface, in-game, opens from
       the captain's desk (_showSaveDrawer). *@
    @{
        // One slot row in the WHOLE rack (#312): every one of the ten slots — the rolling autosave and the
        // nine manual berths — occupied or an "— empty berth —". Every action states what it reads/writes
        // (the #310 semantics law). Occupied: Load (boards it), Export (named for its harbor), Overwrite-
        // with-current (in-game, manual), Clear. Empty: Bank this moment (in-game). Any slot: Import a file
        // INTO this berth — banks it here WITHOUT boarding, distinct from the top-level board-it Import.
        // Row 1 (the newest save, the same one Continue resumes) wears a '← latest' badge.
        RenderFragment<(string ThreadId, string Id, SaveSlotMeta? Meta, bool InGame, bool IsLatest)> SlotRow = ctx =>
    @<div class="slot-row @(ctx.Id == SaveSlotBook.AutoSlotId ? "slot-row-auto" : "") @(ctx.Meta is null ? "slot-row-empty" : "")">
        @if (ctx.Meta is { } m)
        {
            <button type="button" class="slot-load" title="Load this voyage — BOARDS it: replaces the current run with this saved life (purse, cargo, contacts, hoard, heat)"
                    @onclick="() => LoadThreadSlot(ctx.ThreadId, ctx.Id)">
                <span class="slot-icon">@(ctx.Id == SaveSlotBook.AutoSlotId ? "💾" : "📼")</span>
                <span class="slot-text">
                    <span class="slot-where">@(m.WasDocked ? "⚓ " : "🛰 ")@m.Where@(m.Tampered ? " 📛" : "")@(ctx.IsLatest ? " " : "")@if (ctx.IsLatest){<span class="slot-latest">← latest</span>}</span>
                    <span class="slot-when">@(ctx.Id == SaveSlotBook.AutoSlotId ? "autosave · " : $"slot {ctx.Id} · ")day @m.SimDay · @m.RealTimeLabel</span>
                    <span class="slot-stamp">@m.BuildStamp</span>
                </span>
            </button>
            <button type="button" class="slot-mini" title="Export THIS berth's saved voyage to a .json file, named for the place and day it holds"
                    @onclick="() => ExportThreadSlot(ctx.ThreadId, ctx.Id)">⬇</button>
            @if (ctx.InGame && ctx.Id != SaveSlotBook.AutoSlotId)
            {
                <button type="button" class="slot-mini" title="Overwrite this berth with THIS moment (the live game right now)"
                        @onclick="() => SaveToSlot(ctx.Id)">⤓ bank here</button>
            }
            <button type="button" class="slot-mini" title="Import a file INTO this berth — banks it here WITHOUT boarding; the running voyage keeps flying. Load it later to board it."
                    @onclick="() => ImportIntoThreadSlot(ctx.ThreadId, ctx.Id)">📥 file</button>
            @if (ctx.Id != SaveSlotBook.AutoSlotId)
            {
                <button type="button" class="slot-mini slot-mini-danger" title="Clear this berth — forgets its saved voyage"
                        @onclick="() => DeleteThreadSlot(ctx.ThreadId, ctx.Id)">🗑</button>
            }
        }
        else
        {
            <div class="slot-load slot-load-empty">
                <span class="slot-icon">○</span>
                <span class="slot-text"><span class="slot-where slot-where-empty">— empty berth —</span><span class="slot-when">@(ctx.Id == SaveSlotBook.AutoSlotId ? "autosave" : $"slot {ctx.Id}")</span></span>
            </div>
            @if (ctx.InGame && ctx.Id != SaveSlotBook.AutoSlotId)
            {
                <button type="button" class="slot-mini" title="Bank THIS moment (the live game right now) into this empty berth"
                        @onclick="() => SaveToSlot(ctx.Id)">⤓ bank here</button>
            }
            <button type="button" class="slot-mini" title="Import a file INTO this berth — banks it here WITHOUT boarding. This is how you shelve a rescued Downloads save into a named berth."
                    @onclick="() => ImportIntoThreadSlot(ctx.ThreadId, ctx.Id)">📥 file</button>
        }
    </div>;

        RenderFragment<bool> SaveLoadSurface = inGame =>
    @<div class="start-picker save-surface">
        <div class="start-picker-title">@(inGame ? "🧭 Ship's logbook — saves" : "🛰 Space Sails")</div>
        <div class="start-picker-sub">
            @(inGame
                ? "Load a saved voyage, or bank this moment to a slot. The autosave follows the ship on its own."
                : "Your saved voyages. Continue where you left off — or begin a new one.")
        </div>

        @if (!_worldReady)
        {
            @* Honest boot state (#310, #212): the door SAYS it is warming rather than silently eating
               clicks. Buttons are disabled until the reactor is warm. *@
            <div class="save-warming">
                <span class="save-warming-spin">⚙</span>
                <span>Warming the reactor — the ship's computer is still booting. One moment…</span>
            </div>
        }
        else
        {
            @if (_resumeAvailable)
            {
                <button type="button" class="start-picker-option start-picker-continue"
                        title="Pick up where you actually are — loads the most recent save (the rolling autosave)"
                        @onclick="ContinueFromSave">
                    <span class="start-picker-icon">▶</span>
                    <span class="start-picker-text">
                        <span class="start-picker-label">Continue — @(_resumeHavenName ?? "your last berth")</span>
                        <span class="start-picker-blurb">Resume the newest save: purse, cargo, contacts, hoard and heat, all restored.@(_resumeTampered ? " 📛 ledger marked — the save file was edited outside the game." : "")</span>
                    </span>
                </button>
            }

            @if (!inGame)
            {
                @* Docked-starts rework (owner ruling, 2026-07-18 playtest): "All starting points should be
                   the docked positions… never ever Earth as default." A new voyage is no longer a
                   free-flying Earth cast-off — it is a CHOICE OF BERTH, every one a station you clamp onto
                   (and, where the haven has a bar, walk ashore into, jobs waiting on the table). The whole
                   dockable-haven registry is offered here, prominent, inner → outer — the same berths the
                   ?dock cheat and the CI smoke sweep read, so a new haven joins the picker for free. Each
                   routes through the one shared clamp (ChooseBerthStart → StartDockedAtHaven). *@
                <div class="start-picker-berths-intro">Begin a new voyage — every start is docked at a station. Pick a berth:</div>
                <div class="save-slots-list save-berth-starts">
                    @foreach ((string Id, string Name) berth in BerthStarts())
                    {
                        (string Id, string Name) b = berth;
                        bool walkable = SpaceSails.Client.Rendering.HavenInterior.HasInterior(b.Id);
                        bool tutorialHome = b.Id == TutorialHomeHavenId;
                        <button type="button" class="start-picker-option @(tutorialHome ? "start-picker-newvoyage" : "")"
                                title="@(walkable ? "Begin a new voyage clamped on here — walk up the tube into the bar, jobs on the table" : "Begin a new voyage clamped on at this berth — a fuel pump and the Nav map")"
                                @onclick="() => ChooseBerthStart(b.Id)">
                            <span class="start-picker-icon">@(tutorialHome ? "🌙" : "⚓")</span>
                            <span class="start-picker-text">
                                <span class="start-picker-label">@b.Name@(tutorialHome ? " — recommended for a first voyage" : "")</span>
                                <span class="start-picker-blurb">New voyage, already docked at @b.Name.@(walkable ? " Walk ashore into the bar." : "")@(tutorialHome ? " In Luna's orbit, where the compute-core pods launch — the soft-catch lesson begins here." : "")</span>
                            </span>
                        </button>
                    }
                </div>
            }

            @* THE DEV START SITES (owner 2026-07-26: "We should have a developer list of these quick starts
               in the UI also. We can later disbale it. These special palces to start should be shown in the
               UI and marked as dev star sites"). The URL cheats, as buttons — the same entry points
               docs/testing-guide.md tabulates and the CI smoke sweep reads, offered here so nobody has to
               remember or type them. Marked hard as a service door so it never reads as a real voyage, and
               gated on ONE switch (ShowDevStarts) so the whole section goes away in a line. Each is a
               boot-time cheat, so it navigates with a full reload — the world is built from the URL once. *@
            @if (ShowDevStarts)
            {
                <div class="start-picker-devstarts">
                    <button type="button" class="start-picker-devstarts-head" @onclick="() => _showDevStarts = !_showDevStarts"
                            title="Developer quick starts — service entrances into one thing to look at">
                        <span class="start-picker-devstarts-title">@SpaceSails.Core.DevStarts.SectionTitle</span>
                        <span class="start-picker-devstarts-count">@SpaceSails.Core.DevStarts.All.Count</span>
                        <span class="start-picker-devstarts-chev">@(_showDevStarts ? "▾" : "▸")</span>
                    </button>
                    @if (_showDevStarts)
                    {
                        <div class="start-picker-devstarts-blurb">@SpaceSails.Core.DevStarts.SectionBlurb</div>
                        <div class="save-slots-list">
                            @foreach (SpaceSails.Core.DevStarts.Entry entry in SpaceSails.Core.DevStarts.All)
                            {
                                SpaceSails.Core.DevStarts.Entry e = entry;
                                <button type="button" class="start-picker-option start-picker-devstart"
                                        title="@e.Url" @onclick="() => GoToDevStart(e)">
                                    <span class="start-picker-icon">@e.Icon</span>
                                    <span class="start-picker-text">
                                        <span class="start-picker-label">@e.Label<span class="start-picker-devtag">DEV</span></span>
                                        <span class="start-picker-blurb">@e.Blurb</span>
                                        <span class="start-picker-devurl">@e.Url</span>
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @if (!inGame)
            {
                @* THE CAPTAINS' ROSTER (owner 2026-07-19: "a list of captains in the start with gen-ai
                   profile images … then under those are their slots"). The saved voyages, grouped by
                   universe: one captain CARD per game thread — a seeded name and a portrait from the roster
                   (art/captain-N.jpg, a seeded-colour monogram disc if the image is missing) — with that
                   captain's save rows beneath it. The active captain heads the list, marked "at the helm";
                   the rest follow newest-universe-first. This is what tells two adjacent voyages apart. The
                   active captain's card also carries the whole rack's empty berths (file a rescued save in);
                   an idle captain shows only their occupied slots. Grouping is the pure Core GameThreads
                   .GroupSlots; the identity is Core Captains (seeded off the thread GUID). *@
                <div class="save-slots-label">@(_voyageGroups.Count == 0 ? "No saved voyages yet — begin a new one above." : "Saved voyages — a captain per universe")</div>
                <div class="save-captain-roster">
                    @foreach (GameThreadGroup g in _voyageGroups)
                    {
                        GameThreadGroup group = g;
                        (string CaptainName, int AvatarIndex) cap = SpaceSails.Core.Captains.For(group.Thread);
                        string? groupLatestId = group.IsActive && group.Slots.Count > 0 ? group.Slots[0].Id : null;
                        <div class="captain-card @(group.IsActive ? "captain-card-active" : "")">
                            <div class="captain-avatar" style="--mono-color:@CaptainMonoColor(group.Thread.Id)">
                                <span class="captain-mono">@CaptainInitial(cap.CaptainName)</span>
                                <img class="captain-portrait" src="art/captain-@(cap.AvatarIndex).jpg" alt="" aria-hidden="true"
                                     onerror="this.style.display='none'" />
                            </div>
                            <div class="captain-ident">
                                <span class="captain-name">@cap.CaptainName@if (group.IsActive){<span class="captain-helm">⚓ at the helm</span>}</span>
                                <span class="captain-where">@CaptainWhen(group.Thread)</span>
                                @* Evening wind #20 — the roster keeps the memory: who held this license before
                                   the piracy insurance replaced them (most recent first). *@
                                @if (group.Thread.Retired.Count > 0)
                                {
                                    <span class="captain-retired">🪦 @CaptainRetiredSummary(group.Thread)</span>
                                }
                                @* THE LEGEND LEDGER (#400): this captain's selfies — "proof I was there".
                                   Per-life (a successor inherits none). Click a thumb to throw the framed
                                   shot back up. Thumbs fall back to the caption title if the art is unpainted. *@
                                @if (group.Thread.Selfies.Count > 0)
                                {
                                    <div class="captain-selfies" title="The captain's selfies — proof they were there">
                                        <span class="captain-selfies-label">📸 @group.Thread.Selfies.Count in the legend ledger</span>
                                        <div class="captain-selfie-strip">
                                            @foreach (CapturedSelfie selfie in group.Thread.Selfies)
                                            {
                                                CapturedSelfie s = selfie;
                                                <button type="button" class="captain-selfie-thumb" title="@s.Caption"
                                                        @onclick="() => ShowSelfie(s)">
                                                    <img src="art/captain-@(s.AvatarIndex).jpg" alt="" aria-hidden="true"
                                                         onerror="this.style.display='none'" />
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="save-slots-list captain-slots">
                            @foreach (SaveSlotMeta meta in group.Slots)
                            {
                                @SlotRow((group.Thread.Id, meta.Id, meta, inGame, meta.Id == groupLatestId))
                            }
                            @* The active captain also shows the empty berths of the ten-slot rack, so a
                               rescued Downloads save can still be filed into a named berth from the door. *@
                            @if (group.IsActive)
                            {
                                @foreach (string id in AllSlotIds.Where(id => group.Slots.All(s => s.Id != id)))
                                {
                                    @SlotRow((group.Thread.Id, id, (SaveSlotMeta?)null, inGame, false))
                                }
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @* #312 — the in-game logbook: the WHOLE rack for the CURRENT universe only (one captain, the
                   one you are flying), all ten slots. Occupied berths NEWEST FIRST (row 1 is the latest, the
                   same order Continue reads), then empty berths sink to the bottom as '— empty berth —'. *@
                <div class="save-slots-label">@(_slotList.Count == 0 ? "No saved voyages yet — file a save into a berth below, or start a new voyage." : "Saved voyages — newest first")</div>
                <div class="save-slots-list">
                    @{
                        string? latestId = _slotList.Count > 0 ? _slotList[0].Id : null;
                    }
                    @foreach (SaveSlotMeta meta in _slotList)
                    {
                        @SlotRow((_activeThreadId ?? "", meta.Id, meta, inGame, meta.Id == latestId))
                    }
                    @* Empty berths at the bottom, in fixed rack order (autosave, then 1..9). *@
                    @foreach (string id in AllSlotIds.Where(id => _slotList.All(s => s.Id != id)))
                    {
                        @SlotRow((_activeThreadId ?? "", id, (SaveSlotMeta?)null, inGame, false))
                    }
                </div>
            }

            <div class="save-surface-foot">
                @if (inGame)
                {
                    <button type="button" class="btn btn-sm btn-outline-light"
                            title="Download the LIVE game right now as a .json file you keep against a server wipe"
                            @onclick="ExportVault">⬇ Export this moment</button>
                    <button type="button" class="btn btn-sm btn-outline-light"
                            title="Load a vault .json file — it becomes the live game at once (it asks before replacing your voyage)"
                            @onclick="ImportVault">⬆ Import file</button>
                    <button type="button" class="btn btn-sm btn-outline-info"
                            title="Close the logbook and return to the ship"
                            @onclick="CloseSaveDrawer">Close</button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-light"
                            title="Load a vault .json file as a new voyage"
                            @onclick="ImportVault">⬆ Import a save file</button>
                    <a class="btn btn-sm btn-outline-info" href="/"
                       title="Back to the front page — the scenario chooser and the Captain's Guide">🏠 Front page &amp; other scenarios</a>
                }
            </div>
        }
    </div>;
    }

    @if (_showStartPicker)
    {
        <div class="start-picker-backdrop">
            @SaveLoadSurface(false)
        </div>
    }
    else if (_showSaveDrawer)
    {
        <div class="start-picker-backdrop" @onclick="CloseSaveDrawer">
            <div @onclick:stopPropagation="true">
                @SaveLoadSurface(true)
            </div>
        </div>
    }

    @* #310 — the import consent: an import becomes the live game, so it asks once before replacing the
       running voyage, with a one-click "bank current first" escape. *@
    @if (_importConfirming)
    {
        <div class="start-picker-backdrop">
            <div class="start-picker save-surface">
                <div class="start-picker-title">Board this saved voyage?</div>
                @* #312: the label is read FROM THE FILE'S CONTENTS, never its name — a renamed file still
                   says what it is before the captain commits to boarding it. *@
                @if (_importPreview is { } p)
                {
                    <div class="import-preview">
                        <span class="import-preview-where">@(p.WasDocked ? "⚓ " : "🛰 ")@p.Where@(p.Tampered ? " 📛 edited outside the game" : "")</span>
                        <span class="import-preview-when">day @p.SimDay · read from the file's own contents</span>
                    </div>
                }
                else
                {
                    <div class="import-preview import-preview-unknown">The file didn't parse as a save — boarding it may do nothing.</div>
                }
                <div class="start-picker-sub">This file will become the live game at once. Your current run isn't saved to a slot yet unless you bank it. (To shelve a file WITHOUT boarding, use “📥 file” on a berth instead.)</div>
                <div class="save-surface-foot save-surface-foot-center">
                    <button type="button" class="btn btn-sm btn-outline-success"
                            title="Bank the current voyage to a free slot, THEN load the imported file"
                            @onclick="ConfirmImportBankingFirst">💾 Bank current first, then import</button>
                    <button type="button" class="btn btn-sm btn-warning"
                            title="Load the imported file now — the current run is discarded unless already saved"
                            @onclick="ConfirmImportReplace">⬆ Replace now</button>
                    <button type="button" class="btn btn-sm btn-outline-light"
                            title="Keep flying the current voyage — cancel the import"
                            @onclick="CancelImport">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* #255 — the diegetic long-haul jump overlay: the one loading bar allowed to be a FEATURE. While
       the world re-seeds at the arrival epoch, the screen SAYS the state — CROSSING THE VOID, the years
       ticking up, and a charming note that the bus does not stop out here. No cancel is offered. *@
    @if (_jumpActive)
    {
        <div class="jump-overlay">
            <div class="jump-overlay-inner">
                <div class="jump-overlay-title">🚀 @LongHaul.VoidTitle</div>
                <div class="jump-overlay-year">@LongHaul.VoidYearLine(_jumpYear, _jumpTotalYears)</div>
                <div class="jump-overlay-bar">
                    <div class="jump-overlay-fill" style="width:@(_jumpTotalYears > 0 ? (int)(100.0 * Math.Clamp(_jumpYear, 0, _jumpTotalYears) / _jumpTotalYears) : 100)%"></div>
                </div>
                <div class="jump-overlay-bound">@LongHaul.VoidBound(_jumpDestName)</div>
                <div class="jump-overlay-note">@_jumpFlavor</div>
                <div class="jump-overlay-nostop">@LongHaul.VoidNoStop</div>
            </div>
        </div>
    }

    @* #261 — the COMPUTED skip's short beat: a jump-scale coast is reckoned in closed form (or chunked with
       yields), never integrated into a frozen tab. A mundane fast-forward, not the long haul's dramatic
       CROSSING THE VOID — so it says "COAST CONSUMED" and lets out in a beat. *@
    @if (_coastSkipActive)
    {
        <div class="jump-overlay">
            <div class="jump-overlay-inner">
                <div class="jump-overlay-title">⏭ @WarpSkip.CoastConsumedTitle</div>
                <div class="jump-overlay-bound">@WarpSkip.CoastConsumedBound(_coastSkipLabel)</div>
                <div class="jump-overlay-note">@WarpSkip.CoastComputingNote(_coastSkipDays)</div>
            </div>
        </div>
    }

    @* #304 — THE ARRIVAL BRAKE ASKS (owner 2026-07-18: "it is hard to remember in the heat of the moment").
       When a long haul lands the ship hot at a destination that owes a brake, the window opens and the ship
       asks in the captain's voice, carrying the quoted bill. Fire fires it once (through the settle path);
       Hold declines and snoozes, re-raising while the window remains. Same .deck-offer-card overlay family. *@
    @if (_worldReady && !_deckMode && _brakeGate.Asking)
    {
        <div class="deck-offer-card arrival-brake-card">
            <div class="deck-offer-giver">🛬 Arrival brake — @_brakeDestName</div>
            <div class="deck-offer-blurb">@ArrivalBrakeAskText()</div>
            <div class="deck-offer-actions">
                <button type="button" class="btn btn-sm btn-warning"
                        title="Fire the arrival brake now — sheds into the clamp window through the one settle path"
                        @onclick="FireArrivalBrake">@(BrakeIsAerobrake ? "🪂 Commit the pass" : "🔥 Fire the brake")</button>
                <button type="button" class="btn btn-sm btn-outline-light"
                        title="Hold the brake — you have the ship; it'll ask again while you're still coming in hot"
                        @onclick="DeclineArrivalBrake">Hold — I'll shed by hand</button>
            </div>
        </div>
    }

    @* #488 · THE SCUTTLING PANEL. Owner: "we could have a self-destruct option in the ship, like reactor
       overload … in cases where we want to be sure." The third road: it pays NOTHING, which is the only
       reason it can mean anything. No confirmation dialog — the panel states her worth first, and the keys
       are the confirmation. *@
    @if (_showScuttlePanel && _wreck is { } scWreck)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseScuttlePanel)">
            <div class="vent-board scuttle-panel" @onclick:stopPropagation="true">
                <div class="view-object-title">☢ SCUTTLING PANEL — @scWreck.ShipName.ToUpperInvariant()</div>

                <img class="scuttle-art" src="art/scuttle-panel.jpg" alt=""
                     onerror="this.style.display='none'" />

                <div class="vent-sub">
                    @Scuttle.PriceLine(
                        scWreck.AssessedValueCr,
                        Derelict.Resolve(scWreck, Derelict.SalvageChoice.FileTheReport, scWreck.Cause).CreditsNow)
                </div>

                @if (_scuttleSecondsLeft is { } armedLeft)
                {
                    <div class="vent-message">
                        ☢ RUNNING — @HullVenting.SoakLabel(armedLeft). The way out is the way you came in.
                    </div>
                    <div class="vent-actions">
                        <button type="button" class="btn btn-outline-light btn-sm"
                                disabled="@(!Scuttle.CanAbort(armedLeft))"
                                title="@(Scuttle.CanAbort(armedLeft) ? "" : Scuttle.PastRecallLine)"
                                @onclick="AbortTheOverload">
                            🔑 Back the keys out
                        </button>
                        @if (!Scuttle.CanAbort(armedLeft))
                        {
                            <div class="vent-refusal">@Scuttle.PastRecallLine</div>
                        }
                    </div>
                }
                else
                {
                    <div class="vent-actions">
                        @foreach (Scuttle.Method m in ScuttleMethods())
                        {
                            <button type="button" class="btn btn-danger btn-sm"
                                    title="@($"Takes {Scuttle.Speed(m)}. Nobody pays you to be sure.")"
                                    @onclick="ArmTheOverload">
                                ☢ Turn both keys — reactor overload
                            </button>
                        }
                        @* The methods this hull cannot do, and WHY. A greyed control that does not say why
                           is a bug wearing a tooltip's clothes. *@
                        @foreach (Scuttle.Method m in System.Enum.GetValues<Scuttle.Method>())
                        {
                            @if (!ScuttleMethods().Contains(m))
                            {
                                <div class="vent-refusal">@Scuttle.Refusal(m, scWreck.Cause)</div>
                            }
                        }
                    </div>
                }

                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseScuttlePanel)">Step away</button>
            </div>
        </div>
    }

    @* #488 · WHAT YOU HEARD ON THE WAY OUT. Owner: "some kind of pop-up with gen AI about hearing clawing
       of horrible sounds when we went :-D … a confirmation that we did something that made a difference."
       CONFIRMATION WITHOUT REVELATION — the instrument never once said what was in there, and neither does
       this. You know there was something. You know it is not out here any more. That is all you get. *@
    @if (_scuttleEpitaph is { } epitaph)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseScuttleEpitaph)">
            <div class="vent-board scuttle-epitaph" @onclick:stopPropagation="true">
                <div class="view-object-title">☢ SHE IS GONE</div>
                <img class="scuttle-art" src="art/scuttle-she-goes.jpg" alt=""
                     onerror="this.style.display='none'" />
                <div class="scuttle-epitaph-text @(_scuttleHeardIt ? "heard" : "")">@epitaph</div>
                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseScuttleEpitaph)">
                    @(_scuttleHeardIt ? "Sit with that" : "Log it")
                </button>
            </div>
        </div>
    }

    @* #488 · THE OPERATING LOG, AS A CARD. Owner: "maybe the log should open in top most popup and the
       rest of the ui be disabled until it is closed." It is the most important sentence this mechanic
       produces — an answer that refuses to finish itself — and as a line under the switches it read like a
       status bar. It takes the screen; the board waits underneath. *@
    @if (_ventReadCard is { } readRoom && _ventReads.TryGetValue(readRoom, out var readShown))
    {
        bool alive = readShown.Sign == HullVenting.LifeSign.SomethingAlive;
        <div class="view-object-backdrop vent-read-backdrop" @onclick="() => Dismiss(CloseVentReadCard)">
            <div class="vent-board vent-read-card @(alive ? "alive" : "")" @onclick:stopPropagation="true">
                <div class="view-object-title">📟 @readRoom — OPERATING LOG</div>

                <div class="vent-read-die">d20 @readShown.Roll.Face</div>
                <div class="vent-read-line @(alive ? "alive" : "")">@HullVenting.ReadLine(readShown.Sign)</div>

                @* The rule, restated where it costs the most: at the moment the captain most wants the
                   instrument to have told them something it cannot tell them. *@
                <div class="vent-read-foot">
                    The compartment's own instruments, read back — thermal, movement, the last time a door
                    cycled. It records that something in there is warm and moving. It has never been able to
                    tell you WHAT.
                </div>

                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseVentReadCard)">
                    @(alive ? "Back to the board" : "Close the log")
                </button>
            </div>
        </div>
    }

    @* #488 · THE DOOR THAT WILL NOT MOVE. Owner, after strolling into a compartment he had just blown:
       "we need some kind of door locked due to vacuum feature … maybe a gauge that says the door is shut
       due to pressure difference." One atmosphere across a door is about ten tonnes; nobody opens that by
       hand. Two roads through it, priced differently — crack the valve and lose the ship's air for free,
       or spend a charge off the shuttle and keep it. *@
    @if (_pressureDoor is { } pdName && _ventSpaces.TryGetValue(pdName, out var pdSpace))
    {
        var pdVacuumSide = pdSpace.Vented;
        var pdLoaded = HullVenting.DoorHeldByPressure(pdSpace, _spinePressurised);
        <div class="view-object-backdrop" @onclick="() => Dismiss(ClosePressureDoorCard)">
            <div class="vent-board pressure-door" @onclick:stopPropagation="true">
                <div class="view-object-title">
                    @(pdLoaded ? $"⛔ {pdName} — THE DOOR IS LOADED" : $"🚪 {pdName} — HATCH")
                </div>

                @* The gauge. A needle hard over on its stop, which is the whole message — and slack in the
                   middle of its travel when there is nothing across the door at all. *@
                <div class="pd-gauge" role="img" aria-label="pressure differential">
                    <div class="pd-face">
                        <div class="pd-needle @(pdLoaded ? "hard-over" : "slack")"></div>
                        <div class="pd-scale"><span>0</span><span>Δp</span><span class="hot">MAX</span></div>
                    </div>
                    <div class="pd-sides">
                        <span class="@(pdVacuumSide ? "vac" : "air")">@(pdVacuumSide ? "VACUUM" : "AIR") — that side</span>
                        <span class="@(_spinePressurised ? "air" : "vac")">@(_spinePressurised ? "AIR" : "VACUUM") — this side</span>
                    </div>
                </div>

                @if (pdLoaded)
                {
                    <div class="vent-message">@HullVenting.PressureLockLine(pdName, pdVacuumSide)</div>
                    <div class="vent-actions">
                        <button type="button" class="btn btn-warning btn-sm"
                                title="@HullVenting.EqualiseWarnsLine"
                                @onclick="() => { EqualiseAtDoor(pdName); ClosePressureDoorCard(); }">
                            🎚 Crack the equalisation valve
                        </button>
                        <div class="vent-refusal">@HullVenting.EqualiseWarnsLine</div>
                        <div class="vent-refusal">
                            One valve empties the corridor and every room standing open to it. What survives is
                            whatever somebody dogged a hatch on.
                        </div>
                        <div class="vent-refusal">
                            Or keep the ship's air: bring @pdName back to pressure at the valve board aft
                            (@_refillCharges of the shuttle's breaths left).
                        </div>
                    </div>
                }
                else
                {
                    @* The hand-dogs. The counterplay to somebody cracking a valve two compartments away —
                       and the infestation will never use it, because it has not read the manual. *@
                    <div class="vent-actions">
                        <button type="button" class="btn btn-outline-light btn-sm"
                                @onclick="() => { ToggleSealAtHand(pdName); ClosePressureDoorCard(); }">
                            @(pdSpace.DoorShut ? $"🔓 Undog the {pdName} hatch" : $"🔒 Dog the {pdName} hatch down")
                        </button>
                        <div class="vent-refusal">
                            @(pdSpace.DoorShut
                                ? "Sealed. Whatever happens to the pressure in the rest of this ship happens without it — and you are not walking through it either."
                                : "Standing open. It shares the corridor's air, which means it shares whatever happens to the corridor's air.")
                        </div>
                    </div>
                }

                <button type="button" class="view-object-close" @onclick="() => Dismiss(ClosePressureDoorCard)">Step away</button>
            </div>
        </div>
    }

    @* #488 · THE VALVE BOARD — a damage-control mimic, the Battlestar Galactica shape. The ship drawn as
       her own compartments, each one a switch: shut the door, read for life, blow the room. It lives aft in
       ENGINEERING because the bridge panel is dead, so you walk toward the thing to reach the tool that
       kills it. The sensor cannot tell a survivor from the infestation — that is the whole decision. *@
    @if (_showVentPanel && _wreck is { } ventWreck)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseVentPanel)">
            <div class="vent-board" @onclick:stopPropagation="true">
                <div class="view-object-title">⚙ ATMOSPHERE CONTROL — @ventWreck.ShipName.ToUpperInvariant()</div>
                <div class="vent-sub">
                    Mechanical valves, local control. Shut a door before you blow the room behind it.
                    You are in <strong>@(CaptainCompartment() ?? "THE SPINE")</strong>.
                </div>

                @* WHAT IS HAPPENING TO YOU WHILE YOU READ THIS. Owner, after being ringed at the board:
                   "I am not sure if I got any damage from the reevers … I was earlier surrounded by them
                   when I was looking at panels :-D" — and he could not have known, because the condition
                   pips are drawn on the CANVAS and this board's backdrop covers the canvas. The sim keeps
                   running while the panel is open, so the one moment the captain is standing still with
                   their hands full is the one moment the game stopped telling them they were being hit.
                   The board carries its own set. *@
                @if (_surface is { } ventCond)
                {
                    int pipsLeft = Math.Clamp(CaptainCondition.MaxHits - ventCond.HitsTaken, 0, CaptainCondition.MaxHits);
                    <div class="vent-condition @(pipsLeft <= 1 ? "critical" : "")">
                        <span class="vent-condition-label">CONDITION</span>
                        @for (int i = 0; i < CaptainCondition.MaxHits; i++)
                        {
                            <span class="@(i < pipsLeft ? "cond-pip" : "cond-pip spent")"></span>
                        }
                        <span class="vent-condition-word">@CaptainCondition.Readout(ventCond.HitsTaken)</span>
                    </div>
                }

                @* THE SHIP HERSELF, drawn from WreckLayout's own geometry — bow taper, transom, spine and
                   every compartment in its real place and proportion. Owner: "the vent panel should have a
                   miniature map of the ship as UI with buttons clearly showing which part of the ship
                   (visually) they correspond to … so if you don't remember the name of the room you still
                   know to vent the right place." You point at the PLACE; the name is written in it.
                   Coordinates are deck units with Y negated (SVG y runs down, decks run up), so a
                   compartment on this map is where it is on the deck by construction. *@
                @* Every number here goes through Du(): Blazor renders a float attribute in the CURRENT
                   culture, and on a Finnish browser "20.5" becomes "20,5" — which an SVG coordinate reads as
                   two numbers. The map would come apart for the owner and nobody else. *@
                <svg class="vent-map" viewBox="@VentViewBox" preserveAspectRatio="xMidYMid meet"
                     role="group" aria-label="ship compartments">
                    <polygon class="vent-hull" points="@VentHullOutline" />
                    @* THE CORRIDOR IS A PART OF THE SHIP YOU TOUCH. Owner, looking for it: "why can I not
                       pump the spine? … oh it has its own button instead of just selecting it from map?"
                       Exactly — and that was the whole complaint. Every compartment on this board is
                       chosen by putting a finger on it, and the corridor alone had a switch bolted to the
                       side of the panel, which is why it read as unavailable rather than unselected. It is
                       a volume on the mimic; it answers to the mimic. *@
                    @{
                        string spineCls = "vent-area spine"
                            + (_ventSelected == HullVenting.SpineName ? " picked" : "")
                            + (_spinePressurised ? "" : " vented")
                            + (CaptainCompartment() is null ? " here" : "");
                    }
                    <g class="@spineCls" @onclick="() => SelectVentSpace(HullVenting.SpineName)">
                        <rect class="vent-spine-band"
                              x="@Du(WreckLayout.AftX)" y="@Du(-WreckLayout.SpineHalfHeight)"
                              width="@Du(WreckLayout.BowX - 6 - WreckLayout.AftX)"
                              height="@Du(WreckLayout.SpineHalfHeight * 2)" rx="0.4" />
                    </g>

                    @foreach ((string name, float x0, float x1, bool top) in WreckLayout.Compartments)
                    {
                        HullVenting.Space space = SpaceNow(name);
                        string cls = "vent-area"
                            + (space.Vented ? " vented" : "")
                            + (space.DoorShut ? " sealed" : "")
                            + (space.CaptainInside ? " here" : "")
                            + (_ventSelected == name ? " picked" : "");
                        @* A TOP compartment sits at deck y −9…−3; SVG y runs down, so it draws at +3…+9.
                           The row you see above the spine on the deck is the row above it here. *@
                        float y = top ? WreckLayout.SpineHalfHeight : -WreckLayout.BottomY;
                        float cx = (x0 + x1) / 2f;
                        float cy = top ? 6.2f : -5.8f;

                        @* Razor reserves <text> as a control-flow tag, so the SVG labels are emitted as
                           markup. Everything else stays real elements. *@
                        <g class="@cls" @onclick="() => SelectVentSpace(name)">
                            <rect x="@Du(x0)" y="@Du(y)" width="@Du(x1 - x0)"
                                  height="@Du(WreckLayout.BottomY - WreckLayout.SpineHalfHeight)" rx="0.4" />
                            @((MarkupString)VentAreaLabelSvg(name, cx, cy, x1 - x0, VentAreaTag(name, space, x1 - x0),
                                                             WreckLayout.BottomY - WreckLayout.SpineHalfHeight))
                            @* The door onto the spine, at the doorway the captain actually walks through:
                               solid when sealed, broken when open. *@
                            <line class="vent-door"
                                  x1="@Du(VentDoorX(x0, x1) - WreckLayout.DoorHalfWidth)"
                                  x2="@Du(VentDoorX(x0, x1) + WreckLayout.DoorHalfWidth)"
                                  y1="@Du(top ? WreckLayout.SpineHalfHeight : -WreckLayout.SpineHalfHeight)"
                                  y2="@Du(top ? WreckLayout.SpineHalfHeight : -WreckLayout.SpineHalfHeight)" />
                        </g>
                    }

                    <text class="vent-spine-label" x="-4" y="0.7" text-anchor="middle">THE SPINE</text>
                    @* And her clock, in the same place a compartment carries one. Owner: "the spine should
                       also show the vacuum time etc." *@
                    <text class="@SpineTag().Class" x="-4" y="2.5" text-anchor="middle">@SpineTag().Text</text>
                </svg>

                @* The corridor is a volume too. Owner: "I would like to pump the spine also" — and it is
                   the end of his own play: dog every hatch, empty every room, then take the spine. Unlike
                   cracking a valve, this puts the corridor's air in the TANKS.

                   Its switches live in the SAME sub-panel the rooms use, under the same heading, because
                   it is the same kind of thing. There is no valve here: you cannot blow a corridor to
                   space from inside it, and there is no door onto itself to dog. What it has is a pump. *@
                @if (_ventSelected == HullVenting.SpineName)
                {
                    <div class="vent-actions">
                        <div class="vent-picked">@HullVenting.SpineName</div>
                        @* The corridor's own reading, spelled out the way a compartment's is. It counts UP
                           and never says how long is enough — the same rule the rooms live under. *@
                        <div class="vent-readout">
                            @if (!_spinePressurised && _spineVacuumSeconds < YearsOfVacuumSeconds)
                            {
                                @($"🌡 Open to space for {HullVenting.SoakLabel(_spineVacuumSeconds)}. Anything walking it is on borrowed time — and so are you.")
                            }
                            else if (!_spinePressurised)
                            {
                                @("🌡 Hard vacuum, and it has been for decades. Nothing that was walking her is walking her now.")
                            }
                            else
                            {
                                @($"🌡 Pressurised — her own stale air, {_refillCharges} charge{(_refillCharges == 1 ? "" : "s")} in the shuttle's tanks.")
                            }
                        </div>
                        @* THE REFLEX. Owner: "lock all doors would be nice also :-D … for that heat of the
                           moment feel … a kind of rescue thing to do to contain any leaks … and oxygen from
                           going to feed the fire." First in the row because that is the order you reach for
                           them in when something has already gone wrong. *@
                        <button type="button" class="btn btn-outline-warning btn-sm"
                                title="Dog every hatch that will still move. Contains a leak, starves a fire, and shortens the corridor."
                                @onclick="SealTheShip">
                            🔒 Seal the ship
                        </button>
                        @* And the way back out. Owner: "I want to unlock all the doors after the ship is in
                           vacuum" — because the pump SEALS her to work, so the reward for emptying her is a
                           maze of eight dogged hatches. At uniform vacuum nothing is holding any of them. *@
                        <button type="button" class="btn btn-outline-light btn-sm"
                                title="Undog every hatch the pressure is not holding. At uniform vacuum that is all of them — and it is what lets the flood reach every room."
                                @onclick="UnsealTheShip">
                            🔓 Open every hatch
                        </button>
                        @* THE FLOOD. Owner: "we should be able to refill the whole ship since it is in
                           vacuum without closing doors?" — one volume, one pressure, one valve, backwards.
                           Only ever affordable out of air the PUMP banked. *@
                        @if (!_spinePressurised)
                        {
                            <button type="button" class="btn btn-outline-success btn-sm"
                                    disabled="@(_refillCharges < FloodCost())"
                                    title="@(_refillCharges < FloodCost()
                                             ? HullVenting.WholeShipRefillRefusal(FloodCost(), _refillCharges)
                                             : "Open the reserve wide. The corridor and everything standing open to it come back together — dogged hatches stay dead.")"
                                    @onclick="FloodTheShip">
                                🌬 Flood the ship (@FloodCost())
                            </button>
                        }
                        @if (PumpOn(HullVenting.SpineName) is { } spinePump)
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm"
                                    @onclick="() => StopPump(HullVenting.SpineName)">
                                🛢 Stop the corridor pump — @HullVenting.SoakLabel(spinePump.SecondsLeft)
                            </button>
                        }
                        else if (!_spinePressurised)
                        {
                            <div class="vent-refusal">Hard vacuum, from the transom to the lock.</div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-info btn-sm"
                                    disabled="@(!SpinePumpable)"
                                    title="@(SpinePumpable
                                             ? "Put the corridor itself on the pumps. Slower than a room, and worth more."
                                             : HullVenting.SpineNotSealedLine)"
                                    @onclick="StartSpinePump">
                                🛢 Pump the corridor
                            </button>
                            @* THE WHOLE SHIP, AS ONE ORDER. Owner: "there could be a pump the whole ship
                               button though :-D" — and it is more than the other two pressed in turn,
                               because the corridor cannot go on the pumps until every hatch is dogged.
                               This dogs them, starts them, and holds the order for the spine. *@
                            <button type="button" class="btn btn-outline-info btn-sm"
                                    disabled="@(PumpableRooms().Count == 0 && !SpinePumpable)"
                                    title="The whole sequence in one press: dog every hatch that will move, put every compartment on its own pump, and take the corridor as soon as it can. Sealing first is faster — eight small pumps run at once."
                                    @onclick="OrderWholeShipPumped">
                                🔒🛢 Seal her, then pump everything
                            </button>
                            @if (_shipPumpOrder)
                            {
                                <div class="vent-readout">
                                    ⏳ The corridor is on the order — she goes on the pumps as the last hatch seals.
                                </div>
                            }
                        }
                    </div>
                }
                else if (_ventSelected is { } picked)
                {
                    var sel = SpaceNow(picked);
                    var readiness = HullVenting.Readiness(sel);
                    <div class="vent-actions">
                        <div class="vent-picked">@picked</div>
                        @* A door moves unless the PRESSURE is holding it. It used to refuse on any vented
                           compartment, which made a blown room impossible to refill — refilling needs the
                           hatch dogged, and the hatch could never be dogged again. *@
                        <button type="button" class="btn btn-outline-light btn-sm"
                                disabled="@HullVenting.DoorHeldByPressure(sel, _spinePressurised)"
                                title="@(HullVenting.DoorHeldByPressure(sel, _spinePressurised)
                                         ? HullVenting.PressureLockLine(picked, sel.Vented) : "")"
                                @onclick="() => ToggleVentDoor(picked)">
                            @(sel.DoorShut ? "🔓 Open the door" : "🔒 Shut the door")
                        </button>
                        @* Not a radar ping — the compartment's OWN instruments, read back. That framing fits
                           a forty-year-dead ship far better than a live scan, and it makes the result feel
                           like evidence rather than a sensor toy. The detail lives in the hover; the button
                           just names the act. *@
                        @* Readable on a VENTED room too, and that is the point: the vacuum takes time, so
                           "is it finished yet" is the question the instrument exists to half-answer. It was
                           disabled here from back when the handle killed instantly. One reading per STATE —
                           opening a compartment to space is a real change and earns a fresh look, which is
                           not the same as re-rolling until it says something comfortable. *@
                        <button type="button" class="btn btn-outline-light btn-sm"
                                title="@HullVenting.OperatingLogHint"
                                @onclick="() => ReadLifeSigns(picked)">
                            📟 Operating log
                        </button>
                        <button type="button" class="btn btn-danger btn-sm"
                                disabled="@(readiness != HullVenting.VentReadiness.Ready)"
                                title="@(readiness == HullVenting.VentReadiness.Ready ? "Blow it to space" : HullVenting.RefusalLine(readiness, picked))"
                                @onclick="() => VentCompartment(picked)">
                            💨 BLOW @picked
                        </button>
                        @* THE THRIFTY ROAD. Blowing a room throws its air away and you buy it back a breath
                           at a time; pumping it down puts that air in the tanks. The mechanical stage banks
                           the charge early, and the long tail after it only buys you a killing pressure. *@
                        @if (PumpOn(picked) is { } running)
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm" @onclick="() => StopPump(picked)">
                                @(running.RoughBanked ? "🛢 Stop — take the air and go" : "🛢 Stop the pump")
                            </button>
                        }
                        else
                        {
                            @* THE BUTTON NAMES WHAT IT WILL EMPTY. Owner, after the volume rewrite: "the
                               button names might not be so descriptive to our latest vacuum tech :-D" — and
                               they were not. "Pump down" was written when a pump emptied one room; it now
                               empties an atmosphere, and the label is the last place still saying otherwise.
                               So it counts the spaces it is plumbed into, and hovering lists them. *@
                            var pumpVolume = AtmosphereAt(picked);
                            <button type="button" class="btn btn-outline-info btn-sm"
                                    disabled="@(readiness != HullVenting.VentReadiness.Ready)"
                                    title="@(pumpVolume.Count > 1
                                             ? $"One atmosphere, {pumpVolume.Count} spaces: {string.Join(", ", pumpVolume)}. They are standing open to each other, so they empty together."
                                             : "Slower than the handle, and it keeps the air: the mechanical stage banks a charge, the long tail brings it down to a pressure that kills. Several pumps can run at once.")"
                                    @onclick="() => StartPumpDown(picked)">
                                @(pumpVolume.Count > 1 ? $"🛢 Pump this volume ({pumpVolume.Count} spaces)" : "🛢 Pump down")
                            </button>
                        }
                        @* MULTI-SELECT, because the owner immediately found the play the moment one pump
                           stopped blocking another: "run to the control room and lock all doors and pump
                           them down :-D". That is the board being used as a board, so it gets one press. *@
                        @if (PumpableRooms().Count > 1)
                        {
                            <button type="button" class="btn btn-outline-info btn-sm"
                                    title="Put every compartment that still holds air on a pump. Anything standing open to anything else empties as one volume."
                                    @onclick="PumpEverySealedRoom">
                                🛢🛢 Pump every compartment (@PumpableRooms().Count)
                            </button>
                        }

                        @* The other half of the board. Air comes back; nothing that went out with it does. *@
                        @{
                            var refill = HullVenting.RefillState(sel, _refillCharges);
                        }
                        <button type="button" class="btn btn-outline-info btn-sm"
                                disabled="@(refill != HullVenting.RefillReadiness.Ready)"
                                title="@(refill == HullVenting.RefillReadiness.Ready
                                         ? "Spend one of the shuttle's breaths on this compartment. Whatever went out with the air stays out."
                                         : HullVenting.RefillRefusalLine(refill, picked))"
                                @onclick="() => RefillCompartment(picked)">
                            🫁 Refill (@_refillCharges)
                        </button>
                        @if (sel is { HoldsSurvivor: true, Vented: false } && CaptainCompartment() == picked)
                        {
                            <button type="button" class="btn btn-success btn-sm" @onclick="() => RescueSurvivor(picked)">
                                🧑‍🚀 Get them out
                            </button>
                        }
                        @* Only nag while the handle is still worth pulling. After a successful vent the
                           room reads "already open to space", which under the line that just told you the
                           nest went out with the air is noise pretending to be a warning. *@
                        @if (readiness != HullVenting.VentReadiness.Ready && string.IsNullOrEmpty(_ventMessage))
                        {
                            <div class="vent-refusal">@HullVenting.RefusalLine(readiness, picked)</div>
                        }
                    </div>
                }

                @* A board that opens with nothing but "Step away" reads as broken (owner: "the vent panel
                   only shows step away button in start … after I select a space from it the other buttons
                   appear"). The switches belong to a ROOM, so until one is picked the panel says so. *@
                @if (_ventSelected is null)
                {
                    <div class="vent-pick-hint">▲ Pick a compartment on the map — the switches belong to a room.</div>
                }

                @* THE LOG, IN ONE PLACE. The instrument reading used to render ABOVE the switches and the
                   outcome BELOW them, so the panel's two log lines sat on opposite sides of the button row
                   and one of them read as hidden behind the keys (owner: "there is only one line of log
                   visible … now one line is behind keys when there should be two lines"). A board's log is
                   one thing: what the instrument said, and what the handle did, in the order they happened. *@
                @{
                    bool hasRead = _ventSelected is { } lr && _ventReads.ContainsKey(lr);
                    bool hasMsg = !string.IsNullOrEmpty(_ventMessage);
                }
                @* Only drawn when it has something to say — an empty bordered strip is furniture. *@
                @if (hasRead || hasMsg)
                {
                    <div class="vent-log">
                        @if (_ventSelected is { } logRoom && _ventReads.TryGetValue(logRoom, out var logRead))
                        {
                            <div class="vent-readout @(logRead.Sign == HullVenting.LifeSign.SomethingAlive ? "alive" : "")">
                                📟 @logRoom — d20 @logRead.Roll.Face · @HullVenting.ReadLine(logRead.Sign)
                            </div>
                        }
                        @if (_ventMessage is { Length: > 0 } ventMsg)
                        {
                            <div class="vent-message">@ventMsg</div>
                        }
                        @* THE LOG SHE IS STILL KEEPING. Owner: "the operation log should get our new
                           operational entries logged into it." The captain reads this ship's log to work
                           out what her crew did, then does forty minutes of stranger things to her that
                           nothing recorded. Newest at the top, because the newest is what you came to
                           read — and because the panel could only ever show ONE line, so anything that
                           happened while you were looking elsewhere used to be gone before you saw it. *@
                        @if (_ventLog.Count > 0)
                        {
                            <div class="vent-history">
                                <div class="vent-history-head">OPERATING LOG — THIS BOARDING</div>
                                @for (int i = _ventLog.Count - 1; i >= 0; i--)
                                {
                                    <div class="vent-history-line">@_ventLog[i]</div>
                                }
                            </div>
                        }
                    </div>
                }

                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseVentPanel)">Step away</button>
            </div>
        </div>
    }

    @* THE ARCHIVE NODE — what the thing in the hold gave back. See docs/features/the-archive-node.md.

       House rules this card keeps, and they are the whole feature:
         · The image is the EVIDENCE, never the conclusion. There is no caption telling you what the
           handlers are; the game does not know either.
         · The arithmetic is VISIBLE. A bad result is only bearable when you can read exactly why it went
           that way, so the modifier stack is printed rather than hidden.
         · The COLLAR line only appears on the bands that got close enough to read it. Knowing whose
           pattern is in the spar is bought with a bad throw, never given with a good one.
         · Nothing here explains anything. It never confirms what Nebula keeps, and it never says a word
           about the Old Ones. *@
    @if (_archiveCard is { } vision)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseArchiveCard)">
            <div class="view-object archive-vision" @onclick:stopPropagation="true">
                <div class="view-object-title">@vision.Title</div>
                <img class="view-object-img" src="@vision.Art" alt="@vision.Title" onerror="this.style.display='none'" />
                <div class="archive-band">@vision.BandLine</div>
                <div class="view-object-caption">@vision.Lore</div>
                @if (vision.Collar is { Length: > 0 } collar)
                {
                    <div class="archive-collar">@collar</div>
                }
                <div class="archive-dice">🎲 @vision.Dice</div>
                <button type="button" class="view-object-close" title="Get your eyes off it"
                        @onclick="() => Dismiss(CloseArchiveCard)">Get your eyes off it</button>
            </div>
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════════════════════════════════════
       HER OWN ATMOSPHERE BOARD. Owner: "I think our ship should also have these controls. They are so cool
       and it would be consistent in the universe", then "our venting must have captains ok mechanism in it,
       like firing a shot or looting", and "there must be controls to do so on the bridge, but the bridge
       position needs captains ok to vent".

       The SAME panel as a derelict's, deliberately — one board, learned once, and the safest ship in the game
       is the tutorial for the most dangerous one. What is different is the gate in front of the irreversible
       half (the captain's word, by name), the fact that her board can say what is in the room, and that her
       repeater actually has a bus behind it.
       ═══════════════════════════════════════════════════════════════════════════════════════════════════ *@
    @if (_showShipBoard)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseShipBoard)">
            <div class="vent-board" @onclick:stopPropagation="true">
                <div class="view-object-title">⚙ ATMOSPHERE CONTROL — HER OWN HULL</div>
                <div class="vent-sub">
                    @ShipBreathingLine()
                    You are in <strong>@(ShipCompartment() ?? ShipLayout.SpineName)</strong>.
                </div>
                <div class="vent-readout">@ShipAtmosphere.ReserveLine(_shipReserve)</div>

                @* Her deck, from ShipLayout's own rectangles — the same numbers her walls are built from, so a
                   compartment on this map is where it is on the deck by construction. Y is negated because SVG
                   y runs down and decks run up. Every number goes through Du(): a Finnish browser renders 20.5
                   as "20,5" and SVG reads that as two coordinates — it would come apart for the owner and for
                   nobody else. *@
                <svg class="vent-map" viewBox="@ShipViewBox" preserveAspectRatio="xMidYMid meet"
                     role="group" aria-label="her compartments">
                    <polygon class="vent-hull" points="@ShipHullOutline" />

                    @* THE CORRIDOR IS A PART OF THE SHIP YOU TOUCH — the wreck board's hard-won lesson (owner:
                       "why can I not pump the spine? … oh it has its own button instead of just selecting it
                       from map?"). It is a volume on the mimic, so it answers to the mimic. *@
                    @{
                        string shipCorridorCls = "vent-area spine"
                            + (_shipSelected == ShipLayout.SpineName ? " picked" : "")
                            + (ShipCompartment() is null ? " here" : "");
                    }
                    <g class="@shipCorridorCls" @onclick="() => SelectShipSpace(ShipLayout.SpineName)">
                        @((MarkupString)ShipCorridorTagSvg())
                        <rect class="vent-spine-band"
                              x="@Du(ShipLayout.EngineBulkheadX)" y="@Du(-ShipLayout.SpineHalfHeight)"
                              width="@Du(ShipLayout.BridgeBulkheadX - ShipLayout.EngineBulkheadX)"
                              height="@Du(ShipLayout.SpineHalfHeight * 2)" rx="0.4" />
                    </g>

                    @foreach (ShipLayout.Room shipRoom in ShipLayout.Rooms)
                    {
                        HullVenting.Space shipSpace = ShipSpaceNow(shipRoom.Name);
                        string shipCls = "vent-area"
                            + (shipSpace.Vented ? " vented" : "")
                            + (shipSpace.DoorShut ? " sealed" : "")
                            + (shipSpace.CaptainInside ? " here" : "")
                            + (_shipSelected == shipRoom.Name ? " picked" : "");
                        float shipCx = (shipRoom.X0 + shipRoom.X1) / 2f;
                        float shipCy = -(shipRoom.Y0 + shipRoom.Y1) / 2f;
                        (float dsx1, float dsy1, float dsx2, float dsy2) = ShipLayout.DoorSegment(shipRoom);

                        <g class="@shipCls" @onclick="() => SelectShipSpace(shipRoom.Name)">
                            <rect x="@Du(shipRoom.X0)" y="@Du(-shipRoom.Y1)"
                                  width="@Du(shipRoom.X1 - shipRoom.X0)"
                                  height="@Du(shipRoom.Y1 - shipRoom.Y0)" rx="0.4" />
                            @* Her berths are 3.5 du wide and 7 tall, so their names go SIDEWAYS rather than
                               across — the owner's own read of the first board: "the cabins map here could use
                               font rotation to fit the texts?" The helper decides; it is handed the room's
                               height so that it can. *@
                            @((MarkupString)VentAreaLabelSvg(
                                shipRoom.Name, shipCx, shipCy, shipRoom.X1 - shipRoom.X0,
                                ShipAreaTag(shipRoom.Name), shipRoom.Y1 - shipRoom.Y0))
                            @* Her hatch, at the doorway the captain actually walks through: solid when shut,
                               broken when open. ONE definition (ShipLayout.DoorSegment), read both by the thing
                               that draws it and the thing that walks into it. *@
                            <line class="vent-door"
                                  x1="@Du(dsx1)" x2="@Du(dsx2)" y1="@Du(-dsy1)" y2="@Du(-dsy2)" />
                        </g>
                    }
                </svg>

                @if (_shipSelected == ShipLayout.SpineName)
                {
                    <div class="vent-actions">
                        <div class="vent-picked">@ShipLayout.SpineName</div>
                        <div class="vent-readout">
                            🌡 Her corridor, and every hatch aboard opens onto it. There is no valve here: you
                            cannot open the volume you are standing in to space, and there is no door onto
                            itself to dog.
                        </div>
                        <div class="vent-readout">@ShipLayout.VestibuleIsNotACompartment</div>
                        <button type="button" class="btn btn-outline-warning btn-sm"
                                title="Dog every hatch the pressure is not already holding. The reflex, for a fire or a leak."
                                @onclick="SealHerUp">
                            🔒 Seal her up
                        </button>
                        <button type="button" class="btn btn-outline-light btn-sm"
                                title="Undog every hatch the pressure is not holding."
                                @onclick="UnsealHer">
                            🔓 Open her up again
                        </button>
                    </div>
                }
                else if (_shipSelected is { } shipPicked)
                {
                    var shipSel = ShipSpaceNow(shipPicked);
                    var shipReadiness = HullVenting.Readiness(shipSel);
                    var shipAuthority = ShipAuthorityNow();
                    var shipIntent = shipAuthority == ShipAuthority.VentAuthority.None
                        ? (_shipSelected is null
                            ? ShipAuthority.VentIntent.NothingSelected
                            : ShipAuthority.VentIntent.Opportunity)
                        : ShipAuthority.VentIntent.Authorized;
                    var shipRefill = HullVenting.RefillState(shipSel, _shipReserve);
                    bool shipHeld = HullVenting.DoorHeldByPressure(shipSel, ShipCorridorPressurised);

                    <div class="vent-actions">
                        <div class="vent-picked">@shipPicked</div>

                        @* WHAT IS IN THERE — the sentence a derelict's board cannot say. Hers can, because the
                           crew are aboard and the manifest knows where they sleep, and that is exactly why the
                           act needs a name attached to it. *@
                        <div class="vent-readout">@ShipAtmosphere.WhatIsInThere(shipPicked)</div>

                        @* Isolation: the everyday half, and it asks nobody. Owner: "we might want to isolate
                           cabins to keep our disease etc." *@
                        <button type="button" class="btn btn-outline-light btn-sm"
                                disabled="@shipHeld"
                                title="@(shipHeld ? HullVenting.PressureLockLine(shipPicked, shipSel.Vented)
                                                  : ShipAtmosphere.IsolationNeedsNobody)"
                                @onclick="() => ToggleShipDoor(shipPicked, false)">
                            @(shipSel.DoorShut ? "🔓 Undog the hatch" : "🔒 Dog the hatch")
                        </button>

                        @* THE GATE. Not a confirmation dialogue: the word carries the room's NAME, so changing
                           the selection revokes it — the same promise the boarding authorization makes, for the
                           same reason (proximity is never consent).

                           BOTH STEPS ARE ALWAYS DRAWN, greyed with their reason on them. The first cut hid
                           them until the act was legal, and the owner — standing at his own bridge repeater
                           with the hold selected — had to ask "how do I vent the cargo hold here?" There was
                           nothing on the panel to tell him: the refusal line said "shut the door before you
                           pull THIS" while `this` was not on screen to be pulled. A control you cannot press
                           teaches the sequence; a control that is absent teaches nothing. *@
                        @* Under a standing order there is no single word to withdraw — the authority was given
                           at the desk and is taken back there. Saying so beats a button that would lie about
                           what it does. (Owner's arrangement: "like we have the fire at will checkbox".) *@
                        @if (shipAuthority is ShipAuthority.VentAuthority.StandingOrder
                                                or ShipAuthority.VentAuthority.NextActionCleared)
                        {
                            @* WHICH authority is answering, named. A delegated or pre-cleared act must never
                               read like one the captain stood here and ordered. *@
                            <span class="text-warning small">
                                ⚓ Acting @ShipAuthority.UnderAuthority(shipAuthority).
                                @(shipAuthority == ShipAuthority.VentAuthority.NextActionCleared
                                    ? "This clearance is spent by the next act." : "")
                            </span>
                        }
                        else if (shipIntent == ShipAuthority.VentIntent.Authorized)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    title="Take it back. Nothing has happened yet."
                                    @onclick="WithdrawTheCaptainsWord">
                                ↩ Withdraw the word
                            </button>
                        }
                        else if (shipAuthority == ShipAuthority.VentAuthority.None)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm"
                                    disabled="@(shipReadiness != HullVenting.VentReadiness.Ready)"
                                    title="@(shipReadiness == HullVenting.VentReadiness.Ready
                                             ? ShipAuthority.WhyItNeedsSaying
                                             : HullVenting.RefusalLine(shipReadiness, shipPicked))"
                                    @onclick="() => GiveTheCaptainsWord(shipPicked)">
                                🔑 Captain's word: @shipPicked
                            </button>
                        }
                        @* TWO ROADS TO AN EMPTY ROOM, and the owner named both: "one by venting to space in an
                           emergency hurry and another where we more slowly pump it into our stores with rough
                           vacuum pumps and it is kept in the ship." Same word gates both, because both end in
                           a compartment of your own ship at vacuum. *@
                        <button type="button" class="btn btn-danger btn-sm"
                                disabled="@(shipIntent != ShipAuthority.VentIntent.Authorized
                                            || shipReadiness != HullVenting.VentReadiness.Ready)"
                                title="@(shipReadiness != HullVenting.VentReadiness.Ready
                                         ? HullVenting.RefusalLine(shipReadiness, shipPicked)
                                         : shipIntent != ShipAuthority.VentIntent.Authorized
                                             ? ShipAuthority.AskFor(shipPicked)
                                             : "Instant, and the air is GONE — the emergency road. "
                                               + ShipAtmosphere.TheSuitsBesideTheBunks)"
                                @onclick="() => VentShipCompartment(shipPicked)">
                            💨 OPEN @shipPicked TO SPACE
                        </button>
                        @if (ShipPumpOn(shipPicked) is { } shipRunning)
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm"
                                    title="@(shipRunning.RoughBanked
                                             ? "The fill is already in her tanks. Stopping now leaves the room breathable."
                                             : "Stop before the mark and the air stays in the room — none of it reaches the tanks.")"
                                    @onclick="() => StopShipPump(shipPicked)">
                                @(shipRunning.RoughBanked ? "🛢 Stop — take the air and go" : "🛢 Stop the pump")
                            </button>
                        }
                        else
                        {
                            var shipVolume = HullVenting.SharedAtmosphere(
                                shipPicked, ShipSpacesNow(), ShipLayout.SpineName);
                            <button type="button" class="btn btn-outline-info btn-sm"
                                    disabled="@(shipIntent != ShipAuthority.VentIntent.Authorized
                                                || shipReadiness != HullVenting.VentReadiness.Ready)"
                                    title="@(shipReadiness != HullVenting.VentReadiness.Ready
                                             ? HullVenting.RefusalLine(shipReadiness, shipPicked)
                                             : shipIntent != ShipAuthority.VentIntent.Authorized
                                                 ? ShipAuthority.AskFor(shipPicked)
                                                 : shipVolume.Count > 1
                                                     ? $"One atmosphere, {shipVolume.Count} spaces: {string.Join(", ", shipVolume)}. They stand open to each other, so they empty together."
                                                     : "Slower than the handle, and the air is KEPT: the mechanical stage banks a fill into her tanks, the long tail brings it down to a pressure that kills.")"
                                    @onclick="() => StartShipPump(shipPicked)">
                                @(shipVolume.Count > 1
                                    ? $"🛢 Pump this volume into her tanks ({shipVolume.Count} spaces)"
                                    : "🛢 Pump it into her tanks")
                            </button>
                        }

                        <button type="button" class="btn btn-outline-info btn-sm"
                                disabled="@(shipRefill != HullVenting.RefillReadiness.Ready)"
                                title="@(shipRefill == HullVenting.RefillReadiness.Ready
                                         ? "Spend one fill from her own tanks. Whatever went out with the air stays out."
                                         : HullVenting.RefillRefusalLine(shipRefill, shipPicked))"
                                @onclick="() => RefillShipCompartment(shipPicked)">
                            🫁 Put the air back (@_shipReserve)
                        </button>

                        @if (shipReadiness != HullVenting.VentReadiness.Ready
                             && string.IsNullOrEmpty(_shipBoardMessage))
                        {
                            <div class="vent-refusal">@HullVenting.RefusalLine(shipReadiness, shipPicked)</div>
                        }
                    </div>
                }

                @* A board that opens with nothing but "Step away" reads as broken — the wreck's panel taught
                   that (owner: "the vent panel only shows step away button in start"). The switches belong to a
                   ROOM, so until one is picked the panel says so. *@
                @if (_shipSelected is null)
                {
                    <div class="vent-pick-hint">▲ Pick a compartment on the map — the switches belong to a room.</div>
                }

                @if (_shipBoardMessage is { Length: > 0 } shipBoardMsg)
                {
                    <div class="vent-message">@shipBoardMsg</div>
                }

                @* HER BOARD'S OWN LOG, like a derelict's. A panel can only ever show one line, so anything that
                   happened while the captain was looking elsewhere — a pump banking, a hatch that would not
                   move — was gone before it could be read. Newest at the top, because the newest is what you
                   came to read. *@
                @if (_shipBoardLog.Count > 0)
                {
                    <div class="vent-history">
                        <div class="vent-history-head">OPERATING LOG — HER OWN BOARD</div>
                        @for (int i = _shipBoardLog.Count - 1; i >= 0; i--)
                        {
                            <div class="vent-history-line">@_shipBoardLog[i]</div>
                        }
                    </div>
                }

                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseShipBoard)">Step away</button>
            </div>
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════════════════════════════════════
       #523 · THE CHARGE BOARD, aft with the machinery. Owner: "I like you make a PR about how spaceships manage
       their electric charge build up and make us a panel about it into the rear of the ship … Now that desk is
       kind of lame on the ship, so let's add some kind of on automatic there."

       The mechanic was live and invisible: a charged hull is SEEN THREE TIMES AS FAR (SensorModel
       .ChargeGlowFactor), and the only instrument that ever mentioned it halved the number and told you about a
       cat. The dump stays — the joke is good and the act is real — and the board grows around it.
       ═══════════════════════════════════════════════════════════════════════════════════════════════════ *@
    @if (_showChargeBoard)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseChargeBoard)">
            <div class="vent-board" @onclick:stopPropagation="true">
                <div class="view-object-title">⚡ HULL CHARGE — HER OWN POTENTIAL</div>

                @if (_plasma is null)
                {
                    <div class="vent-sub">
                        Nothing out here charges her: this voyage runs without the plasma layer, so the board is
                        a row of dead needles and the dump is a party trick.
                    </div>
                }
                else
                {
                    double hullNow = HullChargeNow();
                    double ambientNow = AmbientChargeNow();
                    HullCharge.Band band = HullCharge.BandOf(hullNow);
                    <div class="vent-sub">
                        HULL: <strong>@HullCharge.BandWord(band)</strong> ·
                        holding @((hullNow * 100).ToString("0", CultureInfo.InvariantCulture))% of what this
                        space could put on her
                    </div>
                    <div class="vent-readout">@HullCharge.DrivenByLine(ambientNow)</div>
                    <div class="vent-readout @(band >= HullCharge.Band.Glowing ? "alive" : "")">
                        @HullCharge.VisibilityLine(hullNow)
                    </div>
                    @if (band == HullCharge.Band.Arcing)
                    {
                        <div class="vent-refusal">
                            ⚡ She is arcing across herself. Everything with a telescope has already noticed.
                        </div>
                    }

                    <div class="vent-actions">
                        @* THE AUTOMATIC — the owner's ask, and a real device: a hollow-cathode plasma contactor,
                           two of which fly on the ISS for exactly this reason. It costs expellant while it runs,
                           which is what keeps it a decision. *@
                        <button type="button"
                                class="btn btn-sm @(_contactorOn ? "btn-success" : "btn-outline-success")"
                                title="@(_contactorOn ? HullCharge.ContactorOnLine : HullCharge.ContactorOffLine)"
                                @onclick="ToggleContactor">
                            @(_contactorOn ? "🜁 CONTACTOR RUNNING — click to secure" : "🜁 Run the contactor (automatic)")
                        </button>
                        @* LAB 43: inside a stream the plasma delivers more current than the cathode can emit, so
                           the automatic can only take the edge off. Ride the river or go unheard, never both. *@
                        @if (_contactorOn && !HullCharge.ContactorWinsHere(ambientNow))
                        {
                            <span class="text-warning small">🜁 outmatched here — she will sit high while you ride the stream</span>
                        }

                        @* And the switch that was the whole console: dump the hull to space. Instant, free, and
                           it does not touch what has soaked into the boards. *@
                        <button type="button" class="btn btn-outline-info btn-sm"
                                title="Dump the hull charge to space now — instant, free, and it will start climbing again immediately."
                                @onclick="VentCharge">
                            ⚡ Dump her charge
                        </button>
                    </div>

                    <div class="vent-readout">
                        🜁 Expellant: @_reactionMassPulses pulses ·
                        the contactor sips @HullCharge.ContactorPulsesPerMinute.ToString("0.0", CultureInfo.InvariantCulture) per minute while it runs
                    </div>

                    @* THE ADMISSION, always shown. Deep dielectric charging buries itself in the boards over
                       hours; the hull gauge reads fine the whole time and the contactor does not help. Same law
                       the wreck's life-sign sensor lives by: the instrument says something is happening, never
                       what. *@
                    <div class="vent-sub">@HullCharge.WhatTheGaugeCannotSee</div>
                }

                @if (_chargeBoardMessage is { Length: > 0 } chargeMsg)
                {
                    <div class="vent-message">@chargeMsg</div>
                }

                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseChargeBoard)">Step away</button>
            </div>
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════════════════════════════════════
       #528 · THE STORY CARD AND THE STORY PLATE. Owner: "The pattern something of importance to story telling
       happens we get image pop up should happen universally in the game as long as it does not block the playing
       too much or be too repetitive."

       Two presentations of one idiom, chosen by Core (StoryBeats.PresentationOf): the CARD takes the screen when
       the moment was already a pause, and the PLATE rides the edge for a few seconds when the game is still
       moving. Every picture degrades honestly — an unpainted beat still delivers its title and caption.
       ═══════════════════════════════════════════════════════════════════════════════════════════════════ *@
    @if (_storyCard is { } told)
    {
        var toldCopy = StoryBeatCopy(told.Beat, told.Subject);
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseStoryCard)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">@toldCopy.Title</div>
                @if (toldCopy.Art is { Length: > 0 })
                {
                    <img class="view-object-img" src="@toldCopy.Art" alt="@toldCopy.Title"
                         onerror="this.style.display='none'" />
                }
                <div class="view-object-caption">@toldCopy.Caption</div>
                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseStoryCard)">…go on</button>
            </div>
        </div>
    }

    @* The plate: same picture, same words, no keyboard stolen and no world stopped. It is not clickable on
       purpose — a thing you must dismiss is a thing that blocked you. *@
    @if (_storyPlate is { } flash)
    {
        var flashCopy = StoryBeatCopy(flash.Beat, flash.Subject);
        <div class="story-plate" aria-live="polite">
            @if (flashCopy.Art is { Length: > 0 })
            {
                <img class="story-plate-art" src="@flashCopy.Art" alt=""
                     onerror="this.style.display='none'" />
            }
            <div class="story-plate-words">
                <div class="story-plate-title">@flashCopy.Title</div>
                <div class="story-plate-caption">@flashCopy.Caption</div>
            </div>
        </div>
    }

    @* THE CASTAWAY CARD. She went; he did not. Owner's own objection, answered: "if you can not get away with
       ship, then propably not with shuttle either" — true about speed, beside the point. The hull was the
       asset, the bounty and the prize; a man in a small cold boat is worth the fuel to nobody. *@
    @if (_shipEpitaph is { } castaway)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseShipEpitaph)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">☢ SHE IS GONE, AND YOU ARE NOT</div>
                <div class="view-object-caption">@castaway.Went</div>
                <div class="view-object-caption">@castaway.Survives</div>
                <div class="view-object-caption">@castaway.Rescue</div>
                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseShipEpitaph)">…take the berth</button>
            </div>
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════════════════════════════════════
       HER SCUTTLING CHARGES, AND THE TWO HANDS IT TAKES. Owner: "that ship also has the scuttling charges...
       let's have a captains approval mechanic for that also on our ship. :-D ... it is the last defence against
       the Borg in Star Trek :-D", and then the sentence that makes it a mechanic rather than an ending: "they
       only need to activate it for the borg to back down enough."

       The second key is the CREW's — "I guess we need the another opinion we just don't have a desk for that on
       the bridge yet" — read off the sheet already on the captain's desk. No new desk required, and the crew
       temperature stops being a report card.
       ═══════════════════════════════════════════════════════════════════════════════════════════════════ *@
    @if (_showShipScuttlePanel)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseShipScuttlePanel)">
            <div class="vent-board" @onclick:stopPropagation="true">
                <div class="view-object-title">☢ SCUTTLING CHARGES — HER OWN KEEL</div>

                @if (_shipChargesSeconds is { } shipBurn)
                {
                    <div class="vent-sub">
                        @(Scuttle.CanAbort(shipBurn)
                            ? "The note of her is up half a tone. The panel will still take the keys back."
                            : "Past recall. Whatever happens now happens on its own schedule.")
                    </div>
                    <div class="vent-readout">
                        ☢ OVERLOAD — @HullVenting.SoakLabel(shipBurn) · the way out is the way you came in
                    </div>
                    @if (Scuttle.CanAbort(shipBurn))
                    {
                        <button type="button" class="btn btn-outline-warning btn-sm" @onclick="BackTheKeysOut">
                            ↩ Back the keys out
                        </button>
                    }
                }
                else
                {
                    <div class="vent-sub">@ShipScuttle.NeverDelegable</div>
                    <div class="vent-readout">@ShipScuttle.PriceLine(_cargoUnits, (long)_cargoValue, _credits)</div>

                    <div class="vent-actions">
                        <button type="button"
                                class="btn btn-sm @(_shipScuttleWordGiven ? "btn-success" : "btn-outline-danger")"
                                title="@ShipScuttle.AskFor("this ship")"
                                @onclick="GiveTheWordAgainstHer">
                            @(_shipScuttleWordGiven ? "✅ THE CAPTAIN'S KEY IS TURNED — click to take it back" : "🔑 The captain's key")
                        </button>

                        @* THE SECOND OPINION. Not a rules explanation and not a dice roll the captain can
                           re-roll: the crew answer from where they already stand with him. *@
                        <button type="button"
                                class="btn btn-sm @(_shipScuttleSecondKey == ShipScuttle.SecondKey.Refused ? "btn-outline-secondary" : "btn-outline-warning")"
                                disabled="@(!_shipScuttleWordGiven)"
                                title="Scuttling her takes two hands. Ask the crew for theirs."
                                @onclick="AskTheCrewForTheSecondKey">
                            🧑‍🔧 Ask the crew for the second key
                        </button>

                        <button type="button" class="btn btn-danger btn-sm"
                                disabled="@(!_shipScuttleWordGiven
                                            || _shipScuttleSecondKey is null
                                            || _shipScuttleSecondKey == ShipScuttle.SecondKey.Refused)"
                                title="@(_shipScuttleSecondKey == ShipScuttle.SecondKey.Refused
                                         ? ShipScuttle.RefusedPointerLine
                                         : "Both keys together. Ninety seconds, and a recall window for the first sixty.")"
                                @onclick="TurnBothKeys">
                            ☢ TURN BOTH KEYS
                        </button>
                    </div>
                }

                @if (_shipScuttleMessage is { Length: > 0 } shipScuttleMsg)
                {
                    <div class="vent-message">@shipScuttleMsg</div>
                }

                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseShipScuttlePanel)">Step away</button>
            </div>
        </div>
    }

    @* #488 · WHAT YOU ARE LOOKING AT. The cause's own station is the one you stand in front of, so it shows
       the wreck's portrait — eight ships that died eight different ways should not read the same. The image
       is the EVIDENCE, never the conclusion; naming what it means is still the captain's job. *@
    @if (_wreckLook is { } look)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseWreckLook)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">@look.Title</div>
                <img class="view-object-img" src="@look.Art" alt="@look.Title" onerror="this.style.display='none'" />
                <div class="view-object-caption">@look.Caption</div>
                <button type="button" class="view-object-close" title="Step back" @onclick="() => Dismiss(CloseWreckLook)">Step back</button>
            </div>
        </div>
    }

    @* #528 · THE STORY PLATE — the vented-room card with the wreck taken out of it, so any beat in the
       game can be given the same level of service instead of a pulse line that fades in a second and a
       half. Same markup, same onerror-hide, same discipline: the image is the EVIDENCE and naming what it
       means is still the captain's job. The text comes from Core (KaamosLore.PlateFor is the first
       tenant), never from a literal here. *@
    @if (_revealCard is { } plate)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseRevealCard)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">@plate.Title</div>
                <img class="view-object-img" src="@plate.Art" alt="@plate.Title" onerror="this.style.display='none'" />
                <div class="view-object-caption">@plate.Caption</div>
                @* #736 · WHAT THE ACT ACTUALLY DID, on the card the act raised. Owner, at the Gilt-Eye: the
                   350 cr and the kept receipt — "the two facts the player acts on" — were pulsing to the HUD
                   under this backdrop while the caption in front carried neither. The caption is the fiction;
                   this row is the arithmetic, and the card's own subtree is the one layer the backdrop cannot
                   blur (#680/#686's law, third organ). *@
                @if (plate.Outcome is { Length: > 0 } plateOutcome)
                {
                    <div class="reveal-outcome">@plateOutcome</div>
                }
                <button type="button" class="view-object-close" title="Look away"
                        @onclick="() => Dismiss(CloseRevealCard)">Look away</button>
            </div>
        </div>
    }

    @* #488 · THE TWO ROADS. Standing at a derelict's cargo, having read her: file the accident report for a
       finder's fee and a contact, or strip her and say nothing for everything today. The cause you put your
       name to is picked from what your evidence actually supports — a wreck that lies will offer you a
       plausible wrong answer until you have corroborated it. *@
    @if (_showWreckChoice && _wreck is { } salvageWreck)
    {
        <div class="mission-celebration-backdrop" @onclick="() => Dismiss(CloseWreckChoice)">
            <div class="treasure-map-card wreck-choice" @onclick:stopPropagation="true">
                <div class="view-object-title">📋 THE @salvageWreck.ShipName.ToUpperInvariant()</div>
                @* Her portrait, if the away team has actually looked at what killed her. Before that the
                   card stays text-only — you do not get the picture for free. *@
                @if (_wreckExamined.Contains("cause") && Derelict.ArtFile(salvageWreck.Cause) is { Length: > 0 } wreckArt)
                {
                    <div class="tm-art" style="background-image: url('@wreckArt');"></div>
                }
                @* The footing comes from Core. It was typed here, and it said "and nobody has been aboard
                   since" on EVERY hull — including ?wreck=piracy, whose evidence two stations away is an
                   airlock cycled from OUTSIDE and a near hold stripped to bare frames, and ?wreck=infested,
                   where something has been aboard the whole time. What is true of every wreck is not that
                   nobody has been aboard; it is that nobody came back for her. *@
                <div class="tm-caption">@Derelict.CardFooting(salvageWreck)</div>

                @if (CanFileWreckReport)
                {
                    <div class="wreck-finding">
                        <div class="wreck-finding-head">YOUR FINDING — what do you put your name to?</div>
                        @foreach (Derelict.WreckCause option in WreckCandidateCauses())
                        {
                            <button type="button"
                                    class="@(_wreckReported == option ? "btn btn-warning btn-sm wreck-cause picked" : "btn btn-outline-light btn-sm wreck-cause")"
                                    @onclick="() => _wreckReported = option">
                                @Derelict.CauseHeadline(option)
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="wreck-finding">
                        <div class="wreck-finding-head">
                            You have not looked at enough of her to file anything. Read her decks first —
                            the damage, the log, the manifest.
                        </div>
                    </div>
                }

                <div class="busted-options">
                    <button type="button" class="btn btn-light btn-sm"
                            disabled="@(!CanFileWreckReport || _wreckReported is null)"
                            title="File the accident report"
                            @onclick="() => ResolveWreck(Derelict.SalvageChoice.FileTheReport)">
                        @Derelict.DescribeChoice(salvageWreck, Derelict.SalvageChoice.FileTheReport)
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" title="Strip her and say nothing"
                            @onclick="() => ResolveWreck(Derelict.SalvageChoice.StripAndSayNothing)">
                        @Derelict.DescribeChoice(salvageWreck, Derelict.SalvageChoice.StripAndSayNothing)
                    </button>
                </div>
                <button type="button" class="view-object-close" title="Decide later"
                        @onclick="() => Dismiss(CloseWreckChoice)">Not yet</button>
            </div>
        </div>
    }

    @* #488 · what the decision actually bought. *@
    @if (_wreckOutcome is { } salvageOutcome)
    {
        <div class="mission-celebration-backdrop" @onclick="() => Dismiss(DismissWreckOutcome)">
            <div class="treasure-map-card" @onclick:stopPropagation="true">
                <div class="view-object-title">
                    @(salvageOutcome.ContactEarned ? "📋 FILED" : salvageOutcome.CargoIsHot ? "🏴 STRIPPED" : "📋 FILED")
                </div>
                <div class="tm-caption">@salvageOutcome.Line</div>
                <div class="tm-contents">💰 @salvageOutcome.CreditsNow.ToString("N0") cr</div>
                @if (salvageOutcome.CargoIsHot)
                {
                    <div class="tm-bearing">🔥 It is in the hold, and it is hot. A collector will know it on sight.</div>
                }
                @* #652 · The half that outlives the payout, WITH A NAME ON IT. This line used to read
                   "Somebody now owes you a straight answer" and there was no somebody: nothing recorded who,
                   nothing persisted, nothing took your call. The assessor is on the ContactLedger now (and
                   therefore in the vault), and the card says whose name is under the finding. *@
                @if (salvageOutcome.ContactEarned && _wreckContact is { Length: > 0 } signedBy)
                {
                    <div class="tm-bearing">@Derelict.ContactLine(signedBy)</div>
                }
                <button type="button" class="btn btn-warning btn-sm mt-2"
                        @onclick="() => Dismiss(DismissWreckOutcome)">Back to the shuttle</button>
            </div>
        </div>
    }

    @* The ground's gift shop (#480 art pass): the 🛒 SOUVENIR KIOSK sold a tee and a magnet and showed
       neither — every HAVEN shop has had painted merchandise since #367, the walked surface had none.
       Same card idiom as the view-object below, same onerror fallback. *@
    @if (_kioskCard is { } buy)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseKioskCard)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">🧾 @buy.Item</div>
                <img class="view-object-img" src="@buy.Art" alt="@buy.Item" onerror="this.style.display='none'" />
                <div class="view-object-caption">@buy.Line</div>
                <button type="button" class="view-object-close" title="Stow it in the sling" @onclick="() => Dismiss(CloseKioskCard)">Stow it</button>
            </div>
        </div>
    }

    @* View-object popup: a Gen-AI image (a souvenir T-shirt, a fridge magnet, any lore prop) the
       player walks up to and inspects with E. Click away, hit Close, or press E again to dismiss. *@
    @* #600 · THE LIFT PANEL. Owner, having ridden a car that only ever went down: "we should have elevator
       panel with UI then (I wonder what the elevator music would be like ) :-D"

       The buttons come from Core (UndergroundComplex.LiftPanel) rather than being worked out here, so the
       #590 card gate and the #592 silence are one tested rule and this file only draws it. SURFACE is always
       the first button — that is the whole bug fix.

       Each button carries the one fact that decides whether the trip is free: whether that floor still holds
       air. A refusing button is PRESENT and says why; an absent button and a broken one look identical from
       the captain's side, and this ground has already shipped that mistake once. *@
    @if (_showLiftPanel && _surface is { } liftEx)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseLiftPanel)">
            <div class="lift-panel" @onclick:stopPropagation="true">
                <div class="view-object-title">🛗 CAR PANEL</div>
                @* #801 · WHICH car. The line is the panel's own no longer: two cars serve this band and
                   only one of them climbs out, so the sentence under the title is decided beside the stops
                   it is describing. *@
                <div class="lift-sub">
                    @LiftPanelLine() You are at
                    <strong>@SpaceSails.Core.UndergroundComplex.DepthPaint(liftEx.Floor)</strong>.
                </div>

                @* #686 · A refusing button answers HERE, inside the panel's own layer — the pulse HUD sits
                   under the backdrop blur, where the refusal is in the DOM and not on the screen. *@
                @if (_liftOutcome is { } refusedLine)
                {
                    <div class="lift-outcome">@refusedLine</div>
                }

                <div class="lift-stops">
                    @foreach (SpaceSails.Core.UndergroundComplex.LiftStop stop in LiftStops())
                    {
                        string cls = "lift-stop"
                            + (stop.IsCurrent ? " here" : "")
                            + (stop.Refusal is not null ? " sealed" : "")
                            + (stop.OpenedBy is not null ? " carded" : "")
                            + (stop.Pressurised ? "" : " dead");
                        <button type="button" class="@cls" disabled="@stop.IsCurrent"
                                title="@(stop.Refusal ?? (stop.Pressurised ? "holds pressure" : "dead air — the tank runs"))"
                                @onclick="() => PressLiftButton(stop)">
                            <span class="lift-stop-depth">@SpaceSails.Core.UndergroundComplex.DepthPaint(stop.Level)</span>
                            <span class="lift-stop-name">@stop.Name</span>
                            <span class="lift-stop-air">
                                @if (stop.IsCurrent)
                                {
                                    <text>◄ you are here</text>
                                }
                                else if (stop.OpenedBy is not null)
                                {
                                    @* #689 · The positive twin of "🔒 sealed" — the row a captain who went
                                       and FOUND the thing has earned. Core decides whether it is true. *@
                                    <text>🎫 opens for you</text>
                                }
                                else if (stop.Refusal is not null)
                                {
                                    <text>🔒 sealed</text>
                                }
                                else if (stop.Pressurised)
                                {
                                    <text>🫁 air</text>
                                }
                                else
                                {
                                    <text>dead air</text>
                                }
                            </span>
                            @* #689 · …and WHICH paper does it, in the office's own register, so the card in
                               the satchel and the promise on the panel are the same words. Owner: "there was
                               no story point about it being needed or used." *@
                            @if (stop.OpenedBy is { } carriedCard)
                            {
                                <span class="lift-stop-card">@carriedCard — the gate will read it</span>
                            }
                        </button>
                    }
                </div>

                <button type="button" class="view-object-close" title="Step out of the car"
                        @onclick="() => Dismiss(CloseLiftPanel)">Close</button>
            </div>
        </div>
    }

    @* #603 · A DOOR THAT WILL NOT OPEN, AND THE POCKETS YOU MIGHT HAVE. Owner: "we should advertise the
       items list on closed locked door pop-up... something like check your items button there that opens
       inventory."

       The #212 law applied to the satchel: the refusal already said WHY, and a captain standing there with
       an authority in their pocket had no way to find out whether it was the one. The door offers the verb
       now — and it is also how the satchel gets discovered, because nobody reads a keybind and everybody
       presses the button on the thing that just refused them. *@
    @if (_lockedDoor is { } door)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseLockedDoor)">
            <div class="locked-door" @onclick:stopPropagation="true">
                <div class="view-object-title">🔒 @door.Sign</div>
                <div class="locked-door-line">@door.Line</div>
                <div class="locked-door-actions">
                    <button type="button" class="locked-door-try" @onclick="OpenSatchelAtTheDoor">
                        🎒 Check your items@(_satchel.Count > 0 ? $" ({_satchel.Count})" : "")
                    </button>
                    <button type="button" class="view-object-close"
                            @onclick="() => Dismiss(CloseLockedDoor)">Leave it</button>
                </div>
            </div>
        </div>
    }

    @* #746 · THE TABLE. You asked to sit; they waved you in; these are your moves.

       Same overlay family as the barkeep's counter card (deck-offer-card) and the same backdrop as every
       other modal down here — because it IS the same object: a conversation with somebody, with a row of
       things you could say. The guard stop, when it comes, renders through this exact block with a different
       Encounter.Scene in it.

       #680's LAW, APPLIED FROM BIRTH: every outcome is rendered HERE, in the panel's own subtree — the one
       layer the backdrop cannot blur. Not one move pulses its line while this panel is up. The only pulse in
       the whole scene is TAKE YOUR LEAVE, and that one is correct precisely because the panel is gone. *@
    @* #784 PHASE TWO · THE FRAME DOCKS, IT DOES NOT DIM.

       Owner, live at a taken table with the panel up — his screenshot showed the card centred and the
       backdrop dimming the whole hall AND the brand-new park behind its glass to near-black: "the seated
       frame docks, it does not dim… the hall stays lit, the A* walkers stay visible, the park stays green.
       The full card returns only for conversations."

       So the ONE @if below forks on Map.Seated.cs's SeatedIsDocked, and the fork is the whole feature:

         seated-idle  → the strip. No .view-object-backdrop is written into the DOM AT ALL — the guard
                        asserts the scrim's ABSENCE, which is #780's lesson read in reverse.
         conversation → the block that was always here, backdrop, art, moves and prose untouched (#778/#787).

       Nothing about the CARD changed. That matters: the haulier ladder, its odds, its one-per-watch law and
       every line in it ship exactly as they were, and when #731's walker crosses the hall for real she will
       arrive from outside the strip and this card will come up over a room the player was already watching.

       #865 · …AND THE FORK MOVED OFF SOLO. Owner, live at a weighbridge clerk's table with the whole hall
       dimmed to black behind one small card: "what if I just sit and eat here... now I am kind of blinded of
       the surrounding here because somebody else sits in the same table" — then, naming the target: "It
       should somehow UI wise be same style as the sitting alone case", and sealing it: "Just the social
       functions as additional options."

       So CO-SEATING IS A STRIP STATE. Joining an occupied top is a posture change like any other seat and it
       docks; only somebody who CAME OVER TO YOU raises the card (SeatedIsDocked now reads TheyCameToYou).
       And it is the SAME COMPONENT WITH COMPANY, not a second one styled alike — the neighbour's plate and
       bark are lines on this strip and their moves are buttons in this row, which is what keeps the rest
       pips, the spread gating and #829's case-door label working identically whether the chair opposite is
       empty or not. *@
    @* #870 lane 6a · SeatedTable is the seat family's own named read of the sitting itself, so this markup
       renames a receiver instead of reaching into the private state of a partial it does not own. *@
    @if (SeatedTable is { } tab)
    {
    @if (SeatedIsDocked)
    {
        <div class="seated-dock" role="status" aria-label="@SpaceSails.Core.SeatedHud.StripLabel">
            @* THE CUSTOMER LINE, in the AIR gauge's register (#740). Every figure on it is the figure the
               mechanic is running on — Map.Seated.cs hands Core the pour window the rest engine doubles off,
               the pip ledger the rest engine writes, and the watch fill the approach roll is scaled by. *@
            @if (SeatedCustomerLine() is { Length: > 0 } customer)
            {
                <div class="seated-dock-line">@customer</div>
            }

            @* #865 · WHO IS SHARING THE TOP, in the instrument row's own clothes — the plate the deck draws
               over them, the room's setting, and the chairs. Same separator, same register, one line lower:
               the strip is the same strip and this is what has changed about the seat. *@
            @if (SeatedCompanyLine() is { Length: > 0 } company)
            {
                <div class="seated-dock-line seated-dock-company">@company</div>
            }

            @* …and their one breath, OVERHEARD rather than extracted. #751 deals a background patron exactly
               one line per watch, and it used to take a press inside a card that had eaten the room to hear
               it. It stands down the moment anything is actually said at this table, because the strip has
               one outcome slot and a bark left under its own answer would print the sentence twice. *@
            @if (SeatedOverheardLine() is { Length: > 0 } overheard)
            {
                <div class="seated-dock-said seated-dock-bark">@overheard</div>
            }

            @* The latest thing that happened at this table — #757's silence lines, the body's footnote, the
               write-up that just landed. One slot, replaced, exactly as the card's own outcome row was. *@
            @if (tab.Outcome is { Length: > 0 } dockedSaid)
            {
                <div class="seated-dock-said">@dockedSaid</div>
            }

            @* …and a running dig says so here too — the sentence, AND the clock beside it.

               #784, owner live on the phase-2 build: "the progress bar is kind of small there... it might be
               good to have it on the dialog... took me a while to notice it." The rectangle over the
               captain's own mark stays (the one progress language, #562/#696, and honest at a glance from
               across the hall) — but a seated captain's eyes are HERE, and a clock drawn where nobody is
               looking is #782's readability law failing at time instead of at type. So the strip carries the
               primary read at the strip's own width, and the fraction is Core's same Fraction() the deck
               rectangle is fed by, so the two can never disagree about one dig. *@
            @if (ProcessingUnderway() is { } dockedBusy)
            {
                <div class="seated-dock-said seated-dock-busy">@dockedBusy</div>
                @if (ProcessingFraction() is { } dockedDug)
                {
                    <div class="seated-dock-dig"
                         role="progressbar"
                         aria-label="@SpaceSails.Core.Processing.Glyph digging"
                         aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@((int)(dockedDug * 100))">
                        <div class="seated-dock-dig-fill" style="width:@((int)(dockedDug * 100))%"></div>
                    </div>
                }
            }

            <div class="seated-dock-actions">
                @* #865/#746 · ASKING FOR THE CHAIR IS STILL ITS OWN BEAT, and it is a strip button now.
                   Until it is pressed, the only two things you may do at somebody else's top are ask and
                   walk away — the same two the card offered, in the same order, without the room going
                   dark to offer them. *@
                @if (!tab.Joined)
                {
                    <button type="button" class="btn btn-sm btn-warning"
                            title="Ask for the empty chair"
                            @onclick="() => TableMoveClicked(SpaceSails.Core.CanteenTable.Join)">@SpaceSails.Core.CanteenTable.AskToJoin</button>
                    <button type="button" class="btn btn-sm btn-outline-light"
                            title="Think better of it. It costs nothing."
                            @onclick="() => TableMoveClicked(SpaceSails.Core.CanteenTable.Leave)">@SpaceSails.Core.CanteenTable.LabelOf(SpaceSails.Core.CanteenTable.Leave)</button>
                }
                @* THE MOVE ROW. At a top you took alone this is SIT A WHILE and the goodbye; at one you
                   joined it is the neighbour's own three — Small talk, Buy the round, Take your leave —
                   because it is the SAME call over whatever scene this sitting is holding. Owner: "just the
                   social functions as additional options." *@
                @foreach (SpaceSails.Core.Encounter.Move move in tab.Joined ? TableMovesOnTheTable() : [])
                {
                    SpaceSails.Core.Encounter.Move m = move;
                    bool open = TableMoveOnOffer(m);
                    <button type="button"
                            class="btn btn-sm @(TableMoveIsUrged(m) ? "btn-warning" : "btn-outline-light")"
                            disabled="@(!open)"
                            title="@(open ? m.Label : TableMoveRefusal(m))"
                            @onclick="() => TableMoveClicked(m.Id)">@m.Label</button>
                }
                @* #758 · THE CURTAIN AND THE DOOR. One button, at the one seat in this game that has a leaf
                   of its own, and it always offers the OTHER stage — a room never has to announce the state
                   it is already standing in. Owner: "something that prevents the sound or sight catching
                   what happens there too easily but is not a real door." The tooltip carries the cost,
                   because the cost IS the mechanic: the whole hall watches a cabinet door close. *@
                @if (ACabinetLeafToWork)
                {
                    <button type="button" class="btn btn-sm btn-outline-light"
                            title="@CabinetLeafHint"
                            @onclick="WorkTheCabinetLeaf">@CabinetLeafLabel</button>
                }
                @* #784 · [I] IS THE DOOR TO THE SPREAD, and this is the same door with a mouse on it. The
                   refusal is drawn rather than hidden (#212): the bar desk has to be able to say NO to a
                   press, because that is how the gumshoe rule gets learned. Once a sheet of this sitting
                   is in the book the door says so (SpreadDoorLabel) — the owner asked the words to carry
                   the fact that the NEXT press looks at a different sheet. *@
                <button type="button"
                        class="btn btn-sm @(CanSpreadTheCaseHere ? "btn-outline-light" : "btn-outline-secondary")"
                        title="@SpreadDoorHint"
                        @onclick="OpenTheSpread">
                    @SpaceSails.Core.SeatedPosture.WriteGlyph @SpreadDoorLabel
                </button>
            </div>

            @* #865/#746 · …and PUT SOMETHING ON THE TABLE fans the pocket open right here, exactly as it
               does on the card: a second press and never a mode, for #614's reason — a captain deciding WHAT
               to put down must not be one mis-click from having put something down. It is inside the strip's
               own subtree, so the room is still behind it. *@
            @if (tab.Joined && tab.Showing)
            {
                <div class="table-showables seated-dock-showables">
                    @if (_satchel.Count == 0)
                    {
                        <div class="satchel-empty">Nothing in your pockets to put down.</div>
                    }
                    @foreach (SpaceSails.Core.Satchel.Item carried in TableShowables())
                    {
                        SpaceSails.Core.Satchel.Item show = carried;
                        <button type="button" class="satchel-item table-showable"
                                title="Put it on the table where everyone can see it"
                                @onclick="() => TableShow(show)">
                            <span class="satchel-item-name">@SatchelLabel(show)</span>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseTable)">
            <div class="deck-offer-card table-card" @onclick:stopPropagation="true">
                <div class="deck-offer-giver">@tab.Plate</div>

                @* #783 · THE TABLE YOU ARE AT, DRAWN ON THE PANEL YOU ARE AT IT THROUGH. Owner, live at a
                   taken table: "the pop up could have Gen AI here." Same seam #756 put the counter's own desk
                   on the barkeep card through — an image in the card's own flow, ABOVE the prose and never
                   behind it, which is how #782's contrast law is kept by construction here: no text sits on
                   the picture at all, so there is nothing to be unreadable over.

                   TWO STATES, TWO PICTURES. The empty chair opposite IS the wait beat; boots up on that same
                   chair with a cold glass is the other thing sitting down can be (#783's relaxation
                   register). Which one shows is SittingAlone's own answer, off the same flag the opening
                   line is chosen with — a panel that picked its own would be free to draw an empty chair
                   under a sentence about your feet being on it. *@
                @if (tab.ArtUrl is { } tableArt)
                {
                    <img class="table-art" src="@tableArt" alt="" aria-hidden="true" />
                }

                @* The seats are the reason you may sit here at all (#746/#739), so the panel says them.
                   Core's numbers, not the renderer's — the same call that drew the top. *@
                <div class="table-seats small">
                    @tab.Scene.Setting — seats @tab.Seats, @(tab.Free == 1 ? "one chair free" : $"{tab.Free} chairs free")
                </div>

                @* #680 · THE ANSWER, INSIDE THE DIALOG. *@
                @if (tab.Outcome is { Length: > 0 } saidAtTable)
                {
                    <div class="table-outcome">@saidAtTable</div>
                }
                @* §5.0's homage: the player watches the numbers add up. Shown only when dice actually
                   decided something — a modifier stack printed under a fixed outcome would be theatre. *@
                @if (tab.Math is { Length: > 0 } tableMath)
                {
                    <div class="table-math small">🎲 @tableMath</div>
                }

                <div class="deck-offer-reward">Purse: @_credits.ToString("N0", CultureInfo.InvariantCulture) cr</div>

                <div class="deck-offer-actions table-actions">
                    @* #746 · ASKING TO SIT IS ITS OWN BEAT — the one the owner said was missing. Until it is
                       pressed, the only two things a stranger standing at somebody's table may do are ask
                       for the chair and walk away. *@
                    @if (!tab.Joined)
                    {
                        <button type="button" class="btn btn-sm btn-warning"
                                title="Ask for the empty chair"
                                @onclick="() => TableMoveClicked(SpaceSails.Core.CanteenTable.Join)">@SpaceSails.Core.CanteenTable.AskToJoin</button>
                        <button type="button" class="btn btn-sm btn-outline-light"
                                title="Think better of it. It costs nothing."
                                @onclick="() => Dismiss(CloseTable)">@SpaceSails.Core.CanteenTable.LabelOf(SpaceSails.Core.CanteenTable.Leave)</button>
                    }
                    @* #749 · ONLY WHAT IS ON THE TABLE. A move you have not earned is still drawn and still
                       refused out loud (#603); a move that is an ANSWER to a sentence nobody has spoken yet
                       is not drawn at all, because you cannot decline an offer that was never made. Core's
                       own call, so a checkpoint rendering through this block gets the same law. *@
                    @foreach (SpaceSails.Core.Encounter.Move move in tab.Joined ? TableMovesOnTheTable() : [])
                    {
                        SpaceSails.Core.Encounter.Move m = move;
                        bool open = TableMoveOnOffer(m);
                        @* The fitter's ask is HIGHLIGHTED once the hand has waved you toward it — the
                           NO-AND's second effect, and the only thing in this panel that is styling rather
                           than state. *@
                        <button type="button"
                                class="btn btn-sm @(TableMoveIsUrged(m) ? "btn-warning" : "btn-outline-light")"
                                disabled="@(!open)"
                                title="@(open ? m.Label : TableMoveRefusal(m))"
                                @onclick="() => TableMoveClicked(m.Id)">@m.Label</button>
                    }
                </div>

                @* Putting something on the table fans the pocket open right here — a second press, never a
                   mode, for #614's reason: a captain deciding WHAT to put down must not be one mis-click
                   from having put something down. *@
                @if (tab.Joined && tab.Showing)
                {
                    <div class="table-showables">
                        @if (_satchel.Count == 0)
                        {
                            <div class="satchel-empty">Nothing in your pockets to put down.</div>
                        }
                        @foreach (SpaceSails.Core.Satchel.Item carried in TableShowables())
                        {
                            SpaceSails.Core.Satchel.Item show = carried;
                            <button type="button" class="satchel-item table-showable"
                                    title="Put it on the table where everyone can see it"
                                    @onclick="() => TableShow(show)">
                                <span class="satchel-item-name">@SatchelLabel(show)</span>
                            </button>
                        }
                    </div>
                }

                <button type="button" class="view-object-close"
                        title="Stand up. It costs nothing and it never will."
                        @onclick="() => Dismiss(CloseTable)">Close</button>
            </div>
        </div>
    }
    }   @* …and the seated region closes. Two frames, one occupation of one table. *@

    @* #784 · THE STAND-UP CONFIRM. Owner, live: "before moving I have to stand up... so if I try to move
       when sitting down it should ask with a pop-up whether I want to stand up again."

       Drawn AFTER the table so it lands on top of it — it is a question about that panel and it has to be
       the thing the eye and the cancel key both reach first. Plain words and nothing else (#782/#783): the
       question, what it costs when it costs something, and the two answers. Esc is the second road to "stay
       where you are", and Enter to "stand up" (see TryConfirmTopOverlay's flagged exception). *@
    @if (TheStandUpConfirmIsUp)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(KeepYourSeat)">
            <div class="deck-offer-card stand-up-card" @onclick:stopPropagation="true">
                <div class="deck-offer-giver">@SpaceSails.Core.SeatedPosture.StandUpAsk</div>
                @if (StandingUpCostsARest)
                {
                    <div class="table-outcome">@SpaceSails.Core.SeatedPosture.StandUpCostsTheRest</div>
                }
                <div class="deck-offer-actions">
                    <button type="button" class="btn btn-sm btn-warning"
                            @onclick="() => Dismiss(StandUpFromTable)">@SpaceSails.Core.SeatedPosture.StandUpYes</button>
                    <button type="button" class="btn btn-sm btn-outline-light"
                            @onclick="() => Dismiss(KeepYourSeat)">@SpaceSails.Core.SeatedPosture.StandUpNo</button>
                </div>
            </div>
        </div>
    }

    @* #603 · THE SATCHEL. Opened with I it is a look at what you are carrying; opened from a door or an
       instrument it is a list of things to TRY, and every answer is definite. *@
    @if (_showSatchel)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseSatchel)">
            <div class="satchel" @onclick:stopPropagation="true">
                <div class="view-object-title">
                    @(_satchelPage switch
                    {
                        SatchelPage.Notes => "📓 WHAT YOU WROTE DOWN",
                        // #741 v1 · Not the tab's own word twice over: a page title is the QUESTION the page
                        // answers, the way the compass's is ("why you are down here").
                        SatchelPage.Threads => "🧵 WHAT YOU WROTE DOWN TWICE",
                        SatchelPage.Spread => "🗂 THE PAPERS, OUT ON THE TABLE",
                        // #828 · The bucket is NAMED, and it is the one the boots are at — never "a bin".
                        // Away from one the title falls back to the verb, because a page whose fixture has
                        // walked off is a page about the verb and nothing else.
                        SatchelPage.Bin => BinWithinReach() is { } titleBin
                            ? SpaceSails.Core.RipAndBin.PickerTitle(titleBin.Tier)
                            : SpaceSails.Core.RipAndBin.Label,
                        // #727 · Not "your missions" — WHY YOU ARE DOWN HERE, which is the question the page
                        // answers and the one a captain three floors into a basement is actually asking.
                        SatchelPage.Missions => "🗺 WHY YOU ARE DOWN HERE",
                        _ => "🎒 WHAT YOU ARE CARRYING",
                    })
                </div>

                @* #690 · A pocket and a notebook are both things a satchel holds. Owner: "should we have
                   notes / clues section in our inventory ui?" — and on the register: "it's like our detective
                   notepad :-D". The field book used to render only at a ship-brain desk, so the captain
                   standing at a sealed door could not consult their own notes; #688's leave verb made that
                   acute by filing a paper's gist to exactly that unreachable place. No second store here —
                   the NOTES page reads _fieldNotes, the one book. *@
                <div class="satchel-tabs">
                    <button type="button"
                            class="satchel-tab @(_satchelPage == SatchelPage.Carried ? "on" : "")"
                            title="What is in the satchel"
                            @onclick="() => _satchelPage = SatchelPage.Carried">
                        🎒 CARRIED@(_satchel.Count > 0 ? $" ({_satchel.Count})" : "")
                    </button>
                    <button type="button"
                            class="satchel-tab @(_satchelPage == SatchelPage.Notes ? "on" : "")"
                            title="What the ground has told you"
                            @onclick="() => _satchelPage = SatchelPage.Notes">
                        📓 NOTES
                    </button>
                    @* #741 v1 · THREADS, beside the book and reading the same one. Owner's issue: "a third
                       tab — THREADS — grouping existing entries by the entities they already name… the
                       THREAD is just the stack of what you wrote about one name, and the captain draws the
                       line." ALWAYS drawn, like the compass: an empty page here is an answer, and a tab
                       that appeared only once a case was forming would be missing exactly while a captain
                       wondered whether the game did this at all. The count is the book's, not a badge. *@
                    <button type="button"
                            class="satchel-tab @(_satchelPage == SatchelPage.Threads ? "on" : "")"
                            title="@SpaceSails.Core.CaseSubjects.TabHint"
                            @onclick="() => TheSatchelTurnsTo(SatchelPage.Threads)">
                        @SpaceSails.Core.CaseSubjects.TabLabel@(TheBookThreads() is { Count: > 0 } stacks
                            ? $" ({stacks.Count})" : "")
                    </button>
                    @* #727 · THE THIRD POCKET. What you learned (📓) and what you owe (🗺) are two different
                       questions, and the book keeps its opinionless voice by not being asked the second one.
                       Unlike SPREAD and THE BIN this tab is ALWAYS drawn: a compass that vanished when there
                       was nothing on it would answer "why am I down here" with silence, and the whole point
                       of the page is that the answer is never nothing — it is "nothing owed on foot", said
                       out loud, on the page. *@
                    <button type="button"
                            class="satchel-tab @(_satchelPage == SatchelPage.Missions ? "on" : "")"
                            title="What you took on, and what of it you can do standing here"
                            @onclick="() => _satchelPage = SatchelPage.Missions">
                        🗺 MISSIONS@(CompassOnFoot() is { Count: > 0 } owed ? $" ({owed.Count})" : "")
                    </button>
                    @* #784 · THE SPREAD, and the tab exists only when there is a table under it. Owner's law:
                       "writing things down requires sitting down to be properly done" — and the tab follows
                       the posture rather than standing there greyed out, because on your feet this is not a
                       page you are being refused, it is a page that does not apply. The refusal a captain
                       DOES need to meet (the bar desk) is inside the page, on the seat that has one. *@
                    @if (CaptainIsSeatedAnywhere)
                    {
                        <button type="button"
                                class="satchel-tab @(_satchelPage == SatchelPage.Spread ? "on" : "")"
                                title="@SpreadDoorHint"
                                @onclick="() => _satchelPage = SatchelPage.Spread">
                            🗂 SPREAD
                        </button>
                    }
                    @* #828 · THE BIN, and the tab follows the FIXTURE the way the spread tab follows the
                       posture: standing at a bucket it is a page, three du away it is not a page you are
                       being refused. It exists so the captain who opened the pocket by reflex ([I]) can
                       still find the bin they are standing at, and so the one who came in through [E] can
                       get back to their pockets and their book without walking away first. *@
                    @if (BinWithinReach() is { } binTab)
                    {
                        <button type="button"
                                class="satchel-tab @(_satchelPage == SatchelPage.Bin ? "on" : "")"
                                title="@SpaceSails.Core.RipAndBin.Hint(binTab.Tier)"
                                @onclick="() => _satchelPage = SatchelPage.Bin">
                            @SpaceSails.Core.RipAndBin.Glyph THE BIN
                        </button>
                    }
                </div>

                @* #784 · THE SPREAD. Owner: "we can't do that without a place to lay the docs we make notes
                   from" — so this page IS the table surface, and every row on it is a paper lying on it.

                   The press starts the DIGGING BAR (Map.Seated.cs → BeginProcessing, Processing.Work.Write):
                   the one channel this surface has, the one progress rectangle it draws, over the captain's
                   own mark on a deck that is still running. Owner's register, kept quiet in the prose:
                   "we are digging for info and understanding."

                   No control is hidden and none is disabled (#212/#603). The bar desk's refusal is a
                   SENTENCE you get by pressing, because that is how the gumshoe rule gets learned. *@
                @if (_satchelPage == SatchelPage.Spread)
                {
                    <div class="satchel-sub">@(CaseHasBegun ? SpaceSails.Core.SeatedSpread.SpreadAgainBlurb : SpaceSails.Core.SeatedSpread.SpreadBlurb)</div>

                    @if (_satchelOutcome is { Length: > 0 } spreadSaid)
                    {
                        <div class="satchel-outcome">@spreadSaid</div>
                    }
                    else if (SpreadRefusal is { Length: > 0 } spreadNo)
                    {
                        <div class="satchel-outcome">@spreadNo</div>
                    }

                    @if (ProcessingUnderway() is { } spreadBusy)
                    {
                        <div class="satchel-outcome">@spreadBusy</div>
                    }

                    @if (SpreadableFinds() is { Count: > 0 } spreadable)
                    {
                        <div class="satchel-items">
                            @foreach (SpaceSails.Core.Satchel.Item lying in spreadable)
                            {
                                SpaceSails.Core.Satchel.Item dig = lying;
                                <div class="satchel-row">
                                    @* Through SpreadDigClicked and not WriteItUp directly: a successful
                                       press CLOSES this dialog (#696 shuts the pocket so the deck comes
                                       back), and a click that closes a dialog leaves focus on a button that
                                       no longer exists — the map then takes no keys at all. Found by
                                       playing it. *@
                                    <button type="button" class="satchel-item spread-item"
                                            title="@WriteUpHint(dig)"
                                            @onclick="() => SpreadDigClicked(dig)">
                                        <span class="satchel-item-name">@SatchelLabel(dig)</span>
                                        <span class="satchel-item-try">
                                            @SpaceSails.Core.SeatedPosture.WriteGlyph @SpreadRowVerb(dig)
                                        </span>
                                    </button>
                                    @* #798 · …AND THE OTHER END OF THE EVENING. Owner: "those trash cans
                                       are needed so we get rid of the processed materials without
                                       connecting them to us too clearly, like leaving them to the table."
                                       The loop is sit, dig, book, BIN — and the bin has to be on the page
                                       the digging happened on, or the last rung is somewhere else.

                                       Never disabled: with no bin within reach it says so, on this page,
                                       and names what would fix it. *@
                                    @if (RipIsOffered(dig))
                                    {
                                        <button type="button" class="satchel-leave"
                                                title="@RipHint(dig)"
                                                @onclick="() => RipItUp(dig)">@SpaceSails.Core.RipAndBin.Glyph</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="satchel-empty">@SpaceSails.Core.SeatedSpread.NothingToWorkLine</div>
                    }
                }
                else if (_satchelPage == SatchelPage.Notes)
                {
                    @* #741 · THE NOTEBOOK. Owner, from the chair: "the notes become EXPANDING TEXT nodes —
                       title-first, collapsed by default… the opened node houses its text as bullets… the
                       note is structured for CONNECTING, not for prose-reading."

                       And the instrument, in his own words: "I guess it could be a red pen only used to
                       connect the things", with the gesture "select one, select the other — connected".

                       Every arrangement decision on this page — which rows sit together, which pair carries
                       a red edge, what a title says, whether the pen may come out — is CaseThreads', asked
                       once per draw. This markup renders rows and decides nothing. *@
                    <div class="satchel-notes-filter">
                        <button type="button" class="satchel-filter @(_notesView == NotesView.Here ? "on" : "")"
                                title="Only what this body and this site have told you"
                                @onclick="() => TheNotebookTurnsTo(NotesView.Here)">📍 this ground</button>
                        <button type="button" class="satchel-filter @(_notesView == NotesView.Everywhere ? "on" : "")"
                                title="The whole book, ground by ground"
                                @onclick="() => TheNotebookTurnsTo(NotesView.Everywhere)">🥾 every ground</button>
                        <button type="button" class="satchel-filter @(_notesView == NotesView.TheCase ? "on" : "")"
                                title="The whole book in the order the red lines put it"
                                @onclick="() => TheNotebookTurnsTo(NotesView.TheCase)">🧵 the case</button>
                    </div>

                    @* #741 · THE PEN. One control, drawn everywhere and disabled nowhere (#212/#603): on
                       your feet or at a bar top it answers with the sentence that says what would fix it,
                       which is how the gumshoe rule gets learned. Picking it up is not a menu — it changes
                       what pressing a title MEANS, which is the whole of the fiction. *@
                    <div class="notebook-pen">
                        <button type="button" class="satchel-filter red-pen @(_penInHand ? "on" : "")"
                                title="@(_penInHand ? SpaceSails.Core.CaseThreads.PenInHandHint : SpaceSails.Core.CaseThreads.PenHint)"
                                @onclick="TakeUpTheRedPen">@SpaceSails.Core.CaseThreads.PenLabel</button>
                        <span class="notebook-register">
                            @(_penInHand
                                ? SpaceSails.Core.CaseThreads.ConnectingBlurb
                                : SpaceSails.Core.CaseThreads.ReadingBlurb)
                        </span>
                    </div>

                    @if (_satchelOutcome is { Length: > 0 } penSaid)
                    {
                        <div class="satchel-outcome">@penSaid</div>
                    }

                    @if (_notesView == NotesView.Everywhere)
                    {
                        <div class="satchel-sub">
                            Every ground you have turned over, the ones you stood on most recently first.
                        </div>

                        @if (SpaceSails.Core.FieldNotes.PerPlace(_fieldNotes) is { Count: > 0 } book)
                        {
                            <div class="satchel-notes">
                                @foreach (SpaceSails.Core.FieldFinding found in book)
                                {
                                    <div class="satchel-place">🥾 @found.Place</div>
                                    <NotebookNodes Rows="@NotebookPage(found.Lines)"
                                               PenInHand="_penInHand"
                                               WithPlace="false"
                                               IsOpen="NodeIsOpen"
                                               IsHeld="NodeIsHeld"
                                               OnTitle="NoteTitlePressed" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="satchel-empty">
                                The book is blank. It fills the way everything out here fills — one room at a
                                time, and only the ones you turn over.
                            </div>
                        }
                    }
                    else if (_notesView == NotesView.TheCase)
                    {
                        @* The one reading where a line drawn between two GROUNDS can put its two entries
                           side by side. The place stops being a heading and becomes a tag on the node — the
                           order belongs to the case here, and a ground is a fact about an entry like any
                           other. *@
                        <div class="satchel-sub">
                            The whole book in the order your own lines put it. The book does not know what
                            any of them means.
                        </div>

                        @if (TheWholeCase() is { Count: > 1 } whole)
                        {
                            <div class="satchel-notes">
                                <NotebookNodes Rows="@NotebookPage(whole)"
                                               PenInHand="_penInHand"
                                               WithPlace="true"
                                               IsOpen="NodeIsOpen"
                                               IsHeld="NodeIsHeld"
                                               OnTitle="NoteTitlePressed" />
                            </div>
                        }
                        else if (_fieldNotes.Count == 0)
                        {
                            <div class="satchel-empty">
                                The book is blank. It fills the way everything out here fills — one room at a
                                time, and only the ones you turn over.
                            </div>
                        }
                        else
                        {
                            <div class="satchel-empty">
                                @SpaceSails.Core.CaseThreads.NothingToConnectLine
                            </div>
                        }
                    }
                    else
                    {
                        <div class="satchel-sub">
                            @* "somewhere" is Core's own word for a ground it cannot name (PlaceLabel), and the
                               satchel only opens on an excursion anyway — a fallback, not a second format. *@
                            @(PlaceUnderfoot() ?? "Somewhere") — what was found here, latest first.
                            The book keeps it. It keeps no opinion about it.
                        </div>

                        @if (NotesFromThisGround() is { Count: > 0 } here)
                        {
                            <div class="satchel-notes">
                                <NotebookNodes Rows="@NotebookPage(here)"
                                               PenInHand="_penInHand"
                                               WithPlace="false"
                                               IsOpen="NodeIsOpen"
                                               IsHeld="NodeIsHeld"
                                               OnTitle="NoteTitlePressed" />
                            </div>
                        }
                        else if (_fieldNotes.Count == 0)
                        {
                            <div class="satchel-empty">
                                The book is blank. It fills the way everything out here fills — one room at a
                                time, and only the ones you turn over.
                            </div>
                        }
                        else
                        {
                            <div class="satchel-empty">
                                Nothing filed for this ground. Either you have not searched it, or it had
                                nothing to say — the book does not know which, and neither do you.
                            </div>
                        }
                    }
                }
                else if (_satchelPage == SatchelPage.Threads)
                {
                    @* ── #741 v1 · THE THREADS ────────────────────────────────────────────────────────────
                       Owner's issue: "nothing collects every note that mentions The Tilt's harbourmaster, or
                       OFFICE OF WORKS… the player who wants the big picture re-reads the whole book and does
                       the string-and-corkboard in their head — which is fine for three entries and hopeless
                       at thirty."

                       So: one heading per name the book has written down MORE THAN ONCE, and under it every
                       entry that wrote it, oldest first. The rows are the notebook's own nodes — the same
                       titles, the same bullets, the same red-line marks — because a second way of drawing an
                       entry would be a second reading of one book.

                       IT CONCLUDES NOTHING. No arrow, no ranking, no "these are related". The stack is the
                       juxtaposition and the juxtaposition is the whole argument; the captain draws the line,
                       with the same pen, and the book keeps no opinion about what it means. *@
                    <div class="satchel-sub">@SpaceSails.Core.CaseSubjects.Blurb</div>

                    <div class="notebook-pen">
                        <button type="button" class="satchel-filter red-pen @(_penInHand ? "on" : "")"
                                title="@(_penInHand ? SpaceSails.Core.CaseThreads.PenInHandHint : SpaceSails.Core.CaseThreads.PenHint)"
                                @onclick="TakeUpTheRedPen">@SpaceSails.Core.CaseThreads.PenLabel</button>
                        <span class="notebook-register">
                            @(_penInHand
                                ? SpaceSails.Core.CaseThreads.ConnectingBlurb
                                : SpaceSails.Core.CaseThreads.ReadingBlurb)
                        </span>
                    </div>

                    @if (_satchelOutcome is { Length: > 0 } stackSaid)
                    {
                        <div class="satchel-outcome">@stackSaid</div>
                    }

                    @if (TheBookThreads() is { Count: > 0 } threads)
                    {
                        <div class="satchel-notes">
                            @foreach (SpaceSails.Core.CaseSubjects.SubjectThread stack in threads)
                            {
                                SpaceSails.Core.CaseSubjects.SubjectThread run = stack;
                                <div class="thread-head">
                                    <span class="thread-name">@stack.Heading</span>
                                    <span class="thread-count">
                                        @SpaceSails.Core.CaseSubjects.EntriesLabel(stack.Entries.Count)
                                    </span>
                                    @* The pen, offered where the stack is. Never disabled and never hidden
                                       (#212/#603): pressed on your feet or at a bar top it answers with the
                                       sentence that says what would fix it, exactly as the pen itself does. *@
                                    <button type="button" class="satchel-filter thread-pen"
                                            title="@SpaceSails.Core.CaseSubjects.ConnectTheStackHint"
                                            @onclick="() => RunThePenDownTheStack(run)">
                                        @SpaceSails.Core.CaseSubjects.ConnectTheStackLabel
                                    </button>
                                </div>
                                <NotebookNodes Rows="@NotebookPage(stack.Entries)"
                                               PenInHand="_penInHand"
                                               WithPlace="true"
                                               IsOpen="NodeIsOpen"
                                               IsHeld="NodeIsHeld"
                                               OnTitle="NoteTitlePressed" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="satchel-empty">@SpaceSails.Core.CaseSubjects.NothingTwiceLine</div>
                    }
                }
                else if (_satchelPage == SatchelPage.Bin)
                {
                    @* #828 · THE BIN — the sleeve held open over the bucket the captain is standing at.
                       Owner: "I think the trash could be an e-use ... where we select from inventory the
                       processed items we rip and deposit into trash."

                       Nothing on this page is a second shredder. The rows are the sleeve's own papers, the
                       order is Core's (worked sheets lead), the words on them are Core's, and the press is
                       RipItUp — the SAME act the spread row fires, which is why the filed fact reads the
                       same whichever grip the captain took. No control is disabled (#212/#603): a sheet
                       nothing has been dug out of yet carries a flag and a warning in its hint, and then
                       does exactly what it is asked, because it is the captain's paper. *@

                    @* The bet is spoken at the bin and nowhere else (RipAndBin.TierBet) — and when the
                       captain has walked off mid-picker the page says THAT instead, rather than going on
                       describing a bucket that is now down the corridor. *@
                    @if (BinWithinReach() is { } overIt)
                    {
                        <div class="satchel-sub">@SpaceSails.Core.RipAndBin.TierBet(overIt.Tier)</div>
                    }
                    else
                    {
                        <div class="satchel-sub">@SpaceSails.Core.RipAndBin.NoBinLine</div>
                    }

                    @if (_satchelOutcome is { Length: > 0 } binSaid)
                    {
                        <div class="satchel-outcome">@binSaid</div>
                    }

                    @if (BinnableFinds() is { Count: > 0 } feed)
                    {
                        <div class="satchel-items">
                            @foreach (SpaceSails.Core.Satchel.Item lying in feed)
                            {
                                SpaceSails.Core.Satchel.Item paper = lying;
                                <div class="satchel-row">
                                    <button type="button" class="satchel-item"
                                            title="@BinRowHint(paper)"
                                            @onclick="() => RipItUp(paper)">
                                        <span class="satchel-item-name">@SatchelLabel(paper)</span>
                                        <span class="satchel-item-try">
                                            @SpaceSails.Core.RipAndBin.Glyph @BinRowFlag(paper)
                                        </span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="satchel-empty">@SpaceSails.Core.RipAndBin.NothingToBinLine</div>
                    }
                }
                else if (_satchelPage == SatchelPage.Missions)
                {
                    @* ── #727 · THE CARRIED COMPASS ──────────────────────────────────────────────────────
                       Owner, 2026-08-06: "Right now the tasks and missions have been ship-UI specific, so a
                       mission that works outside the ship UI is something new… we should filter out /
                       minimize ship-specific stuff to appropriate ('cannot do in this UI level, but high
                       level: go to Moon X') type info in the carried mission UI."

                       ONE MODEL, TWO PROJECTIONS. Every row here is the SAME contract the captain's own
                       desk draws, read through the same CurrentStepOf and folded by Core
                       (MissionProjection.OnFoot). The foot-level step is the desk's own words, byte for
                       byte; everything else is one collapsed sentence naming where the ship must go.

                       AND NO BUTTON IT CANNOT HONOUR. The carried view is READ-ONLY in v1 (the issue's own
                       fence: signing on happens where people are), so this page renders no control at all
                       — not a greyed one, not a hidden one. A dead affordance in a satchel would be the
                       lift-that-only-went-down bug wearing a UI. The steps you CAN act on you act on by
                       walking to the thing and pressing [E], exactly as you always did; this page only
                       tells you which of them are here and which are a voyage. *@
                    <div class="satchel-sub">@SpaceSails.Core.MissionProjection.CompassBlurb</div>

                    @if (_satchelOutcome is { Length: > 0 } missionSaid)
                    {
                        <div class="satchel-outcome">@missionSaid</div>
                    }

                    @if (CompassOnFoot() is { Count: > 0 } compass)
                    {
                        <div class="satchel-notes">
                            @foreach (SpaceSails.Core.CompassLine job in compass)
                            {
                                <div class="satchel-note mission-line">
                                    <div class="mission-title">@job.Title</div>
                                    <div class="mission-why">@job.Why</div>
                                    @* The one place the fold shows: a step you can act on where you stand
                                       reads in the desk's own hand, a step you cannot reads as DIRECTION.
                                       The class is the only difference the markup makes — the words are
                                       Core's either way. *@
                                    <div class="mission-step @(job.Actionable ? "here" : "away")">@job.Step</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="satchel-empty">@SpaceSails.Core.MissionProjection.NothingOwedOnFoot</div>
                    }
                }
                else
                {
                <div class="satchel-sub">
                    @if (_satchelTarget is { } at)
                    {
                        @* #688 · At a door the list has gone quiet except for the keys, and a row of inert
                           controls that never says why is #603's founding sin one layer up. So the door says
                           what it reads. It names no card and hints at no wallet — it says what a lock is. *@
                        <text>
                            Offering it to <strong>@at.Label</strong>.
                            @if (SpaceSails.Core.SatchelTry.IsDoor(at.Target))
                            {
                                <text>It reads authorities and nothing else — a countersigned card, or nothing at all.</text>
                            }
                            else
                            {
                                <text>Pick something.</text>
                            }
                        </text>
                    }
                    else
                    {
                        @* #688 · The subtitle names what it counts. One figure for three compartments was a
                           sentence that could not be true — a sleeve stuffed with manifests says nothing
                           about the pockets, and neither of them says anything about the wallet, which never
                           fills at all. Core does the arithmetic so the dialog and the pocket cannot
                           disagree about the same satchel. *@
                        <text>
                            Everything found out here, and it stays yours between visits.
                            @SpaceSails.Core.Satchel.SpaceLine(_satchel)
                        </text>
                    }
                </div>

                @* #680 · A failed try answers HERE, inside the modal's own layer — the pulse HUD sits
                   under the backdrop blur, where the refusal is in the DOM and not on the screen. *@
                @if (_satchelOutcome is { } said)
                {
                    <div class="satchel-outcome">@said</div>
                }

                @* #696 · AND A RUNNING HOLD SAYS SO, HERE. The darkroom shuts the satchel on the way in so
                   the captain can watch the fan, but nothing stops them opening it again with I while the
                   twenty seconds run — and a pocket that says nothing about the document currently under
                   their own hands is the dialog lying about itself. Same law as the line above: whatever
                   surface is up is the surface that has to speak (#680/#686). *@
                @if (ProcessingUnderway() is { } busy)
                {
                    <div class="satchel-outcome">@busy</div>
                }

                @* ── #837 · THE LOAD CHOOSER ────────────────────────────────────────────────────────────
                   Owner, satchel open on '12 loose rounds': "I would expect like load it into one or both
                   guns" / "and like how many each .. by default I guess it would be all into one in most
                   cases, but we should give flexibility here."

                   One row per gun the captain's hands can reach — the sling first, because a gun on your own
                   back is the least demanding version of this verb, then whatever is set down within arm's
                   length. Every figure on it is Core's: the counts are SentryBot.MagazineCell, which is the
                   same function the MAGAZINES readout is built out of, and the arrow shows what that line
                   will read AFTER the press, before the press (#696 — the price known beforehand).

                   The page decides nothing. It has no arithmetic, no mutation and no words of its own. *@
                @if (TheLoadChooser() is { } loading)
                {
                    <div class="satchel-sub">@SpaceSails.Core.SentryHandLoad.ChooserBlurb(loading.Pocket, loading.KindName)</div>

                    @if (loading.Picks.Count == 0)
                    {
                        <div class="satchel-empty">@SpaceSails.Core.SentryHandLoad.NothingInReachLine</div>
                    }
                    else
                    {
                        <div class="satchel-items">
                            @foreach (SpaceSails.Core.SentryHandLoad.Pick offering in loading.Picks)
                            {
                                SpaceSails.Core.SentryHandLoad.Pick gun = offering;
                                <div class="satchel-row">
                                    <button type="button" class="satchel-item"
                                            title="@gun.Note"
                                            @onclick="() => LoadIntoIt(gun)">
                                        <span class="satchel-item-name">
                                            🔫 @gun.Unit @gun.Now @(gun.Worked ? "→ " + gun.After : "") <span class="satchel-where">@gun.Where</span>
                                        </span>
                                        <span class="satchel-item-try">@SpaceSails.Core.SentryHandLoad.LoadLabel</span>
                                    </button>
                                    @* THE COUNT STEPPER, and it is only drawn where there is a choice to
                                       make: a row whose ceiling is nought has a refusal to say and no
                                       interesting difference between one nothing and another. *@
                                    @if (gun.Ceiling > 0)
                                    {
                                        <button type="button" class="satchel-leave"
                                                title="@SpaceSails.Core.SentryHandLoad.FewerHint"
                                                @onclick="() => NudgeShare(gun, -1)">−</button>
                                        <span class="satchel-share">@gun.Share of @gun.Pocket</span>
                                        <button type="button" class="satchel-leave"
                                                title="@SpaceSails.Core.SentryHandLoad.MoreHint"
                                                @onclick="() => NudgeShare(gun, 1)">+</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <button type="button" class="satchel-back"
                            @onclick="CloseTheLoadChooser">@SpaceSails.Core.SentryHandLoad.BackLabel</button>
                }
                else if (_satchel.Count == 0)
                {
                    <div class="satchel-empty">
                        Empty. Rooms down here are worth searching — most are stripped, and the ones that
                        are not are the reason anybody comes.
                    </div>
                }
                else
                {
                    <div class="satchel-items">
                        @* #614 · A row can now do two different things, so it is two controls rather than
                           one button wearing two hats. LOOK is always available and never spends anything
                           (#603's law: looking is free and repeatable); TRY is the deliberate second press
                           that costs you the decision. Putting them on one button would mean a captain who
                           wanted to admire the collar had to risk offering it to a door. *@
                        @{
                            IReadOnlyList<SpaceSails.Core.Satchel.Item> wallet = Wallet();

                            RenderFragment<SpaceSails.Core.Satchel.Item> Row = item =>
                                @<div class="satchel-row">
                                    @{
                                        bool canOffer = TargetFor(item) is not null;
                                        bool canLook = LookAtItem(item) is not null;
                                    }
                                    <button type="button" class="satchel-item @(canOffer ? "" : "inert")"
                                            disabled="@(!canOffer)"
                                            @onclick="() => TryItem(item)">
                                        <span class="satchel-item-name">@SatchelLabel(item)</span>
                                        @if (canOffer)
                                        {
                                            <span class="satchel-item-try">
                                                @(_satchelTarget is null ? "read it →" : "try it →")
                                            </span>
                                        }
                                    </button>
                                    @if (canLook)
                                    {
                                        <button type="button" class="satchel-look"
                                                title="Look at it properly"
                                                @onclick="() => OpenItemCard(item)">🔍</button>
                                    }
                                    @* #688 · LEAVE IT. Owner: "no way to drop stuff." Its own small control,
                                       never a mode — for #614's reason one size down, a captain making room
                                       must not be one mis-click away from offering a relic to a bulkhead. It
                                       stays available at a door, because a door is exactly where you discover
                                       your pockets are full.

                                       #696 · And for a DOCUMENT the hint names the seconds, because the
                                       decision the darkroom exists for — here, or somewhere with air in it —
                                       cannot be taken by a captain who finds out the price after pressing.
                                       It reads ProcessingSeconds, which is the Core constant (and the QA
                                       cheat), so the hint and the clock are one number. *@
                                    <button type="button" class="satchel-leave"
                                            title="@LeaveHintFor(item)"
                                            @onclick="() => LeaveItem(item)">🫳</button>
                                    @* #784 · WRITE IT UP PROPERLY — the field book's other register, and
                                       posture is the gate. Owner's law: "writing things down requires
                                       sitting down to be properly done." Standing, this refuses OUT LOUD
                                       and the leave control beside it still files the moving-knee scrawl
                                       exactly as it always has; seated at a table the book takes the entry
                                       AND the sheet stays in your pocket.

                                       Drawn on your FEET as well as in a chair, and live either way — the
                                       refusal is how the law is learned, and #603 says a refusal is said
                                       rather than hidden behind a control that is not there. It goes only
                                       when there is genuinely nothing left to write. *@
                                    @if (CanWriteUp(item))
                                    {
                                        <button type="button" class="satchel-leave"
                                                title="@WriteUpHint(item)"
                                                @onclick="() => WriteItUp(item)">@SpaceSails.Core.SeatedPosture.WriteGlyph</button>
                                    }
                                    @* #798 · RIP IT AND BIN IT — the third answer, beside take and leave.
                                       Owner: "I would not like to leave them at table in canteen… we need
                                       option to destroy them by ripping and binning etc?"

                                       Drawn only on EVIDENCE, because on a handful of rounds this is not a
                                       refusal, it is a verb that does not apply — the same rule the spread
                                       tab follows about posture. Live wherever it IS drawn and never
                                       disabled (#212/#603): with no bin in reach it answers with the
                                       sentence that says what would fix it. *@
                                    @if (RipIsOffered(item))
                                    {
                                        <button type="button" class="satchel-leave"
                                                title="@RipHint(item)"
                                                @onclick="() => RipItUp(item)">@SpaceSails.Core.RipAndBin.Glyph</button>
                                    }
                                    @* #837 · LOAD IT FROM THE ROW — the hand-load's second grip. Owner, with
                                       the satchel open on twelve loose rounds: "I would expect like load it
                                       into one or both guns."

                                       Drawn only on ROUNDS, for the shredder's reason one control over: on a
                                       keycard this is not a refusal, it is a verb that does not apply. Live
                                       wherever it IS drawn and never disabled — with nothing within arm's
                                       reach it opens onto the sentence that says what would fix it, which is
                                       how the reach rule is learned. *@
                                    @if (LoadIsOffered(item))
                                    {
                                        <button type="button" class="satchel-load"
                                                title="@LoadHint(item)"
                                                @onclick="() => OpenTheLoadChooser(item)">@SpaceSails.Core.SentryHandLoad.LoadLabel</button>
                                    }
                                    @* #763 · SCAN — read what the kit has been hearing since you walked in.
                                       Drawn only on the kit, for the shredder's and the loader's reason: on
                                       a keycard this is not a refusal, it is a verb that does not apply.
                                       Live wherever it IS drawn and never disabled — with nothing in reach
                                       it opens onto the sentence that says so, which is the only way
                                       "proximity is the only skill" can be learned. *@
                                    @if (ScanIsOffered(item))
                                    {
                                        <button type="button" class="satchel-load"
                                                title="@ScanHint(item)"
                                                @onclick="() => ScanWithTheKit(item)">@SpaceSails.Core.SdrScanner.ScanLabel</button>
                                    }
                                 </div>;
                        }

                        @* #697 · THE WALLET IS ONE THING. Owner: "Let's also add option to try all ID cards
                           ... by grouping them into a folder in the inventory." Four authorities used to be
                           four rows and four presses; they are one row and one press now, and the cards are
                           one tap under it — untouched, because the faces are the best objects in the game
                           (#528/#695) and the deliberate single try is the captain's to make.

                           A folder of one is bureaucracy about bureaucracy, so one card is a card. *@
                        @if (wallet.Count == 1)
                        {
                            @Row(wallet[0])
                        }
                        else if (wallet.Count > 1)
                        {
                            <div class="satchel-row">
                                <button type="button" class="satchel-item satchel-folder"
                                        title="@(_walletOpen ? "Fold it shut" : "Go through the cards")"
                                        @onclick="() => _walletOpen = !_walletOpen">
                                    <span class="satchel-item-name">
                                        @(_walletOpen ? "▾" : "▸") 🎫 THE WALLET (@wallet.Count)
                                    </span>
                                </button>
                                @* Two controls, never one — #614's ruling one size up: opening the folder
                                   must not be a mis-click away from offering everything in it to a door. *@
                                @if (WalletTarget() is not null)
                                {
                                    <button type="button" class="satchel-fan"
                                            title="Hold every card up to it, one after another"
                                            @onclick="TryTheWholeWallet">try them all →</button>
                                }
                            </div>

                            @* ── #760 · WHOSE STANDING IS WHOSE ──────────────────────────────────────
                               Owner: "if the flat list grows past feel, group accesses into an expandable
                               tree/folder view in the satchel: company/estate as the folder, per-site
                               grants beneath."

                               NOT A TREE YET. The pocket has not filled — a tree over four cards is a
                               filing cabinet built for a wallet — so this is the smallest true version of
                               the same idea: inside the fold the cards sit under the name of whoever gave
                               them to you, WHEN THERE ARE TWO OR MORE NAMES. One outfit gets no heading,
                               because a heading over a list that is entirely one thing is a label that
                               cannot be read for information (#697's folder-of-one, one size up).

                               The grouping is Core's (SiteOperator.Accesses) and so is the decision not to
                               group: this page has no arithmetic about companies and cannot drift from the
                               predicate the gates are using. *@
                            @if (_walletOpen)
                            {
                                <div class="satchel-wallet-cards">
                                    @if (SpaceSails.Core.SiteOperator.Accesses(wallet) is { Count: > 0 } outfits)
                                    {
                                        @foreach (SpaceSails.Core.SiteOperator.Folder outfit in outfits)
                                        {
                                            <div class="satchel-place">@outfit.Heading</div>
                                            @foreach (SpaceSails.Core.Satchel.Item card in outfit.Cards)
                                            {
                                                @Row(card)
                                            }
                                        }
                                    }
                                    else
                                    {
                                        @foreach (SpaceSails.Core.Satchel.Item card in wallet)
                                        {
                                            @Row(card)
                                        }
                                    }
                                </div>
                            }
                        }

                        @foreach (SpaceSails.Core.Satchel.Item item in _satchel)
                        {
                            @if (item.Kind != SpaceSails.Core.Satchel.Kind.Authority)
                            {
                                @Row(item)
                            }
                        }
                    </div>
                }
                }

                @* One Close for both pages: the satchel shuts the same way whichever half of it you are
                   reading, and I still toggles it (#688) regardless of the page. *@
                <button type="button" class="view-object-close"
                        @onclick="() => Dismiss(CloseSatchel)">Close</button>
            </div>
        </div>
    }

    @* #836 · THE FLETCH WALLET, FANNED WHILE HE CROSSES THE FLOOR. Owner: "I think I should be able to pick
       the badge I show the guard... like Fletch ... suppose we have 4 different ID's ... one of them real".

       It opens on the HAIL and it is gone by the time his hand is out — the 2026-08-08 ruling stands, the
       read is still automatic and still told on a card, and the only thing that moved is when the captain
       decided. One row per paper, and every row is the captain's own knowledge and nothing else: the glyph,
       the NAME ON IT, what it CLAIMS (its printed face, verbatim from the file that prints it) and what the
       book itself filed about that paper at this site. No percentages, no ticks, no oracle — the man has not
       read it yet, and neither has this dialog. *@
    @if (WalletFanIsUp && _surface is { } fanEx && TheWalletFan is { Count: > 1 } fanPapers)
    {
        <div class="mission-celebration-backdrop" @onclick="() => Dismiss(CloseTheWalletFan)">
            <div class="treasure-map-card wallet-fan" @onclick:stopPropagation="true">
                <div class="view-object-title">@SpaceSails.Core.WalletChoice.ChooserLabel</div>
                <div class="tm-caption">@SpaceSails.Core.WalletChoice.ChooserHint</div>

                <div class="wallet-fan-rows">
                    @foreach (SpaceSails.Core.Satchel.Item paper in fanPapers)
                    {
                        bool inHand = ThePaperInYourHandIs(paper);
                        <button type="button"
                                class="@(inHand ? "wallet-paper picked" : "wallet-paper")"
                                @onclick="() => ChooseThePaper(paper)">
                            <span class="wallet-paper-face">
                                <span class="wallet-paper-glyph">@SpaceSails.Core.WalletChoice.GlyphOf(paper)</span>
                                <span class="wallet-paper-name">@SpaceSails.Core.WalletChoice.NameOn(paper, NameOnYourOwnPapers)</span>
                                @if (inHand)
                                {
                                    <span class="wallet-paper-held">@SpaceSails.Core.WalletChoice.InYourHandLine</span>
                                }
                            </span>
                            <span class="wallet-paper-claims">@SpaceSails.Core.WalletChoice.Claims(paper)</span>
                            <span class="wallet-paper-book">@TheBookOn(paper, fanEx.Stop.Body.Id)</span>
                        </button>
                    }
                </div>

                <button type="button" class="view-object-close"
                        @onclick="() => Dismiss(CloseTheWalletFan)">@SpaceSails.Core.WalletChoice.KeepItLine</button>
            </div>
        </div>
    }

    @if (_viewObject is { } vo)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseViewObject)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">@vo.Label</div>
                @* A card with no wired art at all (the lifeboat muster) shows caption-only; a card whose
                   art is wired but not yet painted (the text-only dedication plaques) renders the img and
                   lets onerror hide it — the same fallback idiom the captain portraits use (art/captain-N.jpg
                   → hidden if absent), so both degrade cleanly to just the caption. *@
                @if (vo.ImageUrl is { Length: > 0 } voImg)
                {
                    <img class="view-object-img" src="@voImg" alt="@vo.Label" onerror="this.style.display='none'" />
                }
                @if (vo.Caption is { Length: > 0 } cap)
                {
                    <div class="view-object-caption">@cap</div>
                }
                @* #763 · THE PRESS, ON THE KIT'S OWN SCREEN. Detection was passive and cost nothing; this
                   is the button, and the owner's whole ruling is that it may never be automatic — "There
                   was a button. I pushed it." One control per carrier the kit heard, recomputed from where
                   the captain is standing rather than stored, and never disabled: a press that is going to
                   be refused still has to be pressable, because the refusal is the thing worth learning. *@
                @if (TheKitsCardIsUp)
                {
                    @foreach (SpaceSails.Core.SdrScanner.Hit hit in TheKitSweeps())
                    {
                        <div class="satchel-row">
                            <span class="satchel-item-name">@SpaceSails.Core.SdrScanner.HitLine(hit)</span>
                            <button type="button" class="satchel-load"
                                    title="@SpaceSails.Core.SdrScanner.PressBlurb"
                                    @onclick="() => PressTheHit(hit)">@SpaceSails.Core.SdrScanner.PressLabel</button>
                        </div>
                    }
                }
                @* #774 · WHAT THE ACT ACTUALLY FOUND, on the card the act raised — the reveal card's row
                   (#736) on the other full-screen card, because the surface raises this one. The
                   dossier is the case it was grown for: the assembly said two to four sentences and fired
                   every one of them as a pulse UNDER this backdrop, so the captain closed a card onto
                   nothing. A region, not a slot: they all fit, and nothing has to be picked. *@
                @if (vo.Outcome is { Length: > 0 } voOutcome)
                {
                    <div class="reveal-outcome">@voOutcome</div>
                }
                <button type="button" class="view-object-close" title="Put it back down and step away" @onclick="() => Dismiss(CloseViewObject)">Close</button>
            </div>
        </div>
    }

    @* THE CAPTAIN'S SELFIE (#400): the framed shot — the vista backdrop with the captain's #368 portrait
       disc composited into the corner (the "no digital trickery, the captain was HERE" homage), the
       boastful house-voice caption, and the note it's filed in the legend ledger. Click away / Close / E
       again dismisses it. Both the img and the portrait fall back cleanly (onerror-hide) if unpainted. *@
    @if (_selfieShot is { } shot)
    {
        <div class="view-object-backdrop selfie-backdrop" @onclick="CloseSelfieShot">
            <div class="view-object selfie-frame" @onclick:stopPropagation="true">
                <div class="view-object-title">@shot.Title</div>
                <div class="selfie-stage">
                    @if (shot.VistaArt is { Length: > 0 } vista)
                    {
                        <img class="selfie-vista" src="@vista" alt="" onerror="this.style.display='none'" />
                    }
                    <img class="selfie-portrait" src="art/captain-@(shot.AvatarIndex).jpg" alt="the captain, HERE"
                         onerror="this.style.display='none'" />
                </div>
                @if (shot.Caption is { Length: > 0 } selfieCap)
                {
                    <div class="view-object-caption selfie-caption">@selfieCap</div>
                }
                <div class="selfie-foot">📸 Filed in the legend ledger · day @shot.SimDay</div>
                <button type="button" class="view-object-close" title="Put the camera away" @onclick="CloseSelfieShot">Close</button>
            </div>
        </div>
    }

    @* The peak-moment nudge (#400 §3): after a big beat, "grab a selfie for the record?" — one-time, small,
       non-blocking. Take it (captures the themed shot) or wave it off for the session. *@
    @if (_selfieOffer is { } selfieOffer)
    {
        <div class="selfie-offer">
            <span class="selfie-offer-text">📸 @selfieOffer.Label — grab a selfie for the record?</span>
            <div class="selfie-offer-actions">
                <button type="button" class="btn btn-sm btn-info" title="Strike a pose — it goes in the legend ledger" @onclick="AcceptSelfieOffer">Take the shot</button>
                <button type="button" class="btn btn-sm btn-outline-light" title="Not this time" @onclick="DeclineSelfieOffer">Not now</button>
            </div>
        </div>
    }

    @* Hatch keypad: brought up by knocking on the specific locked hatch a crack job sent you to. Key in
       the code the Fixer quoted; right code pops the hatch (job → PickedUp), wrong code buzzes red. *@
    @if (_pinJob is { } pinJob)
    {
        <div class="pin-backdrop" @onclick="CancelPin">
            <div class="pin-pad" @onclick:stopPropagation="true">
                <div class="pin-pad-hatch">@(_pinHatch?.Label ?? "LOCKED HATCH")</div>
                <div class="pin-pad-sub">ENTER ACCESS CODE</div>
                <div class="pin-pad-display">@PinDisplay</div>
                <div class="pin-pad-keys">
                    @foreach (string d in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                    {
                        string digit = d;
                        <button type="button" class="pin-pad-key" title="Key this digit into the access code" @onclick="() => PinPush(digit)">@digit</button>
                    }
                    <button type="button" class="pin-pad-key pin-pad-key-fn" title="Clear the code and start over" @onclick="PinClear">C</button>
                    <button type="button" class="pin-pad-key" title="Key a zero into the access code" @onclick='() => PinPush("0")'>0</button>
                    <button type="button" class="pin-pad-key pin-pad-key-go" title="Try this code on the hatch" @onclick="SubmitPin">↵</button>
                </div>
                @* #736 · The buzz, said on the pad. A wrong code leaves the pad up and blanks the four slots,
                   and the sentence that explained why was pulsing to the HUD under this backdrop. *@
                @if (_pinOutcome is { } pinSaid)
                {
                    <div class="panel-outcome">@pinSaid</div>
                }
                <button type="button" class="pin-pad-cancel" title="Back off — leave the hatch locked" @onclick="CancelPin">Cancel</button>
            </div>
        </div>
    }

    @* Deck / first-person pulse toast: the Nav HUD that normally hosts the pulse line is hidden while
       you're walking the ship, so console quips (the HEAD 🚽 gag, cargo tally, vent report, shuttle
       standby) would render nowhere. Surface them over the canvas here, centred near the top. *@
    @if (_deckMode && _pulse.Message is not null)
    {
        <div class="deck-pulse-toast">@_pulse.Message</div>
    }

    @* A bar stranger's contract, slid across the table (go-ashore quests, M-Q1): shown over the deck
       canvas while ashore, with Take / Pass. Same overlay family as the deck-pulse-toast. *@
    @if (_deckMode && _pendingOffer is { } offer)
    {
        <div class="deck-offer-card">
            <div class="deck-offer-giver">◈ @offer.Giver</div>
            <div class="deck-offer-blurb">@offer.Blurb</div>
            <div class="deck-offer-reward">
                @(offer.Reward > 0
                    ? $"Reward: {offer.Reward.ToString("N0", CultureInfo.InvariantCulture)} cr"
                    : "On the house — the tip's the payoff 🕸")
            </div>
            <div class="deck-offer-actions">
                <button type="button" class="btn btn-sm btn-warning" title="Take the stranger's offer — it lands in your logbook" @onclick="AcceptOffer">@(_pendingOffer?.Kind == QuestKind.Intel ? "Take the tip" : "Take the job")</button>
                <button type="button" class="btn btn-sm btn-outline-light" title="Wave the offer off — no hard feelings" @onclick="DeclineOffer">Pass</button>
            </div>
            @* #355 — the drink offer belongs IN the conversation: while a KNOWN face's contract is on the
               table, the same offer-a-drink flow the counter card hosts sits right here too. A stranger's
               first contract has no ledger history yet, so PresentBarContacts stays empty and this is quiet. *@
            @if (CurrentKeep is { } offerKeep && PresentBarContacts().Any(c => c.Giver.Equals(offer.Giver, StringComparison.OrdinalIgnoreCase)))
            {
                @ContactDrinkOffer(offer.Giver, GiverDisplay(offer.Giver), offerKeep)
            }
        </div>
    }

    @* #355 — the patron's OWN-TABLE drink card (doorway two). Press E at a known face drinking here and,
       when they've no fresh contract to slide across, their table opens with the SAME offer-a-drink flow
       the barkeep's counter hosts — the owner's ask: offer a drink IN the conversation with the person.
       Same overlay family as the deck-offer-card; the one shared state machine keeps both doorways in sync. *@
    @if (_deckMode && _patronDrink is { } patron && CurrentKeep is { } patronKeep)
    {
        string patronDisplay = GiverDisplay(patron);
        <div class="deck-offer-card">
            <div class="deck-offer-giver">◈ @patronDisplay</div>
            @if (_patronDrinkBlurb is { } patronLine)
            {
                <div class="deck-offer-blurb">@patronLine</div>
            }
            @if (_barNotice is { } patronNote)
            {
                <div class="deck-bank-notice small">@patronNote</div>
            }
            <div class="deck-offer-reward">Purse: @_credits.ToString("N0", CultureInfo.InvariantCulture) cr · @patronKeep.BarName</div>
            @ContactDrinkOffer(patron, patronDisplay, patronKeep)
            <div class="deck-offer-actions">
                <button type="button" class="btn btn-sm btn-outline-light" title="Sit back — leave the table" @onclick="() => Dismiss(ClosePatronTable)">Done</button>
            </div>
        </div>
    }

    @* PR-WIRE — the favor bank card (FridaySecondPlan §0). Opened at a contact's table with 'b' (in
       person) or from the dark-web desk (wire). Park coin off the purse (safe from confiscation),
       draw it back, or borrow gas money against a favor. Same overlay family as the deck-offer-card. *@
    @if (_bankSession is { } bank)
    {
        long _bankBal = _contacts.For(bank.ContactId).CreditBalance;
        int _bankMissions = _contacts.For(bank.ContactId).MissionsCompleted;
        bool _bankTrusted = ContactSheets.WillStake(_bankMissions);
        TrustTier _bankTier = ContactSheets.TrustFor(_bankMissions);
        <div class="deck-offer-card deck-bank-card">
            <div class="deck-offer-giver">💰 @bank.DisplayName's ledger @(bank.ViaWire ? "· 🕸 wire" : "· 🤝 in person")</div>
            <div class="deck-bank-balance small">
                @if (_bankBal > 0)
                {
                    <span class="text-success">They hold @_bankBal.ToString("N0", CultureInfo.InvariantCulture) cr of yours</span>
                }
                else if (_bankBal < 0)
                {
                    <span class="text-danger">You owe them @((-_bankBal).ToString("N0", CultureInfo.InvariantCulture)) cr</span>
                }
                else
                {
                    <span class="text-secondary">No coin between you yet</span>
                }
                <span class="text-secondary"> · trust: @_bankTier · purse @_credits.ToString("N0", CultureInfo.InvariantCulture) cr</span>
            </div>
            @if (_heat.Level > 0)
            {
                <div class="deck-bank-warn small text-warning">⚠ Heat @_heat.Level — parking coin now is FENCING: a cut comes off the top (still less than the collectors would take).</div>
            }
            <div class="deck-bank-actions">
                <div class="deck-bank-row small">
                    <span class="deck-bank-label">Deposit</span>
                    @foreach (long amt in BankAmounts)
                    {
                        long a = amt;
                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-1"
                                disabled="@(_credits < a)" title="@($"Park {a:N0} cr with {bank.DisplayName} — off the purse, safe from confiscation")"
                                @onclick="() => BankDeposit(a)">@a.ToString("N0", CultureInfo.InvariantCulture)</button>
                    }
                </div>
                <div class="deck-bank-row small">
                    <span class="deck-bank-label">Withdraw</span>
                    @foreach (long amt in BankAmounts)
                    {
                        long a = amt;
                        <button type="button" class="btn btn-sm btn-outline-info py-0 px-1"
                                disabled="@(_bankBal < a)" title="@($"Draw {a:N0} cr back into the purse")"
                                @onclick="() => BankWithdraw(a)">@a.ToString("N0", CultureInfo.InvariantCulture)</button>
                    }
                </div>
                @if (_bankBal < 0)
                {
                    <div class="deck-bank-row small">
                        <span class="deck-bank-label">Repay</span>
                        @foreach (long amt in BankAmounts)
                        {
                            long a = amt;
                            <button type="button" class="btn btn-sm btn-outline-warning py-0 px-1"
                                    disabled="@(_credits < a)" title="@($"Pay {a:N0} cr toward what you owe {bank.DisplayName}")"
                                    @onclick="() => BankRepay(a)">@a.ToString("N0", CultureInfo.InvariantCulture)</button>
                        }
                    </div>
                }
                @if (_bankTrusted && _bankBal >= 0)
                {
                    <div class="deck-bank-row small">
                        <span class="deck-bank-label">Borrow</span>
                        <button type="button" class="btn btn-sm btn-warning py-0 px-1"
                                title="@($"Take {BankLoanPrincipal:N0} cr on a favor — you'll owe {bank.DisplayName} one quiet delivery")"
                                @onclick="() => BorrowFavorFromBank()">📡 favor wire · @BankLoanPrincipal.ToString("N0", CultureInfo.InvariantCulture) cr</button>
                    </div>
                }
            </div>
            @if (bank.Notice is { } notice)
            {
                <div class="deck-bank-notice small">@notice</div>
            }
            <div class="deck-offer-actions">
                <button type="button" class="btn btn-sm btn-outline-light" title="Close the ledger and step back" @onclick="CloseBank">Done</button>
            </div>
        </div>
    }

    @* #247 — the barkeep's counter menu. Owner ashore: "How do I get a drink at the Rusty bar here?"
       Walk up to the bar, press E: buy the house special (routes through the Galley's rum-tot law, so
       overdoing it tilts the deck ashore too), stand a round for the room (warms the regulars), or ask
       for a rumor. Same overlay family as the deck-offer-card. *@
    @if (_deckMode && _barMenu is { } keep)
    {
        <div class="deck-offer-card">
            @* #756 · ONE CARD, TWO KINDS OF COUNTER. Owner: "we could copy a lot of those from say the Tilt
               bar at Uranus" — so the B1 cantina's counter is this card with a different venue behind it,
               not a second card. Everything that needs a PERSON (the keep's own pour, a round for the room,
               asking what they've heard) is gated on keep.SelfService, because 150 m down there is nobody
               back there to ask: the counter does its own serving, which is worse. *@
            @* #756 · …AND ONE CARD, TWO POSTURES. Standing at the counter it is the counter's card; up on a
               stool it is the stool's, and the plate says which seat. Not a second card and not a second
               menu — see Map.Stool.cs for why the one-E-per-fixture rule points here. *@
            <div class="deck-offer-giver">
                @* #870 lane 6a · The pick between the neighbour's plate and this stool's own number moved
                   into the seat family as SeatedStoolPlate — same two Core sentences, same condition, one
                   fewer reader of Map.Stool.cs's private state. *@
                @if (SeatedStoolPlate is { } seatedPlate)
                {
                    @seatedPlate
                }
                else
                {
                    @($"{(keep.SelfService ? "🍸" : "🍺")} {keep.Name} · {keep.BarName}")
                }
            </div>
            @* #756/#759 · WHAT YOU ARE LOOKING AT CHANGES WITH THE POSTURE, because the view does. Owner:
               "I do not see the park through the bar windows?" Standing, you are looking AT the bar desk;
               up on a stool you are above the bottles with the window wall in front of you, and what is
               behind the glass is the green. Core owns both pictures and the caption; this picks by whether
               you sat down. Same onerror-hide law as every other art slot — no file, no frame. *@
            @if (CaptainIsOnAStool)
            {
                <img class="bar-desk-art" src="@SpaceSails.Core.Interior.TheStools.SeatedArtUrl" alt=""
                     aria-hidden="true" onerror="this.style.display='none'" />
                <div class="bar-view-caption">@SpaceSails.Core.Interior.TheStools.SeatedArtCaption</div>
            }
            else if (keep.DeskArtUrl is { } deskArt)
            {
                <img class="bar-desk-art" src="@deskArt" alt="" aria-hidden="true"
                     onerror="this.style.display='none'" />
            }
            <div class="deck-offer-blurb">
                House special: <strong>@keep.DrinkName</strong> — @keep.DrinkFlavor
            </div>
            @* #410 — the empty chair gets a sentence. The rota decides which regulars drink at THIS port on
               THIS watch and sends the rest out or into the back; until now an away one simply had no
               console, so the room never said where they'd gone. The barkeep is the one person who'd know.
               Read off the same frozen watch the deck was welded at, so the line and the chairs agree. *@
            @if (WhoIsInTonight() is { } roomTonight)
            {
                <div class="deck-offer-blurb small text-secondary">“@roomTonight”</div>
            }
            @if (_barNotice is { } note)
            {
                <div class="deck-bank-notice small">@note</div>
            }
            @* #781 · THE TELL, ON THE SECOND LINE. Owner: "There should be a bar keep there (really like
               hidden security guard)" — and the whole of him is here, in one sentence a watch, under the one
               he greeted you with. It is never a speech and never in quotes: nobody in this room remarks on
               it, and the game does not either. Core owns the three sentences and which one this shift wears
               (off the FROZEN watch, never a clock); this draws it only where somebody is behind the counter,
               which on a dead watch is nobody at all. *@
            @if (TheKeepsTell() is { } tell)
            {
                <div class="deck-offer-blurb small text-secondary">@tell</div>
            }
            <div class="deck-offer-reward">Purse: @_credits.ToString("N0", CultureInfo.InvariantCulture) cr</div>
            @* #306/#308/#347 The drink as a two-edged trust maneuver, OFFER-FIRST (owner 2026-07-18: "The
               person may refuse the drink here. That possibility should be determined first"). Extending the
               offer is the CAPTAIN's own idea, so it opens an OFFER MOMENT (offer it / cancel) — a cancel is
               free (reconsidering your own idea is not a betrayal). Confirming is where the CONTACT decides
               accept/refuse; only an accepted glass is bought and poured. After a round for the room, every
               present regular is satisfied for this visit and shows a toast state; a personal offer is still
               available, never demanded. *@
            @foreach ((string giver, string display) in PresentBarContacts())
            {
                @* #355 — the SAME block the patron's table card renders; one state machine, two doorways. *@
                @ContactDrinkOffer(giver, display, keep)
            }
            @* Overheard here (#119 receipt idiom): the tips/rumors you've heard at this counter, kept where
               a round-loosened tongue's words can be re-read — they may not hide and may not auto-vanish. *@
            @{
                IReadOnlyList<Core.OverheardLine> overheard = OverheardHere(3);
            }
            @if (overheard.Count > 0)
            {
                <div class="bar-overheard small">
                    <div class="bar-overheard-head">Overheard here</div>
                    @foreach (Core.OverheardLine o in overheard)
                    {
                        <div class="bar-overheard-line">@o.Text</div>
                    }
                </div>
            }
            @* #4 SundayMorningWind — the talking drinks menu: more than one type (Space Gin, Space Beer,
               Rocket Fuel + the house special), each with its colourful Leisure-Suit-Larry-style flavour.
               This is where the Larry colour lives. Buy any of them for yourself; all at the going rate.

               #780 · AND IT IS IN THE CARD'S BODY, ABOVE THE PINNED FOOT. Owner, live at the B1 counter:
               "How do I buy the drink here?... There is no button to pay there?" and "menu is not readable —
               text and background are both dark." Both sentences are ONE fault, and it was never a colour:
               the menu used to be the LAST child of this card, AFTER .deck-offer-actions — which #735 pins
               with `position: sticky; z-index: 3` and a 12rem box-shadow SCRIM whose whole job is to darken
               whatever slides under the foot. A static sibling that follows a positioned one paints beneath
               it, so the six priced items sat under 92%-opaque black: still in the DOM, still hit-testable,
               and read by a captain as a greyed-out panel behind glass. #680's law one turn further on —
               IN THE DOM IS NOT ON THE SCREEN, and neither is UNDER THE SCRIM.

               So the menu is prose, and prose goes in the body: it scrolls with the card (#754's cap and
               overscroll), and the foot pins BELOW it where the scrim falls on nothing. Every bar in the
               game renders through this block, so the Tilt's card is fixed by the same move. *@
            @if (_showBarMenu)
            {
                <div class="bar-menu">
                    @* #756 · The header stops promising one flat rate, because a card with a 2 cr coffee
                       and a 12 cr double on it cannot have one. Each row prices itself off Core
                       (Drink.PriceAt), so the label, the enabled-ness and the debit are one number. *@
                    <div class="bar-menu-head">@(keep.SelfService ? "🍸 THE CARD UNDER THE GLASS" : $"🍸 THE MENU — {keep.DrinkPrice} cr a glass")</div>
                    @foreach (Core.Drink drink in Core.DrinkMenu.For(keep))
                    {
                        Core.Drink d = drink;
                        int cost = d.PriceAt(keep.DrinkPrice);
                        bool isFood = d.Category == Core.DrinkCategory.Food;
                        <div class="bar-menu-item">
                            @* #780 · THE SPECIALS, SEEN. Owner asked for the card's items to be pictured, and
                               the art landed before the wiring. Optional per item (Drink.ArtUrl), so COMPANY
                               COFFEE and every haven bar's text-only card render exactly as they always did —
                               and the frame onerror-hides like every other art slot in the game, because a
                               missing file must cost a picture and never a row.

                               #782 · The thumbnail stands BESIDE the words at a fixed small size and never in
                               place of them: the name, the price and the line are the row. *@
                            @if (d.ArtUrl is { } dishArt)
                            {
                                <img class="bar-menu-art" src="@dishArt" alt="" aria-hidden="true"
                                     onerror="this.style.display='none'" />
                            }
                            <div class="bar-menu-words">
                                <button type="button" class="btn btn-sm btn-outline-warning bar-menu-buy" disabled="@(_credits < cost)"
                                        title="@($"Order the {d.Name} — {cost} cr")" @onclick="@(() => BuyDrink(d))">@(isFood ? "🍽" : "🥃") @d.Name · @cost cr</button>
                                <span class="bar-menu-flavor">@d.Flavor</span>
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="deck-offer-actions">
                @if (!keep.SelfService)
                {
                    <button type="button" class="btn btn-sm btn-warning" disabled="@(_credits < keep.DrinkPrice)"
                            title="@($"Buy the house special — {keep.DrinkPrice} cr")" @onclick="BuyHouseSpecial">🍹 @keep.DrinkName · @keep.DrinkPrice cr</button>
                }
                <button type="button" class="btn btn-sm btn-outline-light" title="See the full drinks menu" @onclick="ToggleBarMenu">📜 @(_showBarMenu ? "Hide the menu" : "See the menu")</button>
                @if (!keep.SelfService)
                {
                    <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_credits < keep.RoundPrice)"
                            title="@($"Buy a round for the room — {keep.RoundPrice} cr — warms the regulars drinking here")" @onclick="BuyRoundForRoom">🍻 Round for the room · @keep.RoundPrice cr</button>
                    @* #781 · The tooltip names WHOEVER is behind this counter, off Core's own field, rather
                       than a role typed here. At the Tilt that is Halden Frost; at Canteen 1 it is `the
                       keep`, which is the only thing the game is ever allowed to call him. *@
                    <button type="button" class="btn btn-sm btn-outline-info" title="@($"Ask {keep.Name} what they've heard lately")" @onclick="AskBarkeepForRumor">👂 Hear a rumor</button>
                }
                @* #763 · THE BACK COUNTER. Drawn only where the venue admits to having one
                   (Barkeep.BackCounter) — carrying a receiver is legal everywhere and selling one over the
                   bar is a thing about the ROOM. Never disabled: an empty purse is answered in the keep's
                   own words rather than by a control that will not press (#212/#603). *@
                @if (TheBackCounterIsOpen)
                {
                    <button type="button" class="btn btn-sm btn-outline-warning"
                            title="@Core.SdrScanner.CardStory" @onclick="BuyTheKit">@Core.SdrScanner.BuyLabel</button>
                }
                @* #411: the KAAMOS seam — only shows when this bar can advance the ice-moon thread this watch
                   (a rare holder is in, a coordinate's for sale, or the pieces are ready to resolve). *@
                @if (KaamosBarSeamAvailable())
                {
                    @* The label names the STEP, and prices the one step that takes coin — the bought
                       coordinate used to be spent behind a button that said only "Ask about KAAMOS". *@
                    <button type="button" class="btn btn-sm btn-outline-info" title="@KaamosBarSeamTitle()" @onclick="AskAboutKaamos">@KaamosBarSeamLabel()</button>
                }
                @* #422: the NEBULA seam — only shows when this bar can advance arc 2 this watch (a rare Nebula
                   adjuster is drinking here, or the small print's ready to resolve into the contract). *@
                @if (NebulaBarSeamAvailable())
                {
                    @* The label names the STEP: you ask about NEBULA of the adjuster, but nobody is asked
                       anything when your own gathered small print answers itself on your own table. *@
                    <button type="button" class="btn btn-sm btn-outline-info" title="@NebulaBarSeamTitle()" @onclick="AskAboutNebula">@NebulaBarSeamLabel()</button>
                }
                @* ── #756 · THE HIGH CHAIRS ────────────────────────────────────────────────────────────
                   Owner, live: "Also there should be high chairs so sitting at the bar desk is also
                   possible." ONE E AT THE FIXTURE, and the seat verb lives on the card that press opens —
                   #757's rule kept rather than worked around (a row of eight consoles bolted along five
                   deck-units would have put nine press-targets inside one arm's length of each other).

                   The verb is drawn whether or not there is a free seat (#212: an affordance never hides);
                   a full row refuses OUT LOUD in the notice slot above. *@
                @if (CounterHasStools())
                {
                    @if (!CaptainIsOnAStool)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning"
                                title="Get up on one of the tall seats at the counter"
                                @onclick="TakeAStool">🪑 Take a stool</button>
                    }
                    else
                    {
                        @* #749 · ONLY WHAT HAS BEEN SAID. A reply to a sentence nobody has spoken is not a
                           control that is disabled, it is a control that is not there — Core's own call, so
                           the stool and the table cannot end up with two ideas of when an answer exists. *@
                        @foreach (SpaceSails.Core.Encounter.Move stoolMove in StoolMovesOnTheTable())
                        {
                            SpaceSails.Core.Encounter.Move sm = stoolMove;
                            bool canPress = StoolMoveOnOffer(sm);
                            <button type="button"
                                    class="btn btn-sm @(canPress ? "btn-outline-light" : "btn-outline-secondary")"
                                    disabled="@(!canPress)"
                                    title="@(canPress ? sm.Label : StoolMoveRefusal(sm))"
                                    @onclick="() => StoolMoveClicked(sm.Id)">@sm.Label</button>
                        }
                    }
                }
                <button type="button" class="btn btn-sm btn-outline-light" title="Settle up and step back" @onclick="() => Dismiss(CloseBarkeep)">Done</button>
            </div>
        </div>
    }

    @* #425 — THE STATION ORACLE. Solenne "Static" Marsh, the ranting drunk in the corner whose nonsense
       hides the truth (owner: the BSG Base Star Hybrid key). Press E at her stool: she perceives reality on
       channels you can't (x-rays as weather, cosmic dust on the tongue, the archived dead as a chorus), so
       most of what she says is beautiful noise — but a rare line "sounds nuts but is TRUE" and can leak a
       real arc shard. Buy her a drink to widen the channel (a drunk oracle is more prophetic). THE TELL: when
       the room goes quiet the line MIGHT be one of the real ones — but the hush lies sometimes, so the sifting
       is yours. Same overlay family as the deck-offer-card. *@
    @if (_deckMode && _oracleOpen && _oracleLine is { } oline)
    {
        <div class="deck-offer-card oracle-card @(oline.RoomGoesQuiet ? "oracle-quiet" : "")">
            <div class="deck-offer-giver">🌀 @Core.OracleRant.FullName</div>
            @* #528 · THE CORNER, PAINTED. A backdrop rather than a plate: this card is a conversation the
               captain stays inside, turning the dial line by line, and a modal opening over it every time
               would be a card on a card. Same onerror-hide law as every other slot — no file, no frame. *@
            <img class="oracle-art" src="@Core.OracleRant.ArtFile" alt="@Core.OracleRant.FullName"
                 onerror="this.style.display='none'" />
            <div class="deck-offer-blurb oracle-backstory">@Core.OracleRant.Backstory</div>
            @if (oline.RoomGoesQuiet)
            {
                <div class="oracle-hush small">…the room goes quiet. A faint chill. This one lands differently.</div>
            }
            <div class="oracle-line @(oline.RoomGoesQuiet ? "oracle-line-quiet" : "")">“@oline.Text”</div>
            @if (_oracleNotice is { } onote)
            {
                <div class="deck-bank-notice small">@onote</div>
            }
            <div class="deck-offer-reward">
                Purse: @_credits.ToString("N0", CultureInfo.InvariantCulture) cr@(_oracleDrinks > 0 ? $" · you've stood her {_oracleDrinks} glass{(_oracleDrinks == 1 ? "" : "es")}" : "")
            </div>
            <div class="deck-offer-actions">
                <button type="button" class="btn btn-sm btn-outline-info" title="Let her keep talking — turn the dial one line on" @onclick="NextOracleLine">🌀 Keep listening</button>
                @if (CurrentKeep is { } orKeep)
                {
                    <button type="button" class="btn btn-sm btn-warning" disabled="@(_credits < orKeep.DrinkPrice)"
                            title="@($"Stand the oracle a {orKeep.DrinkName} — {orKeep.DrinkPrice} cr. A drunk oracle is more prophetic.")"
                            @onclick="BuyOracleDrink">🥃 Buy her a drink · @orKeep.DrinkPrice cr</button>
                }
                <button type="button" class="btn btn-sm btn-outline-light" title="Leave her to her muttering" @onclick="() => Dismiss(CloseOracle)">Done</button>
            </div>
        </div>
    }

    @* The shuttle-bay airlock pop-up (#163, "the door you understand as a flight"): walking up to the
       bay's airlock lists the places within one shuttle hop. An interior berth is pickable — confirm and
       the crossing IS the trip, you step off ashore there; a body in range with nowhere to step off says
       so honestly; nothing in range keeps the door shut. Same overlay family as the deck-offer-card. *@
    @if (_deckMode && _shuttleBayStops is { } shuttleStops)
    {
        <div class="deck-shuttle-card">
            <div class="deck-shuttle-title">🛸 Board the shuttle — where to?</div>
            @if (shuttleStops.Count == 0)
            {
                @* #368 (owner, 2026-07-19 playtest at The Red Eye's empty board): a fresh berth with nothing
                   in reach must explain itself in the house voice — apologetic and honest, then the nearest
                   ground below with a plain comparison to what the shuttle can actually cross. *@
                <div class="deck-shuttle-empty">
                    Sorry, captain — nothing within shuttle reach from this berth. The moons drift; watch the ranges below.
                </div>
            }
            else
            {
                <div class="deck-shuttle-rows">
                    @foreach (ShuttleStop stop in shuttleStops)
                    {
                        ShuttleStop local = stop;
                        <div class="deck-shuttle-row">
                            <div class="deck-shuttle-dest">
                                <span class="deck-shuttle-name">@(local.HasBerth ? "⚓" : local.IsLandable ? "🌑" : "•") @local.Body.Name</span>
                                <span class="deck-shuttle-meta">
                                    @FormatDistance(local.DistanceMeters) · ETA @FormatDuration(local.TravelSeconds)@(local.HasCache ? " · a chest waits here 🗺" : "")
                                </span>
                            </div>
                            <div class="deck-shuttle-row-actions">
                                @if (local.HasBerth)
                                {
                                    <button type="button" class="btn btn-sm btn-warning"
                                            title="Take the shuttle to @local.Body.Name — the clock advances by the crossing, then you step off ashore"
                                            @onclick="() => TakeShuttleTo(local)">Take the shuttle →</button>
                                }
                                @* #313: a landable surface — board it (destination, not intent). The tube grows in
                                   place; what you do on the ground is decided on the ground. *@
                                @if (local.IsLandable)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            title="Board the shuttle for @local.Body.Name — the down-tube grows on the map and you walk down. Bring cargo if you like; decide on the ground."
                                            @onclick="() => OpenBoardingPanel(local)">🛸 Board for @local.Body.Name</button>
                                }
                                @if (!local.HasBerth && !local.IsLandable)
                                {
                                    <span class="deck-shuttle-noberth"
                                          title="In shuttle range, but there's nowhere to step off yet">no berth ashore yet</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            @* #368 the honest tail: the nearest LANDABLE ground the shuttle can't reach yet — informational,
               never boardable (no buttons, visibly dimmed). Each row compares its current separation to the
               shuttle's reach and says whether the gap is closing or opening right now. When the board above
               is empty this IS the answer ("the nearest ones are:"); when it isn't, it's context underneath. *@
            @if (_shuttleBayFarStops.Count > 0)
            {
                <div class="deck-shuttle-farhead">
                    @(shuttleStops.Count == 0 ? "The nearest ones are:" : "Just beyond reach:")
                </div>
                <div class="deck-shuttle-rows deck-shuttle-far">
                    @foreach (ShuttleFarStop far in _shuttleBayFarStops)
                    {
                        ShuttleFarStop f = far;
                        <div class="deck-shuttle-row deck-shuttle-row-far"
                             title="In range of no shuttle from here — beyond the craft's @ShuttleReachText(f.RangeMeters) reach. Listed so you can watch the gap.">
                            <div class="deck-shuttle-dest">
                                <span class="deck-shuttle-name">🛬 @f.Body.Name@(string.IsNullOrEmpty(f.ParentName) ? "" : $" ({f.ParentName})")</span>
                                <span class="deck-shuttle-meta">
                                    @ShuttleSeparationText(f.DistanceMeters) · beyond shuttle reach (@ShuttleReachText(f.RangeMeters)) · @ShuttleTrendWord(f.Trend)
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (shuttleStops.Count == 0)
            {
                <div class="deck-shuttle-empty">
                    No landable ground near enough to call either — the hatch stays shut for now.
                </div>
            }
            <div class="deck-shuttle-actions">
                <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => Dismiss(CloseShuttleBayDoor)">Close hatch</button>
            </div>
        </div>
    }

    @* #313: the boarding panel — cargo, not a confession. An OPTIONAL 'load a chest' step (coin dial +
       the whole small hold). Landing empty-handed is a complete visit; the intentions live on the ground. *@
    @if (_boardTarget is { } boardStop)
    {
        @* #488: a DERELICT is not a world. This card was written for the regolith and said so in every
           line — "bury it anywhere on the regolith", three seeded landing sites with names like The Quiet
           Basin ("a low bowl of settled dust"), and a beach-comber kit with a shovel and a pickaxe — all
           offered for crossing to a dead ship with a steel deck. The away team is not landing on her; they
           are going ABOARD, through one airlock, and what they bring is a gun and a bot. *@
        <div class="deck-shuttle-card">
            <div class="deck-shuttle-title">
                @(BoardingAWreck ? "🛸 Take the shuttle across → " : "🛸 Board the shuttle → ")@boardStop.Body.Name
            </div>
            <div class="bury-chooser-body">
                <div class="bury-note">
                    @if (BoardingAWreck)
                    {
                        <text>
                            She has one airlock and no atmosphere worth the name. Take the bots — a sentry
                            holds a corridor while you work, and on a hull with something still aboard the
                            walk back out is the part that goes wrong. There is nothing to bury out here and
                            nothing to dig: what she is worth is already in her holds, and what she is is
                            written on her decks.
                        </text>
                    }
                    else
                    {
                        <text>
                            Loading cargo is optional — you are not declaring a plan. Load a chest to bury it
                            anywhere on the regolith, or go empty and probe the ground for shallow treasure (a
                            fishing expedition). Walk down, look around, buy a souvenir. Your call, on the ground.
                        </text>
                    }
                </div>
                @* #320: WHERE to set down. A body is a world, not a level — pick one of its seeded landing
                   sites and the choice is a mood: each names its character in the house voice, and the ground
                   you get differs by site. Only shown when the body offers more than one (a gig site is a
                   single authored ground). *@
                @* A wreck has ONE airlock, so she never offers a choice of ground. (When a big-hull class
                   lands — a liner, a station — this is exactly where multiple ENTRY POINTS belong, because
                   her sections are severed and the shuttle is the only way between them. Not this hull:
                   she is one spine and eight rooms.) *@
                @if (_boardSites.Count > 1 && !BoardingAWreck)
                {
                    <div class="board-sites">
                        <div class="board-sites-head">🛬 Set down at — choosing a site is choosing a mood:</div>
                        @foreach (LandingSite site in _boardSites)
                        {
                            LandingSite s = site;
                            <button type="button"
                                    class="board-site-row @(s.Index == _boardSiteIndex ? "board-site-sel" : "")"
                                    title="Set down at @s.Name — a different ground on @boardStop.Body.Name"
                                    @onclick="() => SelectBoardSite(s.Index)">
                                <span class="board-site-name">@(s.Index == _boardSiteIndex ? "◉" : "○") @s.Name</span>
                                <span class="board-site-flavor">@s.Flavor</span>
                            </button>
                        }
                    </div>
                }
                @* You do not bury a chest on a wreck, and you do not probe her deck plating for shallow
                   treasure. The coin dial and the hold row are regolith gear; aboard, they are noise. *@
                @if (!BoardingAWreck)
                {
                <div class="bury-row">
                    <span>Coin in the chest (optional)</span>
                    <span class="bury-coin">@_boardCoin.ToString("N0", CultureInfo.InvariantCulture) cr</span>
                </div>
                <div class="bury-steppers">
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => AdjustBoardCoin(-500)">−500</button>
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => AdjustBoardCoin(-100)">−100</button>
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => AdjustBoardCoin(100)">+100</button>
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="() => AdjustBoardCoin(500)">+500</button>
                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => SetBoardCoin(_credits)">All @_credits.ToString("N0", CultureInfo.InvariantCulture)</button>
                </div>
                <div class="bury-row bury-cargo">
                    <span>Hold loaded with it</span>
                    <span>@(_cargoUnits > 0 ? $"{_cargoUnits} units ({HotHoldUnits()} hot)" : "empty")</span>
                </div>
                }
                @* #314/#324: load the ship's sentry bots as surface escorts — they hold the line against
                   the Old Ones until their 99-round magazines run dry. A margin you buy, not safety. The
                   row names the troopers in-voice (#212 affordances-never-hide) so the captain KNOWS the
                   bots are aboard and offered — the owner's "where are my bots" gap. *@
                <div class="bury-row">
                    <span>🤖 @BotMusterLine</span>
                    <span class="bury-coin">@_boardBots of @AvailableBots down</span>
                </div>
                <div class="bury-steppers">
                    <button type="button" class="btn btn-sm btn-outline-light" disabled="@(_boardBots <= 0)" @onclick="() => AdjustBoardBots(-1)">−1 bot</button>
                    <button type="button" class="btn btn-sm btn-outline-light" disabled="@(_boardBots >= AvailableBots)" @onclick="() => AdjustBoardBots(1)">+1 bot</button>
                    @if (_boardBots > 0)
                    {
                        <span class="bury-cargo">@LoadedBotsSummary() — press T on the ground to deploy</span>
                    }
                    else if (AvailableBots == 0)
                    {
                        <span class="bury-cargo">none aboard — rearm at a haven</span>
                    }
                </div>
                @* #348: name the beach-comber kit that ALWAYS rides down (owner: "mention that shovel and
                   metal detectors are here by default. Let's have a pick az also"). Copy only — the shovel
                   and detector already drive the dig/probe; the pickaxe is named here as standard gear.
                   PICKAXE MECHANIC HOOK: if the pick later earns a mechanic (a bedrock re-roll, or digging
                   THROUGH the beach-comber D100's "too hard" result), wire it in SurfaceGroundInteract /
                   BeachComber — do NOT build it here, this line just puts the tool in the captain's hands.
                   GEN-AI GEAR ART (#348, Grok-generated art/gear-beachcomber-kit.jpg): the kit
                   illustration rides beside this line as a small capped thumbnail — object-fit cover, a
                   modest max-height so the dialog stays compact and the Board button never leaves screen. *@
                @if (!BoardingAWreck)
                {
                    <div class="bury-row bury-gear">
                        <img class="gear-thumb" src="art/gear-beachcomber-kit.jpg" alt="" aria-hidden="true" />
                        <span>🧰 Beach-comber kit — standard issue</span>
                        <span class="bury-cargo">a shovel, a metal detector & a pickaxe, aboard every trip</span>
                    </div>
                }
                @* #348: the flight time lives in the BODY now, not the button (owner: "The button looks
                   like the chest contains 5 hours of time"). The crossing costs the same with or without
                   cargo, and the destination list already shows this as ETA — so we say it plainly, once,
                   tied to the flight and nothing else. *@
                <div class="bury-row bury-eta">
                    <span>🛰 Flight down</span>
                    <span class="bury-cargo">ETA @FormatDuration(boardStop.TravelSeconds) — same with or without a chest</span>
                </div>
            </div>
            @* #327 the ship calls home: the hold quote before you commit to the walk down. In-voice, from
               the live tank — a short clock is the captain's informed choice, never a silent maroon. *@
            <div class="bury-row @(BoardingHoldSeverity() >= 2 ? "text-danger" : "text-info")">
                <span>@BoardingHoldQuote()</span>
            </div>
            @* #348: ONE Board button (owner: "We should just have one board button"). You board with
               whatever the dialog shows above — a loaded chest, or an empty sling. An empty sling raises
               the "are you certain?" prompt below instead of a second button. *@
            @if (_boardEmptyConfirm)
            {
                @* The empty-sling confirm — NOT a scold. An empty trip is a legitimate fishing
                   expedition: walk the regolith and probe for shallow treasure the beach-comber turns up. *@
                <div class="bury-row bury-empty-confirm text-info">
                    <span>🪛 Board empty-handed? No coin, no cargo in the sling — that's a fishing expedition. Walk the regolith and probe the beach-comber's D100 for shallow treasure. Certain?</span>
                </div>
                <div class="deck-shuttle-actions">
                    <button type="button" class="btn btn-sm btn-warning"
                            title="Board with an empty sling — go probe @boardStop.Body.Name for shallow treasure"
                            @onclick="() => ConfirmBoarding(boardStop)">🛸 Yes — go fishing</button>
                    <button type="button" class="btn btn-sm btn-outline-light"
                            title="Back to the load-out — put something in the chest first"
                            @onclick="() => _boardEmptyConfirm = false">Load something first</button>
                </div>
            }
            else
            {
                <div class="deck-shuttle-actions">
                    <button type="button" class="btn btn-sm btn-warning"
                            title="Board the shuttle for @boardStop.Body.Name with whatever's loaded above — decide what to do on the ground"
                            @onclick="() => TryBoard(boardStop)">🛸 Board</button>
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="CancelBoarding">Never mind</button>
                </div>
            }
        </div>
    }

    @* #223: the treasure-map card — a full-screen artifact (celebration family). Big body image slot
       (placeholder art until the grok lane fills the manifest), the body as a BIG CAPTION, the
       bearing/paces line, and the big red X. X always marks the spot; the barflies swear it never does. *@
    @if (_treasureMapCard is { } map)
    {
        <div class="mission-celebration-backdrop" @onclick="DismissMapCard">
            <div class="treasure-map-card" @onclick:stopPropagation="true">
                <div class="tm-art" style="background-image: @TreasureMapArtCss(map.BodyId);">
                    <div class="tm-x">✗</div>
                </div>
                <div class="tm-caption">@map.Caption(BodyName(map.BodyId))</div>
                <div class="tm-bearing">🧭 @map.BearingLine</div>
                <div class="tm-contents">🧰 @map.ContentsLine()</div>
                @if (map.ReeverLevel > 0)
                {
                    <div class="tm-bearing">🐕 @map.ReeverLevel Reever@(map.ReeverLevel == 1 ? "" : "s") haunt this ground — the most dangerous lock in the system.</div>
                }
                <div class="tm-flavor">✗ marks the spot. (The barflies swear it never does — out here, they're wrong every time.)</div>
                <button type="button" class="btn btn-warning btn-sm mt-2" title="Tuck the map into the Captain's ledger" @onclick="DismissMapCard">Into the ledger 🗺</button>
            </div>
        </div>
    }

    @* #370: THE RESEARCH BRIEF — the charter service's shamelessly optimistic pitch (a gen-AI image +
       sugar-coated copy). Shown on accept and re-viewable during the gig. The fine-print hedge words ARE
       the joke; the reveal will later contradict every word of it. Reuses the treasure-map card idiom. *@
    @if (_expeditionBriefCard is { } brief)
    {
        <div class="mission-celebration-backdrop" @onclick="DismissExpeditionBrief">
            <div class="expedition-brief-card" @onclick:stopPropagation="true">
                <div class="eb-art" style="background-image: @ExpeditionBriefArtCss(brief.Kind);">
                    <div class="eb-stamp">FULLY BENIGN<span>(pending)</span></div>
                </div>
                <div class="eb-title">📋 @brief.Title</div>
                <div class="eb-site">Site: @brief.SiteName</div>
                <div class="eb-body">@brief.Body</div>
                <div class="eb-flavor">Brought to you by the charter service. Terms apply. Sanity not included.</div>
                <button type="button" class="btn btn-success btn-sm mt-2" title="File the brief and take the gig" @onclick="DismissExpeditionBrief">Sounds lovely — file it 📋</button>
            </div>
        </div>
    }

    @* #370: THE REVEAL — the bigger picture, in the site's OWN voice, that contradicts the brief. A major
       sanity-throw moment (a big nerve shock, the dice shown on the tray). The card is the horror beat. *@
    @if (_expeditionRevealCard is { } reveal)
    {
        <div class="mission-celebration-backdrop expedition-reveal-backdrop" @onclick="DismissExpeditionReveal">
            <div class="expedition-reveal-card" @onclick:stopPropagation="true">
                <div class="er-art" style="background-image: @ExpeditionBriefArtCss(reveal.Kind);">
                    <div class="er-scrim"></div>
                    <div class="er-stamp">THE BRIEF WAS A LIE</div>
                </div>
                <div class="er-headline">@reveal.Headline</div>
                <div class="er-site">@reveal.SiteName</div>
                <div class="er-body">@reveal.Body</div>
                <button type="button" class="btn btn-danger btn-sm mt-2" title="There is no unseeing it" @onclick="DismissExpeditionReveal">Hold the line 🫥</button>
            </div>
        </div>
    }

    @* #394: THE DEFLECTION STORYBOARD — the aftermath told in staged panels with delivered art (the BUSTED
       staged idiom). A full deflection is the 4-panel money shot; a graze and an impact each get 2. Per-panel
       gradient fallback behind the image, house-voice captions. Click / button to advance. *@
    @if (_deflectionStory is { Count: > 0 } story && _deflectionStoryIndex < story.Count)
    {
        var panel = story[_deflectionStoryIndex];
        bool last = _deflectionStoryIndex == story.Count - 1;
        <div class="mission-celebration-backdrop" @onclick="AdvanceDeflectionStory">
            <div class="expedition-brief-card" @onclick:stopPropagation="true">
                <div class="eb-art" style="background-image: @DeflectionPanelArtCss(panel);"></div>
                <div class="eb-body">@panel.Caption</div>
                <div class="eb-flavor">Panel @(_deflectionStoryIndex + 1) of @story.Count</div>
                <button type="button" class="btn btn-@(last ? "success" : "secondary") btn-sm mt-2"
                        @onclick="AdvanceDeflectionStory" @onclick:stopPropagation="true">
                    @(last ? "Close 🫡" : "Next ▸")
                </button>
            </div>
        </div>
    }

    @* The chooser (owner: "if many objects under click we let the user choose what they
       meant"): candidates ranked contacts → depots → bodies, lane and sky scan last. *@
    @if (_pickMenu is { Count: > 0 } pickList)
    {
        @* #253: header + one row per candidate, flipped away from the near edge. *@
        var pickAt = ClampMenu(_pickMenuX, _pickMenuY, pickList.Count);
        <div class="map-body-menu bg-dark bg-opacity-75 rounded p-2 text-light small shadow"
             style="left: @(pickAt.X.ToString("F0", CultureInfo.InvariantCulture))px; top: @(pickAt.Y.ToString("F0", CultureInfo.InvariantCulture))px">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-secondary me-2">Which one?</span>
                <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Close" title="Close this chooser"
                        @onclick="ClosePickMenu"></button>
            </div>
            <div class="d-grid gap-1">
                @foreach (PickCandidate pick in pickList)
                {
                    PickCandidate local = pick;
                    <button type="button" class="btn btn-sm btn-outline-info text-start py-0" title="@PickHint(local)"
                            @onclick="() => OpenPickCandidate(local)">@local.Icon @local.Label</button>
                }
            </div>
            @* #405 (owner: "some UI hint about adding more layers when wanted… maybe to the selection
               pop-up"): a crowded knot points straight at the filter — closes the chooser, opens Layers. *@
            <button type="button" class="btn btn-link btn-sm p-0 mt-1 map-pick-filter-hint"
                    title="Open the 🗺 Layers panel to filter what the map draws on this desk"
                    @onclick="OpenLayersFromPick">🗺 crowded? filter the map</button>
        </div>
    }

    @* 🗺 Layers (owner: "filter what is being shown on the map screens"): per-desk checkbox
       panel, Gemini-consulted placement — small toggle, never a modal over the sky. Only shown on
       the desks that actually render the solar map (Nav, Sensors, the War-room orrery); the other
       desks cover the map with a full-screen panel, so the filter would be dead UI there — and on
       the Captain desk it overlapped the (now three-wide) view-toggle. *@
    @if (_activeDesk is ShipDesk.Nav or ShipDesk.Sensors or ShipDesk.WarRoom)
    {
        <div class="map-layers">
            <button type="button" class="btn btn-sm @(_layersOpen ? "btn-info" : "btn-outline-info")"
                    title="Choose what the map draws on this desk"
                    @onclick="() => _layersOpen = !_layersOpen">🗺 Layers</button>
            @if (_layersOpen)
            {
                <div class="map-layers-panel bg-dark bg-opacity-75 rounded p-2 small shadow text-light">
                    @* #405: a collapsible tree. Each parent is a ▸/▾ caret + a tri-state checkbox that
                       cascades to its children; the children indent under it and only show when open. *@
                    @foreach (MapLayerTree.Group group in MapLayerTree.Groups)
                    {
                        MapLayerTree.Group g = group;
                        bool collapsed = CollapsedLayerGroups.Contains(g.Key);
                        MapLayerTree.TriState state = MapLayerTree.GroupStateOf(HiddenLayers, g);
                        <div class="map-layers-group">
                            <div class="map-layers-parent">
                                <button type="button" class="map-layers-caret" title="@(collapsed ? "Expand this family" : "Collapse this family")"
                                        @onclick="() => ToggleLayerGroupCollapsed(g.Key)">@(collapsed ? "▸" : "▾")</button>
                                <label class="map-layers-row map-layers-parent-label">
                                    @if (g.Pinned)
                                    {
                                        @* Threats is pinned — always on, never a run can hide the collision warning. *@
                                        <input type="checkbox" checked disabled title="Pinned — a collision warning is never hidden" />
                                    }
                                    else
                                    {
                                        @* Native indeterminate is a JS-only property Blazor can't bind — so a
                                           Mixed parent renders checked with a .mixed class that overlays the
                                           tri-state dash in CSS. On = checked, Off = unchecked, Mixed = dash. *@
                                        <input type="checkbox" class="@(state == MapLayerTree.TriState.Mixed ? "map-layers-tri mixed" : "map-layers-tri")"
                                               checked="@(state != MapLayerTree.TriState.Off)"
                                               title="Toggle this whole family on or off"
                                               @onchange="() => ToggleLayerGroup(g)" />
                                    }
                                    <span class="fw-semibold">@g.Icon @g.Label</span>
                                    @if (g.Pinned)
                                    {
                                        <span class="map-layers-pin" title="Pinned — always shown">📌</span>
                                    }
                                </label>
                            </div>
                            @if (!collapsed)
                            {
                                @foreach (MapLayerTree.Leaf leaf in g.Leaves)
                                {
                                    MapLayerTree.Leaf l = leaf;
                                    <label class="map-layers-row map-layers-child">
                                        @if (g.Pinned)
                                        {
                                            <input type="checkbox" checked disabled title="Pinned — this warning is never hidden" />
                                        }
                                        else
                                        {
                                            <input type="checkbox" checked="@LayerVisible(l.Key)" title="Show or hide this on the map"
                                                   @onchange="() => ToggleLayer(l.Key)" />
                                        }
                                        <span>@l.Icon @l.Label</span>
                                    </label>
                                }
                            }
                        </div>
                    }
                    <div class="map-layers-foot d-flex justify-content-between align-items-center mt-1">
                        <span class="text-secondary">remembered per desk</span>
                        <button type="button" class="btn btn-link btn-sm p-0 map-layers-reset"
                                title="Drop this desk's layers back to their shipped defaults"
                                @onclick="ResetLayersToDeskDefaults">↺ reset to desk defaults</button>
                    </div>
                </div>
            }
        </div>
    }

    @* #406 Nav search — type a name to find & jump to a target instead of zoom-hunting. Sits beside
       🗺 Layers on the same map desks (Nav/Sensors/WarRoom); the results drop straight down. Reuses the
       pick-row idiom (icon · name · kind/flavor); a row jumps by framing + centring the target (its menu
       is one more click). / focuses it, ↑↓ move, Enter jumps, Esc closes. The input stops keydown
       propagation so typing a name never drives the ship. *@
    @if (_activeDesk is ShipDesk.Nav or ShipDesk.Sensors or ShipDesk.WarRoom)
    {
        <div class="nav-search" @onclick:stopPropagation="true">
            <input @ref="_navSearchInput" type="search" class="form-control form-control-sm nav-search-input"
                   placeholder="🔍 find a target… ( / )" value="@_navSearchQuery" aria-label="Search the map for a target"
                   title="Type a name to find &amp; jump to a body, depot, or contact — / focuses, ↑↓ move, Enter jumps, Esc closes"
                   @oninput="OnNavSearchInput" @onfocus="() => _navSearchOpen = true"
                   @onkeydown="OnNavSearchKeyDown" @onkeydown:stopPropagation="true" />
            @if (_navSearchOpen && _navSearchRows.Count > 0)
            {
                <div class="nav-search-results bg-dark bg-opacity-75 rounded p-1 small shadow text-light">
                    @for (int i = 0; i < _navSearchRows.Count; i++)
                    {
                        NavSearchRow row = _navSearchRows[i];
                        bool sel = i == _navSearchIndex;
                        <button type="button" class="btn btn-sm text-start py-0 nav-search-row @(sel ? "btn-info" : "btn-outline-info")"
                                title="Jump here — frame the map on it and centre the camera"
                                @onclick="() => JumpToSearchResult(row)">
                            <span class="nav-search-name">@row.Icon @row.Name</span>
                            <span class="text-secondary"> · @row.Flavor</span>@if (row.Hidden)
                            {
                                <span class="text-warning"> · hidden by your layer filter</span>
                            }
                        </button>
                    }
                </div>
            }
            else if (_navSearchOpen && !string.IsNullOrWhiteSpace(_navSearchQuery))
            {
                <div class="nav-search-results bg-dark bg-opacity-75 rounded p-1 small shadow text-secondary">
                    nothing on the charts by that name
                </div>
            }
        </div>
    }

    @* #195 (owner ruling, Friday playtest): the Captain's-desk tutorial pop-up is gone. It floated over
       the Nav toolbar and, like the #169 Luna lesson, presumed onboarding it shouldn't own — the tutorial
       flow (#160) will carry that. The lessons stay reachable at the Captain's desk (0) → Tutorials. *@

    @* First-person ⇄ deck-plan toggle. The F key does this, but it isn't discoverable, so give it a
       visible button while you're aboard (top-down or first person). Mirrors HandleDeckKey's 'f'. *@
    @if (_deckMode)
    {
        <button type="button" class="deck-view-toggle btn btn-sm btn-outline-info @(_surface is not null ? "on-surface" : "")"
                title="@(_fpMode ? "Back to the top-down deck plan" : "Step into first person and walk the ship")"
                @onclick="ToggleFirstPerson">
            @(_fpMode ? "🗺 Deck plan (F)" : "🧍 First person (F)")
        </button>
    }

    @* #488 · THE CLOCKS, WHERE YOU CAN SEE THEM WHILE YOU FIGHT. Owner: "I love that pressure waiting in a
       hot spot with round counts dropping :-D" — which only works if the pump and the soak are legible from
       OUT IN THE CORRIDOR, not just from the board you walked away from. Two clocks racing each other: the
       one emptying a room, and the one on the sentry holding the lane while it does. *@
    @* HER OWN CLOCKS, out where she can be read from the corridor. Owner, having started a pump on her board
       and walked away: "I expect to see the pumping here now as we have on the reever infested salvage ship."
       Same strip, same classes — a run you can only infer from a sentence on a panel is a run you will forget
       you started, and hers take the best part of a minute. *@
    @* #538 · THE CAPTAIN'S REMOTE. Owner: "Maybe small button to open the sentry settings pop-up 😎" and then the
       better name for it — "Captain's remote". A small button on the deck HUD, because this is a handheld thing a
       captain thumbs while crouched behind a bulkhead, not a settings menu on a console somewhere else. *@
    @if (_deckMode && _surface is not null)
    {
        <button type="button" class="btn btn-sm btn-outline-warning captains-remote-btn"
                title="@SilentRunning.PanelTitle — hold your bots, and put the boat to sleep"
                @onclick="OpenCaptainsRemote">
            📻 Remote
        </button>
    }

    @if (_showCaptainsRemote)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseCaptainsRemote)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">@(_designateOpen ? ShootTheLock.PanelTitle : SilentRunning.PanelTitle)</div>
                <div class="view-object-caption">@(_designateOpen ? ShootTheLock.PanelBlurb : SilentRunning.PanelBlurb)</div>

                @* #803 · DESIGNATE — the handset's fourth verb, and the only one that spends anything. Two
                   pages on one panel rather than a second pop-up: the answer to a press must be readable on
                   the pop-up that was pressed (#769), and a captain who opened the remote to point a gun has
                   not changed rooms. Every row here is a full sentence at phone size (#782) — a gun's row
                   says what is in it, a target's row says how far and what it costs, and the trigger says
                   the price on its own face, so nothing is spent by a press whose consequence was a glyph. *@
                @if (_designateOpen)
                {
                    @if (_designateUnit is null)
                    {
                        <div class="vent-readout">WHICH GUN</div>
                        <div class="vent-actions">
                            @foreach (var gun in DesignatableGuns())
                            {
                                string unit = gun.Unit;
                                <button type="button" class="btn btn-sm btn-outline-warning"
                                        title="Point this one"
                                        @onclick="() => PickTheGun(unit)">
                                    @ShootTheLock.GunRow(unit, gun.Rounds, Ammunition.ById(gun.AmmoId))
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="vent-readout">@_designateUnit — WHAT IT CAN SEE</div>
                        <div class="vent-actions">
                            @foreach (var mark in _designateTargets)
                            {
                                DesignateTarget aimedAt = mark;
                                <button type="button"
                                        class="btn btn-sm @(mark.Shootable ? "btn-warning" : "btn-outline-secondary")"
                                        title="@(mark.Shootable ? ShootTheLock.FireLabel(mark.Cost) : ShootTheLock.RefusalLine(mark.Sign))"
                                        @onclick="() => FireOnTheLock(aimedAt)">
                                    @ShootTheLock.TargetRow(mark.Sign, mark.RangeDu, mark.Cost)
                                </button>
                            }
                        </div>
                        @if (_designateTargets.Count > 0)
                        {
                            <div class="vent-sub">Press one to fire on it. Anything with nothing to break on it will say so and cost you nothing.</div>
                        }
                    }

                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="BackToTheSwitches">
                        @ShootTheLock.BackLabel
                    </button>
                }
                else
                {
                <div class="vent-actions">
                    <button type="button"
                            class="btn btn-sm @(_weaponsTight ? "btn-warning" : "btn-outline-warning")"
                            title="@(_weaponsTight ? SentryBot.WeaponsFreeLine : SentryBot.WeaponsTightLine)"
                            @onclick="ToggleWeaponsTight">
                        @(_weaponsTight ? "🤖 WEAPONS TIGHT — press to free" : "🤖 Weapons tight (bots hold)")
                    </button>

                    @* #540 · THE WARM-UP IS ORDERED FROM HERE. Owner: "Shuttle warm up should work from remote."
                       So this one button is the whole boat: it reverses whatever standing order she is under, and
                       says which way she is currently travelling on the dial. *@
                    <button type="button"
                            class="btn btn-sm @(_boatOrderedCold ? "btn-warning" : "btn-outline-warning")"
                            title="@(_boatOrderedCold ? SilentRunning.BoatWakingLine : SilentRunning.BoatDarkLine)"
                            @onclick="ToggleBoatPower">
                        @SilentRunning.BoatButtonLabel(BoatState)
                    </button>
                    @* #537 · THE THIRD SWITCH OF THE SAME FAMILY. Owner: "Sweeping could cost time… Also it
                       might be noisy to say knock on walls etc." Quiet or quick is exactly the trade the other
                       two buttons make, so it belongs on the same handheld and not on a console somewhere. *@
                    @if (OnWreck)
                    {
                        <button type="button"
                                class="btn btn-sm @(_soundQuietly ? "btn-warning" : "btn-outline-warning")"
                                title="@HullSounding.OfferLine(SoundingGear)"
                                @onclick="ToggleQuietSearch">
                            @(_soundQuietly ? "✊ QUIET SEARCH — knuckles only" : "📡 Sounder (quick, and heard)")
                        </button>
                    }

                    @* #803 · The fourth switch, and the only one that points at something. On the ground
                       only: the guns it commands are machines a captain has SET DOWN, and there is nowhere
                       to set one down from the bridge. *@
                    @if (_surface is not null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning"
                                title="@ShootTheLock.PanelBlurb"
                                @onclick="OpenDesignate">
                            @ShootTheLock.OpenLabel
                        </button>
                    }

                    @* #760 · THE FIFTH SWITCH, and the only one that addresses a company. Owner: "the ship
                       remote … can use it over the air: send messages that open places and enable things — a
                       door unbolted before you reach it, a lift enabled from the surface."

                       On the ground only, like DESIGNATE, and LIVE whether or not there is anything to send
                       (#212/#603): a handset with no standing in it answers with the sentence that says what
                       would fix it, and a handset on a moon nobody wired answers with the silence. A switch
                       that vanished where it would refuse would teach a captain nothing except that the game
                       is arbitrary. *@
                    @if (_surface is not null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning"
                                title="@RemoteSend.Blurb"
                                @onclick="SendTheStanding">
                            @RemoteSend.OpenLabel
                        </button>
                    }
                </div>

                <div class="vent-readout">@SilentRunning.SpinUpLabel(_boatWarmth, _boatOrderedCold)</div>
                <div class="vent-sub">@SilentRunning.WhatItCostsLine</div>
                }

                @* #736 · What the last switch DID. Every switch on this handset orders something that is
                   somewhere else — bots across the field, a boat on the pad — so the sentence is the whole
                   of the feedback, and it was pulsing under this panel's own backdrop. *@
                @if (_remoteOutcome is { } remoteSaid)
                {
                    <div class="panel-outcome">@remoteSaid</div>
                }

                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseCaptainsRemote)">Pocket it</button>
            </div>
        </div>
    }

    @* #409+ · THE DOOR BOARD. Owner: "Surely some control panels based on the vent panel can be added 🤠" —
       so it is the vent board's own idiom, one row per chamber, and throwing a door here throws it on the
       ground two rooms away. That reach is the whole reason a lock is a TOOL rather than a walk. *@
    @if (_showDoorBoard)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseDoorBoard)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">🎛 DOOR BOARD — VANTAR LABS</div>
                <div class="view-object-caption">
                    Every door in the mountain, on one wall. @(_hasVantarCard
                        ? "The card is in your hand, so they will key as well as shut."
                        : "They will shut. Keying wants a card you are not carrying.")
                </div>

                <div class="vent-actions">
                    @* #633 · named `labDoor`, not `door`: razor compiles this whole file into ONE method, so
                       the #602 locked-door card's `door` on the other branch and this loop's `door` became the
                       same scope the moment the branches met. *@
                    @foreach (var labDoor in _labDoors.OrderBy(d => d.Key, StringComparer.Ordinal))
                    {
                        string id = labDoor.Key;
                        <button type="button"
                                class="btn btn-sm @(labDoor.Value == LockedDoor.State.Locked ? "btn-warning" : "btn-outline-warning")"
                                title="@LockedDoor.Label(labDoor.Value, _hasVantarCard)"
                                @onclick="() => WorkTheDoor(id)">
                            @LockedDoor.Label(labDoor.Value, _hasVantarCard)
                        </button>
                    }
                </div>

                @* #736 · What the last door did — the one answer on this board a captain cannot check by
                   looking, because the door is two rooms away. The refusal that names the missing card was
                   pulsing under this board's own backdrop. *@
                @if (_doorBoardOutcome is { } doorSaid)
                {
                    <div class="panel-outcome">@doorSaid</div>
                }

                <div class="vent-sub">@LockedDoor.WhichSideLine</div>
                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseDoorBoard)">Step back</button>
            </div>
        </div>
    }

    @* #409+ · THE ALARM PANEL — "something to try to hack". The die is SHOWN: target, the stack of named
       modifiers, and the number it landed on, because a roll a captain cannot argue with is a roll they did
       not take part in. And it states the cost of a wrong answer BEFORE they press it, so declining is a
       real option. *@
    @if (_showAlarmPanel)
    {
        <div class="view-object-backdrop" @onclick="() => Dismiss(CloseAlarmPanel)">
            <div class="view-object" @onclick:stopPropagation="true">
                <div class="view-object-title">@LabSecurity.PanelTitle</div>
                <div class="view-object-caption">@LabSecurity.OfferLine(LabSecurity.HackTarget, LabHackStack)</div>

                <div class="vent-readout">
                    @foreach (var mod in LabSecurity.Modifiers(CurrentApproach()))
                    {
                        <div>@(mod.Value >= 0 ? "+" : "")@mod.Value — @mod.Label</div>
                    }
                </div>

                @if (_labHackRoll is { } roll)
                {
                    <div class="vent-readout">
                        🎲 @roll.Face @(roll.Total - roll.Face >= 0 ? "+" : "")@(roll.Total - roll.Face)
                        = <strong>@roll.Total</strong> against @LabSecurity.HackTarget —
                        @(LabSecurity.Beat(roll) ? "it lets go." : "no.")
                    </div>
                }

                <div class="vent-actions">
                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="HackTheAlarm"
                            disabled="@(_labAlarm is LabSecurity.State.Disarmed or LabSecurity.State.LockedDown)">
                        🔔 Have a go at it
                    </button>
                </div>

                @* #736 · What the last go at it answered. The panel STAYS OPEN on every outcome but the
                   lockdown — that is what makes it a thing you argue with — so the sentence that reads the
                   die belongs here and not in a banner behind the blur. *@
                @if (_alarmOutcome is { } alarmSaid)
                {
                    <div class="panel-outcome">@alarmSaid</div>
                }

                <div class="vent-sub">@LabSecurity.LockdownLine</div>
                <button type="button" class="view-object-close" @onclick="() => Dismiss(CloseAlarmPanel)">Leave it</button>
            </div>
        </div>
    }

    @* #540 · ONE STRIP, EVERY CLOCK. This used to be three separate `.wreck-clocks` blocks — and since the CSS
       pins the strip at a FIXED top/right, any two of them running at once drew exactly on top of each other.
       Weapons tight plus a pump was already an unreadable pile; the boat's clocks would have made three. So they
       are one list now, ordered by how much they should frighten you: the keel, then the way off her, then the
       air, then the standing orders you might have forgotten. Which is also the owner's scene, in order —
       "say self destruct tics down but shuttle still warms up". *@
    @if (_deckMode && (_weaponsTight || BoatClockWorthShowing || SweepersAboard
                       || LabAlarmSecondsLeft is not null
                       || SoundingSecondsLeft is not null || SearchBandLine is not null
                       || (OnWreck
                           ? _pumps.Count > 0 || AnyRoomSoaking || _scuttleSecondsLeft is not null
                           : _shipPumps.Count > 0 || _shipChargesSeconds is not null)))
    {
        <div class="wreck-clocks">
            @* #538 · THE SWEEP, ABOVE EVERYTHING. Three professionals working the hull outrank a countdown for
               the captain's attention, because the countdown is a number and this is a question — where are they
               now, and do they know. It reads the WORST state anybody aboard is in, so a challenge cannot be
               hidden behind two colleagues still ticking boxes. *@
            @if (SweepersAboard)
            {
                <div class="wc-line overload @(AnySweeperOnTheCaptain ? "no-recall" : "")">
                    <span class="wc-tag">🕶 @WorstSweeperState.ToString().ToUpperInvariant()</span>
                    <span class="wc-room">
                        @(WorstSweeperState switch
                        {
                            InspectionTeam.Awareness.Challenging => "stand still",
                            InspectionTeam.Awareness.Hunting => "they know you are aboard",
                            InspectionTeam.Awareness.Investigating => "somebody heard that",
                            _ => "not looking for you yet",
                        })
                    </span>
                    <span class="wc-time">@_sweepers.Count</span>
                </div>
            }

            @* THE OVERLOAD, LOUDEST AND FIRST. Owner, having armed it: "it should have a timer visible in
               UI" — and he is right that this was absurd: the entire scene is walking AWAY from the panel,
               and the clock was only readable by going back to it. Past the recall point it stops being a
               countdown and starts being a fact. *@
            @if ((OnWreck ? _scuttleSecondsLeft : _shipChargesSeconds) is { } burn)
            {
                <div class="wc-line overload @(Scuttle.CanAbort(burn) ? "" : "no-recall")">
                    <span class="wc-tag">☢ @(Scuttle.CanAbort(burn) ? "OVERLOAD" : "NO RECALL")</span>
                    <span class="wc-room">@(OnWreck ? "get off her" : "her own keel")</span>
                    <span class="wc-time">@HullVenting.SoakLabel(burn)</span>
                </div>
            }

            @* #409+ · THE MOUNTAIN COUNTING. Above the rest of the strip because it is the only clock here that
               ends with every door in the place keyed, including the one behind you. *@
            @if (LabAlarmSecondsLeft is { } alarm)
            {
                <div class="wc-line overload @(alarm <= 20 ? "no-recall" : "")">
                    <span class="wc-tag">🔔 ALARM</span>
                    <span class="wc-room">@(_hasVantarCard ? "you hold the card" : "the card is deeper in")</span>
                    <span class="wc-time">@HullVenting.SoakLabel(alarm)</span>
                </div>
            }

            @* #537 · THE KNOCK, and the band it is being spent on. A sounding is seconds you are committed to,
               exactly like a pump run, so it goes in the same column — and the band sits under it because a
               captain who walked away from the manifest should not have to walk back for four numbers. *@
            @if (SoundingSecondsLeft is { } knock)
            {
                <div class="wc-line pump">
                    <span class="wc-tag">@(_soundQuietly ? "✊ KNOCKING" : "📡 SOUNDING")</span>
                    <span class="wc-room">stand still</span>
                    <span class="wc-time">@HullVenting.SoakLabel(knock)</span>
                </div>
            }
            @if (SearchBandLine is { } band)
            {
                <div class="wc-line">
                    <span class="wc-tag">📐 UNACCOUNTED</span>
                    <span class="wc-room">@band</span>
                    <span class="wc-time">K</span>
                </div>
            }

            @* THE BOAT, SECOND. Owner: "A timer on the map about the cool down and warm up" — and the map is
               exactly where it belongs, because a captain watching this clock is nowhere near a console. It sits
               under the overload on purpose: those are the two numbers whose race is the whole scene. *@
            @if (BoatClockWorthShowing)
            {
                <div class="wc-line @(BoatState == SilentRunning.BoatState.WarmingUp ? "overload" : "")">
                    <span class="wc-tag">@SilentRunning.ClockTag(BoatState)</span>
                    <span class="wc-room">@SilentRunning.ClockNote(BoatState)</span>
                    <span class="wc-time">
                        @(BoatState == SilentRunning.BoatState.Cold
                            ? "—"
                            : HullVenting.SoakLabel(BoatSecondsLeft))
                    </span>
                </div>
            }

            @* Every pump gets a line, because several can run at once now. *@
            @foreach (var run in (OnWreck ? _pumps : _shipPumps).Values.OrderBy(p => p.SecondsLeft))
            {
                <div class="wc-line pump">
                    <span class="wc-tag">🛢 @(run.RoughBanked ? "TAIL" : "PUMPING")</span>
                    <span class="wc-room">@(run.Volume.Count > 1 ? $"{run.Volume.Count} SPACES" : run.Volume[0])</span>
                    <span class="wc-time">@HullVenting.SoakLabel(run.SecondsLeft)</span>
                </div>
            }
            @if (OnWreck)
            {
                @foreach ((string room, double secs) in RoomsSoaking)
                {
                    <div class="wc-line">
                        <span class="wc-tag">💨 VACUUM</span>
                        <span class="wc-room">@room</span>
                        <span class="wc-time">@HullVenting.SoakLabel(secs)</span>
                    </div>
                }
            }

            @* #538 · WEAPONS TIGHT, FOR AS LONG AS IT STANDS. Owner: "the remote to sentries should be in the
               mobile hud not at captains desk." The order is given on foot and its whole danger is forgetting
               it — so it is not a checkbox somewhere else, it is a line you cannot walk past. Last in the strip
               because it is a standing order rather than a countdown. *@
            @if (_weaponsTight)
            {
                <div class="wc-line overload no-recall">
                    <span class="wc-tag">🤖 TIGHT</span>
                    <span class="wc-room">nothing of yours fires</span>
                    <span class="wc-time">H</span>
                </div>
            }
        </div>
    }

    @* THE CAPTAIN CHIP (owner 2026-07-19: "the current captain profile pic could also be at some corner of
       the screen while playing, so you can immediately check who you are"). A small identity-glance disc —
       the active captain's portrait (art/captain-N.jpg), a seeded-colour monogram if it's missing — quietly
       in the bottom-left corner while ABOARD. The hover title carries the captain's name (owner: "the hint
       text could show that on hover"). Kept below the deck/dock cards in the z-band so it never covers a
       control (it yields to any card that opens over the corner); hidden on a surface excursion, where the
       SANITY gauge and the first-person toggle own the left column (#324). *@
    @if (_worldReady && _surface is null && !_showStartPicker && !_showSaveDrawer && ActiveThreadInfo is { } capThread)
    {
        (string CaptainName, int AvatarIndex) chipCap = SpaceSails.Core.Captains.For(capThread);
        <div class="captain-chip" title="@chipCap.CaptainName — the captain at your helm"
             style="--mono-color:@CaptainMonoColor(capThread.Id)">
            <span class="captain-mono">@CaptainInitial(chipCap.CaptainName)</span>
            <img class="captain-portrait" src="art/captain-@(chipCap.AvatarIndex).jpg" alt="" aria-hidden="true"
                 onerror="this.style.display='none'" />
        </div>
    }

    @* M24: planet click menu — set the body as THE destination so orbit assist tracks it.
       M29: also live on the Sensors desk, where the map is clickable through the desk layer. *@
    @if (_activeDesk is ShipDesk.Nav or ShipDesk.Sensors && _bodyMenuBody is { } menuBody)
    {
        @* #253/#290: up to four action rows on Nav (set dest · arm · 🚀 long haul · 🪂 aerobrake), two on Sensors. *@
        var bodyAt = ClampMenu(_bodyMenuX, _bodyMenuY, 4);
        <div class="map-body-menu bg-dark bg-opacity-75 rounded p-2 text-light small shadow"
             style="left: @(bodyAt.X.ToString("F0", CultureInfo.InvariantCulture))px; top: @(bodyAt.Y.ToString("F0", CultureInfo.InvariantCulture))px">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold me-2">@menuBody.Name</span>
                <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Close" title="Close this body's menu"
                        @onclick="CloseBodyMenu"></button>
            </div>
            <div class="d-grid gap-1">
                @* PR-C desk separation (F7): navigation verbs live on the Nav desk; the same
                   click on Sensors talks scanning. Navigation is done at the Navigation desk. *@
                @if (_activeDesk == ShipDesk.Nav)
                {
                    @if (_destinationBodyId == menuBody.Id)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning" title="Drop this body as the destination — the autopilot stops steering to it"
                                @onclick="() => SetDestination(null)">
                            ✕ Clear destination
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-info"
                                title="@(HarborClassOf(menuBody.Id) == HarborClass.Dock ? "Make this haven the destination — the autopilot flies you in to its dock" : "Make this body the destination — the autopilot navigates to its orbit")"
                                @onclick="() => SetDestination(menuBody.Id)">
                            🎯 Set destination — @(HarborClassOf(menuBody.Id) == HarborClass.Dock ? "navigate to dock" : "navigate to orbit")
                        </button>
                    }
                    <button type="button" class="btn btn-sm @(!NavLockedByDock && _armedOrbitBodyId == menuBody.Id ? "btn-success" : "btn-outline-info")"
                            disabled="@NavLockedByDock" title="@(NavLockedByDock ? DockNavLockTip : ArmMenuHint(menuBody.Id))"
                            @onclick="() => ToggleArmedInsertionFromMenu(menuBody.Id)">
                        @(_armedOrbitBodyId == menuBody.Id
                            ? "🛰 Armed — click to disarm"
                            : HarborClassOf(menuBody.Id) == HarborClass.Dock
                                ? HarborVocabulary.ArmAction(HarborClass.Dock, menuBody.Name)
                                : "🛰 Arm auto-insert at window")
                    </button>
                    @* #246/#249 🚀 LONG HAUL — the PRIMARY entry (owner: "autopilot into vicinity from clicking
                       the target"). When the clicked body sits across the void, the menu recognizes the long-
                       haul distance and offers it as a third action that SETS the destination AND engages in
                       one press — no card-hunting. Visible-but-disabled with the reason (#212), even docked
                       (the undock is part of engaging). *@
                    @if (LongHaulTargetPlanet(menuBody.Id) is { } lhMenuPlanet)
                    {
                        LongHaul.Departure lhMenuDep = LongHaul.SolveDeparture(_ship, _ephemeris!, lhMenuPlanet);
                        string? lhMenuBlock = LongHaulOfferBlock(lhMenuDep, lhMenuPlanet, LongHaulClearanceBlock(lhMenuDep, lhMenuPlanet));
                        <button type="button" class="btn btn-sm @(lhMenuBlock is null ? "btn-warning" : "btn-outline-secondary")"
                                disabled="@(lhMenuBlock is not null)"
                                title="@(lhMenuBlock ?? $"Set {menuBody.Name} as destination and autopilot the whole void in one jump — wake at {lhMenuPlanet.Name}'s capture range; the last mile stays premium")"
                                @onclick="() => EngageLongHaulFromMenu(menuBody.Id)">
                            @(lhMenuDep.Ok
                                ? LongHaul.MenuAction(lhMenuPlanet.Name, lhMenuDep.DeparturePulses, FormatSimTime(lhMenuDep.ArrivalCenterTime))
                                : $"🚀 Long haul to {lhMenuPlanet.Name} — no window from here")
                        </button>
                    }
                    @* #411 ❄ THE CYCLER WINDOW — the KAAMOS route, and the only body in the system it is
                       ever offered at. Shown only to a captain whose berth-code has resolved (the fiction may
                       not arrive before the arc does, #380), and visible-but-disabled with the reason when the
                       run is not filed or the arc is simply not here yet (#212). Core owns every word. *@
                    @if (KaamosCyclerRowVisible(menuBody.Id))
                    {
                        string? cyBlock = KaamosCyclerBlock();
                        <button type="button" class="btn btn-sm @(cyBlock is null ? "btn-info" : "btn-outline-secondary")"
                                disabled="@(cyBlock is not null)"
                                title="@(cyBlock ?? "Put her on the slow arc and be carried all the way in — 38 days, no burn, no brake at the far end")"
                                @onclick="RideTheCyclerWindow">
                            @KaamosCyclerLabel()
                        </button>
                    }
                    @* #290 🪂 AEROBRAKE — the third way to pay the arrival bill (beside the propulsive insert
                       and the warn-and-coast). Shown only for skim-atmosphere worlds (Uranus first; the
                       giants, Earth, Mars — never Titan/Venus). Quotes the honest trade, or is visible-but-
                       disabled with the reason (#212). The quote is priced once on menu-open (it flies drag). *@
                    @if (AerobrakeMenuQuote(menuBody) is { } abQuote)
                    {
                        bool abArmed = _aerobrakeArmedBodyId == menuBody.Id;
                        <button type="button" class="btn btn-sm @(abArmed ? "btn-success" : abQuote.Offered ? "btn-warning" : "btn-outline-secondary")"
                                disabled="@(!abQuote.Offered && !abArmed)"
                                title="@Aerobrake.Trade(menuBody.Name, abQuote)"
                                @onclick="() => EngageAerobrakeFromMenu(menuBody.Id)">
                            @(abArmed ? $"🪂 Aerobrake armed at {menuBody.Name} — click to disarm" : Aerobrake.MenuAction(menuBody.Name, abQuote))
                        </button>
                    }
                }
                else
                {
                    double vicinity = Math.Max(1.2e10, 8 * menuBody.BodyRadius);
                    Vector2d bodyPosition = _ephemeris!.Position(menuBody.Id, SimTime);
                    string bodyScanLabel = $"scan around {menuBody.Name}";
                    <div class="text-secondary">@ScanCostText(bodyPosition, vicinity)</div>
                    <button type="button" class="btn btn-sm btn-info" title="Sweep the telescope around this body — approaches and local space"
                            @onclick="() => ScanAreaFromMenu(bodyPosition, vicinity, bodyScanLabel)">
                        🔭 Scan around @menuBody.Name — approaches &amp; local space
                    </button>
                }
            </div>
        </div>
    }

    @* M29: the contact menu — clicking a ship selects it for the scope AND offers the real
       actions: telescope tracking and the war-room interest (intercept clock, firing solutions). *@
    @if (_activeDesk is ShipDesk.Nav or ShipDesk.Sensors or ShipDesk.WarRoom && _shipMenuId is { } menuShipId && FindNpc(menuShipId) is { } menuNpc)
    {
        @* #253: a vitals line plus up to three actions (interest · track · scan). *@
        var shipAt = ClampMenu(_shipMenuX, _shipMenuY, 4);
        <div class="map-body-menu bg-dark bg-opacity-75 rounded p-2 text-light small shadow"
             style="left: @(shipAt.X.ToString("F0", CultureInfo.InvariantCulture))px; top: @(shipAt.Y.ToString("F0", CultureInfo.InvariantCulture))px">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold me-2">@menuNpc.Ship.Callsign</span>
                <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Close" title="Close this contact's menu"
                        @onclick="CloseShipMenu"></button>
            </div>
            @if (menuNpc.CurrentlyObserved)
            {
                <div class="text-secondary mb-1">
                    @FormatDistance((menuNpc.State.Position - _ship.Position).Length) ·
                    rel @(((menuNpc.State.Velocity - _ship.Velocity).Length / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s ·
                    @* #210: the SIGNED range-rate — are we closing or opening — same voice as the dossier card. *@
                    @RelativeMotion.WordedBefore(RelativeMotion.ClosingSpeed(_ship.Position, _ship.Velocity, menuNpc.State.Position, menuNpc.State.Velocity)) ·
                    scope tracking her now
                </div>
            }
            else
            {
                @* PR-C, the Barnacle case: a labeled contact with no live fix is never mute. *@
                <div class="text-warning mb-1">
                    no live fix — last seen @(((SimTime - menuNpc.LastObservation!.Value.SimTime) / 86400.0).ToString("F1", CultureInfo.InvariantCulture))d ago
                </div>
            }
            <div class="d-grid gap-1">
                @if (menuNpc.CurrentlyObserved)
                {
                    <button type="button" class="btn btn-sm btn-info" title="Mark her a target of interest — intercept clock and firing solutions"
                            @onclick="() => InterestFromMenu(menuShipId)">
                        🎯 Target of interest — intercept clock &amp; firing solutions
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" title="Put the telescope on her — sharpen the fix"
                            @onclick="() => TrackShipFromMenu(menuShipId)">
                        📡 Track with telescope — sharpen the intel
                    </button>
                }
                @if (_activeDesk == ShipDesk.Sensors)
                {
                    Vector2d scanCenter = menuNpc.CurrentlyObserved
                        ? menuNpc.State.Position
                        : menuNpc.LastObservation!.Value.Position;
                    string shipScanLabel = $"scan near {menuNpc.Ship.Callsign}";
                    <button type="button" class="btn btn-sm btn-outline-info" title="Sweep the telescope around here to find her"
                            @onclick="() => ScanAreaFromMenu(scanCenter, 8e9, shipScanLabel)">
                        🔭 Scan around here@(menuNpc.CurrentlyObserved ? "" : " — find out where she went")
                    </button>
                }
            </div>
        </div>
    }

    @* PR-C: the trade-lane menu — the corridor the owner drew by hand, now a clickable region.
       Replaces the tracking post's "— manual aim —" dropdown: the lane IS the control. *@
    @if (_activeDesk == ShipDesk.Sensors && _corridorMenuLane is { } menuLane)
    {
        @* #253: a sweep-cost line plus the two sweep actions. *@
        var corridorAt = ClampMenu(_corridorMenuX, _corridorMenuY, 3);
        <div class="map-body-menu bg-dark bg-opacity-75 rounded p-2 text-light small shadow"
             style="left: @(corridorAt.X.ToString("F0", CultureInfo.InvariantCulture))px; top: @(corridorAt.Y.ToString("F0", CultureInfo.InvariantCulture))px">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold me-2">📦 @menuLane.Name</span>
                <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Close" title="Close this lane's menu"
                        @onclick="CloseCorridorMenu"></button>
            </div>
            <div class="text-secondary mb-1">
                @{ ScanJob laneJob = TradeCorridors.SweepJobFor(menuLane, _ship.Position); }
                sweep arc @((int)(laneJob.ArcWidthRad * 180 / Math.PI))° from here ·
                @SweepCostText(laneJob)
            </div>
            <div class="d-grid gap-1">
                <button type="button" class="btn btn-sm btn-info" title="Sweep this trade lane once, right now"
                        @onclick="() => SweepCorridorFromMenu(menuLane, standing: false)">
                    📡 Sweep this lane now
                </button>
                <button type="button" class="btn btn-sm btn-outline-info" title="Keep re-sweeping this lane every carousel round"
                        @onclick="() => SweepCorridorFromMenu(menuLane, standing: true)">
                    🔁 Standing lane watch — re-sweep every carousel round
                </button>
            </div>
        </div>
    }

    @* PR-C: the open-sky menu — even empty space answers. What a scan here would take, and the
       guideline hint when the spot sits near a known lane. *@
    @if (_activeDesk == ShipDesk.Sensors && _skyMenuWorld is { } skyPoint)
    {
        @* #253: a scan-cost line plus the scan action (and, near a lane, a sweep). *@
        var skyAt = ClampMenu(_skyMenuX, _skyMenuY, 4);
        <div class="map-body-menu bg-dark bg-opacity-75 rounded p-2 text-light small shadow"
             style="left: @(skyAt.X.ToString("F0", CultureInfo.InvariantCulture))px; top: @(skyAt.Y.ToString("F0", CultureInfo.InvariantCulture))px">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold me-2">✨ Open sky</span>
                <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Close" title="Close this patch's menu"
                        @onclick="CloseSkyMenu"></button>
            </div>
            <div class="text-secondary mb-1">
                @FormatDistance((skyPoint - _ship.Position).Length) out ·
                patch radius @FormatDistance(_skyMenuRadius) · @ScanCostText(skyPoint, _skyMenuRadius)
            </div>
            <div class="d-grid gap-1">
                <button type="button" class="btn btn-sm btn-info" title="Point the telescope at this patch — it always resolves something"
                        @onclick="() => ScanAreaFromMenu(skyPoint, _skyMenuRadius, SkyScanLabel(skyPoint))">
                    🔭 Scan this area — the telescope always resolves <em>something</em>
                </button>
                @if (NearLaneFor(skyPoint) is { } nearLane)
                {
                    <div class="text-info">near the @nearLane.Name</div>
                    <button type="button" class="btn btn-sm btn-outline-info" title="Sweep the nearby trade lane instead"
                            @onclick="() => SweepCorridorFromMenu(nearLane, standing: false)">
                        📡 Sweep the @nearLane.PairName lane instead
                    </button>
                }
            </div>
        </div>
    }

    @* #195 (owner ruling: the NOW/NEXT banner covered the toolbar's 'checklist' and '?' buttons):
       the desk tabs, the pilot banner and the ship-alert strip live in ONE in-FLOW column now (was three
       independently top-anchored absolute layers whose fixed `top`s assumed a one-row banner). Because
       they claim real document-flow height, and the Nav toolbar/readout HUD (.map-hud) below is in flow
       too, a 2–3 row banner PUSHES the toolbar down instead of floating over it — a status surface can
       never again hide a control (#123). *@
    <div class="map-topstack">

    @* Station tab bar (StationDesks.md rule 3): visible aboard on every desk — the keyboard-shortcut
       equivalent for players who'd rather click. Captain (PR-15) leads the bar with its `0` key, ahead
       of Nav's `1`. #330 (owner: "Should the tile buttons even be there when we are not on the ship?"):
       HIDDEN on a surface excursion — the captain is off-ship and the desks are a tube ride away. The
       captain's link to the ship overhead is #327's orbit-comms line, painted across the excursion HUD. *@
    @if (_surface is null)
    {
        <div class="desk-tab-bar bg-dark bg-opacity-75 rounded p-1">
            @foreach (ShipDesk desk in TabBarOrder)
            {
                <button type="button" class="btn btn-sm desk-tab @(_activeDesk == desk ? "btn-info" : "btn-outline-light")"
                        title="Switch to the @DeskLabel(desk) desk"
                        @onclick="() => SwitchDeskFromClick(desk)">
                    @DeskKeyLabel(desk) @DeskLabel(desk)
                </button>
            }
            @* Owner request: temporarily clear every panel to read the map, and back. Toggles the
               .map-peek class (CSS fades the overlays, click passes through to the canvas). Hotkey ` . *@
            <button type="button" class="btn btn-sm desk-tab @(_peekMap ? "btn-warning" : "btn-outline-light")"
                    title="Peek at the map — hide the panels (` toggles)" @onclick="TogglePeekMapFromClick">
                @(_peekMap ? "👁 Show panels" : "👁 Peek")
            </button>
        </div>
    }

    @* #127 (owner ruling: "WHO IS FLYING THE SHIP must be big and unmissable" — he watched the
       autopilot fly him into Saturn thinking he had the stick). One persistent banner at the top of
       the flight view, on every desk. Derived from the same source NavChip reads (_armedOrbitBodyId):
       armed auto-orbit = the autopilot is in command and will fly the approach + insertion itself;
       anything else = the helm answers to you. Click jumps to Nav, where the disarm control lives. *@
    @if (_worldReady && !_deckMode)
    {
        string? _armed = _armedOrbitBodyId;
        bool _autopilot = _armed is not null;
        @* #159/#184: the banner speaks the whole plan. FlightNowNext() is the ONE source (the Nav
           header and desk chips read it too), returning an ordered row list: the pinned NOW row, then
           the queue — each pending burn, then the orbit-insert as its OWN plain-language row (#171/#173,
           no more "step 1/1" crash-or-orbit doubt). The ▲▼ arrows page the queue when it runs past NEXT;
           the NOW row is always the active step, so the list auto-scrolls to what the ship is doing. *@
        FlightPlanStatus _banner = FlightNowNext();
        IReadOnlyList<FlightPlanRow> _rows = _banner.Rows;
        int _queueCount = Math.Max(0, _rows.Count - 1);
        int _rowOffset = _queueCount == 0 ? 0 : Math.Clamp(_bannerRowOffset, 0, _queueCount - 1);
        @* NOW text: the row list, except a #155 dock-ready SUCCESS still speaks its own line while manual. *@
        string _nowText = _rows.Count > 0 ? _rows[0].Text : "NOW: coasting";
        if (!_autopilot && !AutopilotStoodDown && _dockReadyStatus is not null && _nowText == "NOW: coasting")
        {
            _nowText = _dockReadyStatus;
        }
        <div class="pilot-banner @(_autopilot ? "pilot-banner-auto" : "pilot-banner-manual")"
             role="button" tabindex="0"
             title="@(_autopilot ? "The autopilot is flying the ship — click to go to Nav and take back the stick" : "You are flying the ship by hand")"
             @onclick="() => SwitchDeskFromClick(ShipDesk.Nav)">
            <span class="pilot-banner-who">@(_autopilot ? "🛰 AUTOPILOT HAS THE SHIP" : "🧭 YOU HAVE THE SHIP")</span>
            <div class="pilot-banner-rows">
                <div class="pilot-banner-mode pilot-banner-now">@_nowText</div>
                @if (_queueCount > 0)
                {
                    <div class="pilot-banner-queue">
                        <span class="pilot-banner-mode pilot-banner-next">@_rows[1 + _rowOffset].Text</span>
                        @if (_queueCount > 1)
                        {
                            <span class="pilot-banner-pager">
                                <button type="button" class="pilot-banner-arrow" title="Earlier step"
                                        disabled="@(_rowOffset == 0)"
                                        @onclick="BannerPageUp" @onclick:stopPropagation="true">▲</button>
                                <span class="pilot-banner-pageno">@(_rowOffset + 1)/@_queueCount</span>
                                <button type="button" class="pilot-banner-arrow" title="Later step"
                                        disabled="@(_rowOffset >= _queueCount - 1)"
                                        @onclick="BannerPageDown" @onclick:stopPropagation="true">▼</button>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        @* #166: the ship-wide alert strip — collision, fuel, orbit-decay, one voice. Unacknowledged
           alerts shout (red/amber, ✕ to silence); an acknowledged alert lingers dimmed while its
           condition holds. Reads the same ShipAlerts channel the parrot and the ledger read. *@
        if (_shipAlerts.Any)
        {
            <div class="ship-alert-strip">
                @foreach (ShipAlert _alert in _shipAlerts.Active)
                {
                    <div class="ship-alert @(_alert.Severity == AlertSeverity.Red ? "ship-alert-red" : "ship-alert-amber") @(_alert.Acknowledged ? "ship-alert-ack" : null)">
                        <span class="ship-alert-msg">@_alert.Message</span>
                        @* #205: an ACTIONABLE alert (a boarding window) carries its subject — the approve/
                           stand-down chips are reachable HERE, on every desk, even when the alert is dimmed.
                           These are the second door the owner couldn't find on the war-room/captain desks. *@
                        @if (_alert.ActionTargetId is not null)
                        {
                            <button type="button" class="btn btn-sm btn-danger py-0 ship-alert-action"
                                    title="Send the shuttles across and board her — this is piracy" @onclick="AuthorizePlunder">🏴 Board her</button>
                            <button type="button" class="btn btn-sm btn-outline-light py-0 ship-alert-action"
                                    title="Stand the shuttles down — leave her be" @onclick="DeclinePlunder">Stand down</button>
                        }
                        @if (!_alert.Acknowledged)
                        {
                            <button type="button" class="ship-alert-silence" title="Silence this alert (it stays until the condition clears)"
                                    @onclick="() => AcknowledgeAlert(_alert.Kind)">✕</button>
                        }
                    </div>
                }
            </div>
        }
    }
    </div>@* /.map-topstack — tabs · banner · alert strip; the Nav HUD (.map-hud) flows below it *@

    @if (_activeDesk == ShipDesk.Nav)
    {
    <div class="map-hud">
        <div class="btn-toolbar bg-dark bg-opacity-75 rounded p-2 gap-2 align-items-center" role="toolbar" aria-label="Time warp controls">
            <div class="d-flex align-items-center gap-1 me-2 map-warp-control">
                <span class="text-light small">warp</span>
                <input type="range" class="form-range" min="0" max="100" step="1"
                       value="@WarpSliderValue" title="Time warp (log scale)"
                       @oninput="OnWarpSliderInput" @onkeydown:stopPropagation="true" />
                <span class="text-light small text-nowrap map-warp-readout">@WarpReadout</span>
            </div>
            @* #172 — ⏭ skip to next event, beside the warp slider (#236: a button, in the toolbar band).
               Jumps time forward to the next burn/arrival; anything important still pulls you back to 1×.
               Disabled when nothing is armed (no next event to skip to). Becomes ■ stop skip while running. *@
            <button type="button" class="btn btn-sm @(_skipActive ? "btn-warning" : "btn-outline-info") me-2"
                    title="Jump time forward to the next burn/arrival — anything important (a burn, an arrival, an alert) still pulls you back to 1×"
                    disabled="@(!_skipActive && !_skipNext.Found)" @onclick="ToggleSkip">
                @(_skipActive ? "■ stop skip" : "⏭ next event")
            </button>
            @* The long-coast advert: on a >1-day dead coast the ship OFFERS the cheap ride. A button, so
               it lives in the toolbar band, never the banner. The coast is free — the skip spends only time. *@
            @if (ShowLongCoastAdvert)
            {
                <button type="button" class="btn btn-sm btn-outline-warning me-2"
                        title="The coast costs nothing — the skip spends only time. Jump to the next event."
                        @onclick="StartSkip">
                    ⏭ Long coast ahead (@LongCoastDays d) — skip it
                </button>
            }
            @* #246/#249 🚀 the long haul as a toolbar chip — a SECONDARY surface (the map context menu is
               the primary entry) mirroring the offer while a long destination is set. Placement per #236,
               beside the ⏭ advert. Visible-but-disabled with the reason (#212). *@
            @if (LongHaulTargetPlanet(_destinationBodyId) is { } lhChipPlanet && _longHaulDeparture is { Ok: true } lhChipDep)
            {
                string? lhChipBlock = LongHaulOfferBlock(_longHaulDeparture, lhChipPlanet, _longHaulClearanceBlock);
                <button type="button" class="btn btn-sm @(lhChipBlock is null ? "btn-warning" : "btn-outline-secondary") me-2"
                        disabled="@(lhChipBlock is not null)"
                        title="@(lhChipBlock ?? $"Autopilot the whole void to {lhChipPlanet.Name} vicinity in one jump — wake at the capture gate; the last mile stays premium")"
                        @onclick="EngageLongHaul">
                    🚀 Long haul (@lhChipDep.DeparturePulses p)
                </button>
            }
            <button type="button" class="btn btn-sm @(Paused ? "btn-warning" : "btn-outline-light") me-2" title="Pause or resume the flow of sim time" @onclick="TogglePause">
                @(Paused ? "Resume" : "Pause")
            </button>
            <button type="button" class="btn btn-sm @(FollowShip ? "btn-info" : "btn-outline-light") me-2" title="Keep the camera locked on the ship as she flies" @onclick="ToggleFollow">
                Follow Ship
            </button>
            @* #237 — clickable zoom: not every captain has a mouse wheel (and automation drives one
               poorly). One real step per press, zooming toward the viewport centre. *@
            <button type="button" class="btn btn-sm btn-outline-light" title="Zoom the map in one step — no mouse wheel needed" @onclick="() => ZoomStep(zoomIn: true)">
                🔍+
            </button>
            <button type="button" class="btn btn-sm btn-outline-light me-2" title="Zoom the map out one step — no mouse wheel needed" @onclick="() => ZoomStep(zoomIn: false)">
                🔍−
            </button>
            <button type="button" class="btn btn-sm @(PlotMode ? "btn-success" : "btn-outline-light") me-2" title="Switch between flying live and plotting a course on the map" @onclick="TogglePlotMode">
                @(PlotMode ? "Play" : "Plot")
            </button>
            @* Berth at a grey-market dock (a station haven) — clamps on, no steering, the heat bleeds
               off. #212: the button reads the ONE dock truth (_dockAffordance), the nearest DOCKABLE
               haven passing DockRule — never the raw nearest body — so it can never disagree with the
               envelope line. #211: latched so it doesn't blink as the drift phases. #213: when in range
               but too hot it becomes ⚓ Match & clamp, quoting the terminal-match burn (visible paused). *@
            @if (_dockedHavenId is not null)
            {
                <button type="button" class="btn btn-sm btn-warning me-2" @onclick="Undock"
                        title="Release the dock clamps and fly off">🚀 Undock</button>
            }
            else if (_dockAffordance.CanClampNow)
            {
                <button type="button" class="btn btn-sm btn-outline-info me-2" @onclick="ToggleDock"
                        title="Clamp onto the dock and lie low — the heat bleeds off while you're berthed">⚓ Dock</button>
            }
            else if (_dockAffordance.NeedsMatch)
            {
                @* Alongside but coasting too hot to clamp — one press flies the terminal match (the same
                   burn the armed autopilot flies), then leaves the plain ⚓ Dock. *@
                <button type="button" class="btn btn-sm btn-info me-2" @onclick="MatchAndClamp"
                        title="@($"Fly the terminal match — nulls the {(_dockAffordance.RelSpeed / 1000).ToString("F1", CultureInfo.InvariantCulture)} km/s drift into the clamp window, then hit ⚓ Dock")">
                    ⚓ Match &amp; clamp — ≈@(_dockAffordance.MatchPulses) p
                </button>
            }
            else if (_dockAffordance.Phase == DockPhase.TooHot)
            {
                @* In range but the match is unaffordable — refuse with the numbers, greyed so it teaches. *@
                <button type="button" class="btn btn-sm btn-outline-secondary me-2" disabled
                        title="@($"Too hot to clamp — the terminal match needs ≈{_dockAffordance.MatchPulses} p, only {_reactionMassPulses} aboard")">
                    ⚓ Match &amp; clamp — needs ≈@(_dockAffordance.MatchPulses) p
                </button>
            }
            <button type="button" class="btn btn-sm @(_showScope ? "btn-info" : "btn-outline-light") ms-2" title="Open or close the telescope scope window" @onclick="ToggleScope">
                Scope
            </button>
            <a class="btn btn-sm btn-outline-secondary" href="/guide" target="_blank" title="Captain's Guide">?</a>
            @* #292: the nav screen is not a billboard. The checklist toggle is a minimal pointer that
               appears ONLY while a lesson is actually in hand (or its card is open) — no persistent
               tutorial chrome for a veteran. Starting or replaying a lesson lives at the Captain's desk
               (0) → Tutorials, the quieter room where the picker already moved. *@
            @if (ActiveTutorialIndex() >= 0 || _showTutorial)
            {
                <a class="btn btn-sm @(_showTutorial ? "btn-info" : "btn-outline-light")" role="button" @onclick="ToggleTutorial" title="Show/hide the current lesson's checklist — pick or replay lessons at the Captain's desk (0) → Tutorials">
                    🏴 checklist
                </a>
            }
            @* SATURDAY-ANCHOR: toolbar — parallel lanes append one button line each below *@
        </div>

        <div class="map-readouts bg-dark bg-opacity-75 rounded p-2 mt-2 text-light small">
            <div class="mb-1">
                <span class="fw-bold">@_scenarioName</span>
                @if (_plasma is not null)
                {
                    <span class="badge bg-info text-dark ms-1">EU ⚡</span>
                }
            </div>
            <div>Sim time: @FormatSimTime(SimTime)</div>
            @if (_skipActive)
            {
                @* #172: while skipping, the roomy line states the whole thing — where we're headed and the ETA. *@
                <div class="text-info">⏭ skipping to @_skipTargetLabel — ETA @FormatDuration(Math.Max(0, _skipTargetEpoch - SimTime)) @(_effectiveWarp < Warp ? $"(held at {_effectiveWarp}× near a body)" : $"({_effectiveWarp}×)")</div>
            }
            else
            {
                <div>Warp: @(Paused ? "paused" : $"{_effectiveWarp}×") @(Warp != _effectiveWarp ? $"(auto-drop from {Warp}×)" : "")</div>
            }
            <div>Zoom: @FormatZoom(_camera.MetersPerPixel)</div>
            <hr />
            <div>
                Ship speed: @(((_ship.Velocity.Length) / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s
                <span class="text-secondary">(circular here: @((CircularSpeedHere / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s)</span>
            </div>
            <div>Mass pulses: @_reactionMassPulses / @ReactionMassCapacity</div>
            <div>Credits: @_credits.ToString("N0", CultureInfo.InvariantCulture)</div>
            <div>Cargo: @_cargoUnits / @CargoCapacity units@(_cargoValue > 0 ? $" (worth {_cargoValue:N0} cr)" : "")</div>
            @if (OrbitInfo() is { } oi)
            {
                <div class="mt-1 small">
                    @* #175: this body is a cargo run's destination — say the delivery next action right
                       in the nav-target box so the parcel's last step is never invisible. *@
                    @if (ActiveCargoRunTo(oi.Body.Id) is not null)
                    {
                        <div class="map-cargo-deliver">📦 @CargoNextAction(oi.Body)</div>
                    }
                    @if (IsDockableHaven(oi.Body))
                    {
                        @* A mass-less haven has no Hill sphere — you clamp its ⚓ dock, you don't orbit.
                           Same panel slot, dock language, so the capture-range math never lies here. *@
                        <div class="d-flex justify-content-between align-items-center">
                            <span>⚓ Dock at @oi.Body.Name — @DockStatusLine(oi)</span>
                        </div>
                        @if (oi.IsDestination)
                        {
                            <div class="text-secondary">
                                @FormatDistance(oi.Distance) out · clamp within @((DockReachMeters / 1000).ToString("N0", CultureInfo.InvariantCulture)) km ·
                                rel @((oi.RelSpeed / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s
                                (match ≤ @((DockMatchSpeedMps / 1000).ToString("N0", CultureInfo.InvariantCulture)))
                                @if (DestinationEta() is { } eta)
                                {
                                    <text> · @eta</text>
                                }
                                <a role="button" class="text-info text-decoration-none ms-1" title="Drop this destination — stop tracking it"
                                   @onclick="() => SetDestination(null)">clear</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                @(oi.IsDestination ? "🎯" : "🛰") Orbit @oi.Body.Name — @OrbitStatusLine(oi)
                            </span>
                            @if (oi.WindowOpen && oi.RadiusInStableBand)
                            {
                                <button type="button" class="btn btn-sm py-0 @(oi.CanEngage && !NavLockedByDock ? "btn-success" : "btn-outline-secondary")"
                                        disabled="@(!oi.CanEngage || NavLockedByDock)"
                                        title="@(NavLockedByDock ? DockNavLockTip : "Circularize into orbit now — the autopilot holds the park")" @onclick="EnterOrbit">
                                    Enter orbit (@oi.Cost p / O)
                                </button>
                            }
                            else if (oi.WindowOpen)
                            {
                                @* #180 moon-grade orbit: this radius is in the tide-chaotic band (Lab 16 — the
                                   owner's ≈0.53-Hill Enceladus park that silently stripped). NEVER circularize
                                   here silently; the button hands the descent to the autopilot, which parks at
                                   the tide-stable radius. The O-key (EnterOrbit) follows the same logic. *@
                                <button type="button" class="btn btn-sm py-0 @(!NavLockedByDock ? "btn-info" : "btn-outline-secondary")"
                                        disabled="@NavLockedByDock"
                                        title="@(NavLockedByDock ? DockNavLockTip : $"this radius is tide-chaotic (Lab 16) — the autopilot descends to the stable park at {FormatDistance(OrbitRule.ParkingRadius(oi.Body, oi.Hill))}")"
                                        @onclick="EnterOrbit">
                                    🛰 Autopilot to stable park (≈@oi.ApproachCost p)
                                </button>
                            }
                            else if (oi.Bound)
                            {
                                @* #176: already in orbit — the button isn't "off", there's just nothing to arm.
                                   Say so instead of a mute grey "Auto-orbit" that reads like a dead control. *@
                                <button type="button" class="btn btn-sm py-0 btn-outline-success" disabled
                                        title="already orbiting — burn prograde to leave, or ⚓ Dock if it's a haven">
                                    In orbit ✓
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm py-0 @(!NavLockedByDock && oi.Armed ? "btn-success" : !NavLockedByDock && oi.InCaptureRange ? "btn-info" : "btn-outline-secondary")"
                                        disabled="@((!oi.InCaptureRange && !oi.Armed) || NavLockedByDock)"
                                        title="@(NavLockedByDock ? DockNavLockTip : "Arm the autopilot to capture into orbit when she's in range")" @onclick="EnterOrbit">
                                    @(oi.Armed
                                        ? (_disarmConfirmBodyId == oi.Body.Id
                                            ? "Disarm? click again"
                                            : oi.InCaptureRange ? "Autopilot ON — flying" : "Autopilot ON — disarm")
                                        : $"Auto-orbit (≈{oi.ApproachCost} p / O)")
                                </button>
                            }
                        </div>
                        <div class="progress map-orbit-bar" title="distance vs capture range">
                            <div class="progress-bar @(oi.InCaptureRange ? "bg-success" : "bg-info")"
                                 style="width: @(Math.Clamp(100 * oi.CaptureRange / Math.Max(oi.Distance, 1), 2, 100).ToString("F0", CultureInfo.InvariantCulture))%"></div>
                        </div>
                        <div class="progress map-orbit-bar" title="relative speed vs 5 km/s limit">
                            <div class="progress-bar @(oi.RelSpeed < OrbitRule.MaxRelativeSpeed ? "bg-success" : "bg-danger")"
                                 style="width: @(Math.Clamp(100 * OrbitRule.MaxRelativeSpeed / Math.Max(oi.RelSpeed, 1), 2, 100).ToString("F0", CultureInfo.InvariantCulture))%"></div>
                        </div>
                        @if (oi.IsDestination)
                        {
                            <div class="text-secondary">
                                @FormatDistance(oi.Distance) out · capture ≤ @FormatDistance(oi.CaptureRange) ·
                                rel @((oi.RelSpeed / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s
                                (max @((OrbitRule.MaxRelativeSpeed / 1000).ToString("F1", CultureInfo.InvariantCulture)))
                                @if (DestinationEta() is { } eta)
                                {
                                    <text> · @eta</text>
                                }
                                <a role="button" class="text-info text-decoration-none ms-1" title="Drop this destination — stop tracking it"
                                   @onclick="() => SetDestination(null)">clear</a>
                            </div>
                        }
                    }
                </div>
            }
            <div>
                Nearest: @_nearestBody?.Name (@FormatDistance((_ship.Position - _nearestBodyPosition).Length), @(((_ship.Velocity - _nearestBodyVelocity).Length / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s rel)@if (_nearestBody is { } nb && IsDockableHaven(nb) && _dockedHavenId is null)
                {
                    <span class="text-info"> · ⚓ dockable haven — coast within @((DockReachMeters / 1000).ToString("N0", CultureInfo.InvariantCulture)) km, ≤@((DockMatchSpeedMps / 1000).ToString("N0", CultureInfo.InvariantCulture)) km/s to clamp on</span>
                }
            </div>
            @if (_activeRadar)
            {
                <div class="text-danger">📡 ACTIVE RADAR — loud; everyone in earshot knows where we are</div>
            }
            @if (_plasma is not null)
            {
                int chargePct = (int)Math.Round(_ship.Charge * 100);
                string chargeClass = _ship.Charge >= ArcChargeThreshold ? "bg-danger"
                    : _ship.Charge >= 0.6 ? "bg-warning" : "bg-info";
                <hr />
                <div>Charge: @chargePct% @(_ship.Charge >= ArcChargeThreshold ? "— ARCING RISK" : "")</div>
                <div class="progress" role="progressbar" aria-label="Hull charge">
                    <div class="progress-bar @chargeClass" style="width: @chargePct%"></div>
                </div>
                @if (_ship.Charge >= ArcChargeThreshold)
                {
                    <div class="text-danger fw-bold">⚡ ARCING — visible system-wide</div>
                }
            }
            @if (_pulse.Message is not null)
            {
                <div class="text-warning">@_pulse.Message</div>
            }
            @if (_captureEngaged)
            {
                <hr />
                <div class="fw-bold text-success">🚀 SHUTTLES AWAY — boarding @_captureTargetCallsign</div>
                <div class="progress my-1" role="progressbar" aria-label="Boarding progress" style="height: 1.1rem;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                         style="width: @(((int)(_captureProgress * 100)))%">@((int)(_captureProgress * 100))%</div>
                </div>
                @* Owner ("let's make it more clear"): the autosteal crawls because boarding runs on
                   WALL-CLOCK, not sim time — cranking warp does nothing. Say the ETA, say warp won't
                   help, and say how to hurry it (a tighter, slower match cuts RequiredSecondsFor). *@
                <div class="small">
                    ≈ @(Math.Max(0, (1 - _captureProgress) * _captureRequiredSeconds).ToString("F0", CultureInfo.InvariantCulture)) s left ·
                    <span class="text-warning">real-time — warp won't hurry it</span>
                    <span class="text-secondary">· hold the match; closer &amp; slower boards faster</span>
                </div>
                @* #202: show what is being taken AS it transfers — no more forensic accounting. The
                   take is the hull's cargo capped by our free hold; priced through the same fence market
                   the loot line and the credited value read. *@
                @if (SelectedCaptureTarget() is { } prey && prey.Ship.CargoUnits > 0)
                {
                    int hold = CargoCapacity - _cargoUnits;
                    int take = Math.Max(0, Math.Min(prey.Ship.CargoUnits, hold));
                    <div class="small text-warning">
                        📦 Prising loose @take units of @prey.Ship.CargoClass — est.
                        @((take * CargoMarket.UnitValue(prey.Ship.CargoClass)).ToString("N0", CultureInfo.InvariantCulture)) cr
                        @(take < prey.Ship.CargoUnits ? "(hold's filling — the rest stays with her)" : "")
                    </div>
                }
            }
            @* #177/#178 — a boardable hull is in range, but piracy is never automatic. Offer it;
               the shuttles do not move until the captain says so. Standing down is free and silent. *@
            @if (_plunderOpportunityTargetId is not null)
            {
                <hr />
                <div class="fw-bold text-warning">🏴 PLUNDER OPPORTUNITY — @_captureTargetCallsign in boarding range</div>
                <div class="small text-secondary mb-1">
                    Boarding @_captureTargetCallsign is PIRACY — you'll take their cargo and carry the heat.
                    Hostile acts need the captain's word.
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-danger" title="Send the shuttles across and board her — this is piracy" @onclick="AuthorizePlunder">🏴 Board her — commit piracy</button>
                    <button type="button" class="btn btn-sm btn-outline-light" title="Stand the shuttles down — leave her be" @onclick="DeclinePlunder">Stand down</button>
                </div>
            }
        </div>

        @* #135/#143 — reference-frame selector. Near a gas giant a moon-to-moon course is useless in
           the solar frame: the primary's ~10 km/s solar orbit drowns the interesting motion. Pick the
           body every time-parameterized draw is expressed co-moving with. Default Sun (inertial); inside
           a giant's Hill sphere that giant is suggested (✦) but never auto-selected — the owner asked for
           a CHOICE. The v-readout is quoted in, and labelled with, the chosen frame. #143: this ONE
           selection governs BOTH the Play-view ribbon/scrub path and the Plot curves, so the chip lives
           OUTSIDE the Plot panel and is visible in both views — the ruler is never silent. *@
        <div class="map-frame bg-dark bg-opacity-75 rounded p-2 mt-2 text-light small">
            <div class="map-plot-frame d-flex flex-wrap align-items-center gap-1">
                <span class="text-secondary">frame:</span>
                @foreach (FrameOption opt in FrameOptions())
                {
                    bool active = opt.Id == _plotFrameBodyId;
                    <button type="button"
                            class="btn btn-sm py-0 @(active ? "btn-info" : opt.Suggested ? "btn-outline-warning" : "btn-outline-light")"
                            title="@opt.Title"
                            @onclick="() => SetPlotFrame(opt.Id)">@opt.Label@(opt.Suggested && !active ? " ✦" : "")</button>
                }
                @* #206 — the compact chips above are contextual (Sun · local giant · target); this overflow
                   makes EVERY body pickable as origin from anywhere (owner: "All planets and moons need it"),
                   grouped by parent. The pick gives it an active chip; #144's law holds (one frame rules map
                   + plotting ribbon + readouts). *@
                <select class="form-select form-select-sm py-0 map-frame-picker"
                        value="@(_plotFrameBodyId ?? "")" @onchange="OnFramePicked"
                        title="Pick ANY planet, moon, or station as the map/plot origin — the choice rules both views (#206)">
                    @* value="" (Sun / inertial) shows this placeholder; an exotic frame shows its own name,
                       so the picker always reads the live origin and pairs with its chip. *@
                    <option value="">frame… ▾</option>
                    @foreach ((string groupLabel, List<CelestialBody> members) in FramePickerGroups())
                    {
                        <optgroup label="@groupLabel">
                            @foreach (CelestialBody b in members)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </optgroup>
                    }
                </select>
                <span class="text-secondary ms-1" title="Ship speed in the selected frame">@FrameSpeedReadout()</span>
            </div>
        </div>

        @if (PlotMode)
        {
            <div class="map-plot bg-dark bg-opacity-75 rounded p-2 mt-2 text-light small">
                <div class="fw-bold mb-1">Plotting</div>
                <div class="mb-1">Scrub: @FormatSimTime(ScrubTime)</div>
                @* stopPropagation: arrow keys must adjust the control, not fire live ship pulses. *@
                <input type="range" class="form-range" min="0" max="@CurrentPlotHorizonSeconds" step="3600"
                       title="Scrub the plot clock forward and back along the course"
                       @bind="_scrubOffsetSeconds" @bind:event="oninput" @onkeydown:stopPropagation="true" />
                <div class="mb-1 d-flex justify-content-between align-items-center">
                    <span>Path length: @FormatHorizon(CurrentPlotHorizonSeconds)</span>
                    <button type="button" class="btn btn-sm py-0 @(_horizonChoice == "auto" ? "btn-info" : "btn-outline-light")"
                            title="Let the nav line pick its own length automatically"
                            @onclick="SetHorizonAuto">auto</button>
                </div>
                @* Same full-width form-range as the scrub slider above it. *@
                <input type="range" class="form-range" min="0" max="100" step="1"
                       value="@HorizonSliderValue" title="Length of the navigation line (log scale)"
                       @oninput="OnHorizonSliderInput" @onkeydown:stopPropagation="true" />
                @* #209 — say the state: when a frame crop or the projection cap makes the drawn ribbon
                   shorter than the full picture, name why (never a silently short path). *@
                @{ var _ribbonNote = RibbonHorizonNote(); }
                @if (_ribbonNote is { } _rn)
                {
                    <div class="small map-ribbon-note @(_rn.Warn ? "text-warning fw-bold" : "text-info")"
                         title="How long a stretch of the plotted course the ribbon actually draws, and why">@_rn.Text</div>
                }
                @* #168: this pass/insertion block appears and vanishes at plot cadence (a closest pass
                   comes and goes as the sim ticks / the scrub moves) and its text reflows. Reserve its
                   tallest state (pass line + insert button) in an always-rendered fixed-height container
                   so the burn steps below never jump under a repeated ±15° click. *@
                <div class="map-plot-passline">
                    @if (_closestPass is { } cp)
                    {
                        <div class="small mb-1 @(cp.Impact ? "text-danger fw-bold" : cp.Severity < 5 ? "text-warning" : "text-secondary")">
                            Closest pass: @cp.BodyName @FormatDistance(cp.Distance) (@cp.Severity.ToString("0.0", CultureInfo.InvariantCulture) R)
                            @(cp.Impact ? "— IMPACT, captain! 🦜" : "")
                        </div>
                        @if (_armablePass is { } ap && PassIsOrbitable(ap) is { } est)
                        {
                            <div class="small mb-1">
                                <button type="button" class="btn btn-sm py-0 @(_armedOrbitBodyId == ap.BodyId ? "btn-success" : "btn-outline-info")"
                                        title="Arm the autopilot to insert into orbit at this pass"
                                        @onclick="() => ToggleArmedInsertion(ap.BodyId)">
                                    🛰 @(_armedOrbitBodyId == ap.BodyId
                                        ? $"Insertion ARMED — will orbit {ap.BodyName} (≈{est} p)"
                                        : $"Insert at {ap.BodyName} pass — {FormatDistance(ap.Distance)} (≈{est} p)")
                                </button>
                            </div>
                        }
                    }
                    else if (_armedOrbitBodyId is not null)
                    {
                        <div class="small mb-1 text-info">🛰 Insertion armed: @_armedOrbitBodyId</div>
                    }
                </div>
                @* PR-D2 · the flight plan OWNS the step editors (docs/WednesdayPlan/UnifiedNavListNotes.md,
                   GeminiUINotes.md). The burn list IS the plan; the old floating sling/skim panels are now
                   scratchpad COMPOSE rows (FMS pattern — solve→preview→commit); every committed step
                   expands in place (accordion — one open at a time), so each step's buttons live inside
                   its own row, not loose on the HUD. The NOW/NEXT line is derived through the same Core
                   helper the pilot banner reads, so the two never disagree. *@
                @{
                    FlightPlanStatus _fp = FlightNowNext();
                    int _fpCount = FlightPlanStepCount();
                }
                <div class="map-flightplan-head mb-2">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fw-bold">🗺 Flight plan</span>
                        @if (_fpCount > 0)
                        {
                            <span class="text-secondary">step @FlightPlanCurrentStep() of @_fpCount</span>
                        }
                    </div>
                    @* #168: NowLine wraps 1↔3 lines and NextLine toggles as the autopilot text changes.
                       Reserve the common 2-line case (now + next) so the frequent 1↔2 flicker can't shove
                       the burn steps below mid-click; a rare 3+-line NowLine may still grow (acceptable). *@
                    <div class="map-flightplan-status">
                        <div class="map-flightplan-now">@_fp.NowLine</div>
                        @if (_fp.NextLine is { } _nextLine)
                        {
                            <div class="map-flightplan-next">@_nextLine</div>
                        }
                    </div>
                </div>
                @* Compose new steps (scratchpad). Add-burn seeds a step at the scrub and opens it; a
                   slingable / skimmable pass offers its own solver as a compose editor that COMMITS a step. *@
                @* #168: the sling / skim compose buttons appear only when the current plot has a
                   slingable / skimmable pass — they toggle at plot cadence and can wrap this row 1↔2
                   lines. Reserve the tallest state so the burn steps below never jump under a click. *@
                <div class="map-plot-compose d-flex flex-wrap align-items-center mb-2 gap-2">
                    <button type="button" class="btn btn-sm btn-outline-light" title="Drop a new burn onto the plan at the scrub time" @onclick="AddBurnAtScrub">
                        + Add burn at scrub
                    </button>
                    @if (_slingablePass is { } sp)
                    {
                        <button type="button" class="btn btn-sm @(_openEditor == FlightEditorKind.Sling ? "btn-info" : "btn-outline-info")"
                                title="Open the sling solver for this flyby" @onclick="ToggleSlingPanel">⤴ Add sling past @sp.BodyName</button>
                    }
                    @if (_skimmablePass is { } kp)
                    {
                        <button type="button" class="btn btn-sm @(_openEditor == FlightEditorKind.Skim ? "btn-danger" : "btn-outline-danger")"
                                title="Open the skim solver for this atmosphere pass" @onclick="ToggleSkimPanel">🔥 Add skim @kp.BodyName</button>
                    }
                    <span class="ms-auto text-nowrap">Planned: @PlannedPulseTotal() / @_reactionMassPulses</span>
                </div>
                @* PR-G · the sling compose editor — SOLVE previews against the real integrator (labs 19/20's
                   crank); "Add the burn" COMMITS the solved node into the plan below. *@
                @if (_openEditor == FlightEditorKind.Sling && _slingablePass is { } slp)
                {
                    <div class="map-step-editor map-sling-body bg-dark bg-opacity-50 rounded p-2 mb-2">
                        <div class="fw-bold small mb-1">⤴ Compose sling past @slp.BodyName</div>
                        <div class="btn-group btn-group-sm w-100 mb-2" role="group" aria-label="Sling side">
                            <button type="button" class="btn @(_slingSide == SlingPlanner.PassSide.Lead ? "btn-success" : "btn-outline-secondary")"
                                    title="Pass on the leading side — steal speed, boost outward" @onclick="() => SetSlingSide(SlingPlanner.PassSide.Lead)">Lead — boost</button>
                            <button type="button" class="btn @(_slingSide == SlingPlanner.PassSide.Trail ? "btn-warning" : "btn-outline-secondary")"
                                    title="Pass on the trailing side — shed speed, brake" @onclick="() => SetSlingSide(SlingPlanner.PassSide.Trail)">Trail — brake</button>
                        </div>
                        <div class="mb-1">Pass distance:
                            <strong>@_slingPassRadii.ToString("0.#", CultureInfo.InvariantCulture) planet radii</strong>
                            <span class="text-secondary">(point-mass floor @SlingMinRadii.ToString("0", CultureInfo.InvariantCulture) R)</span>
                        </div>
                        @* stopPropagation: arrow keys adjust the slider, not fire live ship pulses. *@
                        <input type="range" class="form-range" min="@SlingMinRadii" max="@SlingMaxRadii" step="0.5"
                               value="@_slingPassRadii.ToString(CultureInfo.InvariantCulture)"
                               title="Set how close the flyby skims the planet, in radii"
                               @oninput="OnSlingRadiiInput" @onkeydown:stopPropagation="true" />
                        <div class="text-secondary mb-2">@SlingNodeNoteNow() — solver may propose its own node</div>
                        <button type="button" class="btn btn-sm btn-outline-info w-100 mb-2" disabled="@_slingSolving"
                                title="Fly the sling through the real integrator and preview it" @onclick="RunSlingSolveAsync">@(_slingSolving ? "solving…" : "SOLVE the sling")</button>
                        @if (_slingFailure is { } fail)
                        {
                            <div class="text-warning">⚠ @fail</div>
                        }
                        else if (_slingResult is { Ok: true } r)
                        {
                            <div class="map-sling-verdict">
                                <div>@SlingPassLine(r)</div>
                                <div>@SlingBurnLine(r)</div>
                                <div class="@(r.SpeedGain >= 0 ? "text-success" : "text-warning")">@SlingOutcomeLine(r)</div>
                                <div class="text-warning">@SlingLeverLine(r)</div>
                                <button type="button" class="btn btn-sm btn-success w-100 mt-1" title="Commit this solved sling as a burn on the plan" @onclick="AddSlingBurn">Add the burn → commit step</button>
                            </div>
                        }
                    </div>
                }
                @* PR-I · the skim compose editor — SOLVE flies the pass through the real drag model; the
                   three-zone corridor gauge shows what actually flies; "Add the burn" COMMITS the step. *@
                @if (_openEditor == FlightEditorKind.Skim && _skimmablePass is { } skp)
                {
                    <div class="map-step-editor map-skim-body bg-dark bg-opacity-50 rounded p-2 mb-2">
                        <div class="fw-bold small mb-1">🔥 Compose skim @skp.BodyName</div>
                        <div class="mb-1">Periapsis depth:
                            <strong>@_skimAltKm.ToString("0", CultureInfo.InvariantCulture) km</strong>
                            <span class="text-secondary">(shell top @SkimShellTopKm().ToString("0", CultureInfo.InvariantCulture) km)</span>
                        </div>
                        @* stopPropagation: arrow keys move the slider, not fire live ship pulses. *@
                        <input type="range" class="form-range" min="1" max="@SkimShellTopKm().ToString("0", CultureInfo.InvariantCulture)" step="1"
                               value="@_skimAltKm.ToString("0", CultureInfo.InvariantCulture)"
                               title="Set the periapsis depth of the skim, in km"
                               @oninput="OnSkimAltInput" @onkeydown:stopPropagation="true" />
                        <button type="button" class="btn btn-sm btn-outline-danger w-100 mb-2" disabled="@_skimSolving"
                                title="Fly the skim through the drag model and preview it" @onclick="RunSkimSolveAsync">@(_skimSolving ? "flying the pass…" : "SOLVE the skim")</button>
                        @if (_skimFailure is { } fail)
                        {
                            <div class="text-warning">⚠ @fail</div>
                        }
                        else if (_skimResult is { } g)
                        {
                            @* The corridor gauge: three labeled zones read off the flown DragReport. *@
                            <div class="map-skim-gauge">
                                <div class="map-skim-zone @(g.TooShallow ? "fw-bold" : "text-secondary")">
                                    @(g.ArrivalHyperbolic ? "▲ skip — she bounces" : "▲ too shallow") @(g.TooShallow ? "◀" : "")
                                </div>
                                <div class="map-skim-zone @(g.InCorridor ? "text-success fw-bold" : "text-secondary")">
                                    ● the corridor @(g.InCorridor ? "◀" : "")
                                </div>
                                <div class="map-skim-zone @(g.TooDeep ? "text-danger fw-bold" : "text-secondary")">
                                    ▼ too deep — would hole the sail @(g.TooDeep ? "◀" : "")
                                </div>
                            </div>
                            <div class="map-skim-verdict mt-1">
                                <div>@SkimDepthLine(g)</div>
                                <div class="@(g.TooDeep ? "text-danger" : g.InCorridor ? "text-success" : "text-secondary")">@SkimShedLine(g)</div>
                                <div>@SkimOutcomeLine(g)</div>
                                <div class="text-secondary map-skim-fineprint">@SkimFinePrint()</div>
                                <button type="button" class="btn btn-sm @(g.TooDeep ? "btn-danger" : "btn-success") w-100 mt-1"
                                        title="Commit this solved skim as a burn on the plan" @onclick="AddSkimBurn">@(g.TooDeep ? "Add the burn anyway — fly into the red" : "Add the burn → commit step")</button>
                            </div>
                        }
                    </div>
                }
                @if (_destinationBodyId is not null && _ancientCharges > 0)
                {
                    @* M28: the Ancients' pilot — scarce alien auto-plot, found at the pyramids. *@
                    <button type="button" class="btn btn-sm btn-warning w-100 mb-2" title="Spend an Ancients' charge to auto-plot the whole course" @onclick="UseAncientsPilot">
                        ◬ The Ancients' pilot — lay course to @BodyName(_destinationBodyId) (@_ancientCharges left)
                    </button>
                }

                @if (_planNodes.Count == 0 && _armedOrbitBodyId is null)
                {
                    <div class="text-secondary">No maneuver nodes. Scrub to a future time and add a burn.</div>
                }
                else
                {
                    <div class="map-plot-nodes">
                        @foreach (PlanNode node in _planNodes)
                        {
                            @* PR-D2: each burn is a step. Collapsed, it shows a glanceable line (type +
                               direction + countdown); clicking the line expands its editor in place
                               (accordion — one open at a time). The state pip (planned / done / stale)
                               rides the left edge so the plan reads at a glance. *@
                            FlightStepState _bs = FlightPlanStatusBuilder.BurnState(node.Stale, node.Executed);
                            bool _open = _openEditor == FlightEditorKind.Burn && ReferenceEquals(node, _selectedPlanNode);
                            <div class="mb-1 map-plan-step map-plan-step-@_bs.ToString().ToLowerInvariant() @(node.Stale ? "text-decoration-line-through text-secondary" : "") @(_open ? "map-plan-step-open" : "") @(ReferenceEquals(node, _selectedPlanNode) ? "map-plot-node-selected" : "")">
                                <div class="map-plan-step-line" role="button" tabindex="0"
                                     title="Click to @(_open ? "collapse" : "edit") this step"
                                     @onclick="() => ToggleBurnEditor(node)">
                                    <span class="map-plan-step-pip" title="@_bs" aria-hidden="true"></span>
                                    <span class="map-plan-step-caret" aria-hidden="true">@(_open ? "▾" : "▸")</span>
                                    <span class="flex-grow-1">@BurnGlanceLine(node)</span>
                                    <span class="text-secondary small text-nowrap">@FormatSimTime(node.SimTime)</span>
                                </div>
                                @if (_open)
                                {
                                    @* #838 · THE PLANNER PLANS IN THE VECTOR VIEW, AND IN FOUR WORDS. Owner:
                                       "I almost always use those four directions in respect to our trajectory…
                                       the intermediate angles are the exception." Ruling A (2026-08-17): the ±
                                       idiom — the mode toggle, the prograde/retrograde pair AND the ±15° ↺/↻
                                       nudges — leaves this panel for good and stays where it works, in reflex
                                       flying (the live +/−/arrow keys). What stands here instead: four quick
                                       selects solved in the GHOST'S frame at THIS node's epoch, and free aim
                                       underneath as the exception. *@
                                    <div class="map-plan-step-edit">
                                        <div class="map-burn-quick" role="group" aria-label="Burn direction at this node">
                                            @foreach (NodeDirection _dir in NodeFrame.QuickSelects)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm @(NodeAimedAlong(node, _dir) ? "btn-info" : "btn-outline-info")"
                                                        title="@NodeFrame.Hint(_dir, PlanningPrimaryName(node.SimTime))"
                                                        @onclick="() => SetNodeDirection(node, _dir)">@NodeFrame.Label(_dir)</button>
                                            }
                                        </div>
                                        @* #926 · FLYING WITH THE MOUSE ALONE. Owner (2026-08-17, playing): "Let's add
                                           the plus and minus buttons to the burn scrub angle … the vector rotation is
                                           good for flying with mouse alone, without inputting … like ±5 degrees." Five
                                           degrees off whatever the node points at now — a quick select then a nudge or
                                           two, and the aim is set without the keyboard ever coming into it. The face is
                                           an ANGLE (a degree sign), because this is the vector view's own idiom and not
                                           the reflex-flying control #916 sent back to the live keys. *@
                                        <div class="map-burn-nudge" role="group" aria-label="Nudge this burn's aim five degrees">
                                            <button type="button" class="btn btn-sm btn-outline-info"
                                                    title="@NodeFrame.NudgeHint(-1)"
                                                    @onclick="() => NudgeNodeAim(node, -1)">@NodeFrame.NudgeLabel(-1)</button>
                                            <button type="button" class="btn btn-sm btn-outline-info"
                                                    title="@NodeFrame.NudgeHint(1)"
                                                    @onclick="() => NudgeNodeAim(node, 1)">@NodeFrame.NudgeLabel(1)</button>
                                        </div>
                                        @* #926 — the frame note now says BOTH frames the panel lives between: the one the
                                           aim is solved in (the node's, #916) and the one the plan is READ in (the plot
                                           frame). The second one is what the owner had to remember to switch by hand. *@
                                        <div class="map-burn-frame-note text-secondary">
                                            @NodeFrame.FrameNote(PlanningPrimaryName(node.SimTime)) · @TripFrame.ReadingNote(PlotFrameName())
                                        </div>
                                        @* #926 · ONE LINE, ONE PRESS. Owner (2026-08-17): "the real thrust amounts are
                                           dependent on the coordinate origin. I had to remember to switch to Sun to get
                                           the ship to really start moving from Earth towards Mars." Ruling A: name the
                                           frame, offer the trip's — never switch by yourself. The press moves what the
                                           captain JUDGES by (the ribbon, the numbers); the quick selects go on aiming in
                                           the node's frame, because an escape burn is Earth-prograde either way. *@
                                        @if (TripFrameOffer(node.SimTime) is { } _offer)
                                        {
                                            <div class="map-burn-frame-offer">
                                                <div class="map-burn-frame-offer-line">@TripFrame.OfferLine(PlotFrameName(), _offer.DestinationName, _offer.FrameName)</div>
                                                <button type="button" class="btn btn-sm btn-warning w-100"
                                                        title="@TripFrame.OfferButtonHint(_offer.FrameName)"
                                                        @onclick="() => SetPlotFrame(_offer.FrameId)">@TripFrame.OfferButton(_offer.FrameName)</button>
                                            </div>
                                        }
                                        <div class="map-burn-aim d-flex flex-wrap align-items-center gap-1">
                                            @* Free aim — the exception the vector view keeps. #201: the burn angle is
                                               ship-heading-RELATIVE by default — 0 = straight ahead, +90 = starboard,
                                               −90 = port. The rel/abs toggle keeps the world heading a click away; the
                                               stored HeadingDegrees is always world-space (BurnHeadingConvention). *@
                                            <div class="input-group input-group-sm map-plot-heading">
                                                <input type="text" inputmode="decimal" class="form-control form-control-sm"
                                                       value="@(_burnAngleAbsolute
                                                           ? node.HeadingDegrees.ToString("0.#", CultureInfo.InvariantCulture)
                                                           : BurnHeadingConvention.WorldToRelative(HeadingAlongCourseAt(node.SimTime), node.HeadingDegrees).ToString("+0.#;-0.#;0", CultureInfo.InvariantCulture))"
                                                       title="@(_burnAngleAbsolute
                                                           ? "Free aim — absolute nose heading in degrees (0° = +X, counter-clockwise)"
                                                           : "Free aim — burn angle off the course at this node: 0 = straight ahead, +90 = starboard (right), −90 = port (left)")"
                                                       @onchange="e => SetHeading(node, e)" @onkeydown:stopPropagation="true" />
                                                <span class="input-group-text">°</span>
                                                <button type="button" class="btn btn-outline-secondary"
                                                        title="@(_burnAngleAbsolute ? "Reading absolute world heading — click for course-relative (the angle off the track)" : "Reading course-relative angle (0 ahead, +90 starboard, −90 port) — click for absolute world heading")"
                                                        @onclick="() => _burnAngleAbsolute = !_burnAngleAbsolute">@(_burnAngleAbsolute ? "abs" : "rel")</button>
                                            </div>
                                            @* stopPropagation: typing -/+/arrows here must edit the number, not fire live pulses. *@
                                            <input type="number" class="form-control form-control-sm map-plot-pulses"
                                                   min="1" max="@MaxNodePulses" value="@node.Pulses"
                                                   title="Pulses this burn spends"
                                                   @onchange="e => SetPulses(node, e)" @onkeydown:stopPropagation="true" />
                                            @* Text (not number) input so the 4-decimal padding actually shows —
                                               browsers strip trailing zeros from type=number. Owner: at least
                                               ".0000" must be visible for fine thrust trims. *@
                                            <div class="input-group input-group-sm map-plot-percent">
                                                <input type="text" inputmode="decimal" class="form-control form-control-sm"
                                                       value="@(node.Percent.ToString("0.0000", CultureInfo.InvariantCulture))"
                                                       title="Per-pulse thrust strength in percent — any decimal, shown to four places"
                                                       @onchange="e => SetPercent(node, e)" @onkeydown:stopPropagation="true" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-info" title="Re-time to scrub"
                                                    @onclick="() => RetimeToScrub(node)">@@</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                                    @onclick="() => DeleteNode(node)">&times;</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        @* PR-D2: armed auto-orbit is the terminal step. Collapsed it names the body + state
                           (ARMED → ACTIVE while the autopilot flies the approach); expanded it gains its own
                           disarm control, so the insertion's button lives in its step like every other. The
                           docked-guard (NavLockedByDock) still gates arming/disarming. *@
                        @if (_armedOrbitBodyId is not null)
                        {
                            string _armedId = _armedOrbitBodyId;
                            FlightStepState _is = FlightPlanStatusBuilder.InsertionState(AutopilotFlyingApproach);
                            bool _active = _is == FlightStepState.Active;
                            bool _insOpen = _openEditor == FlightEditorKind.Insertion;
                            <div class="mb-1 map-plan-step map-plan-step-@_is.ToString().ToLowerInvariant() @(_insOpen ? "map-plan-step-open" : "")">
                                <div class="map-plan-step-line" role="button" tabindex="0"
                                     title="Click to @(_insOpen ? "collapse" : "manage")the insertion"
                                     @onclick="ToggleInsertionEditor">
                                    <span class="map-plan-step-pip" title="@_is" aria-hidden="true"></span>
                                    <span class="map-plan-step-caret" aria-hidden="true">@(_insOpen ? "▾" : "▸")</span>
                                    <span class="flex-grow-1">
                                        🛰 @(_orbitKept ? "Holding orbit at" : HarborVocabulary.ArmedStepVerb(HarborClassOf(_armedId))) @BodyName(_armedId)
                                        <span class="text-secondary">— @(_orbitKept ? (_keepTrimPulsesPerDay > 0 ? $"keeping · trim ≈{_keepTrimPulsesPerDay} p/day" : "keeping the park") : _active ? "flying the approach" : "armed · waiting for the window")</span>
                                        @* The promise the autopilot quoted at arm time (#146): the whole-journey
                                           budget it proved affordable before committing. #928: the number is the
                                           CHARGED one — the autopilot's tenth — which is also what the tank is
                                           really billed as the burns fire, so this line and the expellant gauge
                                           can never tell two stories. *@
                                        @if (_armedBudgetPulses > 0)
                                        {
                                            <span class="text-info small">· budgeted ≈@(_armedBudgetPulses) p</span>
                                            <span class="text-secondary small d-block">💸 the autopilot flies at a tenth of the tank a hand would spend</span>
                                        }
                                        @* #146: the in-well transfer plan riding under this arm — the
                                           planner's one-line quote while the cheap Lambert arc is active. *@
                                        @if (_armedTransferSummary is not null)
                                        {
                                            <span class="text-info small d-block">🛰 @_armedTransferSummary</span>
                                        }
                                    </span>
                                    @if (ArmedInsertionSimTime is { } _it)
                                    {
                                        <span class="text-secondary small text-nowrap">@FormatSimTime(_it)</span>
                                    }
                                    <span class="badge @(_orbitKept ? "bg-success" : _active ? "bg-info text-dark" : "bg-secondary")">@(_orbitKept ? "KEEPING" : _active ? "ACTIVE" : "ARMED")</span>
                                </div>
                                @if (_insOpen)
                                {
                                    <div class="map-plan-step-edit">
                                        <button type="button" class="btn btn-sm btn-outline-warning w-100"
                                                disabled="@NavLockedByDock" title="@(NavLockedByDock ? DockNavLockTip : "Stand the autopilot down and fly the ship by hand")"
                                                @onclick="() => ToggleArmedInsertion(_armedId)">
                                            🛰 @(_orbitKept ? "Hand back the ship — release the kept orbit at" : HarborClassOf(_armedId) == HarborClass.Dock ? "Disarm the dock approach to" : "Disarm auto-orbit at") @BodyName(_armedId)
                                        </button>
                                        <div class="text-secondary small mt-1">@(_orbitKept ? "The autopilot is HOLDING this orbit with trims. Release it and you fly by hand — it takes a confirming second click (#179)." : $"Target: {BodyName(_armedId)} — set from the navigation-target panel below; disarm here, then arm a different body.")</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @* M25: the navigation-target panel — its own box, plain words. States exactly what the
       plotted course's nearest point to the destination needs before auto-orbit can take over:
       "the whole point of navigation there" (owner). *@
    @if (PlotMode && _destinationBodyId is not null)
    {
        <div class="map-dest-panel bg-dark bg-opacity-75 rounded p-3 text-light">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-6">🎯 Navigation target: @BodyName(_destinationBodyId)</span>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                        title="Clear the navigation target" @onclick="() => SetDestination(null)">clear target</button>
            </div>
            @if (_destinationPass is { } dp && DestinationPassInfo(dp) is { } info)
            {
                <div class="mb-1">
                    Closest approach on the plotted course: <strong>@FormatDistance(dp.Distance)</strong>
                    at @FormatSimTime(dp.SimTime)
                    <button type="button" class="btn btn-sm btn-outline-info py-0 ms-1"
                            title="Jump the scrub clock to the closest approach" @onclick="() => ScrubToDestinationPass(dp)">scrub to it</button>
                </div>
                @if (info.InRange)
                {
                    <div class="text-success mb-1">
                        ✓ This course passes <strong>inside capture range</strong>
                        (@FormatDistance(info.CaptureRange)). Arm the autopilot and the ship parks
                        itself: approach burn, tidal trims, insertion.
                    </div>
                }
                else
                {
                    <div class="text-warning mb-1">
                        ✗ Capture range is @FormatDistance(info.CaptureRange) — this course misses it by
                        <strong>@FormatDistance(dp.Distance - info.CaptureRange)</strong>.
                        Trim a burn (usually brake a touch earlier) until this line turns green.
                    </div>
                }
                <div class="text-secondary mb-2">
                    Speed at the pass: @((info.RelSpeed / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s
                    relative — the autopilot's burns from there cost ≈ @info.EstPulses pulses.
                </div>
                <button type="button" class="btn btn-sm @(!NavLockedByDock && _armedOrbitBodyId == dp.BodyId ? "btn-success" : !NavLockedByDock && info.InRange ? "btn-info" : "btn-outline-info")"
                        disabled="@NavLockedByDock" title="@(NavLockedByDock ? DockNavLockTip : ArmMenuHint(dp.BodyId))"
                        @onclick="() => ToggleArmedInsertion(dp.BodyId)">
                    @(_armedOrbitBodyId == dp.BodyId
                        ? $"🛰 Autopilot ARMED for {dp.BodyName} — click to disarm"
                        : HarborClassOf(dp.BodyId) == HarborClass.Dock
                            ? HarborVocabulary.ArmAction(HarborClass.Dock, dp.BodyName)
                            : $"🛰 Arm auto-orbit at {dp.BodyName}")
                </button>
            }
            else
            {
                <div class="text-secondary">Projecting the course… the closest pass appears here in a moment.</div>
            }

            @* #246/#249 🚀 LONG HAUL — the destination's OWN planet is the void mode's stop. The OFFER is the
               solved cheap DEPARTURE (reachable from a berth or any coast), never gated on the current coast
               reaching. The current-coast Reach still speaks the honest PROMISE VERDICT ("does NOT reach —
               closest pass X AU") for a manual coast. Visible-but-disabled with the reason, never hidden (#212). *@
            @if (LongHaulTargetPlanet(_destinationBodyId) is { } lhPlanet)
            {
                string lhDestName = _destinationBodyId is { } lhDestId ? BodyName(lhDestId) : lhPlanet.Name;
                string? lhBlock = LongHaulOfferBlock(_longHaulDeparture, lhPlanet, _longHaulClearanceBlock);
                <div class="mt-2 pt-2 border-top border-secondary">
                    @* The manual-coast verdict: does THIS course reach, or how far does it miss? *@
                    @if (_longHaulReach is { } lhReach)
                    {
                        <div class="@(lhReach.Reaches ? "text-info" : "text-secondary") small mb-1">
                            🚀 @LongHaul.ReachVerdict(lhPlanet.Name, lhReach, SimTime)
                        </div>
                    }
                    @if (_longHaulDeparture is { Ok: true } lhDep)
                    {
                        <div class="text-secondary small mb-1">
                            @LongHaul.Promise(lhPlanet.Name, LongHaulCaptureRange(lhPlanet), FormatSimTime(lhDep.ArrivalCenterTime), lhDep.DeparturePulses, LongHaulLastMilePulses())
                        </div>
                        <button type="button"
                                class="btn btn-sm @(lhBlock is null ? "btn-warning" : "btn-outline-secondary")"
                                disabled="@(lhBlock is not null)"
                                title="@(lhBlock ?? "Autopilot the whole void in one jump — charge the departure, wake at the capture gate; the last mile stays premium")"
                                @onclick="EngageLongHaul">
                            @LongHaul.Offer(lhDestName, lhDep.DeparturePulses, FormatSimTime(lhDep.ArrivalCenterTime))
                        </button>
                    }
                    @if (lhBlock is not null)
                    {
                        <div class="text-warning small mt-1">@lhBlock</div>
                    }
                </div>
            }
        </div>
    }

    @* #266: the adrift lifeline. The old strip rendered UNDER the masthead (z-order behind .map-topstack)
       and hid the one button a stranded captain needs — the #262 stranding proved it. Now the state
       SAYS itself on the shared #166 alert strip (above), the parrot proposes the tow, and the rescue is
       a real pop-up (below) with the terms visible. What remains inline is a clear, viewport-clamped
       re-open affordance (#253) that lives clear of the banner's no-button zone (#236) — shown only while
       adrift with the offer dismissed, so a captain who declined can always call the tug back. *@
    @if (Adrift && !_showRescueOffer)
    {
        <div class="map-adrift">
            <button type="button" class="map-adrift-reopen" title="Adrift — out of reaction mass. Open the rescue offer and read its terms." @onclick="OpenRescueOffer">
                🛟 Adrift — request rescue
            </button>
        </div>
    }

    @* #266: the rescue offer, a piracy-pop-up-style modal (#243 legible-gate family). The terms are
       VISIBLE before accepting — who comes (a tug), what it brings (reaction mass), what it costs (the
       whole hold, confiscated, enumerated with hot cargo marked), and a clear accept/decline. Going
       adrift is a story beat, not a strip. Auto-opens on the rising edge; re-openable while stranded. *@
    @if (_showRescueOffer && Adrift)
    {
        IReadOnlyList<RescueOffer.FeeLine> _rescueLines = RescueFeeLines();
        <div class="rescue-backdrop" @onclick="CloseRescueOffer">
            <div class="rescue-card" @onclick:stopPropagation="true">
                <div class="rescue-hail">🛟 ADRIFT — OUT OF REACTION MASS</div>
                <div class="rescue-quote">"We're dry, captain. Not a pulse left, and no pump in reach. Shall I whistle for a tow?"</div>
                <div class="rescue-terms">
                    <div class="rescue-brings">🚀 @RescueOffer.TowPromise(ReactionMassCapacity)</div>
                    <div class="rescue-fee">💸 @RescueOffer.FeeHeadline(_rescueLines)</div>
                    @if (_rescueLines.Count > 0)
                    {
                        <ul class="rescue-manifest">
                            @foreach (RescueOffer.FeeLine _line in _rescueLines)
                            {
                                <li><span title="@(_line.Hot ? HotGlossTitle : null)">@(_line.Hot ? "🔥" : "📦")</span> @_line.Units @_line.CargoClass (@_line.Value.ToString("N0", CultureInfo.InvariantCulture) cr)@(_line.Hot ? " — hot" : "")</li>
                            }
                        </ul>
                    }
                </div>
                <div class="rescue-options">
                    <button type="button" class="btn btn-warning rescue-accept" title="Whistle for the tug — top the tank, surrender the hold" @onclick="AcceptRescue">
                        🛟 Accept the tow — surrender the hold
                    </button>
                    <button type="button" class="btn btn-outline-light rescue-decline" title="Wave the tug off — you stay adrift; the offer stands" @onclick="CloseRescueOffer">
                        Decline — stay adrift
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_showTutorial)
    {
        int activeTrack = ActiveTutorialIndex();
        <div class="map-tutorial">
            <div class="card bg-dark bg-opacity-75 text-light">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    @* The checklist for the active lesson — the picker itself lives in the Captain's
                       Tutorials tab now (starting a lesson IS a captain's order), so this card is a
                       pure progress tracker that rides the map where the hunt actually plays out. *@
                    <span class="fw-bold small">@(activeTrack >= 0 ? TutorialTracks[activeTrack].Title : "Ship's articles")</span>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" title="Close the lesson checklist" @onclick="ToggleTutorial"></button>
                </div>
                <div class="card-body p-2 small">
                    @if (activeTrack >= 0)
                    {
                        for (int i = TutorialTracks[activeTrack].Start; i < TutorialTracks[activeTrack].Start + TutorialTracks[activeTrack].Length; i++)
                        {
                            bool done = _tutorialStep > i;
                            bool current = _tutorialStep == i;
                            <div class="@(done ? "text-secondary" : current ? "fw-bold text-info" : "")">
                                @(done ? "✓" : "•") @TutorialSteps[i]
                            </div>
                        }
                        <div class="text-secondary fst-italic mt-1">Pick another lesson at the Captain's desk (0) → Tutorials.</div>
                    }
                    else
                    {
                        <div class="text-warning">You're a pirate now — the whole system's yours to work.</div>
                        <div class="text-secondary fst-italic mt-1">Replay any lesson at the Captain's desk (0) → Tutorials.</div>
                    }
                </div>
            </div>
        </div>
    }
    }
    @* The scope lives OUTSIDE the Nav-desk if: Blazor must never destroy this canvas — a
       recreated element leaves renderer.js holding a stale 2D context and the scope goes
       permanently dark after any desk switch (M26 fix). CSS hides it off-Nav instead. *@
    <div class="map-scope @(_showScope && _activeDesk == ShipDesk.Nav ? "" : "d-none")">
        <div class="card bg-dark bg-opacity-75 text-light">
            <div class="card-header py-1 d-flex justify-content-between align-items-center gap-1">
                <span class="fw-bold small">Scope 🔭</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Scope target">
                    <button type="button" class="btn btn-outline-light py-0" title="Point the scope at the previous target" @onclick="() => CycleScopeTarget(-1)">◀</button>
                    <button type="button" class="btn @(_scopeManualId is null ? "btn-info" : "btn-outline-light") py-0" title="Let the scope pick its own target automatically" @onclick="() => _scopeManualId = null">AUTO</button>
                    <button type="button" class="btn btn-outline-light py-0" title="Point the scope at the next target" @onclick="() => CycleScopeTarget(1)">▶</button>
                </div>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" title="Close the scope window" @onclick="ToggleScope"></button>
            </div>
            <div class="card-body p-1">
                <canvas id="@ScopeCanvasId" class="map-scope-canvas"></canvas>
            </div>
        </div>
    </div>

    @* SATURDAY-ANCHOR: panels — the desk layer (PR-11): each non-Nav/Deck desk fills the screen
       (rule 1 — 70% belongs to the desk's own topic) while the map/sim keeps running underneath
       (rule 4). Sensors dims the map through; the rest go near-opaque. Parallel desk lanes
       (PR-12/13/14) touch only their own branch of this if-chain; PR-15 adds the Captain branch. *@
    @* M27: the Sensors desk renders ALWAYS (d-none off-desk) — the tracking post must never be
       destroyed: the ledger, the passive watch, and its live-scope canvas all live in it. A
       conditionally-rendered component forgot every track on desk switch and left renderer.js
       holding a stale canvas context (the same disease the Nav scope had). *@
    @* M29: the target dossier — a box of its own for the tactical target, independent of the
       NAV destination: bound for Mercury with the book open on a hauler. Floats bottom-center
       ABOVE the desk layers so the sensors chief reads the same book the navigator does. *@
    @if (_activeDesk is ShipDesk.Nav or ShipDesk.Sensors && TacticalTargetId is { } dossierId && DossierFor(dossierId) is { } dossier)
    {
        <div class="map-dossier bg-dark bg-opacity-75 rounded p-2 text-light small">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">📖 @dossier.Name <span class="text-secondary">@dossier.Detail</span></span>
                <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Close dossier" title="Close the target dossier"
                        @onclick="() => Dismiss(CloseDossier)"></button>
            </div>
            <div>@dossier.StatusLine</div>
            @* The Victoria-I one-line teaser (owner ruling, 2026-07-19): a scanned hull's history in a
               glance — "ex-AURORA QUEEN · three owners deep". The full ledger lives on her comms dossier. *@
            <div class="text-secondary">📜 @ShipHistories.For(dossierId).Teaser</div>
            <div>@FormatDistance(dossier.Distance) · rel @((dossier.RelSpeed / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s ·
                 @RelativeMotion.WordedBefore(dossier.Closing)</div>
            @if (dossier.TrackQuality is { } quality)
            {
                <div>📡 telescope fix @((int)(quality * 100))% <span class="text-secondary">— sharpen it at the Sensors desk</span></div>
            }
            else
            {
                <div class="text-secondary">📡 not on the telescope ledger — track her to sharpen the intel</div>
            }
            <div class="@(dossier.InDriverReach ? "text-info" : "text-secondary")">@dossier.FireLine</div>
            @if (dossier.IsPrey)
            {
                @* The autosteal criterion box (owner): both must be green before shuttles launch. *@
                bool rangeOk = dossier.Distance <= CaptureRule.CaptureRadiusMeters;
                bool speedOk = dossier.RelSpeed <= CaptureRule.MaxRelativeSpeed;
                <div class="border border-secondary rounded px-2 py-1 mt-1">
                    <div class="fw-bold">🎯 Autosteal needs BOTH:</div>
                    <div class="@(rangeOk ? "text-success" : "text-warning")">
                        @(rangeOk ? "✅" : "❌") close enough —
                        @FormatDistance(dossier.Distance) @(rangeOk ? "≤" : ">") @FormatDistance(CaptureRule.CaptureRadiusMeters)
                    </div>
                    <div class="@(speedOk ? "text-success" : "text-warning")">
                        @(speedOk ? "✅" : "❌") speed match —
                        @((dossier.RelSpeed / 1000).ToString("F1", CultureInfo.InvariantCulture)) km/s
                        @(speedOk ? "≤" : ">") @((CaptureRule.MaxRelativeSpeed / 1000).ToString("F0", CultureInfo.InvariantCulture)) km/s
                    </div>
                    <div class="@(dossier.BoardReady == 2 ? "text-success fw-bold" : "text-secondary")">
                        @(dossier.BoardReady switch
                        {
                            2 => "→ BOARDABLE NOW — hold the match, shuttles launch on their own",
                            1 => "→ too fast — match her velocity, or hole her sail so she drifts",
                            _ => "→ close the distance, then match her speed",
                        })
                    </div>
                </div>
            }
            @if (_interestTargetId == dossierId && InterceptChipLine() is { } clock)
            {
                <div class="text-warning">@clock</div>
            }
            <div class="d-flex gap-1 mt-1">
                <button type="button" class="btn btn-sm py-0 @(_interestTargetId == dossierId ? "btn-info" : "btn-outline-info")"
                        title="Mark her the target of interest — intercept clock and firing solutions" @onclick="() => SetInterestTarget(dossierId)">🎯 interest</button>
                <button type="button" class="btn btn-sm btn-outline-info py-0"
                        title="Put the telescope on her to sharpen the fix" @onclick="() => TrackShipFromMenu(dossierId)">📡 sharpen fix</button>
                <button type="button" class="btn btn-sm btn-outline-light py-0"
                        title="Take this target to the war room" @onclick="() => SwitchDeskFromClick(ShipDesk.WarRoom)">⚔ war room</button>
            </div>
        </div>
    }

    @* M29: desk-layer-passthrough — the sensors chief works the SKY, not a form: pointer
       events fall through the desk's empty space to the live map below (pan, wheel zoom,
       ship click → contact menu), while every actual instrument re-enables its own events. *@
    <div class="desk-layer desk-layer-dimmed desk-layer-passthrough @(_activeDesk == ShipDesk.Sensors ? "" : "d-none")">
        <div class="desk-content">
            <SpaceSails.Client.Pages.Stations.TrackingPost @ref="_trackingPost" Visible="_activeDesk == ShipDesk.Sensors" FullScreen="true"
                SimTime="SimTime" ShipPosition="_ship.Position" ShipVelocity="_ship.Velocity" ShipCharge="_ship.Charge"
                Ephemeris="_ephemeris" Candidates="TrackingCandidates()" MaxTracks="_telescopeLevel + 1"
                TelescopeSpeedFactor="1 + 0.5 * _telescopeLevel"
                RadarActive="_activeRadar" OnRadarToggle="SetActiveRadar"
                Transponder="_transponderMode" OnTransponderChange="SetTransponder"
                Opportunities="_courseOpportunities" OnSetInterest="SetInterestTarget"
                OnZoomMap="ZoomSensorsBackdrop" OnCenterShip="CenterShipOnMap"
                OnAreaScanCompleted="OnAreaScanCovered"
                OnClose="() => SwitchDeskFromClick(ShipDesk.Nav)" />
        </div>
    </div>
    @if (_activeDesk is ShipDesk.WarRoom or ShipDesk.Trade or ShipDesk.Comms or ShipDesk.Galley or ShipDesk.Captain)
    {
        @* The war room dims instead of blanking (long-shots PR): the live map behind it IS the
           orrery view for cross-system firing solutions — DrawFirePlan draws the transfer.
           And it's PASSTHROUGH (owner: "the war room map seems dead to mouse clicks") — the
           gunner pans, zooms and clicks contacts on the sky, same as the sensors chief. *@
        <div class="desk-layer @(_activeDesk == ShipDesk.WarRoom ? "desk-layer-dimmed desk-layer-passthrough" : "")">
            <div class="desk-content">
                @if (_activeDesk == ShipDesk.WarRoom)
                {
                    <SpaceSails.Client.Pages.Stations.WarRoom Visible="true" FullScreen="true" SimTime="SimTime" ShipPosition="_ship.Position" ShipVelocity="_ship.Velocity" Contacts="WarRoomContacts()" Hunters="WarRoomHunters()" HeatLevel="_heat.Level" CoolingAtHaven="IsHiddenAtHaven()" Credits="_credits" SensorTracks="WarRoomSensorTracks()" InterestId="@_interestTargetId" Intercept="_intercept" InterceptTargetName="@InterestTargetName()" OnSetInterest="SetInterestTarget"
                        FireAimOffsetSeconds="_fireAimOffsetSeconds" MaxAimOffsetSeconds="MaxFireAimOffsetSeconds" MaxMuzzleSpeedMps="MaxMuzzleSpeed" InterestDistanceMeters="InterestDistanceNow()" FireKind="_fireKind" FireSolution="_fireSolution" FireBlockedBy="@_fireBlockedBy" RoundsInFlight="LiveRounds()" PlannedImpactInSeconds="PlannedImpactEta()" StraightWindowText="@StraightWindowText()" WeaponsAuthorized="WeaponsAuthorized" FireAtWill="_fireAtWill" SlugAmmo="_slugAmmo" MissileAmmo="_missileAmmo" Docked="_docked" CanWarnInterest="CanWarnInterest()" OnBuyAmmo="BuyAmmo" FireDispersionMeters="_fireDispersionMeters" RevealedIterations="_revealedIterations" FireCountdownSeconds="@(FireLocked ? _fireAtSimTime - SimTime : null)" FireTip="@_fireTip" FirePulseCost="@(_fireKind == OrdnanceKind.Missile ? MissilePulseCost : SlugPulseCost)" PulsesAvailable="_reactionMassPulses"
                        OnAimOffsetChanged="SetFireAimOffset" OnFireKindChanged="SetFireKind" OnComputeSolution="ComputeFiringSolution" OnCancelFire="CancelFiringSolution" OnScanWindows="ScanFiringWindows" OnAutoAim="AutoAim" OnArmFire="ArmFire"
                        OnClose="() => SwitchDeskFromClick(ShipDesk.Nav)" OnWarningShot="FireWarningShot" OnBribe="BribeShip" />
                }
                else if (_activeDesk == ShipDesk.Trade)
                {
                    @* Trading floor, master–detail edition (owner: "like File Explorer"): the
                       places-of-business TREE + detail pane owns two thirds of the desk, the
                       cargo manifest keeps its column. The dock market is no longer a loose
                       floating panel — it renders as the dockyard node's detail inside the tree
                       (passed down as a fragment so all its bindings stay right here). *@
                    <div class="desk-trade-grid">
                        <SpaceSails.Client.Pages.Stations.LocalSpace @ref="_localSpace" Visible="true" FullScreen="true" BodyName="@(LocalSpaceBodyId is { } lsb ? BodyName(lsb) : null)" OrbitBodyId="@_orbitedBodyId" ContextBodyId="@LocalSpaceBodyId" Contacts="LocalContacts()" ShipPosition="_ship.Position" ShipVelocity="_ship.Velocity" CargoUnits="_cargoUnits" CargoValue="_cargoValue" Credits="_credits" HoldSpaceUnits="CargoCapacity - _cargoUnits" ActiveTradeTargetId="@_localTradeTargetId" TradeProgress="_localTradeProgress" TradeMessage="@_localTradeMessage" DockedBodyId="@(_docked ? _dockBodyId : null)" DockedBodyName="@(_docked && _dockBodyId is { } dbn ? BodyName(dbn) : null)" BodyNameLookup="BodyName" OnStartTrade="StartLocalTrade" OnStartBuy="StartLocalBuy" OnClose="() => SwitchDesk(ShipDesk.Nav)">
                            <DockMarket>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-success flex-grow-1" disabled="@(_cargoValue <= 0)" title="Sell the whole hold at this dock's prices" @onclick="SellCargo">
                                        Sell cargo (@_cargoValue.ToString("N0", CultureInfo.InvariantCulture) cr)
                                    </button>
                                </div>
                                @* ⛽ fuel is bought in the always-visible fuel gauge (side panel), so it
                                   answers "how do I fill her up?" (#157) whether or not you're docked. *@
                                <div class="fw-bold mb-1">Upgrades</div>
                                <table class="table table-sm table-dark mb-0">
                                    <tbody>
                                        <tr>
                                            <td>Reaction mass<br /><span class="text-secondary">Lv @_massLevel → cap @(ReactionMassCapacity + 150)</span></td>
                                            <td class="text-end align-middle">
                                                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_credits < UpgradePrice(_massLevel))" title="Buy the reaction-mass upgrade — a bigger fuel cap" @onclick='() => BuyUpgrade("mass")'>
                                                    @UpgradePrice(_massLevel).ToString("N0", CultureInfo.InvariantCulture) cr
                                                </button>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Sensor range<br /><span class="text-secondary">Lv @_sensorLevel → @FormatDistance(SensorModel.Default.RangeMeters * Math.Pow(1.4, _sensorLevel + 1))</span></td>
                                            <td class="text-end align-middle">
                                                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_credits < UpgradePrice(_sensorLevel))" title="Buy the sensor upgrade — a longer detection range" @onclick='() => BuyUpgrade("sensor")'>
                                                    @UpgradePrice(_sensorLevel).ToString("N0", CultureInfo.InvariantCulture) cr
                                                </button>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Cargo hold<br /><span class="text-secondary">Lv @_holdLevel → @(CargoCapacity + 10) units</span></td>
                                            <td class="text-end align-middle">
                                                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_credits < UpgradePrice(_holdLevel))" title="Buy the cargo-hold upgrade — more units of space" @onclick='() => BuyUpgrade("hold")'>
                                                    @UpgradePrice(_holdLevel).ToString("N0", CultureInfo.InvariantCulture) cr
                                                </button>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Telescope<br /><span class="text-secondary">Lv @_telescopeLevel → @(_telescopeLevel + 2) simultaneous tracks</span></td>
                                            <td class="text-end align-middle">
                                                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_telescopeLevel >= 3 || _credits < UpgradePrice(_telescopeLevel))" title="Buy the telescope upgrade — track more ships at once" @onclick='() => BuyUpgrade("telescope")'>
                                                    @(_telescopeLevel >= 3 ? "MAX" : $"{UpgradePrice(_telescopeLevel):N0} cr")
                                                </button>
                                            </td>
                                        </tr>
                                        @* PR-BUSTED: the one shipped dice helper — a named +2 on any last stand (the
                                           purchasable-modifier seam; the shop of helpers is a follow-up). *@
                                        <tr>
                                            <td>Boarding-nets jammer<br /><span class="text-secondary">@(_hasNetJammer ? "fitted — +2 on resist" : "+2 on any last stand")</span></td>
                                            <td class="text-end align-middle">
                                                <button type="button" class="btn btn-sm btn-outline-info" disabled="@(_hasNetJammer || _credits < NetJammerPriceCr)" title="A named +2 modifier on resist/Bolivia initiative — proves the dice-helper seam" @onclick="BuyNetJammer">
                                                    @(_hasNetJammer ? "OWNED" : $"{NetJammerPriceCr:N0} cr")
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </DockMarket>
                        </SpaceSails.Client.Pages.Stations.LocalSpace>
                        <div class="desk-side-panel">
                            @* ⛽ FILL HER UP (#157) — the desk's answer to "how do I refuel her?", always
                               shown: a car-gauge fuel meter banded green / amber (<18%) / red (floor),
                               a fat FILL HER UP button + a +10 p top-up when the ship is alongside a pump
                               (FuelReachability.AlongsidePump — the same truth the fuel alarm reads), and an
                               honest "nearest pump N p away" line when it isn't. *@
                            @{
                                int _fuelCap = ReactionMassCapacity;
                                int _fuelPulses = _reactionMassPulses;
                                double _fuelFrac = _fuelCap > 0 ? Math.Clamp((double)_fuelPulses / _fuelCap, 0, 1) : 0;
                                AlertSeverity? _fuelBand = FuelAlertRule.Evaluate(_fuelPulses, _fuelCap);
                                string _fuelBandClass = _fuelBand switch
                                {
                                    AlertSeverity.Red => "fuel-red",
                                    AlertSeverity.Amber => "fuel-amber",
                                    _ => "fuel-green",
                                };
                                CelestialBody? _fuelPump = _ephemeris is not null ? FuelReachability.AlongsidePump(_ephemeris, _ship) : null;
                            }
                            <div class="fuel-desk card bg-dark bg-opacity-50 text-light mb-2">
                                <div class="card-body p-2">
                                    <div class="fuel-desk-title fw-bold">⛽ FUEL</div>
                                    <div class="fuel-gauge @_fuelBandClass" title="Reaction mass: @_fuelPulses of @_fuelCap pulses">
                                        <div class="fuel-gauge-fill" style="width:@(((int)(_fuelFrac * 100)))%"></div>
                                        <div class="fuel-gauge-readout">@_fuelPulses<span class="fuel-gauge-cap"> / @_fuelCap p</span></div>
                                    </div>
                                    @if (_fuelPump is { } _pump)
                                    {
                                        int _fuelPrice = FuelMarket.PricePerPulse(_ephemeris!.Position(_pump.Id, SimTime).Length);
                                        int _fuelRoom = _fuelCap - _fuelPulses;
                                        FuelMarket.Quote _fill = FuelMarket.QuoteFill(_fuelPulses, _fuelCap, _fuelPrice, _credits, int.MaxValue);
                                        FuelMarket.Quote _topUp = FuelMarket.QuoteFill(_fuelPulses, _fuelCap, _fuelPrice, _credits, 10);
                                        <div class="fuel-alongside small mt-1">Alongside @BodyName(_pump.Id) · @_fuelPrice cr/p</div>
                                        <div class="d-flex gap-2 mt-2">
                                            <button type="button" class="btn btn-warning fw-bold fuel-fill-btn flex-grow-1"
                                                    title="@($"Top the tank right off — buys {_fill.Pulses} p for {_fill.Cost:N0} cr")"
                                                    disabled="@(_fuelRoom <= 0 || _fill.Pulses <= 0)" @onclick="() => BuyFuel(int.MaxValue)">
                                                ⛽ FILL HER UP@(_fuelRoom > 0 && _fill.Pulses > 0 ? $" · {_fill.Cost:N0} cr" : "")
                                            </button>
                                            <button type="button" class="btn btn-outline-warning fuel-topup-btn"
                                                    title="@($"Take on {_topUp.Pulses} p for {_topUp.Cost:N0} cr")"
                                                    disabled="@(_fuelRoom <= 0 || _topUp.Pulses <= 0)" @onclick="() => BuyFuel(10)">
                                                +10 p
                                            </button>
                                        </div>
                                        @if (_fuelRoom <= 0)
                                        {
                                            <div class="fuel-note small text-secondary mt-1">Tank's full.</div>
                                        }
                                        else if (_fill.Pulses <= 0)
                                        {
                                            <div class="fuel-note small text-danger mt-1">Not enough credits for even one pulse (@_fuelPrice cr/p).</div>
                                            @* PR-WIRE: broke at the pump — the dream's anonymized favor wire. A trusted
                                               dark-web-native contact wires gas money; you owe them one quiet delivery. *@
                                            @if (BestWireLenderId() is { } lender)
                                            {
                                                <button type="button" class="btn btn-sm btn-warning mt-2 w-100"
                                                        title="@($"Call in a favor — {ContactSheets.For(lender).DisplayName} wires you {PumpLoanPrincipal(_fuelRoom, _fuelPrice):N0} cr for fuel. You'll owe one quiet delivery.")"
                                                        @onclick="CallInFavorAtPump">
                                                    📡 Call in a favor — @ContactSheets.For(lender).DisplayName wires @PumpLoanPrincipal(_fuelRoom, _fuelPrice).ToString("N0", CultureInfo.InvariantCulture) cr
                                                </button>
                                            }
                                        }
                                        else if (_fill.Pulses < _fuelRoom)
                                        {
                                            <div class="fuel-note small text-warning mt-1">Credits cover @_fill.Pulses of the @_fuelRoom p of room.</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fuel-directions small mt-1">@FuelDirectionsLine()</div>
                                    }
                                </div>
                            </div>
                            @* #314 — the sentry rearm line, sitting with the berth's services. Tops the
                               ship's bot magazines back to 99 at one honest price; a receipt prints. *@
                            @if (_dockedHavenId is not null)
                            {
                                <div class="fuel-desk card bg-dark bg-opacity-50 text-light mb-2">
                                    <div class="card-body p-2">
                                        <div class="fuel-desk-title fw-bold">🤖 SENTRY ARMORY</div>
                                        @if (_shipBots.Count == 0)
                                        {
                                            <div class="small text-secondary mt-1">No bots aboard — they're deployed on a surface, or written off.</div>
                                        }
                                        else
                                        {
                                            int _sentryMissing = SentryRoundsMissing();
                                            int _sentryCost = SentryRestockCost();
                                            <div class="small mt-1">
                                                @foreach (var _b in _shipBots)
                                                {
                                                    <span class="me-2">@_b.Unit <span class="fw-bold" style="color:#ff5a46">@SentryBot.Readout(_b.Rounds)</span></span>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-outline-warning btn-sm w-100 mt-2"
                                                    @* #562: the affordability gate reads the CONSTANT, not a
                                                       literal. A hard-coded 2 here silently shadowed
                                                       RestockPricePerRound and went wrong the moment the
                                                       ammo was re-priced — which is now. *@
                                                    disabled="@(_sentryMissing <= 0 || _credits < SentryBot.RestockPricePerRound)"
                                                    title="@($"Rack {_sentryMissing} rounds across the roster at {SentryBot.RestockPricePerRound} cr each")"
                                                    @onclick="RestockSentries">
                                                @(_sentryMissing <= 0 ? "Magazines full" : $"🔫 Rearm sentries — {_sentryMissing} rounds · {_sentryCost:N0} cr")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="trade-manifest-panel card bg-dark bg-opacity-50 text-light">
                            <div class="card-header py-1"><span class="fw-bold small">Cargo manifest</span></div>
                            <div class="card-body p-2 small">
                                @if (_localTradeTargetId is not null)
                                {
                                    <div class="trade-manifest-transfer mb-2">
                                        <div class="text-info trade-manifest-transfer-label">@(_localTradeMessage ?? "Drones ferrying…")</div>
                                        <div class="progress trade-manifest-progress">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" style="width:@(((int)(_localTradeProgress * 100)))%"></div>
                                        </div>
                                        <div class="text-info trade-manifest-transfer-pct">@((int)(_localTradeProgress * 100))%</div>
                                    </div>
                                }
                                @{ IReadOnlyList<CargoManifestEntry> manifest = CargoManifest(); }
                                @if (manifest.Count == 0)
                                {
                                    <div class="text-secondary">Hold empty.</div>
                                }
                                else
                                {
                                    <table class="table table-sm table-dark mb-0">
                                        <thead>
                                            <tr>
                                                <th>Class</th>
                                                <th class="text-end">Units</th>
                                                <th class="text-end">Est. value</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (CargoManifestEntry entry in manifest)
                                            {
                                                <tr>
                                                    <td>@entry.CargoClass</td>
                                                    <td class="text-end">@entry.Units</td>
                                                    <td class="text-end">@entry.Value.ToString("N0", CultureInfo.InvariantCulture) cr</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="fw-bold">
                                                <td>Total</td>
                                                <td class="text-end">@_cargoUnits/@CargoCapacity</td>
                                                <td class="text-end">@_cargoValue.ToString("N0", CultureInfo.InvariantCulture) cr</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                }
                            </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeDesk == ShipDesk.Comms)
                {
                    @* Comms room, master–detail edition (ui-guidelines.md; validated by the Gemini
                       playtest consult): ticker on top, then the CONTACTS TREE on the left — lean
                       rows, one status badge each, grouped Scheduled / En route / fixtures, plus
                       "Off the books" and the dark web market as first-class nodes — and ONLY the
                       selected node's detail on the right. The three loose consoles are gone:
                       tight-beam and laser ranging were always per-contact actions, so they live
                       in the contact's detail now; the market is the dark-web node's detail. *@
                    <div class="desk-comms-room">
                        <div class="comms-ticker">
                            <span class="comms-ticker-label fw-bold small">News wire 📡</span>
                            @{ IReadOnlyList<NewsWire.NewsItem> wire = NewsFeed(CommsTickerAmbientDays); }
                            @if (wire.Count == 0)
                            {
                                <span class="comms-ticker-item text-secondary small">No whispers yet.</span>
                            }
                            else
                            {
                                @foreach (NewsWire.NewsItem item in wire.Take(CommsTickerItemCount))
                                {
                                    <span class="comms-ticker-item small">@item.Headline</span>
                                }
                            }
                        </div>
                        <div class="desk-comms-grid">
                            <div class="desk-side-panel comms-traffic-panel card bg-dark bg-opacity-50 text-light">
                                <div class="card-header py-1"><span class="fw-bold small">Contacts &amp; intel</span></div>
                                <div class="card-body p-2 small desk-traffic-scroll">
                                    @foreach ((string groupLabel, List<NpcState> members) in CommsGroups())
                                    {
                                        <div class="comms-tree-group text-secondary fw-bold">@groupLabel</div>
                                        @foreach (NpcState npc in members)
                                        {
                                            NpcState row = npc;
                                            <div class="comms-node @(row.Ship.Id == _commsSelectedId ? "comms-node-selected" : "")"
                                                 role="button" tabindex="0" title="Open her file in the comms panel" @onclick="() => SelectCommsShip(row.Ship.Id)">
                                                <span class="flex-grow-1">@row.Ship.Callsign</span>
                                                @if (!row.Ship.PublishesTimetable)
                                                {
                                                    <span class="badge bg-dark border border-secondary" title="Bought intel — off the books">🕸</span>
                                                }
                                                @{ (string rowBadge, string rowBadgeCss) = CommsStatusBadge(row); }
                                                <span class="badge @rowBadgeCss">@rowBadge</span>
                                            </div>
                                        }
                                    }
                                    <div class="comms-tree-group text-secondary fw-bold">Intel</div>
                                    @foreach (ScopeIntel intel in _scopeIntel)
                                    {
                                        ScopeIntel si = intel;
                                        string siNodeId = $"scopeintel:{si.Id}";
                                        <div class="comms-node @(_commsSelectedId == siNodeId ? "comms-node-selected" : "")"
                                             role="button" tabindex="0" title="Open this tip in the comms panel" @onclick="() => _commsSelectedId = siNodeId">
                                            <span class="flex-grow-1">@si.Headline</span>
                                            <span class="badge bg-info text-dark">tip</span>
                                        </div>
                                    }
                                    <div class="comms-node @(_commsSelectedId == "offbooks" ? "comms-node-selected" : "")"
                                         role="button" tabindex="0" title="Open the off-the-books ships in the comms panel" @onclick='() => _commsSelectedId = "offbooks"'>
                                        <span class="flex-grow-1">🕵 Off the books</span>
                                        <span class="badge bg-secondary">@OffBooksCount unknown</span>
                                    </div>
                                    <div class="comms-node @(_commsSelectedId == "darkweb" ? "comms-node-selected" : "")"
                                         role="button" tabindex="0" title="Open the dark-web market in the comms panel" @onclick='() => _commsSelectedId = "darkweb"'>
                                        <span class="flex-grow-1">🕸 Dark web market</span>
                                        <span class="badge @(DarkWebCanTrade() ? "bg-success" : "bg-secondary")">@(DarkWebCanTrade() ? "open" : "offline")</span>
                                    </div>
                                </div>
                            </div>
                            @if (_commsSelectedId == "darkweb")
                            {
                                <SpaceSails.Client.Pages.Stations.DarkWeb Visible="true" FullScreen="true" SimTime="SimTime" ShipPosition="_ship.Position" @bind-Credits="_credits" Ledger="_intelLedger" CanTrade="DarkWebCanTrade()" DisabledReason="@DarkWebDisabledReason()" TradeLocationDistanceFromEarthMeters="DarkWebDistanceFromEarth()" MarketShips="DarkWebMarketShips()" TrackedShips="DarkWebTrackedShips()" WireContacts="DarkWebWireContacts()" OnOpenWireBank="id => OpenBank(id, viaWire: true)" OnIntelPurchased="(string cs) => PushNewsEvent(NewsWire.NewsEventKind.IntelPurchased, cs)" OnClose="() => SwitchDesk(ShipDesk.Nav)" />
                            }
                            else
                            {
                                <div class="desk-side-panel card bg-dark bg-opacity-50 text-light">
                                    @if (_commsSelectedId is { } scSel && scSel.StartsWith("scopeintel:", StringComparison.Ordinal) && ScopeIntelById(scSel) is { } tip)
                                    {
                                        <div class="card-header py-1"><span class="fw-bold small">@tip.Headline</span></div>
                                        <div class="card-body p-2 small">
                                            <div class="comms-breadcrumbs text-secondary mb-1">Intel › orbit fix</div>
                                            @foreach (string line in tip.Lines)
                                            {
                                                <div class="mb-1">@line</div>
                                            }
                                            <div class="d-grid gap-1 mt-2">
                                                <button type="button" class="btn btn-sm btn-info py-0 px-1 text-start"
                                                        title="Slew the scope to where this tip predicts and scan" @onclick="() => PointScopeWhereIntelSays(tip)">
                                                    🔭 Point the scope where this says
                                                </button>
                                            </div>
                                            <div class="text-secondary mt-2">The scope slews to the predicted spot and runs a prioritized area scan. Warp time at the <span class="text-light">Sensors desk</span> until the pass lands — when it sweeps over her, she's charted.</div>
                                        </div>
                                    }
                                    else if (_commsSelectedId == "offbooks")
                                    {
                                        <div class="card-header py-1"><span class="fw-bold small">🕵 Off the books</span></div>
                                        <div class="card-body p-2 small">
                                            <div class="comms-breadcrumbs text-secondary mb-1">Intel › Off the books</div>
                                            <div><span class="fw-bold">@OffBooksCount ship@(OffBooksCount == 1 ? "" : "s")</span> are flying with no published timetable — the board can't list what nobody filed.</div>
                                            <div class="text-secondary mt-2">Two ways to find them:</div>
                                            <div class="text-secondary">🔭 sweep the sky with the telescope at the <span class="text-light">Sensors desk</span> — lane watches and area scans catch dark hulls;</div>
                                            <div class="text-secondary">🕸 buy their route intel at the <span class="text-light">dark web market</span> (open at a haven, or a station past Mars) — bought ships join the contacts tree with a 🕸 badge until the tip goes stale.</div>
                                        </div>
                                    }
                                    else if (_commsSelectedId is { } commsSelId && FindNpc(commsSelId) is { } commsShip)
                                    {
                                        bool commsTracked = _trackingPost is not null && _trackingPost.TryGetTrack(commsShip.Ship.Id, out _);
                                        <div class="card-header py-1 d-flex justify-content-between align-items-center">
                                            <span class="fw-bold small">@commsShip.Ship.Callsign</span>
                                            @{ (string detailBadge, string detailBadgeCss) = CommsStatusBadge(commsShip); }
                                            <span class="badge @detailBadgeCss">@detailBadge</span>
                                        </div>
                                        <div class="card-body p-2 small">
                                            <div class="comms-breadcrumbs text-secondary mb-1">Departures board › @commsShip.Ship.Callsign</div>
                                            <div>@commsShip.Ship.CargoClass (@commsShip.Ship.CargoUnits u) · @RouteLabel(commsShip.Ship)</div>
                                            <div>@DepartureLabel(commsShip.Ship)</div>
                                            <div class="text-secondary">last seen: @(commsShip.LastObservation is { } lastObs ? FormatSimTime(lastObs.SimTime) : "never — not yet inside sensor reach")</div>
                                            @{ ShipHistory commsHist = ShipHistories.For(commsShip.Ship.Id); }
                                            @* The Victoria-I history block (owner ruling, 2026-07-19): every hull carries a
                                               past — where she was laid down, the proud names she outlived, how many owners
                                               deep she runs, and the wear that proves the glory. *@
                                            <div class="border-top border-secondary mt-2 pt-1">
                                                <div class="fw-bold">📜 Service history</div>
                                                <div class="text-secondary">@commsHist.LaidDown</div>
                                                @if (commsHist.HasFormerNames)
                                                {
                                                    <div>@commsHist.FormerNamesLine</div>
                                                }
                                                @if (commsHist.CurrentNameLine(commsShip.Ship.Callsign, flyingFalseColors: false) is { } commsNameLine)
                                                {
                                                    <div class="text-secondary">@commsNameLine</div>
                                                }
                                                <div class="text-secondary fst-italic">@commsHist.Condition</div>
                                            </div>
                                            @if (!commsShip.Ship.PublishesTimetable)
                                            {
                                                <div class="text-secondary">🕸 bought intel — goes stale in @IntelStaleInDays(commsShip.Ship.Id).ToString("F0") d</div>
                                            }
                                            <div class="d-grid gap-1 mt-2 comms-actions">
                                                @if (commsTracked)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1 text-start"
                                                            title="Hail her on tight-beam and ask her intentions" @onclick="() => CommsHail(commsShip)">
                                                        📻 Hail via tight-beam — ask her intentions
                                                    </button>
                                                    @if (_commsHailAnswer is not null)
                                                    {
                                                        <div class="text-info">@_commsHailAnswer</div>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-warning py-0 px-1 text-start"
                                                            title="Laser-range her for an exact fix — but she learns where we are" @onclick="() => CommsLaserRange(commsShip)">
                                                        ⚡ Laser range — exact fix, but she learns where we are
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-success py-0 px-1 text-start"
                                                            disabled="@(!CommsCanFence(commsShip))"
                                                            title="@(DarkWebCanTrade() ? "Sell this telescope track to the dark-web market for coin" : DarkWebDisabledReason())"
                                                            @onclick="() => CommsSellTrack(commsShip)">
                                                        🕸 Fence this track@(CommsFencePrice(commsShip) is { } fencePrice ? $" — +{fencePrice:N0} cr" : " — needs ≥50% quality at a haven")
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="text-secondary">Not on your telescope ledger — track her at the <span class="text-light">Sensors desk</span> to hail, laser-range, or fence the track.</div>
                                                }
                                                @if (SelectedTrackedTarget() is { } pinTarget && pinTarget.Ship.Id == commsShip.Ship.Id)
                                                {
                                                    <button type="button" class="btn btn-sm @(_pinned ? "btn-warning" : "btn-outline-light") py-0 px-1 text-start" title="Pin her so the scope holds her brake point" @onclick="TogglePin">
                                                        📌 Pin: brakes at @BodyName(pinTarget.Ship.DestinationId)
                                                    </button>
                                                }
                                            </div>
                                            @if (_commsActionMessage is not null)
                                            {
                                                <div class="text-warning mt-1">@_commsActionMessage</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="card-body p-2 small text-secondary">
                                            Select a contact in the tree — its dossier and comms actions (hail, laser ranging, fencing the track) show here.
                                            Ships missing from the board are found at the <span class="text-light">Sensors desk</span> or bought at the <span class="text-light">dark web market</span>.
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_activeDesk == ShipDesk.Galley)
                {
                    <SpaceSails.Client.Pages.Stations.Galley SimTime="SimTime" Feed="NewsFeed(GalleyFeedAmbientDays).Take(GalleyFeedItemCount).ToList()" RumTots="_rumTots" WobbleActive="RumWobbleActive" LastRumLine="@_lastRumLine" OnPourRum="PourRumFromGalley" />
                }
                else if (_activeDesk == ShipDesk.Captain)
                {
                    <SpaceSails.Client.Pages.Stations.Captain CurrentMission="_mission" Options="_missionOptions" OnSelectMission="SetMission"
                                                              StatusChips="AllStationChips()" OnGoToDesk="SwitchDeskFromClick"
                                                              ShotAuthorized="_shotAuthorized" FireAtWill="_fireAtWill"
                                                              OnAuthorizeShot="AuthorizeShot" OnToggleFireAtWill="ToggleFireAtWill"
                                                              WeaponsTight="_weaponsTight"
                                                              DamageControlAuthorized="_dcStandingOrder"
                                                              OnToggleDamageControlAuthority="ToggleDamageControlAuthority"
                                                              DamageControlNextActCleared="_dcNextActionCleared"
                                                              OnAuthorizeNextDamageControlAct="AuthorizeNextDamageControlAct"
                                                              ArmedCompartment="@_shipAuthorized"
                                                              BridgeRepeaterAlive="ShipBridgeAlive"
                                                              Tutorials="TutorialCards()" ActiveTutorial="ActiveTutorialIndex()" OnStartTutorial="StartTutorial"
                                                              OpenToTutorials="_openCaptainToTutorials" Quests="QuestCards()"
                                                              OnPointScope="PointScopeForActiveFetch"
                                                              Tips="LedgerTips()" OnScopeTip="PointScopeFromLedger"
                                                              Accounts="LedgerAccounts()"
                                                              OnRouteToDarkWeb="OpenDarkWebFromLedger" OnRouteToDossier="OpenDossierFromLedger"
                                                              Maps="LedgerMaps()" OnViewMap="ViewMapFromLedger"
                                                              HoardSummary="@_caches.HoardLine()"
                                                              OnReopenStartPicker="ReopenStartPicker"
                                                              OnOpenSaves="OpenSaveDrawer"
                                                              Voyage="CrewVoyage()"
                                                              InitialTab="_captainTab" OnTabChanged="t => { _captainTab = t; }" />
                }
            </div>
        </div>
    }

    @* #330: the right-side desk status-chip column is ship chrome — hidden on a surface excursion so the
       captain's corners are the excursion's own instruments (SANITY + motion tracker), nothing else. *@
    @if (_surface is null)
    {
        <SpaceSails.Client.Pages.Stations.DeskChips Chips="BuildDeskChips()" OnSelect="SwitchDeskFromClick" />
    }

    @* #185: the completion fanfare. A finished contract is a CELEBRATION — who paid us, what for,
       the coin, the giver grateful in their own voice, and the parrot singing. The money is shown
       arriving here; it never just silently appears in the ledger. *@
    @if (_celebration is { } party)
    {
        <div class="mission-celebration-backdrop" @onclick="DismissCelebration">
            <div class="mission-celebration" @onclick:stopPropagation="true">
                <div class="mc-fanfare">🎉 CONTRACT COMPLETE 🎉</div>
                <div class="mc-title">@party.Title</div>
                <div class="mc-giver">◈ @party.GiverName</div>
                <div class="mc-thanks">@party.GiverThanks</div>
                <div class="mc-payment">💰 +@party.PaidCredits.ToString("N0", CultureInfo.InvariantCulture) cr received</div>
                <div class="mc-parrot">🦜 @party.ParrotSong</div>
                <div class="mc-history">
                    @(party.MissionsWithGiver <= 1
                        ? $"A new name in your logbook — your first job for {party.GiverName}."
                        : $"Job #{party.MissionsWithGiver} for {party.GiverName}. You've got a history now.")
                </div>
                <button type="button" class="btn btn-warning btn-sm mt-2" title="Toast the payday and clear the fanfare" @onclick="DismissCelebration">Raise a glass 🍻</button>
            </div>
        </div>
    }

    @* PR-BUSTED (owner ruling §5): the catch. A hunter runs you down → warp yanks to 1×, the ship is
       grappled, and this pop-up opens in the collector's voice. SUBMIT / BRIBE / RESIST, GTA-BUSTED
       grammar — never game over (the Bolivia freeze-frame ends in brain-backup resurrection). The dice
       are rolled Core-side and shown here, modifiers listed. Reuses the celebration modal's backdrop
       grammar. *@
    @if (_busted is { } bust)
    {
        <div class="busted-backdrop @(bust.Phase is BustedEncounter.Stage.FreezeFrame or BustedEncounter.Stage.Impact or BustedEncounter.Stage.SurfaceEnd ? "busted-sepia" : "")">
            <div class="busted-card" @onclick:stopPropagation="true">
                @switch (bust.Phase)
                {
                    case BustedEncounter.Stage.Demand:
                        @* PR-BUSTED art (docs/art-manifest-busted.md item 3): busted-collector-hail.jpg —
                           the hard-eyed repo captain backs ONLY the Demand header (modifier class), with a
                           dark scrim so the callsign stays readable. Other panels' .busted-hail is untouched. *@
                        @* #528 · the slot from docs/art-manifest-busted.md item 3, PAINTED at last: grapple
                           cables across the frame and the collector's hull filling the ports. The heading rides
                           on the art rather than instead of it — the words are the alarm, the picture is why it
                           is frightening. *@
                        @* #777 · AND IT IS THE BEAT'S OWN CANVAS NOW, not a borrowed picture. CollectorHail
                           is presented HOSTED (StoryBeats.Presentation.Hosted): the caller raises it through
                           the one seam, which spends the cadence and files the words in the log, and then
                           raises nothing — because THIS panel is where the beat lands. Which makes the
                           caption's home here or nowhere. #761: a plot-significant moment is told clearly,
                           on the surface the player is looking at. #736: the words must not be the ones
                           behind the backdrop. So the shipped sentence rides the shipped painting, exactly
                           as it would have on a card of its own — and nothing is shown twice. *@
                        <div class="busted-hail busted-collector-hail">
                            <img class="busted-hail-art" src="@StoryBeats.ArtFile(StoryBeats.Beat.CollectorHail)"
                                 alt="" aria-hidden="true" onerror="this.style.display='none'" />
                            <span>⛓ CAUGHT — @bust.HunterCallsign has you grappled</span>
                            <div class="busted-hail-caption">@StoryBeats.Caption(StoryBeats.Beat.CollectorHail, bust.HunterCallsign)</div>
                        </div>
                        <div class="busted-heat">Heat @HeatFlames(bust.Heat) · exposure: @BustedRule.ExposurePhrase(bust.Heat)</div>
                        <div class="busted-quote">"Heave to. We're collecting. This goes easy or it goes @(bust.Heat >= EncounterRule.MaxHeatLevel ? "Bolivia" : "hard") — your call, captain."</div>
                        @* #422 arc 2 — THE COLLECTOR'S WRIT. The first time a collector grapples you, you get a
                           look at the writ they carry, and it names a policy number, not a manifest. The shard
                           is glimpsed here; the readout below keeps it. *@
                        @if (bust.CollectorWrit is { Length: > 0 } writ)
                        {
                            <div class="busted-nebula busted-writ">
                                <div class="busted-nebula-head">▓ A GLIMPSE OF THE WRIT — NEBULA MUTUAL · RECOVERY OF INSURED ASSET</div>
                                <div class="busted-nebula-line">@writ</div>
                            </div>
                        }
                        int _hotUnits = _hotCargo.TotalHotUnits;
                        int _coinShare = (int)Math.Round(_credits * BustedRule.CoinFraction(bust.Heat));
                        bool _canBribe = _credits >= bust.Bribe.Total;
                        <div class="busted-options">
                            <button type="button" class="btn btn-warning busted-opt" @onclick="() => BustedSubmit(false)">
                                <span class="bo-title">🤍 SUBMIT</span>
                                <span class="bo-detail">They take @_hotUnits hot cargo unit@(_hotUnits == 1 ? "" : "s") + ~@_coinShare.ToString("N0") cr. Heat clears to 0.</span>
                            </button>
                            <button type="button" class="btn btn-info busted-opt" disabled="@(!_canBribe)" @onclick="BustedBribe">
                                <span class="bo-title">💰 BRIBE — @bust.Bribe.Total.ToString("N0") cr</span>
                                <span class="bo-detail">@bust.Bribe.Describe()@(_canBribe ? " · keep the cargo, heat unchanged" : " · you can't cover it")</span>
                            </button>
                            <button type="button" class="btn btn-danger busted-opt" @onclick="BustedResist">
                                <span class="bo-title">🔫 RESIST@(bust.Heat >= EncounterRule.MaxHeatLevel ? " — THE BOLIVIA" : "")</span>
                                @* #621 · The hint used to price only the LOSS. Winning a heat-1/2 resist
                                   raises heat by one — the sim does it, and the game said so only in the
                                   result line, after the button had been pressed. A cost you can confirm
                                   only once you have paid it is not a tell. And the Bolivia is the one
                                   option on this card that ends the captain, which the player is entitled
                                   to know one beat early rather than at the freeze-frame. *@
                                <span class="bo-detail">@(bust.Heat >= EncounterRule.MaxHeatLevel
                                    ? "All guns blazing. A last stand on the dice — you fight clear, or the freeze-frame does the rest and the policy issues somebody new."
                                    : "One opposed roll. Win and they peel off, but heat climbs a notch and the next wave is meaner; lose and it's a harsher cut.")@(_hasNetJammer ? " (jammer +2)" : "")</span>
                            </button>
                        </div>
                        break;

                    case BustedEncounter.Stage.Confiscated:
                        <div class="busted-hail">⛓ CONFISCATED</div>
                        @if (bust.Confiscation is { } conf)
                        {
                            <div class="busted-receipt">
                                @if (conf.CoinTaken > 0)
                                {
                                    <div>💰 −@conf.CoinTaken.ToString("N0") cr from the purse</div>
                                }
                                @foreach (BustedRule.CargoSeizure s in conf.Seizures)
                                {
                                    <div><span title="@(s.Hot ? HotGlossTitle : null)">@(s.Hot ? "🔥" : "📦")</span> −@s.Units @s.CargoClass (@s.Value.ToString("N0") cr)@(s.Hot ? " — hot" : " — clean, minimum take")</div>
                                }
                                @if (conf.CoinTaken == 0 && conf.Seizures.Count == 0)
                                {
                                    <div>Nothing to take — you fly clean. They log it and cut you loose.</div>
                                }
                                <div class="busted-math">@string.Join(" · ", conf.Breakdown.Select(m => $"{m.Label}: {m.Value}"))</div>
                            </div>
                        }
                        <div class="busted-quote">"Debt collected. Heat's off the books — for now. Fly straight, captain."</div>
                        <button type="button" class="btn btn-outline-light busted-close" @onclick="() => Dismiss(CloseBusted)">Take the hit</button>
                        break;

                    case BustedEncounter.Stage.BribedOff:
                    case BustedEncounter.Stage.ResistWon:
                    case BustedEncounter.Stage.Fled:
                        <div class="busted-hail">@(bust.Phase == BustedEncounter.Stage.Fled ? "🏴 BROKE CLEAR" : bust.Phase == BustedEncounter.Stage.ResistWon ? "🔫 THEY PEEL OFF" : "💰 PAID OFF")</div>
                        @if (bust.ResistRoll is { } rr)
                        {
                            <div class="busted-roll">You: @rr.Challenger.Describe()</div>
                            <div class="busted-roll">Collector: @rr.Defender.Describe()</div>
                        }
                        <div class="busted-quote">@bust.ResultMessage</div>
                        <button type="button" class="btn btn-outline-light busted-close" @onclick="() => Dismiss(CloseBusted)">Fly on</button>
                        break;

                    case BustedEncounter.Stage.ResistLost:
                        <div class="busted-hail">🔫 THEY BOARD ANYWAY</div>
                        @if (bust.ResistRoll is { } rl)
                        {
                            <div class="busted-roll">You: @rl.Challenger.Describe()</div>
                            <div class="busted-roll">Collector: @rl.Defender.Describe()</div>
                        }
                        <div class="busted-quote">"Nice try. Now it costs extra." — they take the submission terms plus a harsher cut.</div>
                        <button type="button" class="btn btn-danger busted-close" @onclick="() => PressAndRefocus(BustedResistLostConfirm)">Brace for it</button>
                        break;

                    case BustedEncounter.Stage.Bolivia:
                        <div class="busted-hail">🔫 THE BOLIVIA — the last stand</div>
                        @if (bust.BoliviaInitiative is { } init)
                        {
                            <div class="busted-roll">Initiative — You: @init.Challenger.Total vs Collector: @init.Defender.Total</div>
                        }
                        @if (bust.BoliviaBeatIndex < BoliviaEncounter.Script.Count)
                        {
                            EncounterBeat beat = BoliviaEncounter.Script[bust.BoliviaBeatIndex];
                            @* #528 · THE STAND HAS A PICTURE NOW. The freeze-frame that ENDS this scene has
                               been painted since PR-BUSTED; the three beats that earn it were text with
                               buttons under them, so a captain who HELD the line never saw one frame of
                               what they just lived through. Same sepia register as the freeze-frame. Keyed
                               by the beat's id, never its index — a script is a list somebody will edit —
                               and onerror-hides, so a missing file leaves this panel as it was. *@
                            @if (BoliviaEncounter.ArtFile(beat.Id) is { Length: > 0 } beatArt)
                            {
                                <img class="bolivia-beat-img" src="@beatArt" alt="" aria-hidden="true"
                                     onerror="this.style.display='none'" />
                            }
                            <div class="busted-quote">@beat.Narration</div>
                            <div class="busted-options">
                                @foreach (EncounterChoice choice in beat.Choices)
                                {
                                    string cid = choice.Id;
                                    <button type="button" class="btn btn-outline-danger busted-opt" @onclick="() => BustedBoliviaChoose(cid)">
                                        <span class="bo-title">@choice.Label</span>
                                        <span class="bo-detail">@choice.Hint (@(choice.Modifier.Value >= 0 ? "+" : "−")@Math.Abs(choice.Modifier.Value))</span>
                                    </button>
                                }
                            </div>
                            @if (bust.BoliviaOutcomes.Count > 0)
                            {
                                <div class="busted-math">Running: net @bust.BoliviaNet — @(bust.BoliviaNet >= 0 ? "holding the line" : "going under")</div>
                            }
                        }
                        break;

                    case BustedEncounter.Stage.Impact:
                        @* #264: the surface collected the ship. Reuses the freeze-frame grammar (sepia
                           backdrop, one held beat) and hands off to the SAME brain-backup resurrection —
                           no collector, no dice; "impact coming" finally arrives. *@
                        <div class="busted-freeze">
                            @* PR-BUSTED art (docs/art-manifest-busted.md item 2): busted-ship-explosion.jpg
                               backs this .busted-explosion slot too — same "kerosene-explosion budget"
                               hero fireball as the Resurrected panel. Gradient stays as the load fallback. *@
                            <div class="busted-freeze-art busted-explosion has-art" title="art: the ship folding into the surface at periapsis — the kerosene-explosion budget">
                                <img class="bf-art" src="art/busted-ship-explosion.jpg" alt="" aria-hidden="true" />
                            </div>
                            <div class="busted-freeze-caption">"…the periapsis said 'under the surface'. It wasn't bluffing."</div>
                            @* #621 · This line was TYPED HERE, word for word off ImpactLines[1], and then
                               had "The freeze-frame holds." appended — which is BUSTED's own language about
                               a collector's gun-camera still, on a death with no collector and no camera.
                               That is the exact append #574 pulled out of every other card and replaced with
                               DeathNarration.Tail, which answers "" for an impact; the guard that pins the
                               law (OnlyACOLLECTORDeathTalksAboutTheFreezeFrame) tests Tail, and the markup
                               was quietly going round it. Both faults are one fix: read the seam. *@
                            <div class="busted-quote">@DeathNarration.Line(bust.Cause, bust.Place, bust.Seed, bust.DeathBodyName)@DeathNarration.Tail(bust.Cause, bust.Place)</div>
                            <button type="button" class="btn btn-light busted-close" @onclick="() => PressAndRefocus(BustedResurrect)">…wake up</button>
                        </div>
                        break;

                    case BustedEncounter.Stage.SurfaceEnd:
                        @* Evening wind #20 — the nerve-overdraw death on the regolith. The BUSTED freeze-beat
                           grammar (sepia backdrop, one held beat), but the cause is place-dependent: the Old
                           Ones took you (Reevers) or, rarely at a shattered sliver, you joined them (Joined).
                           The cause art + the seeded house-voice line (DeathNarration) hold, then "…wake up"
                           hands off to the SAME brain-backup resurrection the collector/impact deaths use.
                           Art is Grok-generated. *@
                        <div class="busted-freeze">
                            <div class="busted-freeze-art busted-death-art has-art" title="what happened — a place-dependent surface death">
                                <img class="bf-art" src="art/@DeathNarration.ArtFile(bust.Cause, bust.Place)" alt="" aria-hidden="true" />
                            </div>
                            <div class="busted-whathappened-head">@DeathNarration.Headline(bust.Cause)</div>
                            @* #480 follow-up: the caption names the meter that actually ran out. It used to
                               hardcode the nerve line for everything but Joined — true while nerve was the
                               only thing that ever killed you, wrong now that the five blows decide. *@
                            <div class="busted-freeze-caption">@DeathNarration.SurfaceCaption(bust.Cause, bust.NerveRanOut)</div>
                            <div class="busted-quote">@DeathNarration.Line(bust.Cause, bust.Place, bust.Seed, bust.DeathBodyName)@DeathNarration.Tail(bust.Cause, bust.Place)</div>
                            <button type="button" class="btn btn-light busted-close" @onclick="() => PressAndRefocus(BustedResurrect)">…wake up</button>
                        </div>
                        break;

                    case BustedEncounter.Stage.FreezeFrame:
                        <div class="busted-freeze">
                            @* PR-BUSTED art (docs/art-manifest-busted.md item 1): busted-freeze-frame.jpg —
                               the sepia last-charge still. Held, not animated (the freeze holds). The
                               deterministic gradient stays under it as the load fallback. *@
                            <div class="busted-freeze-art has-art" title="art: two silhouetted rogues charging into blinding muzzle-flash light — homage, sepia freeze">
                                <img class="bf-art" src="art/busted-freeze-frame.jpg" alt="" aria-hidden="true" />
                            </div>
                            <div class="busted-freeze-caption">"…and here we thought this was the easy money."</div>
                            <div class="busted-quote">One massive volley. The freeze-frame holds. Sepia.</div>
                            <button type="button" class="btn btn-light busted-close" @onclick="() => PressAndRefocus(BustedResurrect)">…wake up</button>
                        </div>
                        break;

                    case BustedEncounter.Stage.Resurrected:
                        <div class="busted-hail">🧠 BRAIN-BACKUP RESTORED</div>
                        @* #422 arc 2 — THE GLITCH IN THE REBIRTH. For one flat second before the welcome loops
                           clean, the wake card reads a line it should not — the thread you don't know you're
                           pulling. You experience the Nebula arc by DYING. The flash shows every rebirth; the
                           shard is gathered once (its full text lives in the Captain's ledger). *@
                        @if (bust.RebirthGlitch is { Length: > 0 } glitch)
                        {
                            <div class="busted-nebula busted-glitch">
                                <div class="busted-glitch-flash">@glitch</div>
                                <div class="busted-nebula-line">…then it blinks back to “Welcome back, Captain.” You feel entirely yourself. That is the part they charge for.</div>
                            </div>
                        }
                        @* #380 item 1 — WHAT HAPPENED: the resurrection fiction finally explains itself at the
                           moment it matters. A cause-specific Grok image + one seeded, place-dependent
                           house-voice line (DeathNarration), THEN the existing brain-backup copy below. The
                           two live causes are Collector (BUSTED last stand) and Impact; the surface + void art
                           is wired ready for the surface-death lane. Art is Grok-generated. *@
                        <div class="busted-whathappened">
                            <div class="busted-freeze-art busted-death-art has-art" title="what happened — a place-dependent death">
                                <img class="bf-art" src="art/@DeathNarration.ArtFile(bust.Cause, bust.Place)" alt="" aria-hidden="true" />
                            </div>
                            <div class="busted-whathappened-head">@DeathNarration.Headline(bust.Cause)</div>
                            <div class="busted-whathappened-line">@DeathNarration.Line(bust.Cause, bust.Place, bust.Seed, bust.DeathBodyName)</div>
                        </div>
                        @* The old hull erupting, one clean hero fireball — the brain-backup beat proper. *@
                        <div class="busted-freeze-art busted-explosion has-art" title="art: the old ship blowing up — the kerosene-explosion budget">
                            <img class="bf-art" src="art/busted-ship-explosion.jpg" alt="" aria-hidden="true" />
                        </div>
                        <div class="busted-quote">
                            You wake at @bust.ClinicName's clinic in @bust.HullDescription. The old ship and
                            everything visible aboard is gone — but nothing buried or banked was ever on it.
                            @* #477: the tank used to come up at a "mercy floor" that was exactly the reserve
                               the autopilot refuses to spend, so the new captain woke unable to fly anywhere.
                               It is a full tank now — the same fuel a new voyage starts with. *@
                            The tank's full, at least. They always fill the tank.
                        </div>
                        @* #480 — THE NERVE LEDGER, at the moment it explains the most: this is what broke you,
                           in the captain's own last few named pips. Only shown when the nerve actually kept a
                           record, so a death with no fear in it (a clean impact) is not padded with an empty box. *@
                        @if (DeathNerveLedgerLines is { Count: > 0 } deathLedger)
                        {
                            <div class="busted-nerve-ledger">
                                <div class="busted-nerve-ledger-head">WHAT BROKE YOU — the last of the nerve</div>
                                @foreach (string entry in deathLedger)
                                {
                                    <div class="busted-nerve-ledger-line">@entry</div>
                                }
                            </div>
                        }
                        @* #621 · THE RECEIPT NOW ADDS UP. It printed a 200 cr stake, a −500 cr bill and
                           "0 cr in hand", which is not arithmetic — the purse is floored at zero and the
                           three hundred that went missing was never mentioned anywhere. On the standard
                           uninsured wake the bill ALWAYS exceeds the stake, so this was every death, every
                           time. The shortfall is stated in the same breath as the numbers that made it, and
                           it is said the way this clinic says everything: without being asked. *@
                        <div class="busted-receipt">
                            <div>💰 @bust.StakeCr.ToString("N0") cr insurance stake</div>
                            <div>🏥 −@bust.ClinicBillCr.ToString("N0") cr clinic bill (the rebirth tax)</div>
                            @if (bust.ClinicBillCr > bust.StakeCr)
                            {
                                <div>🧾 @((bust.ClinicBillCr - bust.StakeCr).ToString("N0")) cr short — nobody asks you for it. It goes on the policy's tab, with everything else.</div>
                            }
                            <div>👛 @_credits.ToString("N0") cr in hand</div>
                            @* #477: not a "reach-a-pump reserve" any more — that WAS the bug. The floor was
                               priced at exactly the autopilot's own reserve, so the wake handed over fuel
                               the autopilot then refused to spend. It is a full tank now. *@
                            <div>⛽ @_reactionMassPulses p — a full tank, same as a new voyage</div>
                            <div>🔧 all upgrades reset to starter grade</div>
                        </div>
                        @* #422 arc 2 — THE CLINIC'S SECOND PAGE. Surfaces only once you've woken here before:
                           the bill's ledger carries entries you never made, under a policy number older than
                           you. The shard is gathered here the once; the full text lives in the ledger. *@
                        @if (bust.ClinicLedger is { Length: > 0 } clinicLedger)
                        {
                            <div class="busted-nebula busted-clinic-ledger">
                                <div class="busted-nebula-head">📄 THE CLINIC'S LEDGER HAS A SECOND PAGE</div>
                                <div class="busted-nebula-line">@clinicLedger</div>
                            </div>
                        }
                        @* Evening wind #20 — THE NEW CAPTAIN. On any death-resurrection the piracy insurance
                           puts a new name on the license and a new face in the mirror; the roster keeps the
                           retiree (see the captain cards). Shown only when a thread was actually succeeded
                           (a legacy run with no indexed thread falls back to the brain-backup copy alone). *@
                        @if (!string.IsNullOrEmpty(bust.NewCaptainName))
                        {
                            <div class="busted-succession">
                                <div class="busted-succession-head">🪪 THE POLICY ISSUES A NEW CAPTAIN</div>
                                <div class="busted-succession-line">@CaptainSuccession.PolicyPayoutLine</div>
                                <div class="busted-succession-names">
                                    @if (!string.IsNullOrEmpty(bust.RetiredCaptainName))
                                    {
                                        <span class="succ-old">@bust.RetiredCaptainName</span>
                                        <span class="succ-arrow">→</span>
                                    }
                                    <img class="succ-portrait" src="art/captain-@(bust.NewCaptainAvatar).jpg" alt="" aria-hidden="true"
                                         onerror="this.style.display='none'" />
                                    <span class="succ-new">@bust.NewCaptainName</span>
                                </div>
                            </div>
                        }
                        <button type="button" class="btn btn-light busted-close" @onclick="() => Dismiss(CloseBusted)">Board the rustbucket</button>
                        break;
                }
            </div>
        </div>
    }

    @* #422 — THE CONVERGENCE. The marquee one-time beat: the two rabbit holes (PROJEKTI KAAMOS and NEBULA
       MUTUAL) turn out to be one story — the Expanse moment. Fired by MaybeFireConvergence on the single edge
       BOTH arcs cross their joint threshold; marked seen (persisted) so it never re-plays. Full staged reveal
       card, above everything (a catch that just triggered it sits beneath). The #391 sanity throw is the
       #226 lane's hook (ArcConvergence.ConvergenceSanityShockHook = the heaviest in the game). *@
    @if (_convergenceRevealOpen)
    {
        <div class="convergence-backdrop" @onclick="() => Dismiss(CloseConvergenceReveal)">
            <div class="convergence-card" @onclick:stopPropagation="true">
                <div class="convergence-stamp">◼ ❄ THE THREADS CROSS</div>
                <div class="convergence-head">Two mysteries. One truth.</div>
                <div class="convergence-sub">PROJEKTI KAAMOS · NEBULA MUTUAL — the same held breath</div>
                @* #528 · THE PLATE. The biggest reveal in the game was a text div while a routine collector
                   shakedown had a painted portrait. It is a PLATE, not an illustration of the paragraph
                   below it: two filing systems that were always one building, and nobody in the room to
                   react. onerror-hides, so a missing file leaves this card exactly as it was. *@
                <img class="convergence-img" src="@ArcConvergence.ArtFile" alt="Two mysteries. One truth."
                     onerror="this.style.display='none'" />
                <div class="convergence-body">@ArcConvergence.ConvergenceReveal</div>
                @* The foot is the beat AFTER the beat, and it must not be a recap: it used to close on two
                   sentences copied verbatim out of the paragraph directly above it, so the biggest card in
                   the game repeated itself to the player's face. Core owns the line now, and a guard pins
                   that no sentence of it appears in the body (#422 story pass). *@
                <div class="convergence-foot">@ArcConvergence.ConvergenceFoot</div>
                <button type="button" class="btn btn-light convergence-close" @onclick="() => Dismiss(CloseConvergenceReveal)">…sit with that</button>
            </div>
        </div>
    }

    @* #440 · THE FIRST GROUND. The one card a captain gets before their first excursion (owner, 2026-07-26:
       "Definitely we need a landing site tutorial also for new captains"). Raised by BeginSurfaceExcursion
       AFTER the descent door drops, so it lands over a painted ground rather than over the flying-🛸 door.
       Once per captain — the seen-bit is set the moment it opens and rides in the vault, so it can never
       greet a captain twice (#292: only the truly new). Copy lives in Core GroundLesson, pinned by tests. *@
    @if (_groundLessonOpen)
    {
        <div class="convergence-backdrop" @onclick="() => Dismiss(CloseGroundLesson)">
            <div class="convergence-card ground-lesson-card" @onclick:stopPropagation="true">
                <div class="convergence-stamp">@GroundLesson.Stamp</div>
                <div class="convergence-head">@GroundLesson.Head</div>
                <div class="ground-lesson-levers">
                    @foreach (GroundLesson.Lever lever in GroundLesson.Levers)
                    {
                        <div class="ground-lesson-lever">
                            <span class="ground-lesson-key">@lever.Key</span>
                            <span class="ground-lesson-lever-text">
                                <span class="ground-lesson-lever-title">@lever.Title</span>
                                <span class="ground-lesson-lever-what">@lever.What</span>
                            </span>
                        </div>
                    }
                </div>
                <ul class="ground-lesson-laws">
                    @foreach (string law in GroundLesson.Laws)
                    {
                        <li>@law</li>
                    }
                </ul>
                <button type="button" class="btn btn-light convergence-close" @onclick="() => Dismiss(CloseGroundLesson)">@GroundLesson.Dismiss</button>
                <div class="ground-lesson-foot">@GroundLesson.Foot</div>
            </div>
        </div>
    }

    @* #563 · THE MAP JUST GOT BIGGER — the card that fires the first time a captain forces something open
       and real ground joins the plan. Owner: "The expanding site, how we tell that story to user clearly
       (do we have pop-up with image) is of great interest." Before this it was a toast that faded, while a
       scuttled ship got a full card with art. Once per captain, then the toast takes over for good.
       GEN-AI ART (art/ground-grows.jpg): the forced way standing open onto ground that was not on the plan
       a moment ago. Degrades to no image via the house onerror rule — never a broken frame. *@
    @if (_groundGrewOpen)
    {
        <div class="convergence-backdrop" @onclick="() => Dismiss(CloseGroundGrew)">
            <div class="convergence-card ground-grows-card" @onclick:stopPropagation="true">
                <div class="convergence-stamp">@GroundGrows.Stamp</div>
                <img class="ground-grows-art" src="@GroundGrows.ArtFile" alt=""
                     onerror="this.style.display='none'" />
                <div class="convergence-head">@GroundGrows.Head</div>
                <ul class="ground-grows-beats">
                    @foreach (string beat in GroundGrows.Beats)
                    {
                        <li>@beat</li>
                    }
                </ul>
                <button type="button" class="btn btn-light convergence-close" @onclick="() => Dismiss(CloseGroundGrew)">@GroundGrows.Dismiss</button>
                <div class="ground-lesson-foot">@GroundGrows.Foot</div>
            </div>
        </div>
    }

    @* #562 · THE TUBE FEEDS YOU — first time the ship racks a magazine while the captain stands in her
       down-tube. Owner: "We need to communicate the reload to user also… maybe a gen AI image about it the
       first time." Its real job is teaching the SHAPE of an excursion: the tube is the only place sentries
       get fed, so every trip is a loop with one anchor, and the route out needs the route home in it.
       GEN-AI ART (art/tube-rearm.jpg). Once per captain; the receipt line carries it thereafter. *@
    @if (_tubeRearmOpen)
    {
        <div class="convergence-backdrop" @onclick="() => Dismiss(CloseTubeRearm)">
            <div class="convergence-card ground-grows-card" @onclick:stopPropagation="true">
                <div class="convergence-stamp">@TubeRearm.Stamp</div>
                <img class="ground-grows-art" src="@TubeRearm.ArtFile" alt=""
                     onerror="this.style.display='none'" />
                <div class="convergence-head">@TubeRearm.Head</div>
                <ul class="ground-grows-beats">
                    @foreach (string beat in TubeRearm.Beats)
                    {
                        <li>@beat</li>
                    }
                </ul>
                <button type="button" class="btn btn-light convergence-close" @onclick="() => Dismiss(CloseTubeRearm)">@TubeRearm.Dismiss</button>
                <div class="ground-lesson-foot">@TubeRearm.Foot</div>
            </div>
        </div>
    }

    @* #573 · THE TANK IS GETTING LOW — first time a captain's air passes the low mark on a surface. Owner:
       "make the art... make a pop-up about oxygen being low... the time to hurry warning to the airlock or
       refill". He had just died of a resource he could not see. GEN-AI ART (art/air-running-out.jpg): the
       red-lit visor, a hand on the chest panel, and the lit hatch a long way off across the plain. *@
    @if (_airCardOpen)
    {
        <div class="convergence-backdrop" @onclick="() => Dismiss(CloseAirCard)">
            <div class="convergence-card ground-grows-card" @onclick:stopPropagation="true">
                <div class="convergence-stamp">@AirCard.Stamp</div>
                <img class="ground-grows-art" src="@AirCard.ArtFile" alt=""
                     onerror="this.style.display='none'" />
                <div class="convergence-head">@AirCard.Head</div>
                <ul class="ground-grows-beats">
                    @foreach (string beat in AirCard.Beats)
                    {
                        <li>@beat</li>
                    }
                </ul>
                <button type="button" class="btn btn-light convergence-close" @onclick="() => Dismiss(CloseAirCard)">@AirCard.Dismiss</button>
                <div class="ground-lesson-foot">@AirCard.Foot</div>
            </div>
        </div>
    }

    @* M28: the ship's parrot — a small perch visible on every desk, one squawk at a time. *@
    <div class="parrot-perch" aria-live="polite" title="the ship's parrot">
        @if (_parrotSquawk is not null)
        {
            <div class="parrot-bubble">@_parrotSquawk</div>
        }
        <span class="parrot-bird">🦜</span>
    </div>

    @* THE DICE TRAY (#305) — the shared 2D6 reveal a dice-scripted event casts into (aerobrake episodes
       now; Reevers/BUSTED/drinks next). Any system raises one via RaiseDiceEvent(DiceEvent). *@
    <DiceTray Event="_diceTrayEvent" OnDismiss="() => Dismiss(DismissDiceTray)" />
</div>

@code {

    @* #355 — the offer-a-drink affordance for ONE bar contact, rendered IDENTICALLY from both doorways:
       the barkeep's counter card and the patron's own table. It reads the one shared state machine
       (_pendingContactDrink / _roundThisVisit), so a moment opened at the table shows the same confirm at
       the counter and vice versa. keep gives the price/pour, resolved the same way at either doorway. *@
    private RenderFragment ContactDrinkOffer(string giver, string display, Core.Interior.Barkeep keep) => @<text>
        @{
            Core.Drink? knownFav = KnownFavoriteDrink(giver);
            bool poursUsual = BarPoursFavorite(giver);
        }
        @if (_pendingContactDrink == giver)
        {
            <div class="deck-offer-actions">
                <span class="bar-offer-moment small">Offer @display a drink? They'll choose their own pour.</span>
                <button type="button" class="btn btn-sm btn-warning" disabled="@(_credits < keep.DrinkPrice)"
                        title="@($"Offer {display} a drink ({keep.DrinkPrice} cr) — they pick their own pour; only if they take it is it poured, and the 2D6 decides if they open up or you slip a tell")"
                        @onclick="@(() => BuyContactDrink(giver))">🥃 Offer it · @keep.DrinkPrice cr</button>
                @if (poursUsual && knownFav is { } fav)
                {
                    <button type="button" class="btn btn-sm btn-success" disabled="@(_credits < keep.DrinkPrice)"
                            title="@($"Stand {display} the {fav.Name} — their usual. A small honest edge (+1) to the offer, and a warmer glass.")"
                            @onclick="@(() => BuyContactDrink(giver, true))">🥃 Their usual — @fav.Name · @keep.DrinkPrice cr</button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        title="Changed your mind — no harm done" @onclick="CancelContactDrinkOffer">Cancel</button>
            </div>
        }
        else if (_roundThisVisit)
        {
            <div class="deck-offer-actions">
                <span class="bar-toasted small">🍻 @display toasted you with the room@(knownFav is { } kf ? $" · drinks {kf.Name}" : "")</span>
                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_credits < keep.DrinkPrice)"
                        title="@($"Offer {display} a personal glass on top of the round — they may still refuse; extra warmth, never demanded")"
                        @onclick="@(() => OfferContactDrink(giver))">🥃 Offer another · @keep.DrinkPrice cr</button>
            </div>
        }
        else
        {
            <div class="deck-offer-actions">
                <button type="button" class="btn btn-sm btn-warning"
                        title="@($"Offer {display} a drink ({keep.DrinkPrice} cr) — a sign of trust they may accept or refuse; if taken, the 2D6 decides if they open up or you slip a tell")"
                        @onclick="@(() => OfferContactDrink(giver))">🥃 Offer @display a drink · @keep.DrinkPrice cr</button>
            @if (knownFav is { } kf2)
            {
                <span class="bar-favorite small" title="You've learned what they drink">❤ @kf2.Name</span>
            }
            </div>
        }
    </text>;

    private void DrawPyramids()
    {
        for (int i = 0; i < AncientsRule.PyramidCount; i++)
        {
            if (!AncientsRule.Revealed(i, _ship.Position, SimTime))
            {
                continue;
            }

            Vector2d position = AncientsRule.PyramidPosition(i, SimTime);
            (float sx, float sy) = _camera.WorldToScreen(position);
            Span<float> triangle = stackalloc float[8];
            triangle[0] = sx; triangle[1] = sy - 6;
            triangle[2] = sx - 5; triangle[3] = sy + 4;
            triangle[4] = sx + 5; triangle[5] = sy + 4;
            triangle[6] = sx; triangle[7] = sy - 6;
            _renderer!.DrawPolyline(triangle, PyramidColor, 1.6f);
            _renderer.DrawText(sx + 8, sy - 6, "◬ ???", PyramidColor);
        }
    }

    private void DrawOrdnance()
    {
        foreach (OrdnanceState round in _ordnance)
        {
            if (round.Spent)
            {
                continue;
            }

            (float sx, float sy) = _camera.WorldToScreen(round.State.Position);
            _renderer!.DrawCircle(sx, sy, round.Round.Kind == OrdnanceKind.Missile ? 2.5f : 1.8f,
                OrdnanceColor, OrdnanceColor);
            // A short streak along the velocity so a round reads as MOVING at map zoom.
            Vector2d tail = round.State.Position - round.State.Velocity.Normalized() * (_camera.MetersPerPixel * 6);
            (float tx, float ty) = _camera.WorldToScreen(tail);
            Span<float> streak = stackalloc float[4];
            streak[0] = sx; streak[1] = sy; streak[2] = tx; streak[3] = ty;
            _renderer.DrawPolyline(streak, OrdnanceColor with { A = 120 }, 1f);
        }
    }
}
