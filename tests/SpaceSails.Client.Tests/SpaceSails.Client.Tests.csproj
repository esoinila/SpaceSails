<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE DECK AUDIT. Owner, having been handed the same bug on two different decks — "there two e's are
       too close to each others now", then "see the two crowded consoles at the back of our ship" — asked
       for the thing that stops it recurring: "add a CI check to catch all such cases."

       Every geometry law the ship has lived under so far was written in SpaceSails.Core.Tests, which can
       only see what has been moved into Core. The consoles have NOT been: they are literals in
       DeckPlan.BuildShip, HavenInterior, WreckInterior and MoonSurface. That is exactly why the collisions
       kept happening in the client and kept passing CI.

       So this project references the CLIENT and walks the real plans — the same arrays the renderer draws
       and the same NearestConsoleSpot the [E] key dispatches through. A test that reasons about a copy of
       the geometry proves nothing; this one asks the shipping objects. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA1416: the client assembly is [SupportedOSPlatform("browser")] because the Blazor WASM SDK says so,
         and this test project runs on the CI runner. Every member it touches — DeckPlan's walls, consoles and
         NearestConsoleSpot, and the layout builders in HavenInterior / WreckInterior / MoonSurface — is pure
         arithmetic with no browser API anywhere beneath it, which is exactly why the geometry CAN be audited
         off-browser. Scoped to this project; the client itself keeps the analyzer. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- #1108 — THE SERIALISING COLLECTION, LINKED SO THERE IS EXACTLY ONE OF IT. An xUnit collection
       definition is per-ASSEMBLY, so both suites need one; the process-wide registers it protects
       (StopOrder, PreservationZone, Burial, PoliteDecline, QuietHands) are Core's, and BOTH suites write
       to them — four classes in this one do. Two copies of a definition whose whole job is "there is one
       of these" is how the two halves come to disagree, so the file is LINKED, exactly as this project's
       MapMarkup.cs is linked into the Core suite next door and for the same reason. Its namespace is
       SpaceSails.Core.Tests, so the classes here that use it say `using SpaceSails.Core.Tests;`. -->
  <ItemGroup>
    <Compile Include="..\SpaceSails.Core.Tests\StopRegisterCollection.cs" Link="StopRegisterCollection.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SpaceSails.Client\SpaceSails.Client.csproj" />
  </ItemGroup>

</Project>
