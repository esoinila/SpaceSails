<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- #251 item 1 - THIS SUITE READS THE CLIENT'S MARKUP TOO, so it needs the same composed reader.
       TheDeathCardReadsTheNarrationSeamTests states its law over Map.razor, and the wake card moved into
       Pages/Map/BustedCard.razor with the rest of the surfaces. MapMarkup hands back the page with every
       surface spliced in at its invocation site; it is LINKED rather than copied so there is exactly one
       of it, and it is held to its own law next door in TheComposedPageIsThePageTests. -->
  <ItemGroup>
    <Compile Include="..\SpaceSails.Client.Tests\MapMarkup.cs" Link="MapMarkup.cs" />
    <!-- #251 item 3 — and its twin for the stylesheet, for the same reason and by the same rule: one copy,
         linked. MapMarkup.Read hands the whole cascade back for Pages/Map.razor.css, so it cannot compile
         without it. -->
    <Compile Include="..\SpaceSails.Client.Tests\MapStylesheet.cs" Link="MapStylesheet.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SpaceSails.Core\SpaceSails.Core.csproj" />
    <ProjectReference Include="..\..\labs\SpaceSails.LabViz\SpaceSails.LabViz.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\scenarios\*.json" Link="scenarios\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- #299 — the z-band sync gate reads the LIVE stylesheets. Copy them beside the test assembly every
       build (a CSS edit rebuilds the test project → recopies), so CssZBandSyncTests parses the current
       source, not a stale snapshot, with no dependency on the working directory. -->
  <ItemGroup>
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\css\app.css" Link="cssource\app.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\Pages\Map.razor.css" Link="cssource\Map.razor.css" CopyToOutputDirectory="PreserveNewest" />
    <!-- #251 item 3 — and the seventy-six sheets the page's own stylesheet was split into. The bands this
         gate resolves are spread across them now (`.jump-overlay` is JumpCard's, `.busted-backdrop` is
         BustedCard's), and a z-index only means anything against the WHOLE cascade anyway: copying the
         page's half alone would leave the gate quietly resolving fewer selectors every time a rule moved. -->
    <Content Include="..\..\src\SpaceSails.Client\Pages\Map\*.razor.css" Link="cssource\Map\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\Components\DiceTray.razor.css" Link="cssource\DiceTray.razor.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- #528 — the plate gate reads the LIVE art directory the same way. Every reveal plate names a JPG;
       a plate pointed at a file nobody painted degrades silently in the browser (the onerror-hide law is
       what makes that safe) and would therefore never be noticed. Copy the arc's paintings beside the test
       assembly so RevealPlatesArePaintedTests can hold each constant to a file that actually exists.
       The treasure-* glob is copied WHOLE on purpose: TreasureMapArtIsWiredTests checks the other
       direction too — a painting that shipped with nothing pointed at it — and can only see the orphans
       if every one of them is here. -->
  <ItemGroup>
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\kaamos-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\nebula-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\convergence.jpg" Link="artsource\convergence.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\death-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\busted-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\bolivia-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\treasure-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\vented-nest-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- #654 — all three of a derelict's evidence stations, so EveryWreckEvidenceStationIsPainted can
         hold the ten cause portraits AND the two generic station plates to files on disk. -->
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\wreck-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- #528 round two — the plates that hang off a beat's own predicate rather than an arc's pool. -->
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\lab-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\outpost-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\collector-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\hatch-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\archive-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\oracle-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\bond-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- #695 — the five office faces of an authority card, and the #528 original kept as the fallback, so
         EveryOfficeIssuesItsOwnPaintedFace can hold each office's ArtUrl to a file that is actually there. -->
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\the-authority-card*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- #725 — the two silent finds. Both were filed as beats with no picture at all, so a card wired over
         a JPG that is not in the folder would leave them exactly as silent as they started and the
         onerror-hide would make sure nobody found out. TheTwoSilentFindsArePainted holds each to a file. -->
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\the-plate.jpg" Link="artsource\the-plate.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\the-staff-mess.jpg" Link="artsource\the-staff-mess.jpg" CopyToOutputDirectory="PreserveNewest" />
    <!-- #751 — the hall and the cabinet. Both are first-entry cards over the same onerror-hide seam, so a
         canvas that never got copied in would leave the two loudest rooms on B1 showing a hole and saying
         nothing about it. TheHallAndTheCabinetArePainted holds each constant to a file. -->
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\b1-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>