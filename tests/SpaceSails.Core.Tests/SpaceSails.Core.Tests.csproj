<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SpaceSails.Core\SpaceSails.Core.csproj" />
    <ProjectReference Include="..\..\labs\SpaceSails.LabViz\SpaceSails.LabViz.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\scenarios\*.json" Link="scenarios\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- #299 — the z-band sync gate reads the LIVE stylesheets. Copy them beside the test assembly every
       build (a CSS edit rebuilds the test project → recopies), so CssZBandSyncTests parses the current
       source, not a stale snapshot, with no dependency on the working directory. -->
  <ItemGroup>
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\css\app.css" Link="cssource\app.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\Pages\Map.razor.css" Link="cssource\Map.razor.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\Components\DiceTray.razor.css" Link="cssource\DiceTray.razor.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- #528 — the plate gate reads the LIVE art directory the same way. Every reveal plate names a JPG;
       a plate pointed at a file nobody painted degrades silently in the browser (the onerror-hide law is
       what makes that safe) and would therefore never be noticed. Copy the arc's paintings beside the test
       assembly so RevealPlatesArePaintedTests can hold each constant to a file that actually exists.
       The treasure-* glob is copied WHOLE on purpose: TreasureMapArtIsWiredTests checks the other
       direction too — a painting that shipped with nothing pointed at it — and can only see the orphans
       if every one of them is here. -->
  <ItemGroup>
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\kaamos-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\nebula-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\convergence.jpg" Link="artsource\convergence.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\death-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\busted-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\bolivia-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\treasure-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\vented-nest-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- #654 — all three of a derelict's evidence stations, so EveryWreckEvidenceStationIsPainted can
         hold the ten cause portraits AND the two generic station plates to files on disk. -->
    <Content Include="..\..\src\SpaceSails.Client\wwwroot\art\wreck-*.jpg" Link="artsource\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>